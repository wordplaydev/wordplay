CLAUDE.md
functions/.env.local
static/wasm
# Structural updates bundle, built from CHANGELOG.md by `npm run updates`.
# The per-locale translations of its entries are committed; this is not.
static/updates.json
src/routes/\[\[locale\]\]/updates/date.json

# Generated font artifacts (built by `npm run fonts-build` in postinstall/build
# from the committed fonts.manifest.ts + fonts.lock.json + emoji-faces.css).
/static/fonts/fonts.css
/static/fonts/fonts-fallback.css
/src/basis/faces/faces.generated.ts
/src/basis/faces/faces.fallback.generated.ts

# Content hashes for every locale asset, built by `npm run locale-assets` in
# postinstall/build. Not committed: it would change on every locale edit, which
# is exactly the churn the locale work is trying to reduce.
/src/db/locales/localeAssets.generated.ts

# Each locale's assembled document, rebuilt from its `sections/` by
# `npm run locales-assemble` in postinstall/build. The sections are the source;
# committing the assembly too would put the whole-file diff back into every
# locale change, which is the thing splitting them was for.
#
# Written as ignore-everything-then-exempt because a locale code contains
# hyphens (`ta-IN-LK-SG.json`), so no glob separates `<code>.json` from
# `<code>-tutorial.json` by shape alone. A NEW per-locale file kind must be
# exempted here or it will be silently ignored; localeDirectoryFiles.test.ts
# fails if one is not.
/src/locale/en-US.json
/static/locales/*/*.json
!/static/locales/*/*-datetimes.json
!/static/locales/*/*-emojis.json
!/static/locales/*/*-how.json
!/static/locales/*/*-tutorial.json
!/static/locales/*/*-tutorial-quick.json
!/static/locales/*/*-updates.json

# Python bytecode cache (emoji font tooling)
__pycache__/

# The GitHub wiki (wordplay.wiki.git), cloned here by `npm run wiki` so it can
# be read and edited alongside the code. It's a separate repository, committed
# and pushed on its own.
wiki/
.changelog-condense/
