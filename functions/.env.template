# Copy this to functions/.env and fill in real values. That file is gitignored;
# this one is not, so nothing here may be a live credential — a token committed
# here is readable by anyone with repo access, and stays in history after it is
# removed.
#
# Not here: RESEND_API_KEY, THROTTLE_PEPPER, and ANTHROPIC_API_KEY. Those are
# Secret Manager values, set per project with `firebase functions:secrets:set`,
# and a copy in this file would do nothing.

# A GitHub personal access token, scoped to wordplaydev/wordplay only.
# Fine-grained: Contents, Issues, and Pull requests all read and write — the
# contributors PR creates a branch and commits, and the stale-assignment bot
# comments and unassigns. Classic: the `repo` scope covers all of it.
GITHUB_TOKEN =
# Set to true to make the stale-assignment tidy bot log intended actions
# without posting comments or unassigning anyone.
DRY_RUN = false
