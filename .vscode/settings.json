{
    "editor.formatOnSave": true,
    // Format on save must never fall through to VS Code's built-in JSON formatter:
    // it expands every inline array, so one save of a locale file rewrites ~10,000
    // lines and makes the branch conflict with every later change to that file.
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace, 'Noto Music'",
    "terminal.integrated.fontFamily": "Menlo, Monaco, 'Courier New', monospace, 'Noto Music'"
}