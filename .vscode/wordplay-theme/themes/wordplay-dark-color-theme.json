{
    "$schema": "vscode://schemas/color-theme",
    "name": "Wordplay Dark",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        "foreground": "#ffffff",
        "descriptionForeground": "#9f9f9f",
        "disabledForeground": "#9f9f9f",
        "errorForeground": "#ff7829",
        "focusBorder": "#2f66f5",
        "widget.border": "#6d6d6d",
        "selection.background": "#b67c003e",
        "textLink.foreground": "#c69938",
        "textLink.activeForeground": "#c69938",
        "textBlockQuote.background": "#1e1e1e",
        "textCodeBlock.background": "#1e1e1e",
        "textSeparator.foreground": "#6d6d6d",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#9f9f9f",
        "titleBar.border": "#6d6d6d",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#ffffff",
        "statusBar.border": "#6d6d6d",
        "statusBar.noFolderBackground": "#000000",
        "statusBar.debuggingBackground": "#ff5e00",
        "statusBar.debuggingForeground": "#000000",
        "statusBarItem.remoteBackground": "#c7b4ff",
        "statusBarItem.remoteForeground": "#000000",
        "statusBarItem.hoverBackground": "#b67c003e",
        "statusBarItem.errorBackground": "#ff7829",
        "statusBarItem.errorForeground": "#000000",
        "statusBarItem.warningBackground": "#bf8d21",
        "statusBarItem.warningForeground": "#000000",
        "activityBar.background": "#000000",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#9f9f9f",
        "activityBar.border": "#6d6d6d",
        "activityBar.activeBorder": "#9b6900",
        "activityBarBadge.background": "#bf8d21",
        "activityBarBadge.foreground": "#000000",
        "sideBar.background": "#000000",
        "sideBar.foreground": "#ffffff",
        "sideBar.border": "#6d6d6d",
        "sideBarTitle.foreground": "#9f9f9f",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.foreground": "#ffffff",
        "sideBarSectionHeader.border": "#6d6d6d",
        "editorGroup.border": "#6d6d6d",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#6d6d6d",
        "tab.activeBackground": "#000000",
        "tab.activeForeground": "#ffffff",
        "tab.activeBorderTop": "#9b6900",
        "tab.activeBorder": "#000000",
        "tab.inactiveBackground": "#000000",
        "tab.inactiveForeground": "#9f9f9f",
        "tab.hoverBackground": "#b67c003e",
        "tab.border": "#6d6d6d",
        "tab.unfocusedActiveBorderTop": "#9b690066",
        "editor.background": "#000000",
        "editor.foreground": "#ffffff",
        "editorCursor.foreground": "#b67c00",
        "editor.selectionBackground": "#b67c003e",
        "editor.inactiveSelectionBackground": "#b67c001f",
        "editor.selectionHighlightBackground": "#b67c001f",
        "editor.wordHighlightBackground": "#3a72fe26",
        "editor.wordHighlightStrongBackground": "#3a72fe40",
        "editor.findMatchBackground": "#b67c003e",
        "editor.findMatchHighlightBackground": "#b67c001f",
        "editor.lineHighlightBackground": "#1e1e1e",
        "editor.rangeHighlightBackground": "#b67c001f",
        "editorWhitespace.foreground": "#6d6d6d80",
        "editorIndentGuide.background1": "#6d6d6d66",
        "editorIndentGuide.activeBackground1": "#9f9f9f",
        "editorLineNumber.foreground": "#9f9f9f",
        "editorLineNumber.activeForeground": "#ffffff",
        "editorRuler.foreground": "#6d6d6d66",
        "editorLink.activeForeground": "#c69938",
        "editorBracketMatch.background": "#b67c003e",
        "editorBracketMatch.border": "#b67c00",
        "editorBracketHighlight.foreground1": "#ffffff",
        "editorBracketHighlight.foreground2": "#ff7829",
        "editorBracketHighlight.foreground3": "#ffffff",
        "editorBracketHighlight.foreground4": "#ff7829",
        "editorBracketHighlight.foreground5": "#ffffff",
        "editorBracketHighlight.foreground6": "#ff7829",
        "editorBracketHighlight.unexpectedBracket.foreground": "#f076b1",
        "editorError.foreground": "#ff7829",
        "editorWarning.foreground": "#c69938",
        "editorInfo.foreground": "#779cff",
        "editorGutter.modifiedBackground": "#779cff",
        "editorGutter.addedBackground": "#c69938",
        "editorGutter.deletedBackground": "#ff7829",
        "editorOverviewRuler.border": "#6d6d6d",
        "editorOverviewRuler.findMatchForeground": "#c69938",
        "editorOverviewRuler.errorForeground": "#ff7829",
        "editorOverviewRuler.warningForeground": "#c69938",
        "editorOverviewRuler.modifiedForeground": "#779cff",
        "editorOverviewRuler.addedForeground": "#c69938",
        "editorOverviewRuler.deletedForeground": "#ff7829",
        "editorWidget.background": "#1e1e1e",
        "editorWidget.border": "#6d6d6d",
        "editorHoverWidget.background": "#1e1e1e",
        "editorHoverWidget.border": "#6d6d6d",
        "editorSuggestWidget.background": "#1e1e1e",
        "editorSuggestWidget.border": "#6d6d6d",
        "editorSuggestWidget.selectedBackground": "#2f66f5",
        "editorSuggestWidget.selectedForeground": "#ffffff",
        "editorSuggestWidget.highlightForeground": "#c69938",
        "peekView.border": "#9b6900",
        "peekViewEditor.background": "#000000",
        "peekViewEditor.matchHighlightBackground": "#b67c003e",
        "peekViewResult.background": "#1e1e1e",
        "peekViewResult.selectionBackground": "#b67c003e",
        "peekViewTitle.background": "#1e1e1e",
        "diffEditor.insertedTextBackground": "#c6993826",
        "diffEditor.removedTextBackground": "#ff782926",
        "diffEditor.border": "#6d6d6d",
        "panel.background": "#000000",
        "panel.border": "#6d6d6d",
        "panelTitle.activeForeground": "#ffffff",
        "panelTitle.inactiveForeground": "#9f9f9f",
        "panelTitle.activeBorder": "#9b6900",
        "panelSection.border": "#6d6d6d",
        "panelSectionHeader.background": "#000000",
        "panelSectionHeader.border": "#6d6d6d",
        "terminal.background": "#000000",
        "terminal.foreground": "#ffffff",
        "terminal.border": "#6d6d6d",
        "terminal.selectionBackground": "#b67c003e",
        "terminalCursor.foreground": "#b67c00",
        "sash.hoverBorder": "#9b6900",
        "tree.indentGuidesStroke": "#6d6d6d66",
        "list.activeSelectionBackground": "#2f66f5",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#1e1e1e",
        "list.inactiveSelectionForeground": "#ffffff",
        "list.hoverBackground": "#b67c003e",
        "list.highlightForeground": "#c69938",
        "list.focusOutline": "#2f66f5",
        "list.errorForeground": "#ff7829",
        "list.warningForeground": "#c69938",
        "button.background": "#2f66f5",
        "button.foreground": "#ffffff",
        "button.hoverBackground": "#2550bf",
        "button.secondaryBackground": "#1e1e1e",
        "button.secondaryForeground": "#ffffff",
        "badge.background": "#bf8d21",
        "badge.foreground": "#000000",
        "progressBar.background": "#b67c00",
        "input.background": "#000000",
        "input.foreground": "#ffffff",
        "input.border": "#6d6d6d",
        "input.placeholderForeground": "#9f9f9f",
        "inputOption.activeBorder": "#2f66f5",
        "inputValidation.errorBackground": "#000000",
        "inputValidation.errorBorder": "#ff7829",
        "inputValidation.warningBackground": "#000000",
        "inputValidation.warningBorder": "#b67c00",
        "dropdown.background": "#000000",
        "dropdown.foreground": "#ffffff",
        "dropdown.border": "#6d6d6d",
        "quickInput.background": "#1e1e1e",
        "quickInputList.focusBackground": "#2f66f5",
        "quickInputList.focusForeground": "#ffffff",
        "menu.background": "#1e1e1e",
        "menu.foreground": "#ffffff",
        "menu.border": "#6d6d6d",
        "menu.selectionBackground": "#2f66f5",
        "menu.selectionForeground": "#ffffff",
        "scrollbarSlider.background": "#6d6d6d66",
        "scrollbarSlider.hoverBackground": "#6d6d6d99",
        "scrollbarSlider.activeBackground": "#9f9f9fcc",
        "notificationCenterHeader.background": "#1e1e1e",
        "notifications.background": "#1e1e1e",
        "notifications.border": "#6d6d6d",
        "notificationsErrorIcon.foreground": "#ff7829",
        "notificationsWarningIcon.foreground": "#c69938",
        "notificationsInfoIcon.foreground": "#779cff",
        "gitDecoration.addedResourceForeground": "#c69938",
        "gitDecoration.untrackedResourceForeground": "#c69938",
        "gitDecoration.modifiedResourceForeground": "#779cff",
        "gitDecoration.deletedResourceForeground": "#ff7829",
        "gitDecoration.ignoredResourceForeground": "#9f9f9f",
        "gitDecoration.conflictingResourceForeground": "#f076b1",
        "breadcrumb.foreground": "#9f9f9f",
        "breadcrumb.focusForeground": "#ffffff",
        "breadcrumb.background": "#000000",
        "minimap.findMatchHighlight": "#b67c00",
        "minimap.selectionHighlight": "#b67c00",
        "minimapSlider.background": "#6d6d6d4d",
        "settings.headerForeground": "#ffffff",
        "settings.modifiedItemIndicator": "#9b6900",
        "keybindingLabel.background": "#1e1e1e",
        "keybindingLabel.foreground": "#ffffff",
        "keybindingLabel.border": "#6d6d6d"
    },
    "semanticTokenColors": {
        "type": "#ff7829",
        "class": "#ff7829",
        "interface": "#ff7829",
        "enum": "#ff7829",
        "typeParameter": "#ff7829",
        "namespace": "#ff7829",
        "keyword": "#ff7829",
        "function": "#ffffff",
        "method": "#ffffff",
        "variable": "#ffffff",
        "parameter": "#ffffff",
        "property": "#ffffff",
        "enumMember": "#779cff",
        "string": "#779cff",
        "number": "#779cff"
    },
    "tokenColors": [
        {
            "name": "Docs",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": {
                "foreground": "#c7b4ff",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc references",
            "scope": [
                "storage.type.class.jsdoc",
                "entity.name.type.instance.jsdoc",
                "variable.other.jsdoc",
                "comment.block.documentation keyword"
            ],
            "settings": {
                "foreground": "#c69938",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Delimiters",
            "scope": [
                "punctuation",
                "meta.brace",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.separator.comma",
                "punctuation.terminator",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#e1e1e1"
            }
        },
        {
            "name": "Relations",
            "scope": [
                "punctuation.accessor",
                "punctuation.separator.key-value",
                "punctuation.separator.label",
                "keyword.operator.type.annotation",
                "meta.object-literal.key punctuation.separator"
            ],
            "settings": {
                "foreground": "#ff7829"
            }
        },
        {
            "name": "Operators and keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator",
                "storage",
                "storage.modifier",
                "storage.type",
                "variable.language.super",
                "keyword.other"
            ],
            "settings": {
                "foreground": "#ff7829"
            }
        },
        {
            "name": "Evaluation markers",
            "scope": [
                "storage.type.function",
                "storage.type.function.arrow",
                "keyword.operator.arrow",
                "keyword.control.new",
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#779cff"
            }
        },
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.type",
                "support.class",
                "meta.type.annotation entity.name",
                "entity.name.tag",
                "entity.name.namespace"
            ],
            "settings": {
                "foreground": "#ff7829"
            }
        },
        {
            "name": "Literals",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "punctuation.definition.string",
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "string.regexp",
                "variable.language.this",
                "support.constant"
            ],
            "settings": {
                "foreground": "#779cff"
            }
        },
        {
            "name": "Names",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "entity.name.function",
                "support.function",
                "meta.definition.variable",
                "meta.object-literal.key",
                "support.type.property-name",
                "entity.other.attribute-name",
                "meta.property-name"
            ],
            "settings": {
                "foreground": "#ffffff"
            }
        },
        {
            "name": "Evaluated definitions",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator"
            ],
            "settings": {
                "foreground": "#f076b1"
            }
        },
        {
            "name": "Placeholders",
            "scope": [
                "comment.block.documentation storage.type.placeholder",
                "variable.language.placeholder.wordplay"
            ],
            "settings": {
                "foreground": "#9f9f9f"
            }
        },
        {
            "name": "Unknown",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#f076b1"
            }
        },
        {
            "name": "Deprecated",
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#9f9f9f",
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markup headings",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#c7b4ff",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup emphasis",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup italics",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#779cff"
            }
        },
        {
            "name": "Markup underline",
            "scope": [
                "markup.underline"
            ],
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markup links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#c69938",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markup diffs",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#c69938"
            }
        },
        {
            "name": "Markup deletions",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#ff7829"
            }
        }
    ]
}
