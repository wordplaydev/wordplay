{
    "name": "wordplay-theme",
    "displayName": "Wordplay",
    "description": "The Wordplay app's own palette as a VS Code theme, and syntax highlighting for .wp files.",
    "version": "1.0.0",
    "private": true,
    "publisher": "wordplay",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": ["Themes", "Programming Languages"],
    "contributes": {
        "languages": [
            {
                "id": "wordplay",
                "aliases": ["Wordplay", "wordplay"],
                "extensions": [".wp"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "wordplay",
                "scopeName": "source.wordplay",
                "path": "./syntaxes/wordplay.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "Wordplay Light",
                "uiTheme": "vs",
                "path": "./themes/wordplay-light-color-theme.json"
            },
            {
                "label": "Wordplay Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/wordplay-dark-color-theme.json"
            }
        ]
    }
}
