¶Bánh kem phồng lên ở mỗi nhịp rồi lắng xuống giữa các nhịp.¶
ƒ bánhKem() Cụmtừ(
		'🎂'
		(4m + ((đếm2 % 2) · 0.4m))
		khoảngthờigian: 0.2s
	)

Sânkhấu(
	[
		Nhóm(
			Ngănxếp(đệm: 0.5m)
			[
				bánhKem()
				Cụmtừ('Chúc Mừng Sinh Nhật' 1.3m)
			]
		)
		ÂmNhạc(
			[
				BảnNhạc(giaiĐiệu2 nhạcCụ: NhạcCụ.sáo nhịp: 0.5beats)
				BảnNhạc(
					bèTrầm
					nhạcCụ: NhạcCụ.đànVĩCầm
					nhịp: 0.5beats
					âmLượng: 65%
				)
				BảnNhạc(
					hợpÂm
					nhạcCụ: NhạcCụ.đànPiano
					nhịp: 1beats
					âmLượng: 55%
				)
			]
			nhịpĐộ: 116beats/min
			tên: 'sinh nhật'
		)
	]
	lýlịch: Màusắc(18% 20 330°)
	màusắc: Màusắc(96% 0 0°)
)
