¶Một chiếc thuyền. Nó trượt thêm một chút ở mỗi nhịp và nghiêng qua bên khác mỗi lần, đó chính là điều tạo cảm giác đang chèo thuyền; làn đường quyết định nó nằm cao bao nhiêu và bắt đầu trước bao xa, để chúng không di chuyển giống nhau.¶
ƒ thuyền(làn•# bắtĐầu2•#)•Cụmtừ
	Cụmtừ(
		'🚣'
		1.5m
		vịTrí: VịTrí(
			((((nhịpChèo + bắtĐầu2) % 16) - 8) · 1.1) · 1m
			((làn · 1.9) - 1.9) · 1m
		)
		xoay: (((nhịpChèo + làn) % 2) = 0) ? 9° -9°
		khoảngthờigian: 0.2s
	)

độiTàu: [thuyền(0 0) thuyền(1 6) thuyền(2 11)]

Sânkhấu(
	[
		:độiTàu
		Cụmtừ(
			'〰〰〰〰〰〰〰〰'
			1m
			vịTrí: VịTrí(-8m -3.2m)
			màusắc: Màusắc(48% 22 240°)
		)
		Cụmtừ(
			'Row, row, row your boat'
			0.9m
			vịTrí: VịTrí(-4.4m 3.4m)
		)
		ÂmNhạc(
			[
				BảnNhạc(giaiĐiệu2 nhạcCụ: NhạcCụ.sáo nhịp: 0.5beats)
				BảnNhạc(
					hợpÂm
					nhạcCụ: NhạcCụ.đànPiano
					nhịp: 1beats
					âmLượng: 60%
				)
				BảnNhạc(
					máiChèo
					nhạcCụ: NhạcCụ.trống
					nhịp: 1beats
					âmLượng: 45%
				)
			]
			nhịpĐộ: 144beats/min
			tên: 'thuyền'
		)
	]
	lýlịch: Màusắc(22% 18 230°)
	màusắc: Màusắc(96% 0 0°)
)
