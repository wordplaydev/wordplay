			)
			BảnNhạc(
				âmTrầm
				nhạcCụ: NhạcCụ.đànBassTổngHợp
				nhịp: 1𝅘𝅥
				chìaKhóa: -24semitones
				âmLượng: đãNghe(2 30%)
			)
			BảnNhạc(
				trống2
				nhạcCụ: NhạcCụ.trống
				nhịp: 1𝅘𝅥
				âmLượng: đãNghe(3 20%)
			)
			BảnNhạc(
				hànhKhúc
