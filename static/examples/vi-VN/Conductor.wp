bàiHát: ÂmNhạc(
		[
			BảnNhạc(
				diễuHành
				nhạcCụ: giọng(nổiBật)
				âmLượng: 55%
				nhịp: 1𝅘𝅥
			)
			BảnNhạc(
				trầm
				nhạcCụ: NhạcCụ.đànBassTổngHợp
				nhịp: 1𝅘𝅥
				chìaKhóa: -24semitones
				âmLượng: ngheThấy(2 30%)
			)
			BảnNhạc(
				trống2
				nhạcCụ: NhạcCụ.trống
				nhịp: 1𝅘𝅥
				âmLượng: ngheThấy(3 20%)
			)
			BảnNhạc(
				diễuHành
				nhạcCụ: NhạcCụ.kènSaxophone
				nhịp: 1𝅘𝅥
				chìaKhóa: -12semitones
				âmLượng: ngheThấy(4 22%)
			)
			BảnNhạc(
				đệm2
				nhạcCụ: NhạcCụ.đànPadTổngHợp
				nhịp: 1𝅝
				chìaKhóa: -12semitones
				âmLượng: ngheThấy(5 16%)
			)
			BảnNhạc(
				dây
				nhạcCụ: NhạcCụ.đànVĩCầm
				nhịp: 1𝅘𝅥
				âmLượng: ngheThấy(6 18%)
			)
			BảnNhạc(
				chuông2
				nhạcCụ: NhạcCụ.chuông
				nhịp: 1𝅝
				chìaKhóa: 12semitones
				âmLượng: ngheThấy(7 12%)
			)
			BảnNhạc(
				bộĐếm
				nhạcCụ: NhạcCụ.sáo
				nhịp: 1𝅘𝅥
