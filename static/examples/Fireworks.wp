Stage(
	[
		:firing.translate(ƒ(p•Part i•#) burst(p i))
		Music(
			[
				Track(melody instrument: Instrument.trumpet volume: 90% loop: ⊥)
				Track(
					bass
					instrument: Instrument.piano
					key: -12semitones
					volume: 50%
					pan: -0.4
					loop: ⊥
				)
				Track(bell instrument: Instrument.bell volume: 55% loop: ⊥)
				Track(
					violin
					instrument: Instrument.violin
					volume: 45%
					pan: 0.3
					loop: ⊥
				)
				Track(flute instrument: Instrument.flute volume: 65% loop: ⊥)
				Track(drums instrument: Instrument.drums volume: 45% loop: ⊥)
			]
			tempo: 84beats/min
			scale: Music.chromatic
			name: 'anthem'
		)
	]
	background: Color(10% 12 265°)
	color: Color(96% 0 0°)
)
