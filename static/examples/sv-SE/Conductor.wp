	]

sång: Musik(
		[
			Spår(
				marsch
				instrument: röst2(utvald)
				volym: 55%
				takt: 1𝅘𝅥
			)
			Spår(
				bas2
				instrument: Instrument.syntBas
				takt: 1𝅘𝅥
				tonart: -24semitones
				volym: hörd(2 30%)
			)
			Spår(
				trummor2
				instrument: Instrument.trummor
				takt: 1𝅘𝅥
				volym: hörd(3 20%)
			)
			Spår(
				marsch
				instrument: Instrument.saxofon
				takt: 1𝅘𝅥
				tonart: -12semitones
				volym: hörd(4 22%)
			)
			Spår(
				matta
				instrument: Instrument.syntPad
				takt: 1𝅝
				tonart: -12semitones
				volym: hörd(5 16%)
			)
			Spår(
				stråkar
				instrument: Instrument.fiol
				takt: 1𝅘𝅥
				volym: hörd(6 18%)
			)
			Spår(
				klockor
				instrument: Instrument.klocka
				takt: 1𝅝
				tonart: 12semitones
				volym: hörd(7 12%)
			)
			Spår(
				räknare
				instrument: Instrument.flöjt
				takt: 1𝅘𝅥
				volym: hörd(8 14%)
			)
		]
		tempo: takt2 · 1beats/min
		skala: Musik.kromatisk
		namn: 'kejserlig marsch'
	)

¶Hur långt flottan har rest. Den räknar sina egna klockslag istället för att läsa av klockan, och räknar dem snabbare när marschen går fortare, så skeppen flyger i takt med tempot.¶
resa: 0 … ∆ Tid(40ms) … resa + (takt2 ÷ 72)

ƒ status()•'' '\lager\ of 8 playing · \takt2\ beats a minute'

¶En rad av instruktionerna, nedtonad så att flottan och huvudspelaren läses först.¶
ƒ rad(text2•'')•Fras Fras(
		text2
		0.3m
		färg: Färg(64% 4 265°)
	)

¶Instruktionerna, staplade mot vänsterkanten istället för centrerade, så att ögat kan löpa rakt nedåt.¶
visning: Grupp(
		Stack('<' 0.16m)
		[
			Fras(ikon(utvald) 0.9m färg: Färg(56% 65 25°))
			Fras(status() 0.38m färg: Färg(70% 25 30°))
			rad('höj handen — mer orkester')
			rad('sänk den — bara melodin')
			rad(
				'hand vänster — långsammare · hand höger — snabbare'
			)
			rad('fingrar upp — 1 🎹 · 2 🎻 · 3 🪈 · 4 ⚡ · 5 🎺')
		]
	)

¶Ett skepp som korsar scenen, flygande i ett band långt ovanför instruktionerna så att det aldrig korsar texten. Dess bana bestämmer hur högt det flyger och hur långt in det startar, så de flyger aldrig i formation.¶
ƒ skepp(tecken2•'' bana•# hastighet2•#)•Fras
	Fras(
		tecken2
		0.7m
		plats: Plats(
			(((((resa · hastighet2) + (bana · 47)) % 200) - 100) · 0.045) · 1m
			((bana · 0.65) + 2.2) · 1m
		)
	)

flotta: [
		skepp('🛸' 0 3)
		skepp('🚀' 1 2)
		skepp('🛰' 2 4)
		skepp('🛸' 3 5)
	]

ƒ stjärna(x2•# y2•# storlek2•#)•Fras
	Fras(
		'✦'
		storlek2 · 1m
		plats: Plats(x2 · 1m y2 · 1m)
		färg: Färg(46% 8 275°)
	)

¶Scenen zoomar för att passa allt som finns på den, så allt som rör sig skulle skala om hela bilden vid varje klockslag och få orden att flyta omkring. De fyra hörnstjärnorna ligger längre ut än skeppen någonsin flyger och längre ut än den längsta textraden, så anpassningen får en ram som aldrig ändras och bilden håller sig stilla. Resten är bara himmel.¶
stjärnor: [
		stjärna(-5.6 -2.3 0.18)
		stjärna(5.6 -2.3 0.18)
		stjärna(-5.6 5 0.18)
		stjärna(5.6 5 0.18)
		stjärna(-4.9 2.1 0.22)
		stjärna(-3.9 3.9 0.14)
		stjärna(-2.2 2.5 0.18)
		stjärna(1.1 3.4 0.14)
		stjärna(2.7 4.4 0.22)
		stjärna(4.6 2.7 0.14)
	]

Etapp(
	[:stjärnor :flotta visning sång]
	bakgrund: Färg(7% 6 275°)
	färg: Färg(88% 3 265°)
)
