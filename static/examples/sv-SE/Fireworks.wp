	[
		:avfyrar.översätta(ƒ(p6•Del i2•#) explosion(p6 i2))
		Musik(
			[
				Spår(
					melodi2
					instrument: Instrument.trumpet
					volym: 90%
					loop: ⊥
				)
				Spår(
					bas2
					instrument: Instrument.piano
					tonart: -12semitones
					volym: 50%
					panorering: -0.4
					loop: ⊥
				)
				Spår(
					klocka2
					instrument: Instrument.klocka
					volym: 55%
					loop: ⊥
				)
				Spår(
					fiol2
					instrument: Instrument.fiol
					volym: 45%
					panorering: 0.3
					loop: ⊥
				)
				Spår(
					flöjt2
					instrument: Instrument.flöjt
					volym: 65%
					loop: ⊥
				)
				Spår(
					trummor2
					instrument: Instrument.trummor
					volym: 45%
					loop: ⊥
				)
			]
			tempo: 84beats/min
			skala: Musik.kromatisk
			namn: 'hymn'
		)
	]
	bakgrund: Färg(10% 12 265°)
	färg: Färg(96% 0 0°)
)
