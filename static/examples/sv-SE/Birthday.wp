		{4 6 8}
		ø
		ø
		ø
		{1 3 5}
		ø
		{4 5 7 9}
		{1 3 5}
		ø
		ø
	]

¶Tårtan sväller vid varje taktslag och lugnar sig mellan dem.¶
ƒ tårta() Fras(
		'🎂'
		(4m + ((räkna2 % 2) · 0.4m))
		varaktighet: 0.2s
	)

Etapp(
	[
		Grupp(
			Stack(stoppning: 0.5m)
			[
				tårta()
				Fras('Ja, må han leva' 1.3m)
			]
		)
		Musik(
			[
				Spår(
					melodi2
					instrument: Instrument.flöjt
					takt: 0.5beats
				)
				Spår(
					alt
					instrument: Instrument.fiol
					takt: 0.5beats
					volym: 65%
				)
				Spår(
					ackord
					instrument: Instrument.piano
					takt: 1beats
					volym: 55%
				)
			]
			tempo: 116beats/min
			namn: 'födelsedag'
		)
	]
	bakgrund: Färg(18% 20 330°)
	färg: Färg(96% 0 0°)
)
