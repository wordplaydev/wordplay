¶Tårtan sväller vid varje slag och sjunker tillbaka mellan dem.¶
ƒ tårta() Fras(
		'🎂'
		(4m + ((antal2 % 2) · 0.4m))
		varaktighet: 0.2s
	)

Etapp(
	[
		Grupp(
			Stack(stoppning: 0.5m)
			[
				tårta()
				Fras('Happy Birthday' 1.3m)
			]
		)
		Musik(
			[
				Spår(
					melodi2
					instrument: Instrument.flöjt
					takt: 0.5beats
				)
				Spår(
					alt
					instrument: Instrument.fiol
					takt: 0.5beats
					volym: 65%
				)
				Spår(
					ackord
					instrument: Instrument.piano
					takt: 1beats
					volym: 55%
				)
			]
			tempo: 116beats/min
			namn: 'födelsedag'
		)
	]
	bakgrund: Färg(18% 20 330°)
	färg: Färg(96% 0 0°)
)
