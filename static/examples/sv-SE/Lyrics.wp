			synth1
			bass1
			bass2
			drums1
			drums2
			drums3
			drums4
			drums5
			drums6
			synth2
			bell1
			bell2
			bell3
			bell4
			bell5
			bell6
			bell7
			bell8
			bell9
			bell10
			pad1
			pad2
			pad3
			sax1
			sax2
			sax3
		]
		tempo: 84beats/min
		skala: Musik.kromatisk
		namn: 'krockkudde'
	)

Etapp(
	[
		ord4()
		låt
	]
	ansikte: 'Phudu'
	bakgrund: Färg(0 0 0°)
	färg: Färg(100 0 0°)
)
