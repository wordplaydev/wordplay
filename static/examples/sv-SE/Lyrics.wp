			sax1
			sax2
			sax3
		]
		tempo: 84beats/min
		skala: Musik.kromatisk
		namn: 'krockkudde'
	)

Etapp(
	[
		ord4()
		sång
	]
	ansikte: 'Phudu'
	bakgrund: Färg(0 0 0°)
	färg: Färg(100 0 0°)
)
