¶En båt. Den glider lite längre fram för varje slag och gungar åt andra hållet varje gång, vilket är det som ser ut som rodd. Banan bestämmer hur högt den ligger och hur långt framme den startade, så att de inte rör sig som en enda båt.¶
ƒ båt(bana•# start2•#)•Fras
	Fras(
		'🚣'
		1.5m
		plats: Plats(
			((((åratag + start2) % 16) - 8) · 1.1) · 1m
			((bana · 1.9) - 1.9) · 1m
		)
		rotation: (((åratag + bana) % 2) = 0) ? 9° -9°
		varaktighet: 0.2s
	)

flotta: [båt(0 0) båt(1 6) båt(2 11)]

Etapp(
	[
		:flotta
		Fras(
			'〰〰〰〰〰〰〰〰'
			1m
			plats: Plats(-8m -3.2m)
			färg: Färg(48% 22 240°)
		)
		Fras(
			'Ro, ro, ro din båt'
			0.9m
			plats: Plats(-4.4m 3.4m)
		)
		Musik(
			[
				Spår(
					melodi2
					instrument: Instrument.flöjt
					takt: 0.5beats
				)
				Spår(
					ackord
					instrument: Instrument.piano
					takt: 1beats
					volym: 60%
				)
				Spår(
					åror
					instrument: Instrument.trummor
					takt: 1beats
					volym: 45%
				)
			]
			tempo: 144beats/min
			namn: 'båt'
		)
	]
	bakgrund: Färg(22% 18 230°)
	färg: Färg(96% 0 0°)
)
