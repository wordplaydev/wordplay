		ø
		ø
		ø
		{1 3 5}
		ø
		{4 5 7 9}
		{1 3 5}
		ø
		ø
	]

¶El pastel crece en cada pulso y se asienta entre ellos.¶
ƒ pastel() Frase(
		'🎂'
		(4m + ((conteo2 % 2) · 0.4m))
		duración: 0.2s
	)

Escenario(
	[
		Grupo(
			Pila(relleno: 0.5m)
			[
				pastel()
				Frase('Feliz cumpleaños' 1.3m)
			]
		)
		Música(
			[
				Pista(
					melodía2
					instrumento: Instrumento.flauta
					pulso: 0.5beats
				)
				Pista(
					contralto
					instrumento: Instrumento.violín
					pulso: 0.5beats
					volumen: 65%
				)
				Pista(
					acordes
					instrumento: Instrumento.piano
					pulso: 1beats
					volumen: 55%
				)
			]
			tempo: 116beats/min
			nombre: 'cumpleaños'
		)
	]
	fondo: Color(18% 20 330°)
	color: Color(96% 0 0°)
)
