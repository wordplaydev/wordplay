Escenario(
	[
		:disparando.traducir(ƒ(p6•Parte i2•#) estallido(p6 i2))
		Música(
			[
				Pista(
					melodía2
					instrumento: Instrumento.trompeta
					volumen: 90%
					bucle: ⊥
				)
				Pista(
					bajo2
					instrumento: Instrumento.piano
					clave: -12semitones
					volumen: 50%
					balance: -0.4
					bucle: ⊥
				)
				Pista(
					campana2
					instrumento: Instrumento.campana
					volumen: 55%
					bucle: ⊥
				)
				Pista(
					violín2
					instrumento: Instrumento.violín
					volumen: 45%
					balance: 0.3
					bucle: ⊥
				)
				Pista(
					flauta2
					instrumento: Instrumento.flauta
					volumen: 65%
					bucle: ⊥
				)
				Pista(
					batería
					instrumento: Instrumento.tambores
					volumen: 45%
					bucle: ⊥
				)
			]
