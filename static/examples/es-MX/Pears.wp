M
Peras
=== start/en
¶Esta es una historia corta interactiva. Define varias escenas distintas y pasa de una a otra según diferentes interacciones, como clics, colisiones y otras acciones. Parte de la diversión de vivir la historia es descubrir las interacciones necesarias para avanzar.¶

exposición: [
		Frase(`Mi papá quería irse.` lugar: Lugar(-9m 0m))
	]

conflicto: [
		Frase(
			`"Mamá", ya tenemos que irnos.`
			lugar: Lugar(-8m 7m)
		)
		Frase(`/"Llévate esto a casa."/` lugar: Lugar(1m 4m))
		Frase(
			`"¡Mamá, no queremos nada!"`
			lugar: Lugar(-8m 1m)
		)
		Frase(
			`"¡Llévate esto a casa!"`
			tamaño: 2m
			lugar: Lugar(-6m -4m)
			inmóvil: Secuencia.temblor()
		)
	]

acciónCreciente1: [
		Frase(
			`Mi 炮炮👵🏽 salió al patio trasero`
			lugar: Lugar(-9m 7m)
		)
		Frase(`La seguí, con curiosidad` lugar: Lugar(-6m 4m))
		Frase(
			`👵🏽`
			nombre: 'paupau'
			tamaño: 2m
			materia: Materia()
			lugar: Lugar(6m -6m)
			burbuja: `/"¡沙梨🍐, llévate esto a casa!"/`
		)
		Frase(
			`👧🏻`
			nombre: 'yo'
			tamaño: 1m
			materia: Materia()
			lugar: Ubicación(Lugar(-8m -6m))
		)
	]

acciónCreciente2: [
		Frase(
			`Ella se detuvo junto a un árbol pequeño.`
			lugar: Lugar(-9m 6m)
		)
		Frase(
			`Sobre él colgaban decenas de 沙梨 amarillas y brillantes`
			lugar: Lugar(-9m 1m)
			envolver: 10m
		)
		Frase(
			`"Mamá, no queremos peras."`
			tamaño: .75m
			lugar: Lugar(-4m 0m)
		)
		Frase(
			`/Yo quería una pera./`
			tamaño: 2m
			lugar: Lugar(-8m -3m)
		)
		Frase(
			"🍐"
			tamaño: 2m
			lugar: Lugar(-1m -7m)
			nombre: 'pear'
			seleccionable
		)
	]

¶Definimos los lugares por adelantado para poder hacerlas caer desde el mismo punto.¶
lugares: (6 → []).traducir(
		ƒ() Lugar(Azar(-2m 2m) Azar(-3m -5m))
	)
clímax: [
		Frase(
			`Ella se arrodilló en la tierra.`
			lugar: Lugar(-9m 6m)
		)
		Frase(`Tomó un cuchillo` lugar: Lugar(-9m 4m))
		Frase(`Y con cuidado cortó seis` lugar: Lugar(-9m 2m))
		Frase(
			`Dejándolas caer en su canasta de abajo`
			lugar: Lugar(-9m 0m)
		)
		Frase("🧺" tamaño: 4m lugar: Lugar(-2m -12m))
		Frase(
			"🌳"
			nombre: "tree"
			tamaño: 5m
			lugar: Lugar(-3m -7m)
			seleccionable
		)
		:lugares.traducir(
			ƒ(colocar índice2)
				Frase(
					"🍐"
					nombre: "pear\índice2\"
					lugar: Elección() = 'tree' ? Movimiento(colocar) colocar
				)
		)
		Frase("🔪" lugar: Puntero())
	]

resolución2: [
		Frase(`Me las llevó` lugar: Lugar(-9m 6m))
		Frase(`Se arrodilló frente a mí` lugar: Lugar(-8m 4m))
		Frase(`Y me entregó la canasta` lugar: Lugar(-7m 2m))
		Frase(`/"Llévatelas a casa"/` lugar: Lugar(0m -2m))
	]

créditos: [
		Frase(`por /Amy J. Ko/`)
	]

historia: [
		exposición
		conflicto
		acciónCreciente1
		acciónCreciente2
		clímax
		resolución2
		créditos
	]

¶Llevar la cuenta de los clics y los toques¶
clic: ∆ Botón()
¶Medir cuánto tiempo pasa después de hacer clic en el árbol¶
tiempoDespuésDelCorte: 0ms … Elección() = 'tree' … Tiempo(
			1000ms
		)
¶Detectar cuándo llegamos con Pau Pau¶
enCasaDePauPau: ∆ Colisión('yo')
¶Detectar cuándo se elige la pera¶
eligióLaPera: Elección() = 'pear'
¶Cambiar el segmento según el segmento actual¶
segmento2•#:
	1 …
	segmento2 ???
		1: clic
		2: clic
		3: enCasaDePauPau
		4: eligióLaPera
		5: tiempoDespuésDelCorte > 1500ms
		6: ∆ Botón()
		⊥
		… segmento2 + 1

Escenario(
	historia[segmento2]
	cara: 'Arvo'
	lugar: Lugar(0m 0m -20m)
	marco: Rectángulo(-10m 10m 10m -10m)
)