K
Diseños
=== start
¶Filas, pilas y grupos de frases, cada uno con poses animadas llamativas.¶

latir: Secuencia(
		{
			0%: Pose(escala: .9)
			50%: Pose(escala: 1.1)
			100%: Pose(escala: .9)
		}
	)
reboteZ: Secuencia(
		{
			0%: Pose(desplazamiento: Lugar(z: 0m))
			50%: Pose(desplazamiento: Lugar(z: -2m))
			100%: Pose(desplazamiento: Lugar(z: 0m))
		}
		1s
	)

Grupo(
	Fila()
	[
		Grupo(
			Pila()
			[
				Frase('Gatito')
				Frase('Gato' inmóvil: reboteZ)
				Grupo(
					Fila()
					[Frase('Perro') Frase('Canino')]
					inmóvil: latir
				)
				Frase('Felino')
			]
		)
		Grupo(
			Pila()
			[
				Frase('Hola')
				Frase('Hola')
			]
			inmóvil: Secuencia.girar(2s "straight")
		)
	]
)