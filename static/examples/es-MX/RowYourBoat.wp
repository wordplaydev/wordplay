¶Un bote. Se desliza un poco más en cada tiempo y se balancea hacia el otro lado cada vez, lo cual se ve como si estuviera remando; el carril define qué tan alto se ubica y qué tan adelante comenzó, para que no se muevan todos igual.¶
ƒ bote(carril•# comenzar•#)•Frase
	Frase(
		'🚣'
		1.5m
		lugar: Lugar(
			((((remada + comenzar) % 16) - 8) · 1.1) · 1m
			((carril · 1.9) - 1.9) · 1m
		)
		rotación: (((remada + carril) % 2) = 0) ? 9° -9°
		duración: 0.2s
	)

flota: [bote(0 0) bote(1 6) bote(2 11)]

Escenario(
	[
		:flota
		Frase(
			'〰〰〰〰〰〰〰〰'
			1m
			lugar: Lugar(-8m -3.2m)
			color: Color(48% 22 240°)
		)
		Frase(
			'Rema, rema, rema tu bote'
			0.9m
			lugar: Lugar(-4.4m 3.4m)
		)
		Música(
			[
				Pista(
					melodía2
					instrumento: Instrumento.flauta
					pulso: 0.5beats
				)
				Pista(
					acordes
					instrumento: Instrumento.piano
					pulso: 1beats
					volumen: 60%
				)
				Pista(
					remos
					instrumento: Instrumento.tambores
					pulso: 1beats
					volumen: 45%
				)
			]
			tempo: 144beats/min
			nombre: 'bote'
		)
	]
	fondo: Color(22% 18 230°)
	color: Color(96% 0 0°)
)
