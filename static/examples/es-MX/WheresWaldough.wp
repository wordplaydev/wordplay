🔁
¿Dónde está Waldough?
=== start/en
¶Encuentra a Waldough escondido entre la multitud: busca al hombre de la camisa naranja y haz clic en él para ganar.¶

nombre2: Elección()
atrapado: ⊥ … ∆ (nombre2) … (nombre2 = 'ResetButton') ? ⊥ ((nombre2 = 'Waldough') | atrapado)
puntos2: 0 … ∆ (nombre2) … (nombre2 = 'Waldough') ? 1 + puntos2 puntos2

ƒ punto2() Lugar(
		((0.1 × Azar(-9m 9m)) + Azar(-2m 1m))
		((0.1 × Azar(-9m 9m)) + Azar(-2m 1m))
	)
ƒ nuevosPuntos() [
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
		punto2()
	]
puntos3: nuevosPuntos() … ∆ (nombre2) … (nombre2 = 'ResetButton') ? nuevosPuntos(
			) puntos3


Escenario(
	[
		Frase(
			"🔁"
			seleccionable
			lugar: Lugar(4m -0.5m)
			inmóvil: atrapado ? Pose(rotación: 180°) Pose()
			duración: 0.5s
			nombre: 'ResetButton'
		)
		Frase(
			'Busca la camisa naranja'
			0.2m
			lugar: Lugar(-6.2m 0.75m)
			fuente: 'Carter One'
		)
		Frase(
			'hombre (llamado Waldough) y'
			0.2m
			lugar: Lugar(-6.4m 0.25m)
			fuente: 'Carter One'
		)
		Frase(
			'haz clic en él para ganar.🧍🏻'
			0.2m
			lugar: Lugar(-6.0m -0.25m)
			fuente: 'Carter One'
		)
		Frase(
			'Puntos: ' + puntos2 → ''
			0.5m
			lugar: Lugar(-5.9m -1m)
		)

		Frase("🏀" lugar: puntos3[1])
		Frase("🦧" lugar: puntos3[2])
		Frase("🍊" lugar: puntos3[3])
		Frase("👻" lugar: puntos3[4])
		Frase("🤖" lugar: puntos3[5])
		Frase("👽" lugar: puntos3[6])
		Frase("🐀" lugar: puntos3[7])
		Frase("🦣" lugar: puntos3[8])
		Frase("🐸" lugar: puntos3[9])
		Frase("🍎" lugar: puntos3[10])
		Frase("💧" lugar: puntos3[11])
		Frase("🍔" lugar: puntos3[12])
		Frase("❤" lugar: puntos3[13])
		Frase("🍥" lugar: puntos3[14])
		Frase(
			"🧍🏻"
			seleccionable: ~atrapado
			lugar: puntos3[15]
			inmóvil: atrapado ? Pose(rotación: 180°) Pose()
			duración: 0s
			nombre: 'Waldough'
		)
		Frase("🔥" lugar: puntos3[16])
		Frase("🎂" lugar: puntos3[17])
		Frase("🐕" lugar: puntos3[18])
		Frase("🦈" lugar: puntos3[19])
		Figura(Rectángulo(-3.5m -3m 3.5m -3.5m))
		Figura(Rectángulo(-3.5m 3.5m 3.5m 3m))
		Figura(Rectángulo(-3.5m 3.5m -3m -3.5m))
		Figura(Rectángulo(3m 3.5m 3.5m -3.5m))
	]
	lugar: Lugar(0m 0m -5m)
)