T
Poema
=== start
¶Un poema cuyos versos llegan flotando, cada uno con su propia entrada.¶

•línea(texto2•"" pose•Pose|Secuencia atrás: Color(
			100
			100
			100°
		) frente: Color(0 0 0°))

¶Una lista de versos del poema, cada uno con una pose.¶
poema: [
		línea(
			'El archivo de la computadora'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'del cual'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea('no tengo ningún recuerdo' Pose(rotación: 10°))
		línea(
			'le hago clic para abrirlo'
			Secuencia(
				{
					0%: Pose(escala: 1)
					50%: Pose(escala: 0.7)
					100%: Pose(escala: 1)
				}
				0.25s
			)
		)
		línea(
			'mira'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'me desplazo más abajo'
			Pose(opacidad: 0% desplazamiento: Lugar(y: 5m))
		)
		línea(
			'la pantalla'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'sigue iluminada y vacía'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
			Color(0 0 0°)
			Color(100 100 0°)
		)
		línea(
			'así me encuentro de nuevo conmigo'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'con esperanza e inútil'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'un misterio'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'justo como debí haber hecho'
			Pose(opacidad: 0% desplazamiento: Lugar(y: -5m))
		)
		línea(
			'el 19 de agosto de 2010, a las 11:08 a. m.'
			Pose()
		)
	]

número2: 1 … ∆ Botón() | ∆ Tecla() …
		(número2 = (poema.longitud() + 1)) ? 1 número2 + 1
línea2: poema[número2]

número2 ≤ poema.longitud() ?
	Escenario(
		[
			Frase(
				línea2.texto2
				entrando: línea2.pose
				duración: 1s
				nombre: número2 → ""
				estilo: 'cautious'
			)
		]
		fondo: línea2.atrás
		inmóvil: Pose(color: línea2.frente)
	)
	Escenario(
		[
			Grupo(
				Pila()
				[
					Frase('CONSEJO PARA MÍ MISMA')
					Frase('Jane Hirshfield')
				]
				entrando: Pose(escala: 0.75)
			)
		]
		fondo: Color(0% 0 0°)
		color: Color(100% 100 0°)
	)