↑
Laberinto
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en

•laberinto() (
	cuadrícula•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ celda2(fila2•# columna•#) (
			celdas: cuadrícula[fila2]
			celdas•[] ? celdas[columna] ø
		)

	ƒ permitido(fila3•# columna2•#) celda2(fila3 columna2)•''
)

laberinto2: laberinto()

•estado(fila4•# columna3•# pasos•#)
(
	ƒ abajo2() estado(fila4 + 1 columna3 pasos + 1)
	ƒ arriba() estado(fila4 - 1 columna3 pasos + 1)
	ƒ izquierda2() estado(fila4 columna3 - 1 pasos + 1)
	ƒ derecha2() estado(fila4 columna3 + 1 pasos + 1)
)

ƒ permitido2(state•estado fila5•# col•#) laberinto2.permitido(
		state.fila4 + fila5
		state.columna3 + col
	)

dirección2: Elección()
state2•estado: estado(1 1 0) … ∆ dirección2 …
		((dirección2 = "left") & permitido2(state2 0 -1)) ? state2.izquierda2(
			)
			((dirección2 = "right") & permitido2(state2 0 1)) ? state2.derecha2(
				)
				((dirección2 = "up") & permitido2(state2 -1 0)) ? state2.arriba(
					)
					((dirección2 = "down") & permitido2(state2 1 0)) ? state2.abajo2(
						)
						state2

actual: (
		celda3: laberinto2.celda2(state2.fila4 state2.columna3)
		celda3 ?? ' ')
arriba2: laberinto2.celda2(
		state2.fila4 - 1
		state2.columna3
	)•''
abajo3: laberinto2.celda2(state2.fila4 + 1 state2.columna3)•''
izquierda3: laberinto2.celda2(
		state2.fila4
		state2.columna3 - 1
	)•''
derecha3: laberinto2.celda2(
		state2.fila4
		state2.columna3 + 1
	)•''
ganó: actual = '🤩'

Escenario(
	[
		Grupo(
			Cuadrícula(3 3 0.25m)
			[
				ø
				Frase(
					'↑'
					nombre: 'up'
					seleccionable: arriba2
					inmóvil: Pose(opacidad: arriba2 ? 1 0.2)
				)
				ø
				Frase(
					'←'
					nombre: 'left'
					seleccionable: izquierda3
					inmóvil: Pose(opacidad: izquierda3 ? 1 0.2)
				)
				Frase(
					actual
					inmóvil: ganó ?
						Secuencia.girar(
							duración: 1s
							estilo: 'straight'
						)
						Pose()
				)
				Frase(
					'→'
					nombre: 'right'
					seleccionable: derecha3
					inmóvil: Pose(opacidad: derecha3 ? 1 0.2)
				)
				ø
				Frase(
					'↓'
					nombre: 'down'
					seleccionable: abajo3
					inmóvil: Pose(opacidad: abajo3 ? 1 0.2)
				)
				ø
			]
		)
	]
	lugar: Lugar(0m 0m -3m)
	cara: 'Noto Emoji'
	fondo: Color(0 0 0°)
	inmóvil: Pose(Color(100 100 0°))
)