↑
Laberinto
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•laberinto() (
	cuadrícula•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ celda2(fila2•# columna•#) (
			celdas: cuadrícula[fila2]
			celdas•[] ? celdas[columna] ø
		)

	ƒ permitido(fila3•# columna2•#) celda2(fila3 columna2)•''
)

laberinto2: laberinto()

•estado(fila4•# columna3•# pasos•#)
(
	ƒ abajo2() estado(fila4 + 1 columna3 pasos + 1)
	ƒ arriba() estado(fila4 - 1 columna3 pasos + 1)
	ƒ izquierda2() estado(fila4 columna3 - 1 pasos + 1)
	ƒ derecha2() estado(fila4 columna3 + 1 pasos + 1)
)

ƒ permitido2(estado2•estado fila5•# columna4•#) laberinto2.permitido(
		estado2.fila4 + fila5
		estado2.columna3 + columna4
	)

dirección2: Elección()
estado3•estado: estado(1 1 0) … ∆ dirección2 …
		((dirección2 = "left") & permitido2(estado3 0 -1)) ? estado3.izquierda2(
			)
			((dirección2 = "right") & permitido2(estado3 0 1)) ? estado3.derecha2(
				)
				((dirección2 = "up") & permitido2(estado3 -1 0)) ? estado3.arriba(
					)
					((dirección2 = "down") & permitido2(estado3 1 0)) ? estado3.abajo2(
						)
						estado3

actual: (
		celda3: laberinto2.celda2(
				estado3.fila4
				estado3.columna3
			)
		celda3 ?? ' ')
arriba2: laberinto2.celda2(
		estado3.fila4 - 1
		estado3.columna3
	)•''
abajo3: laberinto2.celda2(
		estado3.fila4 + 1
		estado3.columna3
	)•''
izquierda3: laberinto2.celda2(
		estado3.fila4
		estado3.columna3 - 1
	)•''
derecha3: laberinto2.celda2(
		estado3.fila4
		estado3.columna3 + 1
	)•''
ganaste: actual = '🤩'

Escenario(
	[
		Grupo(
			Cuadrícula(3 3 0.25m)
			[
				ø
				Frase(
					'↑'
					nombre: 'up'
					seleccionable: arriba2
					inmóvil: Pose(opacidad: arriba2 ? 1 0.2)
				)
				ø
				Frase(
					'←'
					nombre: 'left'
					seleccionable: izquierda3
					inmóvil: Pose(opacidad: izquierda3 ? 1 0.2)
				)
				Frase(
					actual
					inmóvil: ganaste ?
						Secuencia.girar(
							duración: 1s
							estilo: 'straight'
						)
						Pose()
				)
				Frase(
					'→'
					nombre: 'right'
					seleccionable: derecha3
					inmóvil: Pose(opacidad: derecha3 ? 1 0.2)
				)
				ø
				Frase(
					'↓'
					nombre: 'down'
					seleccionable: abajo3
					inmóvil: Pose(opacidad: abajo3 ? 1 0.2)
				)
				ø
			]
		)
	]
	lugar: Lugar(0m 0m -3m)
	cara: 'Noto Emoji'
	fondo: Color(0 0 0°)
	inmóvil: Pose(Color(100 100 0°))
)