⚽
كومة الحروف
=== start
¶حرف U ضخم بخط مزخرف يمثل الدلو. خمسة حروف كبيرة تتساقط داخله، ثم تنهمر قلوب وكرات قدم وتستقر في تجاويفها وعُقَدها. كل شيء يصطدم بحسب شكل حدوده الخارجية، لا بحسب المستطيل المحيط به، وهذا ما يجعل حرف U قادرًا على استيعاب أي شيء، وما يجعل الكرة تستقر داخل تجويف الحرف بدل أن تطفو فوقه، وما يجعل القلب يُدخِل طرفه بين حرفين.¶

¶الدلو هو حرف مثل بقية الحروف، بخط مزخرف بحيث تنتهي أذرعه بحواف مسطحة. يحتاج إلى حركة ليصبح صلبًا، ويحتاج إلى كتلة كبيرة بحيث لا يستطيع أي شيء يسقط فيه أن يحرّكه. يقف على الأرض بين جدارين يلامسان جانبيه بالضبط: قاعدته مستديرة، فلولا الجدارين لمال واهتز مع ازدياد الكومة.¶
كوب: عبارة(
		'U'
		22m
		شكل: "Merriweather"
		اسم: 'كوب'
		مكان: الحركة(مكان(-8.1m -11m))
		لون: Color(85% 10 250°)
		مادة: مادة(الكتلة: 5000kg الاحتكاك: 0.9 مخطط: ⊤)
	)

¶خط عرض ثقيل، لأن الحرف السميك له تجويف واسع بما يكفي لالتقاط كرة. اختيرت الحروف بسبب تجاويفها وعُقَدها.¶
واجهة: 'Titan One'
حروف: ['a' 'b' 'c' 'd' 'e']

¶تتساقط الحروف أولًا، من المكان نفسه لكن بارتفاعات متفاوتة، بحيث يستقر كل حرف فوق الآخر وتتكوّن الكومة تدريجيًا نحو الأعلى.

لا يصبح الحرف صلبًا إلا لأن موضعه حركة وله مادة — فالمُخرَج الذي يضعه برنامج هو شبح يمرّ عبره كل شيء. كتلتها هي ما يمنع الكرات من دفع الكومة وتفريقها، وطلب حدود خارجية من المادة هو ما يجعلها تصطدم بحسب أشكال حروفها.¶
كومة2: حروف.ترجم(
		ƒ(حرف•'' فهرس2•#)
			عبارة(
				حرف
				3m
				واجهة
				اسم: "letter\فهرس2\"
				مكان: الحركة(
					مكان(((فهرس2 × 0.5m) - 2m) ((فهرس2 × 5m) + 8m))
				)
				لون: Color(75% 80 (فهرس2 × 62°))
				مادة: مادة(الكتلة: 60kg الاحتكاك: 0.9 مخطط: ⊤)
			)
	)

¶تسقط القلوب بعد ذلك. يمكن للرمز التعبيري أيضًا أن يطلب حدوده الخارجية، فيصطدم كل قلب بحسب شكله: يَنزلِق طرفه إلى الفجوات التي كان صندوق سيجلس فوقها.¶
قلوب: ['🧡' '💛' '💚' '💙' '💜' '🩷'].ترجم(
		ƒ(قلب•'' فهرس3•#)
			عبارة(
				قلب
				2m
				اسم: "heart\فهرس3\"
				مكان: الحركة(
					مكان(
						((فهرس3 × 0.6m) - 2.2m)
						((فهرس3 × 1.5m) + 34m)
					)
				)
				مادة: مادة(الكتلة: 20kg الاحتكاك: 0.8 مخطط: ⊤)
			)
	)

¶تبدأ الكرات من أعلى كل شيء، فتصل بعد أن تكون الكومة قد استقرت. هي لا تطلب حدودًا خارجية: مستطيلها المستدير بالكامل هو ما يجعلها تتدحرج.¶
كرات: 18 → [].ترجم(
		ƒ(رقم4)
			عبارة(
				"⚽"
				1.1m
				اسم: "ball\رقم4\"
				مكان: الحركة(
					مكان(عشوائي(-2m 2m) ((رقم4 × 1.8m) + 44m))
					سرعة(عشوائي(-1m/s 1m/s) 0m/s)
				)
				مادة: مادة(
					الارتداد: 0.3
					الاحتكاك: 0.4
					الاستدارة: 0.5
				)
			)
	)

مسرح(
	[
		¶أرض، وجداران مقابل جانبي الدلو.¶
		شكل(مستطيل(-10m -11m 10m -12m))
		شكل(مستطيل(-8.8m 12m -7.8m -11m))
		شكل(مستطيل(7.8m 12m 8.8m -11m))
		كوب
		:كومة2
		:قلوب
		:كرات
	]
	جاذبية: 9.8m/s^2
	مكان: مكان(0m -1m -17m)
	خلفية: Color(25% 20 250°)
)
