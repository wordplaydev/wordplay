¶قارب. يتقدّم قليلاً مع كل نبضة ويتمايل بالاتجاه المعاكس في كل مرة، وهذا ما يبدو وكأنه تجديف؛ المسار يحدّد مدى ارتفاعه ومدى تقدّمه في البداية، لذلك لا تتحرك القوارب معاً كوحدة واحدة.¶
ƒ القارب(مسار2•# بداية2•#)•عبارة
	عبارة(
		'🚣'
		1.5m
		مكان: مكان(
			((((ضربةالمجداف + بداية2) % 16) - 8) · 1.1) · 1m
			((مسار2 · 1.9) - 1.9) · 1m
		)
		دوران: (((ضربةالمجداف + مسار2) % 2) = 0) ? 9° -9°
		مدة: 0.2s
	)

أسطول: [القارب(0 0) القارب(1 6) القارب(2 11)]

مسرح(
	[
		:أسطول
		عبارة(
			'〰〰〰〰〰〰〰〰'
			1m
			مكان: مكان(-8m -3.2m)
			لون: Color(48% 22 240°)
		)
		عبارة(
			'جدّف، جدّف، جدّف قاربك'
			0.9m
			مكان: مكان(-4.4m 3.4m)
		)
		موسيقى(
			[
				مسار(لحن2 آلة: آلة.ناي نبضة: 0.5beats)
				مسار(
					وتريات
					آلة: آلة.بيانو
					نبضة: 1beats
					مستوىالصوت: 60%
				)
				مسار(
					المجاديف
					آلة: آلة.طبول
					نبضة: 1beats
					مستوىالصوت: 45%
				)
			]
			إيقاع: 144beats/min
			اسم: 'القارب'
		)
	]
	background: Color(22% 18 230°)
	color: Color(96% 0 0°)
)
