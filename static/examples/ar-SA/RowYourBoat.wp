¶قارب. ينزلق إلى الأمام قليلًا مع كل نبضة ويتأرجح في الاتجاه المعاكس في كل مرة، وهذا ما يبدو كأنه تجديف؛ والمسار يحدد ارتفاعه ومقدار تقدمه عند البداية، فلا تتحرك القوارب كلها معًا.¶
ƒ القارب(مسار2•# بداية2•#)•عبارة
	عبارة(
		'🚣'
		1.5m
		مكان: مكان(
			((((ضربةالمجداف + بداية2) % 16) - 8) · 1.1) · 1m
			((مسار2 · 1.9) - 1.9) · 1m
		)
		دوران: (((ضربةالمجداف + مسار2) % 2) = 0) ? 9° -9°
		مدة: 0.2s
	)

أسطول: [القارب(0 0) القارب(1 6) القارب(2 11)]

مسرح(
	[
		:أسطول
		عبارة(
			'〰〰〰〰〰〰〰〰'
			1m
			مكان: مكان(-8m -3.2m)
			لون: Color(48% 22 240°)
		)
		عبارة(
			'جدّف، جدّف، جدّف بقاربك'
			0.9m
			مكان: مكان(-4.4m 3.4m)
		)
		موسيقى(
			[
				مسار(اللحن آلة: آلة.ناي نبضة: 0.5beats)
				مسار(
					الأوتار
					آلة: آلة.بيانو
					نبضة: 1beats
					مستوىالصوت: 60%
				)
				مسار(
					المجاديف
					آلة: آلة.طبول
					نبضة: 1beats
					مستوىالصوت: 45%
				)
			]
			إيقاع: 144beats/min
			اسم: 'القارب'
		)
	]
	خلفية: Color(22% 18 230°)
	لون: Color(96% 0 0°)
)
