🖐
يد
===
¶ارفع أصابعك أمام الكاميرا، وستجد يد إيموجي تعدّ معك.¶
يد2: يد()

مسرح(
	[
		عبارة(
			(يد2.أصابع = 0 ? '✊'
					يد2.أصابع = 1 ? '☝'
						يد2.أصابع = 2 ? '✌'
							يد2.أصابع = 3 ? '🤟'
								يد2.أصابع = 4 ? '🖖'
									'🖐')
			مكان: يد2.مكان
			حجم: 2m
			إزاحة: مكان(-1m)
		)
		مجموعة(
			صف('<')
			[
				عبارة('1⃣' إزاحة: مكان(0m يد2.إبهام ? 1m 0m))
				عبارة('2⃣' إزاحة: مكان(0m يد2.فهرس ? 1m 0m))
				عبارة('3⃣' إزاحة: مكان(0m يد2.وسطى ? 1m 0m))
				عبارة('4⃣' إزاحة: مكان(0m يد2.بنصر ? 1m 0m))
				عبارة('5⃣' إزاحة: مكان(0m يد2.خنصر ? 1m 0m))
			]
			مكان: مكان(-4.5m 5m)
		)
		مجموعة(
			كومة('|')
			[
				عبارة((يد2.كف ? '🤚' '🤛') حجم: 2m)
				عبارة((يد2.مفتوح ? 'مفتوحة' 'مغلقة') حجم: 1.5m)
			]
			مكان: مكان(-2m -8m)
		)
		عبارة(`/أرِ الكاميرا يدك/` مكان: مكان(-6m -10m) حجم: 1m)
	]
	مكان: مكان(0m 0m -20m)
)