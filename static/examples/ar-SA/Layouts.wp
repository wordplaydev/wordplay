K
التخطيطات
=== start
¶صفوف وأكوام ومجموعات من العبارات، وكل منها يتخذ وضعيات متحركة لافتة.¶

نبض: تسلسل(
		{
			0%: Pose(مقياس: .9)
			50%: Pose(مقياس: 1.1)
			100%: Pose(مقياس: .9)
		}
	)
ارتداد2: تسلسل(
		{
			0%: Pose(إزاحة: مكان(z: 0m))
			50%: Pose(إزاحة: مكان(z: -2m))
			100%: Pose(إزاحة: مكان(z: 0m))
		}
		1s
	)

مجموعة(
	صف()
	[
		مجموعة(
			كومة()
			[
				عبارة('قطة صغيرة')
				عبارة('قطة' سكون: ارتداد2)
				مجموعة(صف() [عبارة('كلب') عبارة('كلبي')] سكون: نبض)
				عبارة('قطّي')
			]
		)
		مجموعة(
			كومة()
			[
				عبارة('مرحباً')
				عبارة('أهلاً')
			]
			سكون: تسلسل.spin(2s "straight")
		)
	]
)