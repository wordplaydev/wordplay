K
التخطيطات
=== start
¶صفوف وأكوام ومجموعات من العبارات، كل واحدة منها تأخذ وضعية متحركة.¶
نبض: تسلسل(
		{
			0%: Pose(scale: .9)
			50%: Pose(scale: 1.1)
			100%: Pose(scale: .9)
		}
	)
ارتدادثلاثيالأبعاد: تسلسل(
		{
			0%: Pose(offset: مكان(z: 0m))
			50%: Pose(offset: مكان(z: -2m))
			100%: Pose(offset: مكان(z: 0m))
		}
		1s
	)

مجموعة(
	صف()
	[
		مجموعة(
			كومة()
			[
				عبارة('قطة صغيرة')
				عبارة('قطة' resting: ارتدادثلاثيالأبعاد)
				مجموعة(
					صف()
					[عبارة('كلب') عبارة('كلبي')]
					resting: نبض
				)
				عبارة('قططي')
			]
		)
		مجموعة(
			كومة()
			[
				عبارة('مرحبًا')
				عبارة('أهلًا')
			]
			resting: تسلسل.spin(2s "straight")
		)
	]
)