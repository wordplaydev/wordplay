K
التخطيطات
=== start
¶صفوف وأكوام ومجموعات من العبارات، كل واحدة منها تأخذ وضعية متحركة.¶

نبض: تسلسل(
		{
			0%: Pose(مقياس: .9)
			50%: Pose(مقياس: 1.1)
			100%: Pose(مقياس: .9)
		}
	)
ارتدادثلاثيالأبعاد: تسلسل(
		{
			0%: Pose(إزاحة: مكان(z: 0m))
			50%: Pose(إزاحة: مكان(z: -2m))
			100%: Pose(إزاحة: مكان(z: 0m))
		}
		1s
	)

مجموعة(
	صف()
	[
		مجموعة(
			كومة()
			[
				عبارة('قطة صغيرة')
				عبارة('قطة' سكون: ارتدادثلاثيالأبعاد)
				مجموعة(
					صف()
					[عبارة('كلب') عبارة('كلبي')]
					سكون: نبض
				)
				عبارة('قططي')
			]
		)
		مجموعة(
			كومة()
			[
				عبارة('مرحبًا')
				عبارة('أهلًا')
			]
			سكون: تسلسل.spin(2s "straight")
		)
	]
)