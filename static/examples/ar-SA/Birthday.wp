¶تنتفخ الكعكة عند كل نبضة وتهدأ بين النبضات.¶
ƒ الكعكة() عبارة('🎂' (4m + ((العدّ % 2) · 0.4m)) مدة: 0.2s)

مسرح(
	[
		مجموعة(
			كومة(الحشو: 0.5m)
			[
				الكعكة()
				عبارة('عيد ميلاد سعيد' 1.3m)
			]
		)
		موسيقى(
			[
				مسار(اللحن آلة: آلة.ناي نبضة: 0.5beats)
				مسار(
					الألتو
					آلة: آلة.كمان
					نبضة: 0.5beats
					مستوىالصوت: 65%
				)
				مسار(
					الأوتار
					آلة: آلة.بيانو
					نبضة: 1beats
					مستوىالصوت: 55%
				)
			]
			إيقاع: 116beats/min
			اسم: 'عيد ميلاد'
		)
	]
	خلفية: Color(18% 20 330°)
	لون: Color(96% 0 0°)
)
