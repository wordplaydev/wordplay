¶تنتفخ الكعكة مع كل نبضة وتهدأ بينها.¶
ƒ كعكة() عبارة('🎂' (4m + ((عدّ % 2) · 0.4m)) مدة: 0.2s)

مسرح(
	[
		مجموعة(
			كومة(الحشو: 0.5m)
			[
				كعكة()
				عبارة('عيد ميلاد سعيد' 1.3m)
			]
		)
		موسيقى(
			[
				مسار(لحن2 آلة: آلة.ناي نبضة: 0.5beats)
				مسار(
					صوتمنخفض
					آلة: آلة.كمان
					نبضة: 0.5beats
					مستوىالصوت: 65%
				)
				مسار(
					وتريات
					آلة: آلة.بيانو
					نبضة: 1beats
					مستوىالصوت: 55%
				)
			]
			إيقاع: 116beats/min
			اسم: 'عيد ميلاد'
		)
	]
	background: Color(18% 20 330°)
	color: Color(96% 0 0°)
)
