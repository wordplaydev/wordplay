Y
مغامرة
=== start/en
¶مغامرة نصية في خمس عشرة غرفة: تستيقظ مقيدًا في غرفة مظلمة وباردة، وعليك أن تجد طريقة واحدة من أربع طرق تنتهي بها هذه الليلة. تؤدي الغرف كل واحدة إلى الأخرى، فالمنعطف الخاطئ يعيدك إلى حلقة بدل أن يوصلك إلى طريق مسدود، وما تحمله معك هو ما يقرر أي الممرات مفتوحة أمامك.¶

¶طريقة للخروج من غرفة: اسم الخيار، ومعرّف الغرفة التي يؤدي إليها، وإذا كان الباب مقفلًا، ما الذي يجب أن تحمله لتستخدمه. الحيلة كلها في تسمية الوجهة بدلًا من الاحتفاظ بها. يجب أن يكون الرابط موجودًا قبل أن يستطيع أي شيء الإشارة إليه، فالقصة المبنية من روابط لا يمكنها إلا أن تشير إلى الخلف، ولا يمكنها أبدًا أن تعود من جديد. أما معرّف النص فليس له مثل هذه القاعدة، فيمكن لغرفتين أن تسمي كل واحدة الأخرى، ويمكن أن تحتوي الخريطة على حلقات.¶
•باب(وسم•'' غرفة•'' يحتاج•'': '')

¶غرفة. معظم الغرف تحتاج فقط إلى الأجزاء الثلاثة الأولى: معرّف، وما تجده فيها، وأبوابها. الأجزاء الثلاثة الأخيرة مخصصة للغرف المميزة — واحدة تعطيك شيئًا، وأربع تنهي القصة.¶
•غرفة2(معرّف2•'' وصف2•'' أبواب•[باب]: [] خذ•'': '' نهاية2•'': '' فاز•?: ⊥)

¶أين أنت وماذا تحمل. هذا هو جوهر القصة فعليًا: معرّف غرفة واحدة وكومة صغيرة من الأشياء.¶
•رحلة(غرفة3•'' حقيبة•[''])

¶كل غرفة في قائمة واحدة. الأولى فقط هي المهمة من ناحية الترتيب: فهي حيث تبدأ القصة، وحيث ترجعك كل نهاية إليها.¶
غرف•[غرفة2]: [
		غرفة2(
			'زنزانة'
			'تستيقظ في غرفة مظلمة وباردة تفوح منها رائحة العفن. معصماك مقيدان خلف ظهرك، ومن ربط العقدة لم يكن مستعجلًا في ذلك.'
			[
				باب('استدر على جانبك' 'الأرض')
				باب('استلقِ ساكنًا واستمع' 'استمع')
			]
		)
		غرفة2(
			'استمع'
			'يصلك صوتان من خلال ألواح الأرضية. إنهما يتجادلان حول من ترك البوابة مفتوحة، ولا يبدو أن أيًا منهما قلق بشأنك.'
			[باب('استدر على جانبك' 'الأرض')]
		)
		غرفة2(
			'الأرض'
			'من جانبك تستطيع أن ترى تحت السرير: سكين على الحجارة المفروشة، صدئة على طول ظهرها، قريبة بما يكفي لتصل إليها إن كنت مستعدًا لوضع وجهك على الأرض.'
			[
				باب('خذها وحرر نفسك بها' 'القبو')
				باب('ابقَ ساكنًا واستمع مرة أخرى' 'استمع')
			]
		)
		غرفة2(
			'القبو'
			'القبو، وأنت واقف: السرير، وكومة من الحبل المقطوع، ودرج يتسلق أحد الجدران، وممر منخفض يمتد من الجدار الآخر.'
			[
				باب('اصعد الدرج' 'الدرج')
				باب('اسلك الممر المنخفض' 'الممر')
			]
			خذ: 'سكين'
		)
		غرفة2(
			'الدرج'
			'درجات تآكلت من المنتصف. في منتصف الطريق توجد مِنَصّة معلَّق عليها فانوس على خُطّاف، وفوق المِنَصّة يستمر الدرج في الصعود.'
			[
				باب('خذ الفانوس' 'فانوس')
				باب('واصل الصعود' 'باب')
				باب('عُد إلى الأسفل' 'القبو')
			]
		)
		غرفة2(
			'فانوس'
			'يشتعل الفتيل في المحاولة الثانية، ويتضح أن المِنَصّة أصغر بكثير مما جعلها الظلام تبدو عليه.'
			[
				باب('واصل الصعود' 'باب')
				باب('عُد إلى الأسفل' 'القبو')
			]
			خذ: 'فانوس'
		)
		غرفة2(
			'باب'
			'في أعلى الدرج، باب ثقيل مُقفَل بمزلاج من الجهة الأخرى. المزلاج قديم، والفجوة بجانبه واسعة بما يكفي لإدخال نصل.'
			[
				باب('حاول فتح المزلاج بالسكين' 'قاعة')
				باب('عُد إلى الأسفل' 'الدرج')
			]
		)
		غرفة2(
			'قاعة'
			'قاعة فيها موقد بارد وكرسيّان مدفوعان بعيدًا عنه، وكأن الجدال انتهى على عجل. في الطرف البعيد بوابة، وتحتها ضوء رمادي.'
			[
				باب('اعبر نحو البوابة' 'بوابة')
				باب('انزل الدرج مرة أخرى' 'الدرج')
			]
		)
		غرفة2(
			'بوابة'
			'البوابة مقيّدة بسلسلة، والسلسلة تمرّ عبر قفل بحجم قبضة يدك. خلفها يهبط الطريق نحو الوادي.'
			[
				باب(
					'أدر المفتاح في القفل'
					'سفح التل'
					يحتاج: 'مفتاح'
				)
				باب('تسلّق السلسلة بدلًا من ذلك' 'تسلّق')
				باب('عُد إلى القاعة' 'قاعة')
			]
		)
		غرفة2(
			'الممر'
			'المَمَرّ منخفض لدرجة أنك تسير على يد واحدة، وتفوح منه رائحة النهر. بعد بضع خطوات، يتوقف الظلام عن كونه ظلًّا ويصبح جدارًا.'
			[
				باب('تحسّس طريقك للأمام' 'أعمى')
				باب('احمل الضوء معك' 'سرداب' يحتاج: 'فانوس')
				باب('عُد من حيث أتيت' 'القبو')
			]
		)
		غرفة2(
			'سرداب'
			'يجد الفانوس غرفة منخفضة مليئة بصناديق حجرية، وعلى خطّاف بجانب آخر صندوق، مفتاح صدئ لا تزال قطعة قماش معقودة فيه.'
			[
				باب('تابع نحو الماء' 'النهر')
				باب('ارجع في الممر' 'الممر')
			]
			خذ: 'مفتاح'
		)
		غرفة2(
			'أعمى'
			'تتابع مع يد ممدودة أمامك. لا تجد اليد شيئًا، وبعد لحظة لا تجد قدماك شيئًا أيضًا. الظلام يحتفظ بما يُعطى له.'
			نهاية2: 'الظلام يحتفظ بك.'
		)
		غرفة2(
			'تسلّق'
			'تكون قد قطعت معظم الطريق إلى الأعلى قبل أن تتذكر السلسلة كم هي قديمة. يجدونك عند أسفل البوابة عند الفجر، وهذه المرة يحضرون حبلًا يكفي لشخصين.'
			نهاية2: 'أُمسك بك عند البوابة.'
		)
		غرفة2(
			'النهر'
			'ينتهي الممر عند شبكة حديدية فوق ماء جارٍ. القضبان قديمة والسكين صبورة. تخرج مع النهر، ويصبح المنزل بعيدًا خلفك قبل أن تصبح السماء رمادية حتى.'
			نهاية2: 'خرجت مع النهر.'
			فاز: ⊤
		)
		غرفة2(
			'سفح التل'
			'يدور المفتاح، وتنسكب السلسلة في العشب، وتتأرجح البوابة دون أي صوت يسمعه أحد. الوادي رمادي بلون الصباح، والطريق لك وحدك.'
			نهاية2: 'خرجت عبر البوابة.'
			فاز: ⊤
		)
	]

¶الغرفة التي تحمل هذا المعرّف. تعطي find() القيمة ø عندما لا يوجد تطابق، ومعرّف لا يسمّي أي غرفة يُعدّ فجوة في الخريطة وليس منعطفًا في القصة، لذا فإن الغرفة الأولى تحل محله.¶
ƒ اذهب(أراد•'')•غرفة2 غرف.find(
		ƒ(غرفة4•غرفة2) غرفة4.معرّف2 = أراد
	) ?? غرف[1]

¶الأبواب التي يمكنك أن تسلكها فعلًا من هنا. الباب المقفل الذي لا تملك له شيئًا لا يُعرض عليك ببساطة، لذا يبدو جدارًا حتى يصبح الشيء الذي يفتحه بين يديك.¶
ƒ طرق(هنا•غرفة2 حقيبة2•[''])•[باب]
	هنا.أبواب.filter(
		ƒ(باب2•باب) (باب2.يحتاج = '') | حقيبة2.يحتوي(
					باب2.يحتاج
				)
	)

¶ادخل إلى غرفة، والتقط ما تحويه. كانت add() ستمنحك بكل سرور سكينًا ثانية، لذا اسأل أولًا.¶
ƒ يصل(هنا2•غرفة2 حقيبة3•[''])•رحلة
	رحلة(
		هنا2.معرّف2
		((هنا2.خذ ≠ '') & (~حقيبة3.يحتوي(هنا2.خذ))) ? حقيبة3.مع(
				هنا2.خذ
			) حقيبة3
	)

مفتاح2: مفتاح()

¶ضغطة مفتاح، بالترتيب: عند نهاية، أي مفتاح يوقظك في الغرفة الأولى مجددًا؛ مفتاح ليس 1 أو 2 أو 3 لا يعني شيئًا؛ رقم يتجاوز عدد الأبواب في هذه الغرفة لا يعني شيئًا أيضًا؛ وعندها فقط يكون بابًا. هذا الاختبار الثالث هو الجدير بالتدوين، لأن الوصول إلى القائمة يلتف على نفسه — بدونه، سيؤدي الضغط على 3 في غرفة بها بابان إلى أخذ الباب الأول دون أن تدري.¶
ƒ خطوة(ت•رحلة ك•'')•رحلة (
		هنا3: اذهب(ت.غرفة3)
		أبواب2: طرق(هنا3 ت.حقيبة)
		هنا3.نهاية2 ≠ '' ? رحلة('زنزانة' [])
			~((ك = '1') | (ك = '2') | (ك = '3')) ? ت
				(ك → #) > أبواب2.الطول() ? ت
					يصل(اذهب(أبواب2[ك → #].غرفة) ت.حقيبة)
	)

رحلة2•رحلة: رحلة('زنزانة' []) … ∆ مفتاح2 … خطوة(
			رحلة2
			مفتاح2
		)

هنا4: اذهب(رحلة2.غرفة3)
أبواب3: طرق(هنا4 رحلة2.حقيبة)

¶ما تحمله، ويظهر فقط عندما تحمل شيئًا ما.¶
تحمل:
	رحلة2.حقيبة.الطول() > 0
	? [
			عبارة(
				`*تحمل* \رحلة2.حقيبة.ادمج(' · ')\`
				حجم: 0.3m
				محاذاة: '|'
				لون: Color(60% 30 0°)
			)
		]
		[]

¶ما يكمن تحت الغرفة: أبوابها، مرقّمة بحيث يكون ما تقرأه هو ما تضغطه، أو، عند النهاية، كيف انتهت والمفتاح الوحيد الذي يبدأها من جديد.¶
أدناه:
	هنا4.نهاية2 ≠ ''
	? [
			عبارة(
				`*\هنا4.نهاية2\*`
				حجم: 0.8m
				محاذاة: '|'
				لون: هنا4.فاز ? Color(85% 50 90°) Color(45% 40 25°)
				مدة: 1.5s
				entering: Pose(opacity: 0% scale: 0.5)
			)
			عبارة(
				`اضغط أي مفتاح للاستيقاظ مجددًا`
				حجم: 0.3m
				محاذاة: '|'
				مدة: 3s
				entering: Pose(opacity: 0%)
			)
		]
		أبواب3.translate(
			ƒ(باب3•باب فهرس2•#)
				عبارة(
					`\فهرس2\. *\باب3.وسم\*`
					حجم: 0.5m
					محاذاة: '|'
					اسم: باب3.وسم
					مدة: 1s
					entering: Pose(opacity: 0%)
				)
		)

مسرح(
	[
		مجموعة(
			كومة()
			[
				عبارة(
					هنا4.وصف2
					حجم: 0.5m
					لف: 14m
					محاذاة: '|'
					اسم: هنا4.معرّف2
					مدة: 0.5s
					entering: Pose(offset: مكان(0m 2m))
				)
				:تحمل
				:أدناه
			]
		)
	]
	background: Color(0 0 0°)
	color: Color(100% 0 0°)
	face: "Permanent Marker"
)
