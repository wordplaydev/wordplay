Y
مغامرة
=== start/en
¶مغامرة نصية في خمس عشرة غرفة: تستيقظ مقيّدًا في غرفة مظلمة وباردة، وعليك أن تجد واحدة من أربع طرق تنتهي بها هذه الليلة. الغرف تقود إلى بعضها، فالمنعطف الخاطئ يُعيدك في حلقة بدل أن يُوصلك إلى طريق مسدود، وما تحمله معك يحدد أي الممرات تُفتح أمامك.¶

¶طريق للخروج من غرفة: اسم الخيار، ومعرّف الغرفة التي يفتح عليها، وإذا كان الباب مقفلًا فما يجب أن تحمله لتستعمله. ذكر الوجهة بدل الاحتفاظ بها هو السرّ كله. فالربط يجب أن يوجد قبل أن يذكره أي شيء، لذلك لا تستطيع قصة مبنية من روابط أن تشير إلا إلى الوراء، ولا يمكنها أن تعود من جديد. أما معرّف النص فلا يخضع لهذه القاعدة، لذلك يمكن لغرفتين أن تذكر كل واحدة منهما الأخرى، ويمكن أن تحتوي الخريطة على حلقات.¶
•باب(تسمية•'' غرفة•'' يحتاج•'': '')

¶غرفة. معظم الغرف تحتاج إلى الثلاثة الأولى فقط: معرّف، وما تجده هناك، وأبوابها. الثلاثة الأخيرة للغرف الخاصة: غرفة تعطيك شيئًا، والغرف الأربع التي تُنهي القصة.¶
•غرفة2(معرّف2•'' وصف2•'' أبواب•[باب]: [] خذ•'': '' نهاية2•'': '' فاز•?: ⊥)

¶أين أنت وما الذي تحمله. هذا هو جوهر القصة فعلًا: معرّف غرفة واحدة وكومة صغيرة من الأشياء.¶
•رحلة(غرفة3•'' حقيبة•[''])

¶كل الغرف في قائمة واحدة. الأولى فقط هي المهمة بحسب موضعها: فهي المكان الذي تبدأ منه القصة، والمكان الذي يعيدك إليه كل ختام.¶
غرف•[غرفة2]: [
		غرفة2(
			'زنزانة'
			'تستيقظ في غرفة مظلمة وباردة رائحتها كرائحة العفن. معصماك مربوطان خلف ظهرك، ومن عقد العقد لم يكن مستعجلًا.'
			[
				باب('تدحرج على جنبك' 'أرض')
				باب('استلقِ ساكنًا واستمع' 'استمع')
			]
		)
		غرفة2(
			'استمع'
			'يصلك صوتان من خلال ألواح الأرضية. يتجادلان حول من ترك البوابة مفتوحة، ولا يبدو أيٌّ منهما قلقًا بشأنك.'
			[باب('تدحرج على جنبك' 'أرض')]
		)
		غرفة2(
			'أرض'
			'وأنت على جنبك ترى ما تحت السرير الصغير: سكينًا على البلاط الحجري، صدئ من ظهره، قريبًا بما يكفي لتصل إليه إن رضيت أن تضع وجهك على الأرض.'
			[
				باب('خذه وقطّع قيودك' 'قبو')
				باب('ابقَ ساكنًا واستمع مرة أخرى' 'استمع')
			]
		)
		غرفة2(
			'قبو'
			'القبو وأنت واقف: السرير الصغير، وحبل مقطوع متناثر، ودرج يصعد على أحد الجدران وممر منخفض يمتد من الجدار الآخر.'
			[
				باب('اصعد الدرج' 'درج')
				باب('اسلك الممر المنخفض' 'ممر')
			]
			خذ: 'سكين'
		)
		غرفة2(
			'درج'
			'درجات متآكلة في منتصفها. في منتصف الصعود يوجد مسطّح صغير يتدلّى فيه فانوس من خطّاف، وفوق المسطّح تواصل السلالم صعودها.'
			[
				باب('خذ الفانوس' 'فانوس')
				باب('واصل الصعود' 'باب')
				باب('انزل إلى الأسفل' 'قبو')
			]
		)
		غرفة2(
			'فانوس'
			'يشتعل الفتيل في المحاولة الثانية، ويتبيّن أن المسطّح أصغر بكثير مما جعلته الظلمة يبدو.'
			[
				باب('واصل الصعود' 'باب')
				باب('انزل إلى الأسفل' 'قبو')
			]
			خذ: 'فانوس'
		)
		غرفة2(
			'باب'
			'في أعلى السلالم يوجد باب ثقيل مغلق بمزلاج من الجهة الأخرى. المزلاج قديم، والفجوة بجانبه واسعة بما يكفي لدخول نصل.'
			[
				باب('حرّك المزلاج بالسكين' 'قاعة')
				باب('انزل إلى الأسفل' 'درج')
			]
		)
		غرفة2(
			'قاعة'
			'قاعة فيها موقد انطفأ منذ زمن وكرسيّان مدفوعان بعيدًا عنه، كأن الجدال انتهى على عجل. في آخر القاعة بوابة، وتحتها ضوء رمادي.'
			[
				باب('اذهب إلى البوابة' 'بوابة')
				باب('انزل السلالم مرة أخرى' 'درج')
			]
		)
		غرفة2(
			'بوابة'
			'البوابة مقيّدة بسلسلة، والسلسلة تمرّ عبر قفل بحجم قبضة يدك. وراءها ينحدر الطريق إلى الوادي.'
			[
				باب(
					'أدر المفتاح في القفل'
					'سفح التل'
					يحتاج: 'مفتاح'
				)
				باب('تسلّق السلسلة بدلًا من ذلك' 'تسلّق')
				باب('ارجع إلى القاعة' 'قاعة')
			]
		)
		غرفة2(
			'ممر'
			'الممرّ منخفض لدرجة أنك تتقدّم على يد واحدة، ورائحته رائحة نهر. بعد بضع خطوات، لا تعود العتمة مجرد ظلّ، بل تصير جدارًا.'
			[
				باب('تحسّس طريقك' 'أعمى')
				باب(
					'احمل الضوء معك إلى الداخل'
					'سرداب'
					يحتاج: 'فانوس'
				)
				باب('ارجع من الطريق الذي أتيت منه' 'قبو')
			]
		)
		غرفة2(
			'سرداب'
			'يجد الفانوس غرفة منخفضة فيها صناديق من حجر. وعلى خُطّاف بجانب آخر صندوق، يعلّق مفتاح صدئ ما زالت قطعة قماش مربوطة به.'
			[
				باب('تابع نحو الماء' 'النهر')
				باب('ارجع في الممر' 'ممر')
			]
			خذ: 'مفتاح'
		)
		غرفة2(
			'أعمى'
			'تتابع السير ويدك ممدودة أمامك. لا تجد يدك شيئًا، وبعد لحظة لا تجد قدماك شيئًا أيضًا. الظلام يحتفظ بكل ما يُعطى له.'
			نهاية2: 'الظلام يحتفظ بك.'
		)
		غرفة2(
			'تسلّق'
			'تصعد معظم الطريق، ثم تتذكّر السلسلة كم هي قديمة. يجدونك عند أسفل البوابة وقت الفجر، وهذه المرة يأتون بحبل يكفي لاثنين.'
			نهاية2: 'أُمسك بك عند البوابة.'
		)
		غرفة2(
			'النهر'
			'ينتهي الممر عند شبكة حديدية فوق ماء جارٍ. القضبان قديمة والسكين صبور. تخرج مع النهر، وتصبح البيت بعيدًا خلفك قبل أن تتحول السماء إلى الرمادي.'
			نهاية2: 'الخروج مع النهر.'
			فاز
		)
		غرفة2(
			'سفح التل'
			'يدور المفتاح، وتنسكب السلسلة على العشب، وتنفتح البوابة بلا صوت يسمعه أحد. الوادي رمادي مع الصباح، والطريق لك.'
			نهاية2: 'الخروج من البوابة.'
			فاز
		)
	]

¶الغرفة التي لها هذا المعرّف. تعيد find() القيمة ø عندما لا يتطابق شيء. والمعرّف الذي لا يسمّي أي غرفة هو ثقب في الخريطة وليس منعطفًا في القصة، لذلك تحلّ الغرفة الأولى مكانه.¶
ƒ اذهب(مطلوب•'')•غرفة2 غرف.ابحث(
		ƒ(غرفة4•غرفة2) غرفة4.معرّف2 = مطلوب
	) ?? غرف[1]

¶الأبواب التي يمكنك فعلًا دخولها من هنا. الباب المقفل الذي لا تملك ما يفتحه لا يُعرض أبدًا، فيبدو كأنه جدار حتى يصبح ما يفتحه في يدك.¶
ƒ طرق(هنا•غرفة2 حقيبة2•[''])•[باب]
	هنا.أبواب.تصفية(
		ƒ(باب2•باب) (باب2.يحتاج = '') | حقيبة2.يحتوي(
					باب2.يحتاج
				)
	)

¶ادخل غرفة والتقط كل ما فيها. قد تعطيك add() سكينًا ثانية بكل سرور، لذلك اسأل أولًا.¶
ƒ يصل(هنا2•غرفة2 حقيبة3•[''])•رحلة
	رحلة(
		هنا2.معرّف2
		((هنا2.خذ ≠ '') & (~حقيبة3.يحتوي(هنا2.خذ))) ? حقيبة3.مع(
				هنا2.خذ
			) حقيبة3
	)

مفتاح3: مفتاح()

¶ضغطة مفتاح، بالترتيب: عند النهاية، أي مفتاح يوقظك في الغرفة الأولى من جديد. المفتاح الذي ليس 1 أو 2 أو 3 لا معنى له. والرقم الأكبر من عدد الأبواب في هذه الغرفة لا معنى له أيضًا. وبعد ذلك فقط يكون المفتاح بابًا. هذا الاختبار الثالث يستحق أن يُكتب، لأن الوصول إلى عناصر القائمة يلتفّ من البداية. ومن دونه، ستؤدي الضغطة على 3 في غرفة فيها بابان إلى فتح الباب الأول بهدوء.¶
ƒ خطوة2(ر•رحلة م•'')•رحلة (
		هنا3: اذهب(ر.غرفة3)
		أبواب2: طرق(هنا3 ر.حقيبة)
		هنا3.نهاية2 ≠ '' ? رحلة('زنزانة' [])
			~((م = '1') | (م = '2') | (م = '3')) ? ر
				(م → #) > أبواب2.الطول() ? ر
					يصل(اذهب(أبواب2[م → #].غرفة) ر.حقيبة)
	)

رحلة2•رحلة: رحلة('زنزانة' []) … ∆ مفتاح3 … خطوة2(
			رحلة2
			مفتاح3
		)

هنا4: اذهب(رحلة2.غرفة3)
أبواب3: طرق(هنا4 رحلة2.حقيبة)

¶ما تحمله، ويظهر فقط عندما تحمل شيئًا.¶
تحمل:
	رحلة2.حقيبة.الطول() > 0
	? [
			عبارة(
				`*تحمل* \رحلة2.حقيبة.ادمج(' · ')\`
				حجم: 0.3m
				محاذاة: '|'
				لون: Color(60% 30 0°)
			)
		]
		[]

¶ما يظهر تحت الغرفة: أبوابها مرقّمة بحيث يكون ما تقرؤه هو ما تضغطه، أو عند النهاية، كيف انتهت وزرّ واحد يعيد البدء.¶
أدناه:
	هنا4.نهاية2 ≠ ''
	? [
			عبارة(
				`*\هنا4.نهاية2\*`
				حجم: 0.8m
				محاذاة: '|'
				لون: هنا4.فاز ? Color(85% 50 90°) Color(45% 40 25°)
				مدة: 1.5s
				دخول: Pose(شفافية: 0% مقياس: 0.5)
			)
			عبارة(
				`اضغط أي مفتاح لتستيقظ من جديد`
				حجم: 0.3m
				محاذاة: '|'
				مدة: 3s
				دخول: Pose(شفافية: 0%)
			)
		]
		أبواب3.ترجم(
			ƒ(باب3•باب فهرس2•#)
				عبارة(
					`\فهرس2\. *\باب3.تسمية\*`
					حجم: 0.5m
					محاذاة: '|'
					اسم: باب3.تسمية
					مدة: 1s
					دخول: Pose(شفافية: 0%)
				)
		)

مسرح(
	[
		مجموعة(
			كومة()
			[
				عبارة(
					هنا4.وصف2
					حجم: 0.5m
					لف: 14m
					محاذاة: '|'
					اسم: هنا4.معرّف2
					مدة: 0.5s
					دخول: Pose(إزاحة: مكان(0m 2m))
				)
				:تحمل
				:أدناه
			]
		)
	]
	خلفية: Color(0 0 0°)
	لون: Color(100% 0 0°)
	وجه: "Permanent Marker"
)
