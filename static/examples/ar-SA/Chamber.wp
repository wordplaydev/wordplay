文
غرفة
=== start
¶مئة حرف من أربعة أنظمة كتابة ترتدّ داخل صندوق مغلق. اقلب الجاذبية أو هزّها.¶

العدّ: 100

¶الأبجديات الأربع التي تُؤخذ منها الحروف.¶
لاتينية: 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' → ['']
يونانية: 'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ' → ['']
عربية: 'ابتثجحخدذرزسشصضطظعغفقكلمنهوي' → ['']
صينيةيابانيةكورية: '日月火水木金土山川田人口手目耳心力大小上下中天空海花鳥風雨雪' → ['']

¶آخر عنصر تحكم تم النقر عليه.¶
اختيار2: اختيار()

¶اخلط الأبجديات الأربع معًا مرة واحدة عند بداية البرنامج، ثم أبقِ هذا الترتيب دائمًا. الخلط المكتوب كربط عادي سيعطي كل حرف رمزًا جديدًا في كل إطار.¶
رموزالحروف2: [:لاتينية :يونانية :عربية :صينيةيابانيةكورية].مخلوطة(
	) … ∆ اختيار2 … رموزالحروف2

¶صحيح فقط في التقييم الذي سببه زر الهزّ، فتحصل الحروف على دفعة واحدة لكل نقرة بدل أن تُدفع في كل إطار.¶
هزّ: (∆ اختيار2) & (اختيار2 = 'shake')

¶يبدّل المفتاح بين جاذبية الأرض وعدم وجود جاذبية.¶
سقوط: ⊤ … ∆ اختيار2 … (اختيار2 = 'gravity') ? ~سقوط سقوط

¶سرعة واتجاه ودوران عشوائية.¶
ƒ إطلاق() سرعة(
		عشوائي(-12m/s 12m/s)
		عشوائي(-12m/s 12m/s)
		عشوائي(-120°/s 120°/s)
	)

حروف: العدّ → [].ترجم(
		ƒ(رقم4)
			عبارة(
				رموزالحروف2[رقم4]
				اسم: "glyph\رقم4\"
				مكان: الحركة(
					مكان(عشوائي(-7.5m 7.5m) عشوائي(-5.5m 5.5m))
					إطلاق()
					السرعةالتالية: هزّ ? إطلاق() ø
				)
				مادة: مادة(الارتداد: 0.7 الاحتكاك: 0)
			)
	)

¶عنصرا التحكم. ليس لهما كتلة، ومكانهما ليس حركة، لذلك يتركهما محرك الفيزياء وشأنهما.¶
مفتاح3: عبارة(
		سقوط ? '⬇ الجاذبية' '🌌 طافٍ'
		0.7m
		اسم: 'gravity'
		قابلللتحديد
		مكان: مكان(-13m 1m)
	)

الهزّاز: عبارة(
		'🎲 هزّ'
		0.7m
		اسم: 'shake'
		قابلللتحديد
		مكان: مكان(-13m -1m)
	)

مسرح(
	[
		¶أربعة جدران سميكة بما يكفي حتى لا يخترقها شيء عندما يتحرك بسرعة.¶
		شكل(مستطيل(-8.6m 6.6m 8.6m 6m))
		شكل(مستطيل(-8.6m -6m 8.6m -6.6m))
		شكل(مستطيل(-8.6m 6.6m -8m -6.6m))
		شكل(مستطيل(8m 6.6m 8.6m -6.6m))
		:حروف
		مفتاح3
		الهزّاز
	]
	جاذبية: سقوط ? 9.8m/s^2 0m/s^2
	مكان: مكان(-2.5m 0m -11m)
)
