👩‍💻
فجوة في الكود
=== start/en
¶يعرض هذا المشروع بيانات حقيقية وعامة عن عدد النساء اللواتي يحصلن على شهادات في علوم الحاسوب في الولايات المتحدة، وكيف تغير ذلك العدد مع الوقت.

يستخدم المشروع جدولي بيانات، أحدهما باسم years والآخر باسم fields، ثم يتيح لك اختيار أحد ثلاثة عروض باستخدام الأزرار في الأعلى. كل عرض هو مخطط أعمدة مكوّن من رموز نساء تعبيرية، مع شرح بلغة بسيطة في التذييل.¶
↓ years
↓ fields

¶دالة fill تصنع شريطًا واحدًا مصمتًا. تكرر رمز المرأة التعبيري count مرة، وتضم كل النسخ معًا في قطعة نص واحدة بلا فراغات، فيظهر الصف كشريط متواصل بدل نقاط منفصلة.¶
ƒ تعبئة(عدّ•#) (عدّ → []).translate(ƒ() '👩').ادمج('')

¶دالة chart ترسم مخططًا شريطيًا من ثلاث قوائم متطابقة: تسمية، وطول شريط من رموز تعبيرية، وقيمة. كل شريط هو صف واحد في تكديس محاذَى من اليسار، فتبدأ كل الأشرطة من نفس الحافة، ويمكن مقارنة أطوالها مباشرة. تظهر التسمية والقيمة في نهاية كل شريط، في نفس الصف، فتبقى متراصفة مع شريطها.¶
ƒ مخطط2(تسميات•[''] وحدات•[#] قيم•[''])
	مجموعة(
		كومة('<' الحشو: 0.2m)
		وحدات.translate(
			ƒ(و2•# i•#)
				مجموعة(
					صف('|' الحشو: 0.3m)
					[
						عبارة(تعبئة(و2) حجم: 0.3m)
						عبارة(
							`\تسميات[i]\ \قيم[i]\`
							حجم: 0.28m
							لون: Color(45% 0 0°)
						)
					]
				)
		)
	)

¶المشهد ١ — "الصعود والانحدار". لكل سنة في البيانات، نرسم شريطًا طوله هو النسبة المئوية لدرجات علوم الحاسوب التي حصلت عليها النساء. كل رمز امرأة تعبيري يمثل حوالي ٥ بالمئة، فنقسم النسبة على ٥ لنحصل على طول الشريط.¶
صفوفالوقت: (years ⎡?سنة نسبةمئوية⎦ ⊤) → []
عرضالوقت: مخطط2(
		صفوفالوقت.translate(ƒ(صف2) صف2.سنة)
		صفوفالوقت.translate(ƒ(صف3) (صف3.نسبةمئوية ÷ 5).تقريب())
		صفوفالوقت.translate(
			ƒ(صف4) (صف4.نسبةمئوية.تقريب() → '') + '%'
		)
	)

¶المشهد ٢ — "مجال واحد خارج عن السياق". نقارن نسبة النساء بين مجالات دراسة مختلفة في سنة واحدة حديثة. الصفوف مرتّبة مسبقًا من الأعلى نسبة نساء إلى الأقل، فيقع علوم الحاسوب في أسفل المخطط.¶
صفوفالحقول: (fields ⎡?حقل نسبةمئوية2⎦ ⊤) → []
عرضالحقول: مخطط2(
		صفوفالحقول.translate(ƒ(صف5) صف5.حقل)
		صفوفالحقول.translate(
			ƒ(صف6) (صف6.نسبةمئوية2 ÷ 5).تقريب()
		)
		صفوفالحقول.translate(
			ƒ(صف7) (صف7.نسبةمئوية2 → '') + '%'
		)
	)

¶المشهد ٣ — "نساء أكثر، حصة أصغر". هذان قياسان مختلفان، فنرسمهما كمخططين منفصلين جنبًا إلى جنب. المخطط الأيسر يحسب عدد النساء (كل رمز تعبيري يمثل حوالي ٢٠٠٠ شخص)، والمخطط الأيمن يعرض حصتهن من كل الدرجات (كل رمز تعبيري يمثل حوالي ٥ بالمئة). في كل مخطط، يستخدم الشريطان نفس الوحدة، فيمكن مقارنتهما: العدد يتضاعف تقريبًا بينما تنخفض الحصة.¶
صفوفالعدد: (years ⎡?سنة نساء نسبةمئوية⎦ ((سنة = '1984') | (سنة = '2022'))) → []
قديم: صفوفالعدد[1]
الآن2: صفوفالعدد[2]

مخططالنساء: مخطط2(
		['1984' '2022']
		[
			(قديم.نساء ÷ 2000).تقريب()
			(الآن2.نساء ÷ 2000).تقريب()
		]
		[قديم.نساء → '' الآن2.نساء → '']
	)
مخططالحصة: مخطط2(
		['1984' '2022']
		[
			(قديم.نسبةمئوية ÷ 5).تقريب()
			(الآن2.نسبةمئوية ÷ 5).تقريب()
		]
		[
			(قديم.نسبةمئوية.تقريب() → '') + '%'
			(الآن2.نسبةمئوية.تقريب() → '') + '%'
		]
	)
عرضالأعداد: مجموعة(
		صف('<' الحشو: 1.5m)
		[
			مجموعة(
				كومة('|' الحشو: 0.3m)
				[
					عبارة(
						`/النساء الحاصلات على درجات علوم الحاسوب/`
						حجم: 0.28m
					)
					مخططالنساء
				]
			)
			مجموعة(
				كومة('|' الحشو: 0.3m)
				[
					عبارة(
						`/حصتهن من كل درجات علوم الحاسوب/`
						حجم: 0.28m
					)
					مخططالحصة
				]
			)
		]
	)

¶
The three buttons. Choice reports the name of whatever selectable Phrase
the reader last clicked. We start on the time view and update whenever the
choice changes.
¶
اختيار2: اختيار()
الحالي: 'time' … ∆ اختيار2 … اختيار2

تبويبات: مجموعة(
		صف('|' الحشو: 0.6m)
		[
			عبارة(
				'▸ عبر الزمن'
				قابلللتحديد: ⊤
				اسم: 'time'
				حجم: 0.35m
				لون: Color(60% 50 20°)
			)
			عبارة(
				'▸ حسب المجال'
				قابلللتحديد: ⊤
				اسم: 'fields'
				حجم: 0.35m
				لون: Color(60% 50 140°)
			)
			عبارة(
				'▸ العدد مقابل الحصة'
				قابلللتحديد: ⊤
				اسم: 'counts'
				حجم: 0.35m
				لون: Color(60% 50 280°)
			)
		]
	)

¶اختر المخطط والتذييل للمشهد الحالي.¶
المتن: الحالي = 'time' ? عرضالوقت (الحالي = 'fields' ? عرضالحقول عرضالأعداد)

التذييل:
	الحالي = 'time' ?
		عبارة(
			`/بلغت حصة النساء من درجات البكالوريوس في علوم الحاسوب في الولايات المتحدة أعلاها عند ٣٧٪ في عام ١٩٨٤، ثم انخفضت لحوالي ٢٥ سنة إلى نحو ١٨٪ حوالي عام ٢٠٠٨، ولم تتعافَ إلا ببطء. كل 👩 ≈ ٥٪. المصدر: NCES Digest of Education Statistics، الجدول 325.35./`
			لف: 9m
			حجم: 0.26m
		)
		الحالي = 'fields' ?
			عبارة(
				`/حوالي عام ٢٠١٨، حصلت النساء على معظم درجات علم النفس والأحياء، وحوالي نصف درجات الرياضيات والعلوم الاجتماعية، لكن أقل من ٢٠٪ من درجات علوم الحاسوب — وهي تقريبًا أدنى حصة بين كل المجالات. كل 👩 ≈ ٥٪. المصدر: NSF NCSES، Women, Minorities, and Persons with Disabilities in S&E./`
				لف: 9m
				حجم: 0.26m
			)
			عبارة(
				`/في عام ١٩٨٤ حصلت حوالي ١٢٬٠٠٠ امرأة على درجات علوم الحاسوب — أي ٣٧٪ منهن. بحلول عام ٢٠٢٢ أصبح العدد أكثر من ٢٤٬٠٠٠، ضعف العدد تقريبًا، ومع ذلك كانت النسبة ٢٣٪ فقط: نما المجال بسرعة كبيرة حتى إن أعداد الرجال نمت أسرع. يمكن أن يزداد العدد بينما تتقلص الحصة. المصدر: NCES./`
				لف: 9m
				حجم: 0.26m
			)

مسرح(
	[
		مجموعة(
			كومة('|' الحشو: 0.4m)
			[
				عبارة(`فجوة في الكود` حجم: 0.7m شكل: 'Monoton')
				عبارة(
					`/من يحصل على درجات علوم الحاسوب؟/`
					حجم: 0.35m
				)
				تبويبات
				المتن
				التذييل
			]
		)
	]
	face: 'Quicksand'
)
=== years/en
¶النسبة المئوية لدرجات البكالوريوس في علوم الحاسوب والمعلومات في الولايات المتحدة التي حصلت عليها النساء، بحسب السنة، مع عدد النساء والعدد الإجمالي للدرجات. المصدر: National Center for Education Statistics، Digest of Education Statistics، الجدول 325.35. https://nces.ed.gov/programs/digest/d23/tables/dt23_325.35.asp¶
