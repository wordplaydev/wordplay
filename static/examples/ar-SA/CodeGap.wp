👩‍💻
فجوة في الكود
=== start/en
¶يعرض هذا المشروع بيانات حقيقية وعامة عن عدد النساء اللاتي يحصلن على شهادات في علوم الحاسوب في الولايات المتحدة، وكيف تغيّر هذا العدد. يستعير جدولين للبيانات، أحدهما اسمه years والآخر اسمه fields، ثم يتيح لك اختيار واحد من ثلاثة عروض بالأزرار في الأعلى. كل عرض هو مخطط أعمدة مصنوع من رموز تعبيرية لامرأة، مع شرح بلغة بسيطة في التذييل.¶
↓ years
↓ fields

¶تصنع الدالة fill شريطًا واحدًا متصلًا. تكرّر رمز المرأة التعبيري بعدد count من المرات، ثم تضمّها في نص واحد بلا فراغات، فيظهر الصف كشريط متصل واحد بدل نقاط منفصلة.¶
ƒ تعبئة(العدّ•#) (العدّ → []).ترجم(ƒ() '👩').ادمج('')

¶ترسم الدالة chart مخططًا شريطيًا من ثلاث قوائم متطابقة: تسمية، وطول الشريط بالرموز التعبيرية، وقيمة. كل شريط هو صف في كومة محاذاة لليسار، فتبدأ كل الأشرطة من الحافة نفسها ويمكن مقارنة أطوالها مباشرة. وتأتي التسمية والقيمة في نهاية كل شريط وفي الصف نفسه، فتبقى بمحاذاة شريطها.¶
ƒ مخطط2(تسميات•[''] وحدات•[#] قيم•[''])
	مجموعة(
		كومة('<' الحشو: 0.2m)
		وحدات.ترجم(
			ƒ(و2•# ت•#)
				مجموعة(
					صف('|' الحشو: 0.3m)
					[
						عبارة(تعبئة(و2) حجم: 0.3m)
						عبارة(
							`\تسميات[ت]\ \قيم[ت]\`
							حجم: 0.28m
							لون: Color(45% 0 0°)
						)
					]
				)
		)
	)

¶العرض 1 — "الصعود والهبوط". نرسم لكل سنة في البيانات شريطًا طوله يساوي النسبة المئوية لشهادات علوم الحاسوب التي حصلت عليها النساء. كل رمز امرأة يمثّل نحو 5 بالمئة، لذلك نقسم النسبة على 5 لنحصل على طول الشريط.¶
صفوفالوقت: (years ⎡?السنة2 النسبةالمئوية⎦ ⊤) → []
عرضالوقت: مخطط2(
		صفوفالوقت.ترجم(ƒ(صف2) صف2.السنة2)
		صفوفالوقت.ترجم(ƒ(صف3) (صف3.النسبةالمئوية ÷ 5).تقريب())
		صفوفالوقت.ترجم(
			ƒ(صف4) (صف4.النسبةالمئوية.تقريب() → '') + '%'
		)
	)

¶العرض 2 — "مجال واحد يسير عكس الباقي". نقارن حصة النساء في مجالات دراسية مختلفة في سنة حديثة واحدة. الصفوف مرتبة أصلًا من الأكثر نساءً إلى الأقل، لذلك تأتي علوم الحاسوب في أسفل المخطط.¶
صفوفالمجال: (fields ⎡?حقل النسبةالمئوية2⎦ ⊤) → []
عرضالمجالات: مخطط2(
		صفوفالمجال.ترجم(ƒ(صف5) صف5.حقل)
		صفوفالمجال.ترجم(
			ƒ(صف6) (صف6.النسبةالمئوية2 ÷ 5).تقريب()
		)
		صفوفالمجال.ترجم(ƒ(صف7) (صف7.النسبةالمئوية2 → '') + '%')
	)

¶العرض 3 — "نساء أكثر، حصة أصغر". هذان قياسان مختلفان، لذلك نرسمهما في مخططين منفصلين جنبًا إلى جنب. المخطط الأيسر يعدّ النساء (كل رمز يساوي نحو 2000 شخص)، والمخطط الأيمن يعرض حصتهن من كل الشهادات (كل رمز يساوي نحو 5 بالمئة). في كل مخطط يستخدم الشريطان الوحدة نفسها، فيمكن مقارنتهما: العدد يكاد يتضاعف بينما الحصة تنخفض.¶
صفوفالعدد: (years ⎡?السنة2 النساء النسبةالمئوية⎦ ((السنة2 = '1984') | (السنة2 = '2022'))) → []
قديم: صفوفالعدد[1]
الآن2: صفوفالعدد[2]

مخططالنساء: مخطط2(
		['1984' '2022']
		[
			(قديم.النساء ÷ 2000).تقريب()
			(الآن2.النساء ÷ 2000).تقريب()
		]
		[قديم.النساء → '' الآن2.النساء → '']
	)
مخططالنسبة: مخطط2(
		['1984' '2022']
		[
			(قديم.النسبةالمئوية ÷ 5).تقريب()
			(الآن2.النسبةالمئوية ÷ 5).تقريب()
		]
		[
			(قديم.النسبةالمئوية.تقريب() → '') + '%'
			(الآن2.النسبةالمئوية.تقريب() → '') + '%'
		]
	)
عرضالأعداد: مجموعة(
		صف('<' الحشو: 1.5m)
		[
			مجموعة(
				كومة('|' الحشو: 0.3m)
				[
					عبارة(
						`/النساء الحاصلات على شهادات علوم الحاسوب/`
						حجم: 0.28m
					)
					مخططالنساء
				]
			)
			مجموعة(
				كومة('|' الحشو: 0.3m)
				[
					عبارة(
						`/حصتهن من كل شهادات علوم الحاسوب/`
						حجم: 0.28m
					)
					مخططالنسبة
				]
			)
		]
	)

¶الأزرار الثلاثة. تعيد Choice اسم آخر عبارة Phrase قابلة للتحديد نقر عليها القارئ. نبدأ بعرض الزمن ونحدّث العرض كلما تغيّر الاختيار.¶
اختيار2: اختيار()
الحالي: 'time' … ∆ اختيار2 … اختيار2

علاماتالتبويب: مجموعة(
		صف('|' الحشو: 0.6m)
		[
			عبارة(
				'▸ عبر الزمن'
				قابلللتحديد
				اسم: 'time'
				حجم: 0.35m
				لون: Color(60% 50 20°)
			)
			عبارة(
				'▸ حسب المجال'
				قابلللتحديد
				اسم: 'fields'
				حجم: 0.35m
				لون: Color(60% 50 140°)
			)
			عبارة(
				'▸ العدد مقابل الحصة'
				قابلللتحديد
				اسم: 'الأعداد'
				حجم: 0.35m
				لون: Color(60% 50 280°)
			)
		]
	)

¶اختر المخطط والتذييل المناسبين للعرض الحالي.¶
المحتوى: الحالي = 'time' ? عرضالوقت (الحالي = 'fields' ? عرضالمجالات عرضالأعداد)

التذييل:
	الحالي = 'time' ?
		عبارة(
			`/بلغت حصة النساء من شهادات البكالوريوس في علوم الحاسوب في الولايات المتحدة ذروتها عند 37% في عام 1984، ثم انخفضت نحو 25 سنة إلى قرابة 18% حوالي عام 2008، ولم تتعافَ إلا ببطء. كل 👩 ≈ 5%. المصدر: NCES Digest of Education Statistics, Table 325.35./`
			لف: 9m
			حجم: 0.26m
		)
		الحالي = 'fields' ?
			عبارة(
				`/في حوالي عام 2018، حصلت النساء على معظم شهادات علم النفس والأحياء، ونحو نصف شهادات الرياضيات والعلوم الاجتماعية، لكن على أقل من 20% من شهادات علوم الحاسوب — وهي من أدنى الحصص بين كل المجالات. كل 👩 ≈ 5%. المصدر: NSF NCSES, Women, Minorities, and Persons with Disabilities in S&E./`
				لف: 9m
				حجم: 0.26m
			)
			عبارة(
				`/في عام 1984 حصلت نحو 12000 امرأة على شهادات علوم الحاسوب — أي 37% منها. وبحلول عام 2022 حصلت أكثر من 24000 امرأة عليها، أي ضعف العدد، لكن الحصة بلغت 23% فقط: فقد نما المجال بسرعة كبيرة حتى إن أعداد الرجال نمت أسرع. قد يرتفع العدد وتنخفض الحصة. المصدر: NCES./`
				لف: 9m
				حجم: 0.26m
			)

مسرح(
	[
		مجموعة(
			كومة('|' الحشو: 0.4m)
			[
				عبارة(`فجوة الكود` حجم: 0.7m شكل: 'Monoton')
				عبارة(
					`/من يحصل على شهادات علوم الحاسوب؟/`
					حجم: 0.35m
				)
				علاماتالتبويب
				المحتوى
				التذييل
			]
		)
	]
	وجه: 'Quicksand'
)
=== years/en
¶النسبة المئوية لشهادات البكالوريوس في علوم الحاسوب والمعلومات في الولايات المتحدة التي حصلت عليها النساء، حسب السنة، مع عدد النساء والعدد الكلي للشهادات. المصدر: National Center for Education Statistics, Digest of Education Statistics, Table 325.35. https://nces.ed.gov/programs/digest/d23/tables/dt23_325.35.asp¶

