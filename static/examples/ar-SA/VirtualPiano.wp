🎹
بيانو افتراضي
=== start
¶بيانو بأوكتاف واحد يمكنك العزف عليه! للحصول على أفضل تجربة، أطفئ تصور الموسيقى.¶

¶يخزّن هذا الربط تدفق مفاتيح يكتشف أي مفتاح ضغطته.¶
مضغوط2: مفتاح()

¶يخزّن هذا ربطًا بين المفاتيح التي تضغطها والنغمات التي ستُعزف،بشكلين: نص (لعرض النغمة التي تُعزف) وقيمة نصية رقمية(لتحويلها إلى رقم (#) وإدخالها في قائمة مقطوعة).

تم اختيار هذا الترتيب المحدد ليحاكي مفاتيح البيانو بشكل قريب، حيث تُمثَّلالمفاتيح البيضاء بحروف أبجدية، وتُمثَّل المفاتيح السوداء بأحرف رقمية.¶
خريطةالنغمات: {
		'w': ['دو' "1"]
		'3': ['دو# / ري ب' "2"]
		'e': ['ري' "3"]
		'4': ['ري# / مي ب' "4"]
		'r': ['مي' "5"]
		't': ['فا' "6"]
		'6': ['فا# / صول ب' "7"]
		'y': ['صول' "8"]
		'7': ['صول# / لا ب' "9"]
		'u': ['لا' "10"]
		'8': ['لا# / سي ب' "11"]
		'i': ['سي' "12"]
		'o': ['دو5' "13"]
	}

¶تُرجع هذه الدالة اسم النغمة، بناءً على المفتاح الذي تم ضغطه.إذا لم يكن المفتاح نغمة صالحة، فإنها تُرجع نصًا فارغًا.¶
ƒ إرجاعنص(مفتاح2•"")•"" (خريطةالنغمات{مفتاح2} ≠ ø) ? خريطةالنغمات{مفتاح2}[1] ""

¶تُرجع هذه الدالة رقم النغمة المطابق للمفتاح المضغوط ضمن قائمة،لاستخدامه كمُدخل في مقطوعة. إذا كان المفتاح المضغوط غير صالح، فإنهاتُرجع قائمة فارغة.¶
ƒ إرجاعنغمة(مفتاح3•"")•[] [
		(خريطةالنغمات{مفتاح3} ≠ ø) ? (خريطةالنغمات{مفتاح3}[2] → #) [
			]
	]

¶تأخذ هذه الدالة قائمة رقمية وتُرجع مقطوعة بتلك القائمة من النغمات.الحلقة مغلقة حتى تُعزف النغمة مرة واحدة فقط عند الضغط على المفتاح.¶
ƒ إرجاعمقطوعة(نغمة2•[#]) مسار(نغمة2 حلقة: ⊥)

¶يحدد هذان الربطان اللون الذي يُعطى للمفتاح المطابق عند الضغط عليهوعند عدم الضغط عليه.¶
لونالضغط: Color(10 270 50°)
لونفارغ: Color(0 0 0°)

¶يشغّل هذا المقطوعة المطابقة للمفتاح المضغوط. السلم الموسيقي كروماتيكيحتى تستطيع المقطوعات الوصول إلى جميع أنصاف النغمات. تتم إعادة التشغيلعند الضغط على مفتاح صالح، بحيث تُعزف المقطوعة عند كل ضغطة على المفتاح،حتى لو ضُغط مرتين متتاليتين.¶
موسيقى(
	إرجاعمقطوعة(إرجاعنغمة(مضغوط2))
	سلم: موسيقى.لوني
	إعادةالتشغيل: خريطةالنغمات{مضغوط2} ≠ ø
)

¶عرض البيانو، والمفاتيح التي يجب ضغطها، والنغمة التي تُعزف عندالضغط على مفتاح.¶
مجموعة(
	كومة('>' 1m)
	[
		مجموعة(
			صف('>' -.3m)
			[
				عبارة(
					'▯'
					اسم: 'w'
					حجم: 3m
					لون: مضغوط2 = 'w' ? لونالضغط لونفارغ
				)
				عبارة(
					'▮'
					اسم: '3'
					حجم: 3m
					لون: مضغوط2 = '3' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 'e'
					حجم: 3m
					لون: مضغوط2 = 'e' ? لونالضغط لونفارغ
				)
				عبارة(
					'▮'
					اسم: '4'
					حجم: 3m
					لون: مضغوط2 = '4' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 'r'
					حجم: 3m
					لون: مضغوط2 = 'r' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 't'
					حجم: 3m
					لون: مضغوط2 = 't' ? لونالضغط لونفارغ
				)
				عبارة(
					'▮'
					اسم: '6'
					حجم: 3m
					لون: مضغوط2 = '6' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 'y'
					حجم: 3m
					لون: مضغوط2 = 'y' ? لونالضغط لونفارغ
				)
				عبارة(
					'▮'
					اسم: '7'
					حجم: 3m
					لون: مضغوط2 = '7' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 'u'
					حجم: 3m
					لون: مضغوط2 = 'u' ? لونالضغط لونفارغ
				)
				عبارة(
					'▮'
					اسم: '8'
					حجم: 3m
					لون: مضغوط2 = '8' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 'i'
					حجم: 3m
					لون: مضغوط2 = 'i' ? لونالضغط لونفارغ
				)
				عبارة(
					'▯'
					اسم: 'o'
					حجم: 3m
					لون: مضغوط2 = 'o' ? لونالضغط لونفارغ
				)
			]
		)

		مجموعة(
			صف('>' 1.1m)
			[
				عبارة('w')
				عبارة('3')
				عبارة('e')
				عبارة('4')
				عبارة('r t')
				عبارة('6')
				عبارة('y')
				عبارة('7')
				عبارة('u')
				عبارة('8')
				عبارة('i  o')
			]
		)
		عبارة(إرجاعنص(مضغوط2))
	]
)
