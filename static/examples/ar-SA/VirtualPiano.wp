🎹
بيانو افتراضي
=== start
¶بيانو من أوكتاف واحد يمكنك العزف عليه! للحصول على أفضل تجربة، أوقف تصوّر الموسيقى.¶

¶يخزّن هذا الربط تدفق مفتاح يكتشف أي مفتاح ضغطت عليه.¶
مضغوط2: مفتاح()

¶يخزّن هذا خريطة تربط بين المفاتيح التي تضغط عليها والنوتات التي ستعزفها. تأتي النوتة بشكل نص (لعرض النوتة التي يتم عزفها) وبشكل نص رقمي حرفي (لتحويله إلى رقم (#) وإدخاله في قائمة مسار).

تم اختيار هذا التخطيط ليشبه مفاتيح البيانو قدر الإمكان. المفاتيح البيضاء تمثّلها الأحرف، والمفاتيح السوداء تمثّلها الأرقام.¶
خريطةالنوتات: {
		'w': ['دو' "1"]
		'3': ['C# / Db' "2"]
		'e': ['ري' "3"]
		'4': ['D# / Eb' "4"]
		'r': ['مي' "5"]
		't': ['فا' "6"]
		'6': ['F# / Gb' "7"]
		'y': ['صول' "8"]
		'7': ['G# / Ab' "9"]
		'u': ['لا' "10"]
		'8': ['A# / Bb' "11"]
		'i': ['سي' "12"]
		'o': ['C5' "13"]
	}

¶تُرجع هذه الدالة اسم النوتة بحسب المفتاح الذي تم الضغط عليه. إذا لم يكن المفتاح نوتة صالحة، تُرجع نصًا فارغًا.¶
ƒ إرجاعنص(مفتاح3•"")•"" (خريطةالنوتات{مفتاح3} ≠ ø) ? خريطةالنوتات{مفتاح3}[1] ""

¶تُرجع هذه الدالة رقم النوتة المقابل للمفتاح المضغوط داخل قائمة، لاستخدامه كمدخل في مسار. إذا كان المفتاح المضغوط غير صالح، تُرجع قائمة فارغة.¶
ƒ إرجاعنوتة(مفتاح4•"")•[] [
		(خريطةالنوتات{مفتاح4} ≠ ø) ? (خريطةالنوتات{مفتاح4}[2] → #) [
			]
	]

¶تأخذ هذه الدالة قائمة أرقام وتُرجع مسارًا يحتوي على قائمة النوتات هذه. التكرار متوقف حتى تُعزف النوتة مرة واحدة عند الضغط على المفتاح.¶
ƒ إرجاعمسار(نغمة2•[#]) مسار(نغمة2 حلقة: ⊥)

¶يحدد هذان الربطان اللون الذي يأخذه المفتاح المقابل عند الضغط عليه وعند عدم الضغط عليه.¶
لونالضغط: Color(10 270 50°)
لونالفراغ: Color(0 0 0°)

¶يعزف هذا المسار المقابل للمفتاح المضغوط. السلّم كروماتي حتى يستطيع المسار الوصول إلى كل أنصاف النغمات. تُضبط إعادة العزف عند الضغط على مفتاح صالح، فيُعزف المسار كلما ضُغط المفتاح، حتى لو ضُغط مرتين متتاليتين.¶
موسيقى(
	إرجاعمسار(إرجاعنوتة(مضغوط2))
	سلم: موسيقى.لوني
	إعادةالتشغيل: خريطةالنوتات{مضغوط2} ≠ ø
)

¶عرض البيانو والمفاتيح التي يجب الضغط عليها والنوتة التي تُعزف عند الضغط على مفتاح.¶
مجموعة(
	كومة('>' 1m)
	[
		مجموعة(
			صف('>' -.3m)
			[
				عبارة(
					'▯'
					اسم: 'w'
					حجم: 3m
					لون: مضغوط2 = 'w' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▮'
					اسم: '3'
					حجم: 3m
					لون: مضغوط2 = '3' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 'e'
					حجم: 3m
					لون: مضغوط2 = 'e' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▮'
					اسم: '4'
					حجم: 3m
					لون: مضغوط2 = '4' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 'r'
					حجم: 3m
					لون: مضغوط2 = 'r' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 't'
					حجم: 3m
					لون: مضغوط2 = 't' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▮'
					اسم: '6'
					حجم: 3m
					لون: مضغوط2 = '6' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 'y'
					حجم: 3m
					لون: مضغوط2 = 'y' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▮'
					اسم: '7'
					حجم: 3m
					لون: مضغوط2 = '7' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 'u'
					حجم: 3m
					لون: مضغوط2 = 'u' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▮'
					اسم: '8'
					حجم: 3m
					لون: مضغوط2 = '8' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 'i'
					حجم: 3m
					لون: مضغوط2 = 'i' ? لونالضغط لونالفراغ
				)
				عبارة(
					'▯'
					اسم: 'o'
					حجم: 3m
					لون: مضغوط2 = 'o' ? لونالضغط لونالفراغ
				)
			]
		)

		مجموعة(
			صف('>' 1.1m)
			[
				عبارة('w')
				عبارة('3')
				عبارة('e')
				عبارة('4')
				عبارة('r t')
				عبارة('6')
				عبارة('y')
				عبارة('7')
				عبارة('u')
				عبارة('8')
				عبارة('i  o')
			]
		)
		عبارة(إرجاعنص(مضغوط2))
	]
)
