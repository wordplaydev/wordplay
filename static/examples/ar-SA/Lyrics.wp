		سطر('في وميض بين النجوم' 87 4.5 5)
		سطر('عدت لأنقذ الكون' 95 5 1)
		سطر('في نوم عميق، عميق' 131 4 1)
		سطر('من البراءة' 135 5 1)
		سطر('وُلدت من جديد' 140 5 3)
		سطر('في سيارة ألمانية سريعة' 155 4 6)
		سطر('أنا مندهش أنني نجوت' 163.25 5 1)
		سطر('وسادة هوائية أنقذت حياتي' 169.75 5 7)
		سطر('في وميض بين النجوم' 179 4.5 5)
		سطر('عدت لأنقذ الكون' 187 5 1)
		سطر('في وميض بين النجوم' 251 4.5 5)
