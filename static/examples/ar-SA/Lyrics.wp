	]

¶السطر الذي يحتوي نافذته على هذه النبضة، أو ø بينها — وهذا معظم الأغنية، لأنها في أغلبها موسيقى بلا كلمات.¶
عرض: سطور.find(
		ƒ(ل•سطر) (عدّ ≥ ل.بداية2) & (عدّ < (ل.بداية2 + ل.استمرار))
	)

¶المعالجات، واحدة لكل نوع.¶
ƒ قول(ل2•سطر)•عبارة
	(ل2.نوع2 = 2) ?
		عبارة(
			ل2.كلمات2
			دوران: 5°
			entering: Pose(opacity: 0 rotation: 0°)
		)
		(ل2.نوع2 = 3) ? عبارة(
				ل2.كلمات2
				entering: Pose(scale: 2)
			)
			(ل2.نوع2 = 4) ?
				عبارة(
					ل2.كلمات2
					لون: Color(50% 136 337°)
					entering: تسلسل(
						{
							0%: Pose(offset: مكان(0m -2m))
							50%: Pose(offset: مكان(0m 2m))
							100%: Pose(offset: مكان(0m -2m))
						}
						duration: 3s
					)
				)
				(ل2.نوع2 = 5) ? عبارة(
						ل2.كلمات2
						entering: تسلسل.shake(0.75s count: 5x)
					)
					(ل2.نوع2 = 6) ?
						عبارة(
							ل2.كلمات2
							entering: تسلسل(
								{
									0%: Pose(offset: مكان(-10m 0m))
									50%: Pose(offset: مكان(1m 0m))
									100%: Pose(offset: مكان(0m 0m))
								}
								duration: 3s
							)
						)
						(ل2.نوع2 = 7) ?
							¶يظهر كما يوصفه اسمه: من بعيد وشبه معدوم، إلى أكبر من حجمه الأصلي في ربع ثانية، ثم يرتد قليلًا حتى يستقر. إزاحة المحور z هي ما تجعله يبدو قادمًا نحوك بدل أن يكبر فقط — فالمسرح يغيّر الحجم حسب العمق، لذا التحرك نحو المُشاهد يكبّره من تلقاء نفسه.¶
							عبارة(
								ل2.كلمات2
								1.5m
								entering: تسلسل(
									{
										0%: Pose(
											offset: مكان(0m 0m 6m)
											scale: 0.1
											opacity: 0
										)
										55%: Pose(
											offset: مكان(0m 0m -1.5m)
											scale: 1.3
											opacity: 1
										)
										75%: Pose(
											offset: مكان(0m 0m 0.5m)
											scale: 0.92
										)
										100%: Pose(
											offset: مكان(0m 0m 0m)
											scale: 1
										)
									}
									duration: 0.45s
								)
								resting: تسلسل.shake(0.4s)
							)
							(ل2.نوع2 = 8) ? عبارة(ل2.كلمات2 0.7m)
								عبارة(ل2.كلمات2)

¶تسمية سطر باسم كلماته الخاصة تجعله يُعامَل كمُخرَج مستقل، فيعرف المسرح أنه خرج ويستطيع تشغيل @Pose الخاص بخروجه. بدون الاسم، كل سطر من نفس النوع سيكون هو نفس المُخرَج، وستتبدل الكلمات دون أن تتلاشى أبدًا.¶
ƒ مُغنّى(ل3•سطر)•عبارة (
		مقول: قول(ل3)
		((مقول.اسم:ل3.كلمات2).exiting:Pose(opacity: 0)).مدة:0.75s
	)

¶أربعة رموز نوتة موسيقية، تتبدل مع الإيقاع. لا يستطيع @List/length أن يضمن أنه ليس صفرًا، لذا قد تكون الباقي ø؛ والرقم 0 هو ما تتحول إليه تلك الـø.¶
رموز: ['♩' '♪' '♫' '♬']
رمز: رموز[((عدّ % رموز.الطول()) ?? 0) + 1]

¶لا توجد كلمات على المسرح في معظم الأغنية — المقدمة الطويلة، الفجوات بين الأسطر، الخاتمة — فبدل أن يظلم المسرح، يعرض الإيقاع. الرمز هو اسمه الخاص، لذا يدخل كل رمز ويخرج فور وصوله.¶
ƒ نوتات()•عبارة
	عبارة(
		رمز
		2m
		اسم: رمز
		لون: Color(50% 0 0°)
		entering: Pose(opacity: 0 scale: 0.6)
		exiting: Pose(opacity: 0)
		مدة: 0.3s
	)

¶محتوى @Stage لا يمكن أن يحمل ø، لذا حين لا توجد كلمات، يعرض المسرح الإيقاع بدلًا من أن يبقى فارغًا.¶
ƒ كلمات3()•عبارة
	عرض•ø ? نوتات() مُغنّى(عرض)

¶النوتة الموسيقية: كل مقطوعة مستعارة، تُعزف بالسرعة التي تُحسب بها كلمات الأغنية. كل نغمة تحمل مدتها وحجم صوتها الخاص، لذا لا شيء هنا يحتاج إلى إيقاع — @Music/tempo وحده يقرر سرعة كل شيء.¶
