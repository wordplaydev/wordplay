🐤
طائر الطنان
=== start/en
¶لعبة طائر يطير بالدندنة! اضغط زرًا أو مفتاحًا ليرفرف الطائر، أو دندن في الميكروفون — يطفو الطائر إلى ارتفاع يوافق طبقة صوت دندنتك. مرّ بين الفجوات الموجودة بين أكوام الرموز التعبيرية. لمس كومة أو لمس الأرض ينهي اللعبة؛ وبعد الاصطدام، يبدأ عدّ تنازلي ثم تبدأ اللعبة من جديد.¶

¶كل حاجز هو كومة من الرموز التعبيرية مأخوذة من إحدى هذه المجموعات.¶
أنواع: [
		['🌵' '🌱' '🌿' '🍀' '🎋']
		['🍩' '🧁' '🍰' '🍪' '🍦']
		['🐙' '🐟' '🦀' '🐡' '🦑']
		['🚗' '🚌' '🚕' '🚙' '🚓']
		['🌸' '🌼' '🌻' '🌷' '💐']
		['⭐' '🌟' '✨' '☁' '🌙']
	]

¶مقدار تحرك الحاجز إلى اليسار في كل نبضة زمنية.¶
سرعة2: 0.2m

¶أي اصطدام بالطائر. سقف اللعبة يُسمّى 'السماء'، فارتطام الطائر به يجعله يرتد بدلًا من أن ينهي اللعبة.¶
تحطم: تصادم('طائر')
قاتل: تحطم•ø ? ⊥ (تحطم.الكائن ≠ 'sky')

نبضة2: الوقت(40ms)
نقطةاللعبة: الوقت(100ms)

¶حالة اللعبة: مرحلة (1 = عدّ تنازلي، 2 = يلعب الآن، 3 = اصطدم) وعدد أعشار الثانية التي قضيناها فيها. نحسب نبضات ساعة واحدة بدلًا من طرح الأوقات، لأن كل Time() يبدأ من الصفر.¶
•لعبة(مرحلة•# دقّات•#)
لعبة2•لعبة: لعبة(1 0) …
	∆ نقطةاللعبة | قاتل …
		لعبة2.مرحلة ???
			1: (لعبة2.دقّات ≥ 36) ? لعبة(2 0) لعبة(
					1
					لعبة2.دقّات + 1
				)
			2: قاتل ? لعبة(3 0) لعبة2
			3: (لعبة2.دقّات ≥ 25) ? لعبة(1 0)
				¶طالما الطائر مستقر على شيء ما، تُبقي الاصطدامات هذا الأثر نشطًا؛ لكن نحسب فقط نبضات الساعة الحقيقية كي تبقى مدة التوقف ثابتة دائمًا.¶
				لعبة(3 لعبة2.دقّات + (∆ نقطةاللعبة ? 1 0))
			لعبة2

¶رقم العدّ التنازلي المطلوب عرضه: 3، 2، 1.¶
عدّ: (لعبة2.دقّات < 12) ? 3 (لعبة2.دقّات < 24) ? 2 1

¶اختر طريقة اللعب بالضغط على زر 🎤 أو ⌨: الدندنة تحرك الطائر، أما النقر أو الضغط على المفاتيح فيجعله يرفرف. الوضعان منفصلان، حتى لا يتعارض الكلام قرب الميكروفون مع استخدام لوحة المفاتيح.¶
مُختار: اختيار()
وضع•'': 'tap' … (مُختار = 'hum') | (مُختار = 'tap') … مُختار

¶في وضع النقر، يرفرف الطائر عند النقر أو الضغط على أي مفتاح.¶
رفرفة: (وضع = 'tap') & (∆ زر() | ∆ مفتاح())

¶في وضع الدندنة، يطفو الطائر إلى ارتفاع يوافق حِدّة دندنتك — النغمات المنخفضة قرب الأرض، والنغمات العالية قرب السماء — ولا يرتفع أكثر من ذلك.¶
طبقةالصوت2: طبقةالصوت()
همهمة: (وضع = 'hum') & (طبقةالصوت2 > 50hz)

ƒ طبقةالصوتإلىالارتفاع(هرتز•#hz)
	(هرتز < 80hz) ? -4m
		(هرتز > 400hz) ? 5m
			-4m + (((هرتز - 80hz) ÷ 320hz) × 9m)

¶يتحرك الطائر نحو الارتفاع المدندَن قليلاً في كل مرة، فينساب بسلاسة بدلاً من أن يهتز مع كل تذبذب في النغمة.¶
موضعطبقةالصوتY•#m: 1m … ∆ طبقةالصوت2 … همهمة ? (0.8 × موضعطبقةالصوتY) + (0.2 × طبقةالصوتإلىالارتفاع(
							طبقةالصوت2
						)) موضعطبقةالصوتY

¶يحوم الطائر أثناء العد التنازلي، ويرفرف صعوداً أو يطفو عند النغمة المدندنة أثناء اللعب، ثم يسقط بفعل الجاذبية بعد الاصطدام.¶
مكانالطائر: الحركة(
		مكان(-4m 1m)
		المكانالتالي:
		(لعبة2.مرحلة = 1) ? مكان(-4m 1m)
			((لعبة2.مرحلة = 2) & همهمة) ? مكان(
					-4m
					موضعطبقةالصوتY
				) ø
		السرعةالتالية:
		(لعبة2.مرحلة = 1) ? سرعة(0m/s 0m/s)
			((لعبة2.مرحلة = 2) & همهمة) ? سرعة(0m/s 0m/s)
				((لعبة2.مرحلة = 2) & رفرفة) ? سرعة(0m/s 15m/s) ø
	)

¶رمز الكتكوت التعبيري يواجه اليسار، لذلك كل وضعية تعكسه ليواجه الاتجاه الذي يتحرك نحوه.¶
طائر: عبارة(
		'🐤'
		1m
		اسم: 'طائر'
		مكان: مكانالطائر
		مادة: مادة(1kg 0.4 0)
		resting:
		(لعبة2.مرحلة = 3) ? Pose(rotation: 180° flipx: ⊤)
			تسلسل(
				{
					0%: Pose(flipx: ⊤ rotation: -12°)
					50%: Pose(flipx: ⊤ rotation: 12°)
					100%: Pose(flipx: ⊤ rotation: -12°)
				}
				0.35s
			)
	)

¶كل حاجز له: موضع أفقي، وعدد الرموز التعبيرية المعلقة من الأعلى، ومجموعة الرموز التعبيرية التي صُنع منها. تتحرك الحواجز نحو اليسار أثناء اللعب، وتلتف إلى اليمين بشكل عشوائي جديد، وتُعاد ضبطها عند بدء لعبة جديدة.¶
•أنبوب(x2•#m أعلى2•# نوع2•#)

أنبوب1•أنبوب: أنبوب(10m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب1.x2 ≠ 10m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(10m عشوائي(1 5) عشوائي(1 6))
			(أنبوب1.x2 < -13m) ? أنبوب(
					أنبوب1.x2 + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب1.x2 - سرعة2 أنبوب1.أعلى2 أنبوب1.نوع2)

أنبوب2•أنبوب: أنبوب(16m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب2.x2 ≠ 16m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(16m عشوائي(1 5) عشوائي(1 6))
			(أنبوب2.x2 < -13m) ? أنبوب(
					أنبوب2.x2 + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب2.x2 - سرعة2 أنبوب2.أعلى2 أنبوب2.نوع2)

أنبوب3•أنبوب: أنبوب(22m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب3.x2 ≠ 22m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(22m عشوائي(1 5) عشوائي(1 6))
			(أنبوب3.x2 < -13m) ? أنبوب(
					أنبوب3.x2 + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب3.x2 - سرعة2 أنبوب3.أعلى2 أنبوب3.نوع2)

أنبوب4•أنبوب: أنبوب(28m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب4.x2 ≠ 28m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(28m عشوائي(1 5) عشوائي(1 6))
			(أنبوب4.x2 < -13m) ? أنبوب(
					أنبوب4.x2 + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب4.x2 - سرعة2 أنبوب4.أعلى2 أنبوب4.نوع2)

¶هل تجاوز حاجز الطائر للتو؟¶
ƒ تمتجاوزه(x3•#m) (x3 ≤ -5m) & (x3 > (-5m - سرعة2))

النتيجة•#: 0 …
	(لعبة2.مرحلة = 1) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? 0
			(تمتجاوزه(أنبوب1.x2) | تمتجاوزه(أنبوب2.x2) | تمتجاوزه(
						أنبوب3.x2
					) | تمتجاوزه(أنبوب4.x2)) ? النتيجة + 1
				النتيجة

¶ابنِ كومة واحدة من الرموز التعبيرية كعمود مادي. مدة الصفر تجعل الالتفاف إلى الجانب الأيمن فوريّاً بدلاً من انزلاق مرئي.¶
ƒ عمود(خلايا•# نوع3•# x4•#m y2•#m)
	مجموعة(
		كومة('|' 0m)
		(خلايا → []).translate(
			ƒ(زنزانة•#) عبارة(
					أنواع[نوع3][1 + ((زنزانة - 1) % 5)]
					1m
				)
		)
		مكان: مكان(x4 y2)
		مادة: مادة()
		مدة: 0s
	)

¶يتكوّن الحاجز من عمودين: واحد معلّق من السماء، وآخر ينمو من الأرض، بينهما فجوة تبلغ نحو 6 أمتار.¶
ƒ أكوام(أنبوب5•أنبوب) [
		عمود(
			أنبوب5.أعلى2
			أنبوب5.نوع2
			أنبوب5.x2
			6m - (أنبوب5.أعلى2 × 1m)
		)
		عمود(6 - أنبوب5.أعلى2 أنبوب5.نوع2 أنبوب5.x2 -6m)
	]

¶الأرض تُسقط الطائر، والسماء ترتدّ به إلى الأسفل.¶
الأرض: شكل(
		مستطيل(-8m -5.7m 8m -6m)
		الخلفية: Color(60% 60 130°)
	)
السماء: شكل(مستطيل(-8m 7m 8m 6m) الاسم: 'sky')
الجدارالأيسر: شكل(مستطيل(-8.4m 6m -8m -6m))
الجدارالأيمن: شكل(مستطيل(8m 6m 8.4m -6m))

عرضالنتيجة: عبارة("\النتيجة\" 1.5m مكان: مكان(-0.5m 4m))
طبقاتفوقية:
	لعبة2.مرحلة ???
		1: [عبارة("\عدّ\" 3m مكان: مكان(-1m -1.5m))]
		3: [عبارة('💥' 3m مكان: مكان(-1.5m -1.5m))]
		[]

¶مبدّل الوضع: الطريقة المختارة للعب تكون مضيئة، والأخرى خافتة.¶
زرالدندنة: عبارة(
		'🎤'
		0.8m
		اسم: 'hum'
		قابلللتحديد: ⊤
		مكان: مكان(-4.2m 4.7m)
		resting: (وضع = 'hum') ? Pose() Pose(opacity: 40%)
	)
زرالنقر: عبارة(
		'⌨'
		0.8m
		اسم: 'tap'
		قابلللتحديد: ⊤
		مكان: مكان(-3m 4.7m)
		resting: (وضع = 'tap') ? Pose() Pose(opacity: 40%)
	)

تعليمات1: عبارة(
		'اختر ⌨ للرفرفة بالنقرات والمفاتيح، أو 🎤 للدندنة لتحديد ارتفاع طائرك!'
		0.45m
		مكان: مكان(-6.9m -4.7m)
	)
تعليمات2: عبارة(
		'مرّ عبر الفجوات. لا تلمس الأكوام!'
		0.4m
		مكان: مكان(-4.5m -5.4m)
	)

¶الرفرفة نفسها هي عملية تقييم واحدة — التفاعل الذي يرفع الطائر يحدث عند النقر أو الضغط على المفتاح فقط، ولا شيء غير ذلك — لذا يمكنها إصدار صوت الجناح مباشرة: نغمة واحدة في اللقطة التي ترفرف فيها، ولا شيء في بقية الوقت. النغمة التي بدأت تُكمل حتى نهايتها، فإفراغ هذه القائمة بعد لقطة واحدة لا يقطع صوت الجناح. في وضع الدندنة لا توجد أي رفرفة على الإطلاق، فتبقى القائمة فارغة ويصمت الطائر بينما تغنّي له.¶
نوتاتالرفرفة: رفرفة ? [3] []

صوتالرفرفة: موسيقى(
		مسار(نوتاتالرفرفة آلة: آلة.طبول مستوىالصوت: 70% حلقة: ⊥)
		إعادةالتشغيل: رفرفة
		اسم: 'رفرفة'
	)

¶عشرون بوابة، من التوتر الخفيف إلى الذعر الشديد. تغيير الإيقاع يندمج عند الضربة التالية بدلاً من البدء من جديد، فكل بوابة تُحكم الحلقة تحتك دون أن تفقد موضعها أبداً — والاصطدام يعيد النتيجة إلى الصفر، مما يعيد كل شيء إلى البداية من جديد.¶
إلحاح: (النتيجة ÷ 20).الأصغر(1)

¶سلّم فريجي للدرجة الثانية الخافضة: نصف نغمة فوق نغمة الأساس، وهي أكثر نغمة مقلقة يمكن الوصول إليها دون الخروج عن السلّم. يعتمد عليها الباص في كل شطر آخر، وتنتهي عبارة آلة السينثيسايزر عندها، فلا تستقر الحلقة أبداً في مكان.¶
أغنيةالقلق: موسيقى(
		[
			مسار(
				[1 ø 1 ø 2 ø 1 ø]
				آلة: آلة.مُركِّبباص
				نبضة: 1beats
				مستوىالصوت: 50%
			)
			مسار(
				[5 ø 4 ø 5 ø 4 2]
				آلة: آلة.مُركِّب
				نبضة: 1beats
				مستوىالصوت: 35%
			)
			مسار(
				[1 3 3 3 2 3 3 3 1 3 3 3 2 3 3 3]
				آلة: آلة.طبول
				نبضة: 0.5beats
				مستوىالصوت: 35%
			)
		]
		إيقاع: (100beats/min + (إلحاح · 100beats/min))
		سلم: موسيقى.فريجي
		اسم: 'قلِق'
	)

¶يستمر العمل طوال العد التنازلي والطيران ويتوقف فجأة عند الاصطدام، لتنفرد 💥 بالمكان لنفسها.¶
قائمةالأغاني: (لعبة2.مرحلة = 3) ? [] [أغنيةالقلق]

¶الاصطدام: صنج، ودمدمة منخفضة، وسلّم القلق ينهار على نفسه من الأعلى — نفس النغمات التي ظلت الأغنية تدور حولها، لتصل أخيراً إلى لا مكان.

هذا لا يحتاج إلى @Music.replay. الوصول إلى المسرح سبب كافٍ لإصدار الصوت، والنغمة التي تُعزف مرة واحدة تصمت بعد انتهائها حتى تغادر؛ العد التنازلي يخرجها من المسرح وينساها، لذا يصدر الاصطدام التالي صوتها من جديد من البداية. تستمر نحو ضربة ونصف، وهو ما يتسع بارتياح ضمن الثانيتين والنصف التي تستغرقها وقفة الاصطدام.¶
صوتالموت: موسيقى(
		[
			مسار(
				[8 7 5 4 2 1 ø ø]
				آلة: آلة.مُركِّب
				نبضة: 0.25beats
				مستوىالصوت: 55%
				حلقة: ⊥
			)
			مسار(
				[4 ø]
				آلة: آلة.طبول
				نبضة: 1beats
				مستوىالصوت: 50%
				حلقة: ⊥
			)
			مسار(
				[1 ø]
				آلة: آلة.مُركِّبباص
				نبضة: 1beats
				مستوىالصوت: 60%
				حلقة: ⊥
			)
		]
		إيقاع: 100beats/min
		سلم: موسيقى.فريجي
		اسم: 'تحطم'
	)

قائمةالموت: (لعبة2.مرحلة = 3) ? [صوتالموت] []

مسرح(
	[
		طائر
		صوتالرفرفة
		:قائمةالأغاني
		:قائمةالموت
		:أكوام(أنبوب1)
		:أكوام(أنبوب2)
		:أكوام(أنبوب3)
		:أكوام(أنبوب4)
		الأرض
		السماء
		الجدارالأيسر
		الجدارالأيمن
		عرضالنتيجة
		:طبقاتفوقية
		زرالدندنة
		زرالنقر
		تعليمات1
		تعليمات2
	]
	مكان: مكان(0m 0m -12m)
	frame: مستطيل(-8m 6m 8m -6m)
	background: Color(90% 20 240°)
)
