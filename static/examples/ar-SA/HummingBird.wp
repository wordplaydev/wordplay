🐤
الطائر الطنان
=== start/en
¶لعبة الطائر الدندن! انقر أو اضغط مفتاحًا ليرفرف الطائر، أو دندن في الميكروفون، فيطفو الطائر إلى ارتفاع درجة صوتك. مرّ عبر الفجوات بين أكوام الرموز التعبيرية. إذا لمست كومة أو الأرض، تتحطم اللعبة. بعد التحطم، يبدأ العدّ التنازلي ثم تبدأ اللعبة من جديد.¶

¶كل حاجز هو كومة من الرموز التعبيرية من إحدى هذه المجموعات.¶
الأنواع: [
		['🌵' '🌱' '🌿' '🍀' '🎋']
		['🍩' '🧁' '🍰' '🍪' '🍦']
		['🐙' '🐟' '🦀' '🐡' '🦑']
		['🚗' '🚌' '🚕' '🚙' '🚓']
		['🌸' '🌼' '🌻' '🌷' '💐']
		['⭐' '🌟' '✨' '☁' '🌙']
	]

¶المسافة التي يتحركها الحاجز إلى اليسار في كل نبضة.¶
سرعة2: 0.2m

¶أي اصطدام بالطائر. اسم السقف «السماء»، لذلك عندما يلمسه الطائر يرتد فقط ولا يتحطم.¶
اصطدام: تصادم('طائر')
قاتل: اصطدام•ø ? ⊥ (اصطدام.الكائن ≠ 'sky')

نبضة2: الوقت(40ms)
نبضةاللعبة: الوقت(100ms)

¶حالة اللعبة: مرحلة (1 = عدّ تنازلي، 2 = لعب، 3 = تحطم) وعدد أعشار الثانية التي قضيناها فيها. نحسب نبضات ساعة واحدة بدل طرح الأوقات، لأن كل Time() يبدأ من الصفر.¶
•لعبة(مرحلة•# نبضات•#)
لعبة2•لعبة: لعبة(1 0) …
	∆ نبضةاللعبة | قاتل …
		لعبة2.مرحلة ???
			1: (لعبة2.نبضات ≥ 36) ? لعبة(2 0) لعبة(
					1
					لعبة2.نبضات + 1
				)
			2: قاتل ? لعبة(3 0) لعبة2
			3: (لعبة2.نبضات ≥ 25) ? لعبة(1 0)
				¶عندما يستقر الطائر على شيء، تبقى التصادمات تشغّل هذا الرد. لذلك نحسب نبضات الساعة الحقيقية فقط، ليكون طول التوقف دائمًا ثابتًا.¶
				لعبة(3 لعبة2.نبضات + (∆ نبضةاللعبة ? 1 0))
			لعبة2

¶رقم العدّ التنازلي الذي يظهر: 3 ثم 2 ثم 1.¶
العدّ: (لعبة2.نبضات < 12) ? 3 (لعبة2.نبضات < 24) ? 2 1

¶اختر طريقة اللعب بالضغط على الزر 🎤 أو ⌨: الدندنة تحرّك الطائر، أو النقرات والمفاتيح تجعله يرفرف. الوضعان منفصلان، فلا يتعارض الكلام قرب الميكروفون مع لوحة المفاتيح.¶
مُختار: اختيار()
الوضع•'': 'tap' … (مُختار = 'hum') | (مُختار = 'tap') … مُختار

¶في وضع النقر، يرفرف الطائر عند النقر أو عند الضغط على أي مفتاح.¶
رفرفة: (الوضع = 'tap') & (∆ زر() | ∆ مفتاح())

¶في وضع الدندنة، يطفو الطائر إلى ارتفاع نغمة دندنتك: النغمات المنخفضة قرب الأرض، والنغمات العالية قرب السماء، ولا يرتفع أكثر من ذلك.¶
درجةالصوت: طبقةالصوت()
دندنة: (الوضع = 'hum') & (درجةالصوت > 50hz)

ƒ مندرجةالصوتإلىالارتفاع(هرتز•#hz)
	هرتز.إعادةالقياس(80hz 400hz -4m 5m).حد(-4m 5m)

¶اقترب من الارتفاع المدندَن شيئًا فشيئًا، حتى ينساب الطائر بدلًا من أن يرتجف مع كل اهتزاز في النغمة.¶
صدرجةالصوت•#m: 1m … ∆ درجةالصوت … دندنة ? صدرجةالصوت.نحو(
				مندرجةالصوتإلىالارتفاع(درجةالصوت)
				20%
			) صدرجةالصوت

¶يحوم الطائر أثناء العد التنازلي، ثم يرفرف للأعلى أو يطفو عند النغمة المدندنة أثناء اللعب، ويسقط بفعل الجاذبية بعد الاصطدام.¶
مكانالطائر: الحركة(
		مكان(-4m 1m)
		المكانالتالي:
		(لعبة2.مرحلة = 1) ? مكان(-4m 1m)
			((لعبة2.مرحلة = 2) & دندنة) ? مكان(-4m صدرجةالصوت) ø
		السرعةالتالية:
		(لعبة2.مرحلة = 1) ? سرعة(0m/s 0m/s)
			((لعبة2.مرحلة = 2) & دندنة) ? سرعة(0m/s 0m/s)
				((لعبة2.مرحلة = 2) & رفرفة) ? سرعة(0m/s 15m/s) ø
	)

¶رمز الكتكوت التعبيري ينظر إلى اليسار، لذلك تقلبه كل وضعية ليواجه الجهة التي يتجه إليها.¶
طائر: عبارة(
		'🐤'
		1m
		اسم: 'طائر'
		مكان: مكانالطائر
		مادة: مادة(1kg 0.4 0)
		سكون:
		(لعبة2.مرحلة = 3) ? Pose(دوران: 180° قلبأفقي)
			تسلسل(
				{
					0%: Pose(قلبأفقي دوران: -12°)
					50%: Pose(قلبأفقي دوران: 12°)
					100%: Pose(قلبأفقي دوران: -12°)
				}
				0.35s
			)
	)

¶لكل حاجز: موضع أفقي، وعدد الرموز التعبيرية المعلّقة من الأعلى، ومجموعة الرموز التي يتكوّن منها. تتحرك الحواجز نحو اليسار أثناء اللعب، ثم تعود من اليمين بشكل عشوائي جديد، وتُعاد ضبطها عند بدء لعبة جديدة.¶
•أنبوب(س•#m أعلى2•# نوع2•#)

أنبوب1•أنبوب: أنبوب(10m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب1.س ≠ 10m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(10m عشوائي(1 5) عشوائي(1 6))
			(أنبوب1.س < -13m) ? أنبوب(
					أنبوب1.س + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب1.س - سرعة2 أنبوب1.أعلى2 أنبوب1.نوع2)

أنبوب2•أنبوب: أنبوب(16m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب2.س ≠ 16m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(16m عشوائي(1 5) عشوائي(1 6))
			(أنبوب2.س < -13m) ? أنبوب(
					أنبوب2.س + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب2.س - سرعة2 أنبوب2.أعلى2 أنبوب2.نوع2)

أنبوب3•أنبوب: أنبوب(22m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب3.س ≠ 22m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(22m عشوائي(1 5) عشوائي(1 6))
			(أنبوب3.س < -13m) ? أنبوب(
					أنبوب3.س + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب3.س - سرعة2 أنبوب3.أعلى2 أنبوب3.نوع2)

أنبوب4•أنبوب: أنبوب(28m عشوائي(1 5) عشوائي(1 6)) …
	((لعبة2.مرحلة = 1) & (أنبوب4.س ≠ 28m)) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? أنبوب(28m عشوائي(1 5) عشوائي(1 6))
			(أنبوب4.س < -13m) ? أنبوب(
					أنبوب4.س + 24m
					عشوائي(1 5)
					عشوائي(1 6)
				)
				أنبوب(أنبوب4.س - سرعة2 أنبوب4.أعلى2 أنبوب4.نوع2)

¶هل تجاوز حاجز الطائر للتو؟¶
ƒ تجاوز(س2•#m) (س2 ≤ -5m) & (س2 > (-5m - سرعة2))

النتيجة•#: 0 …
	(لعبة2.مرحلة = 1) | ((لعبة2.مرحلة = 2) & ∆ نبضة2) …
		(لعبة2.مرحلة = 1) ? 0
			(تجاوز(أنبوب1.س) | تجاوز(أنبوب2.س) | تجاوز(أنبوب3.س) | تجاوز(
						أنبوب4.س
					)) ? النتيجة + 1
				النتيجة

¶ابنِ كومة واحدة من الرموز التعبيرية على شكل عمود. المدة 0ث تجعل العودة إلى الجهة اليمنى فورية بدلًا من انزلاق ظاهر.¶
ƒ عمود(خلايا•# نوع3•# س3•#m ص•#m)
	مجموعة(
		كومة('|' 0m)
		(خلايا → []).ترجم(
			ƒ(زنزانة•#) عبارة(
					الأنواع[نوع3][1 + ((زنزانة - 1) % 5)]
					1m
				)
		)
		مكان: مكان(س3 ص)
		مادة: مادة()
		مدة: 0s
	)

¶الحاجز عمودان: واحد معلّق من السماء، وواحد ينمو من الأرض، وبينهما فجوة طولها نحو 6 أمتار.¶
ƒ أكوام(أنبوب5•أنبوب) [
		عمود(
			أنبوب5.أعلى2
			أنبوب5.نوع2
			أنبوب5.س
			6m - (أنبوب5.أعلى2 × 1m)
		)
		عمود(6 - أنبوب5.أعلى2 أنبوب5.نوع2 أنبوب5.س -6m)
	]

¶الأرض تُحطّم الطائر، أما السماء فتُرجعه إلى الأسفل.¶
الأرض2: شكل(
		مستطيل(-8m -5.7m 8m -6m)
		الخلفية: Color(60% 60 130°)
	)
السماء: شكل(مستطيل(-8m 7m 8m 6m) الاسم: 'sky')
الجدارالأيسر: شكل(مستطيل(-8.4m 6m -8m -6m))
الجدارالأيمن: شكل(مستطيل(8m 6m 8.4m -6m))

عرضالنتيجة: عبارة("\النتيجة\" 1.5m مكان: مكان(-0.5m 4m))
الطبقاتالعلوية:
	لعبة2.مرحلة ???
		1: [عبارة("\العدّ\" 3m مكان: مكان(-1m -1.5m))]
		3: [عبارة('💥' 3m مكان: مكان(-1.5m -1.5m))]
		[]

¶مبدّل الوضع: طريقة اللعب المختارة ساطعة، والأخرى باهتة.¶
زرالدندنة: عبارة(
		'🎤'
		0.8m
		اسم: 'hum'
		قابلللتحديد
		مكان: مكان(-4.2m 4.7m)
		سكون: (الوضع = 'hum') ? Pose() Pose(شفافية: 40%)
	)
زرالنقر: عبارة(
		'⌨'
		0.8m
		اسم: 'tap'
		قابلللتحديد
		مكان: مكان(-3m 4.7m)
		سكون: (الوضع = 'tap') ? Pose() Pose(شفافية: 40%)
	)

التعليمات1: عبارة(
		'اختر ⌨ لترفرف بالنقرات والمفاتيح، أو 🎤 لتتحكم في ارتفاع طائرك بالدندنة!'
		0.45m
		مكان: مكان(-6.9m -4.7m)
	)
التعليمات2: عبارة(
		'مرّ من بين الفجوات. لا تلمس الأعمدة!'
		0.4m
		مكان: مكان(-4.5m -5.4m)
	)

¶الرفرفة هي بالفعل تقييم واحد، فرد الفعل الذي يرفع الطائر يعمل عند النقر أو المفتاح فقط، ولا شيء غيرهما. لذلك يمكنه أن يُصدر صوت الجناح مباشرة: نغمة واحدة في الإطار الذي ترفرف فيه، ولا شيء بقية الوقت. النغمة التي بدأت تُعزف حتى نهايتها، فإفراغ هذه القائمة بعد إطار واحد لا يقطع صوت الجناح. في وضع الدندنة لا توجد رفرفات أبدًا، فتبقى القائمة فارغة ويبقى الطائر صامتًا بينما تغني له.¶
نغماتالرفرفة: رفرفة ? [3] []

صوتالرفرفة: موسيقى(
		مسار(نغماتالرفرفة آلة: آلة.طبول مستوىالصوت: 70% حلقة: ⊥)
		إعادةالتشغيل: رفرفة
		اسم: 'رفرفة'
	)

¶عشرون بوابة، من القلق الخفيف إلى الذعر. تغيير الإيقاع يدخل عند النبضة التالية بدلًا من البدء من جديد، فتشدّ كل بوابة الحلقة من تحتك دون أن تفقد مكانها. وعند الاصطدام تعود النتيجة إلى الصفر، فيهبط الإيقاع كله إلى الأسفل من جديد.¶
الاستعجال: (النتيجة ÷ 20).الأصغر(1)

¶السلّم الفريجي للدرجة الثانية المخفّضة: نصف نغمة فوق نغمة البيت، وهي أكثر نغمة مقلقة يمكن أن تسمعها دون الخروج من السلّم. يتكئ عليها الباص كل مقياس ثانٍ، وتنتهي عندها جملة السينثسايزر، فلا تستقر الحلقة في أي مكان.¶
أغنيةالقلق: موسيقى(
		[
			مسار(
				[1 ø 1 ø 2 ø 1 ø]
				آلة: آلة.مُركِّبباص
				نبضة: 1beats
				مستوىالصوت: 50%
			)
			مسار(
				[5 ø 4 ø 5 ø 4 2]
				آلة: آلة.مُركِّب
				نبضة: 1beats
				مستوىالصوت: 35%
			)
			مسار(
				[1 3 3 3 2 3 3 3 1 3 3 3 2 3 3 3]
				آلة: آلة.طبول
				نبضة: 0.5beats
				مستوىالصوت: 35%
			)
		]
		إيقاع: (100beats/min + (الاستعجال · 100beats/min))
		سلم: موسيقى.فريجي
		اسم: 'قلق'
	)

¶تعمل أثناء العد التنازلي والطيران، وتتوقف فجأة عند الاصطدام، فيبقى المجال كله لـ 💥.¶
قائمةالأغاني: (لعبة2.مرحلة = 3) ? [] [أغنيةالقلق]

¶الاصطدام: صنج، وصوت ارتطام منخفض، والسلّم القلق ينزل بنفسه من الأعلى. هي النغمات نفسها التي كانت الأغنية تدور حولها، وقد أصبحت الآن لا تقود إلى أي مكان.

هذا الصوت لا يحتاج إلى @Music.replay. الوصول إلى المسرح سبب كافٍ ليُصدر الصوت، والصوت الذي يُعزف مرة واحدة ثم ينتهي يبقى صامتًا حتى يغادر المسرح. العد التنازلي يُخرجه من المسرح وينساه، فيُعزف الاصطدام التالي من البداية. تستمر مدته نحو نبضة ونصف، أي ضمن الثانيتين والنصف التي يستغرقها توقف الاصطدام.¶
صوتالموت: موسيقى(
		[
			مسار(
				[8 7 5 4 2 1 ø ø]
				آلة: آلة.مُركِّب
				نبضة: 0.25beats
				مستوىالصوت: 55%
				حلقة: ⊥
			)
			مسار(
				[4 ø]
				آلة: آلة.طبول
				نبضة: 1beats
				مستوىالصوت: 50%
				حلقة: ⊥
			)
			مسار(
				[1 ø]
				آلة: آلة.مُركِّبباص
				نبضة: 1beats
				مستوىالصوت: 60%
				حلقة: ⊥
			)
		]
		إيقاع: 100beats/min
		سلم: موسيقى.فريجي
		اسم: 'اصطدام'
	)

قائمةالموت: (لعبة2.مرحلة = 3) ? [صوتالموت] []

مسرح(
	[
		طائر
		صوتالرفرفة
		:قائمةالأغاني
		:قائمةالموت
		:أكوام(أنبوب1)
		:أكوام(أنبوب2)
		:أكوام(أنبوب3)
		:أكوام(أنبوب4)
		الأرض2
		السماء
		الجدارالأيسر
		الجدارالأيمن
		عرضالنتيجة
		:الطبقاتالعلوية
		زرالدندنة
		زرالنقر
		التعليمات1
		التعليمات2
	]
	مكان: مكان(0m 0m -12m)
	إطار: مستطيل(-8m 6m 8m -6m)
	خلفية: Color(90% 20 240°)
)
