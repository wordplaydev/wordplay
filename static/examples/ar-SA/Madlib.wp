4
القصة الناقصة
=== start
¶قصة مضحكة: أعطِ الكلمات، واحصل على قصة طريفة.¶

¶هذا يتتبّع أنواع الكلمات التي نحتاجها، وعددها¶
•نوعالكلمة(وسم•"" عدّ•#)

¶هذه هي الكلمات التي نحتاجها للقصة المضحكة أدناه.¶
أدوار: [
		نوعالكلمة('صفات' 4)
		نوعالكلمة('أسماء' 3)
		نوعالكلمة('أفعال، الزمن الماضي' 3)
		نوعالكلمة('ظروف' 4)
	]

محادثة: الدردشة()
¶كل مرة تُرسَل فيها محادثة، ننتقل إلى نوع الكلمة التالي¶
دور: 1 … ∆ محادثة … دور + 1
¶كل مرة تُرسَل فيها محادثة، نقسّمها عند الفراغات ونضيفها إلى الردود¶
ردود•[['']]: [] … ∆ محادثة … [:ردود محادثة ÷ ' ']

¶نعطي هذه الفهارس أرقامًا لتسهيل قراءة القصة المضحكة¶
صفات: 1
أسماء: 2
ظروف: 4
أفعال: 3

اسأل: ردود.الطول() < 4

مسرح(
	[
		¶قبل أن تصلنا الردود، نطلب الردود¶
		اسأل ?
			مجموعة(
				كومة('|' 0.25m)
				[
					عبارة(`\أدوار[دور].عدّ\ \أدوار[دور].وسم\ رجاءً!`)
					عبارة('(مفصولة بفراغات)' 0.5m)
				]
			)
			¶بعد أن تصلنا الردود، نعرض القصة المضحكة¶
			(
				¶اصنع قائمة جمل باستخدام الردود¶
				جُمل: [
						`اليوم ذهبتُ إلى حديقة الحيوان.`
						`رأيتُ *\ردود[أسماء][1]\* *\ردود[ظروف][1]\* يقفز صعودًا وهبوطًا في شجرته.`
						`هو *\ردود[أفعال][1]\* *\ردود[ظروف][2]\* عبر النفق الكبير الذي أدى إلى *\ردود[صفات][2]\* *\ردود[أسماء][2]\*.`
						`أحضرت بعض الفول السوداني ومررته عبر القفص إلى * رمادي ضخم\ردود[أسماء][3]\* يرتفع فوق رأسي.`
						`إطعام ذلك الحيوان جعلني جائعًا.`
						`ذهبت لأحضر *\ردود[صفات][3]\* مغرفة من الآيس كريم.`
						`لقد ملأت معدتي.`
						`بعد ذلك *\ردود[أفعال][2]\* *\ردود[ظروف][2]\* للحاق بحافلتنا.`
						`عندما وصلت إلى البيت *\ردود[أفعال][3]\* أمي من أجل يوم *\ردود[صفات][4]\* في حديقة الحيوان.`
					]
				¶ترجمها إلى عبارات¶
				مجموعة(كومة('<') جُمل.translate(ƒ(جملة) عبارة(جملة)))
			)
	]
	face: 'Phudu'
)