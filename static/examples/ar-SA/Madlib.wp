4
املأ الفراغات
=== start
¶لعبة الكلمات الناقصة: أعطِ الكلمات واحصل على قصة مضحكة.¶

¶هذا يتتبّع أنواع الكلمات التي نحتاجها وعددها¶
•نوعالكلمة(تسمية•"" العدّ•#)

¶هذه هي الكلمات التي نحتاجها للقصة الناقصة أدناه.¶
الأدوار: [
		نوعالكلمة('الصفات' 4)
		نوعالكلمة('الأسماء' 3)
		نوعالكلمة('الأفعال في الزمن الماضي' 3)
		نوعالكلمة('الظروف' 4)
	]

الدردشة2: الدردشة()
¶في كل مرة تُرسَل فيها دردشة، انتقل إلى نوع الكلمة التالي¶
الدور: 1 … ∆ الدردشة2 … الدور + 1
¶في كل مرة تُرسَل فيها دردشة، قسّم الدردشة عند المسافات وأضفها إلى الردود¶
الردود•[['']]: [] … ∆ الدردشة2 … [:الردود الدردشة2 ÷ ' ']

¶نعطي هذه الفهارس أرقامًا لتسهيل قراءة القصة الناقصة¶
الصفات: 1
الأسماء: 2
الظروف: 4
الأفعال: 3

اسأل: الردود.الطول() < 4

مسرح(
	[
		¶قبل أن تكون لدينا الردود، اطلب الردود¶
		اسأل ?
			مجموعة(
				كومة('|' 0.25m)
				[
					عبارة(
						`\الأدوار[الدور].العدّ\ \الأدوار[الدور].تسمية\ من فضلك!`
					)
					عبارة('(مفصولة بمسافات)' 0.5m)
				]
			)
			¶بعد أن تصبح لدينا الردود، اعرض القصة الناقصة¶
			(
				¶اصنع قائمة من الجمل باستخدام الردود¶
				جمل: [
						`ذهبت اليوم إلى حديقة الحيوانات.`
						`رأيت *\الردود[الأسماء][1]\* *\الردود[الظروف][1]\* يقفز صعودًا وهبوطًا في شجرته.`
						`لقد *\الردود[الأفعال][1]\* *\الردود[الظروف][2]\* عبر النفق الكبير الذي يؤدي إلى *\الردود[الصفات][2]\* *\الردود[الأسماء][2]\* الخاص به.`
						`أخذت بعض الفول السوداني ومررته عبر القفص إلى *\الردود[الأسماء][3]\* رمادي ضخم يرتفع فوق رأسي.`
						`إطعام ذلك الحيوان جعلني أشعر بالجوع.`
						`ذهبتُ لأشتري كرة آيس كريم *\الردود[الصفات][3]\*.`
						`لقد ملأت معدتي.`
						`بعد ذلك *\الردود[الأفعال][2]\* *\الردود[الظروف][2]\* لألحق بالحافلة.`
						`عندما وصلتُ إلى البيت *\الردود[الأفعال][3]\* أمي على يوم *\الردود[الصفات][4]\* في حديقة الحيوان.`
					]
				¶ترجمها إلى عبارات¶
				مجموعة(كومة('<') جمل.ترجم(ƒ(جملة) عبارة(جملة)))
			)
	]
	وجه: 'Phudu'
)