↑
متاهة
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•متاهة() (
	شبكة2•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ زنزانة(صف2•# عمود•#) (
			خلايا: شبكة2[صف2]
			خلايا•[] ? خلايا[عمود] ø
		)

	ƒ مسموح(صف3•# عمود2•#) زنزانة(صف3 عمود2)•''
)

متاهة2: متاهة()

•حالة(صف4•# عمود3•# خطوات•#)
(
	ƒ أسفل2() حالة(صف4 + 1 عمود3 خطوات + 1)
	ƒ أعلى2() حالة(صف4 - 1 عمود3 خطوات + 1)
	ƒ يسار2() حالة(صف4 عمود3 - 1 خطوات + 1)
	ƒ يمين2() حالة(صف4 عمود3 + 1 خطوات + 1)
)

ƒ مسموح2(حالة2•حالة صف5•# عمود4•#) متاهة2.مسموح(
		حالة2.صف4 + صف5
		حالة2.عمود3 + عمود4
	)

اتجاه2: اختيار()
حالة3•حالة: حالة(1 1 0) … ∆ اتجاه2 …
		((اتجاه2 = "left") & مسموح2(حالة3 0 -1)) ? حالة3.يسار2(
			)
			((اتجاه2 = "right") & مسموح2(حالة3 0 1)) ? حالة3.يمين2(
				)
				((اتجاه2 = "up") & مسموح2(حالة3 -1 0)) ? حالة3.أعلى2(
					)
					((اتجاه2 = "down") & مسموح2(حالة3 1 0)) ? حالة3.أسفل2(
						)
						حالة3

الحالي: (
		زنزانة2: متاهة2.زنزانة(حالة3.صف4 حالة3.عمود3)
		زنزانة2 ?? ' ')
أعلى3: متاهة2.زنزانة(حالة3.صف4 - 1 حالة3.عمود3)•''
أسفل3: متاهة2.زنزانة(حالة3.صف4 + 1 حالة3.عمود3)•''
يسار3: متاهة2.زنزانة(حالة3.صف4 حالة3.عمود3 - 1)•''
يمين3: متاهة2.زنزانة(حالة3.صف4 حالة3.عمود3 + 1)•''
فاز: الحالي = '🤩'

مسرح(
	[
		مجموعة(
			شبكة(3 3 0.25m)
			[
				ø
				عبارة(
					'↑'
					اسم: 'up'
					قابلللتحديد: أعلى3
					resting: Pose(opacity: أعلى3 ? 1 0.2)
				)
				ø
				عبارة(
					'←'
					اسم: 'left'
					قابلللتحديد: يسار3
					resting: Pose(opacity: يسار3 ? 1 0.2)
				)
				عبارة(
					الحالي
					resting: فاز ?
						تسلسل.spin(duration: 1s style: 'straight')
						Pose()
				)
				عبارة(
					'→'
					اسم: 'right'
					قابلللتحديد: يمين3
					resting: Pose(opacity: يمين3 ? 1 0.2)
				)
				ø
				عبارة(
					'↓'
					اسم: 'down'
					قابلللتحديد: أسفل3
					resting: Pose(opacity: أسفل3 ? 1 0.2)
				)
				ø
			]
		)
	]
	مكان: مكان(0m 0m -3m)
	face: 'Noto Emoji'
	background: Color(0 0 0°)
	resting: Pose(Color(100 100 0°))
)