متاهة
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en

•متاهة() (
	الشبكة•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ زنزانة(صف2•# عمود•#) (
			خلايا: الشبكة[صف2]
			خلايا•[] ? خلايا[عمود] ø
		)

	ƒ مسموح(صف3•# عمود2•#) زنزانة(صف3 عمود2)•''
)

متاهة2: متاهة()

•الحالة(صف4•# عمود3•# خطوات•#)
(
	ƒ للأسفل() الحالة(صف4 + 1 عمود3 خطوات + 1)
	ƒ للأعلى() الحالة(صف4 - 1 عمود3 خطوات + 1)
	ƒ لليسار() الحالة(صف4 عمود3 - 1 خطوات + 1)
	ƒ لليمين() الحالة(صف4 عمود3 + 1 خطوات + 1)
)

ƒ مسموح2(state•الحالة صف5•# عمود4•#) متاهة2.مسموح(
		state.صف4 + صف5
		state.عمود3 + عمود4
	)

الاتجاه2: اختيار()
state2•الحالة: الحالة(1 1 0) … ∆ الاتجاه2 …
		((الاتجاه2 = "left") & مسموح2(state2 0 -1)) ? state2.لليسار(
			)
			((الاتجاه2 = "right") & مسموح2(state2 0 1)) ? state2.لليمين(
				)
				((الاتجاه2 = "up") & مسموح2(state2 -1 0)) ? state2.للأعلى(
					)
					((الاتجاه2 = "down") & مسموح2(state2 1 0)) ? state2.للأسفل(
						)
						state2

الحالي: (
		زنزانة2: متاهة2.زنزانة(state2.صف4 state2.عمود3)
		زنزانة2 ?? ' ')
للأعلى2: متاهة2.زنزانة(state2.صف4 - 1 state2.عمود3)•''
للأسفل2: متاهة2.زنزانة(state2.صف4 + 1 state2.عمود3)•''
لليسار2: متاهة2.زنزانة(state2.صف4 state2.عمود3 - 1)•''
لليمين2: متاهة2.زنزانة(state2.صف4 state2.عمود3 + 1)•''
فاز: الحالي = '🤩'

مسرح(
	[
		مجموعة(
			شبكة(3 3 0.25m)
			[
				ø
				عبارة(
					'↑'
					اسم: 'up'
					قابلللتحديد: للأعلى2
					سكون: Pose(شفافية: للأعلى2 ? 1 0.2)
				)
				ø
				عبارة(
					'←'
					اسم: 'left'
					قابلللتحديد: لليسار2
					سكون: Pose(شفافية: لليسار2 ? 1 0.2)
				)
				عبارة(
					الحالي
					سكون: فاز ?
						تسلسل.spin(duration: 1s نمط: 'straight')
						Pose()
				)
				عبارة(
					'→'
					اسم: 'right'
					قابلللتحديد: لليمين2
					سكون: Pose(شفافية: لليمين2 ? 1 0.2)
				)
				ø
				عبارة(
					'↓'
					اسم: 'down'
					قابلللتحديد: للأسفل2
					سكون: Pose(شفافية: للأسفل2 ? 1 0.2)
				)
				ø
			]
		)
	]
	مكان: مكان(0m 0m -3m)
	وجه: 'Noto Emoji'
	خلفية: Color(0 0 0°)
	سكون: Pose(Color(100 100 0°))
)