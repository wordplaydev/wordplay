قصيدة
=== start
¶قصيدة تنساب أسطرها إلى المسرح، وكل سطر يدخل بطريقته الخاصة.¶

•سطر(نص2•"" وضعية•Pose|تسلسل الخلف: Color(100 100 100°) الأمام: Color(
			0
			0
			0°
		))

¶قائمة بأسطر القصيدة، ولكل سطر وضعية.¶
قصيدة: [
		سطر('ملف الحاسوب' Pose(شفافية: 0% إزاحة: مكان(y: -5m)))
		سطر('الذي' Pose(شفافية: 0% إزاحة: مكان(y: -5m)))
		سطر('لا أتذكره أبدًا' Pose(دوران: 10°))
		سطر(
			'أنقر عليه لأفتحه'
			تسلسل(
				{
					0%: Pose(مقياس: 1)
					50%: Pose(مقياس: 0.7)
					100%: Pose(مقياس: 1)
				}
				0.25s
			)
		)
		سطر('انظر' Pose(شفافية: 0% إزاحة: مكان(y: -5m)))
		سطر(
			'أمرّر الصفحة إلى الأسفل أكثر'
			Pose(شفافية: 0% إزاحة: مكان(y: 5m))
		)
		سطر('الشاشة' Pose(شفافية: 0% إزاحة: مكان(y: -5m)))
		سطر(
			'تبقى مضاءة من الخلف وفارغة'
			Pose(شفافية: 0% إزاحة: مكان(y: -5m))
			Color(0 0 0°)
			Color(100 100 0°)
		)
		سطر(
			'وهكذا ألتقي بنفسي من جديد'
			Pose(شفافية: 0% إزاحة: مكان(y: -5m))
		)
		سطر(
			'مليئًا بالأمل وبلا فائدة'
			Pose(شفافية: 0% إزاحة: مكان(y: -5m))
		)
		سطر('لغز' Pose(شفافية: 0% إزاحة: مكان(y: -5m)))
		سطر(
			'تمامًا كما فعلت من قبل'
			Pose(شفافية: 0% إزاحة: مكان(y: -5m))
		)
		سطر('في 19 أغسطس 2010، الساعة 11:08 صباحًا' Pose())
	]

رقم4: 1 … ∆ زر() | ∆ مفتاح() …
		(رقم4 = (قصيدة.الطول() + 1)) ? 1 رقم4 + 1
سطر2: قصيدة[رقم4]

رقم4 ≤ قصيدة.الطول() ?
	مسرح(
		[
			عبارة(
				سطر2.نص2
				دخول: سطر2.وضعية
				مدة: 1s
				اسم: رقم4 → ""
				نمط: 'cautious'
			)
		]
		خلفية: سطر2.الخلف
		سكون: Pose(لون: سطر2.الأمام)
	)
	مسرح(
		[
			مجموعة(
				كومة()
				[عبارة('نصيحة لنفسي') عبارة('جين هيرشفيلد')]
				دخول: Pose(مقياس: 0.75)
			)
		]
		خلفية: Color(0% 0 0°)
		لون: Color(100% 100 0°)
	)