T
قصيدة
=== start
¶قصيدة أبياتها تنساب واحدًا تلو الآخر، ولكل بيت دخوله الخاص.¶
•سطر(نص2•"" وضعية•Pose|تسلسل خلف: Color(100 100 100°) أمام: Color(
			0
			0
			0°
		))

¶قائمة بأبيات القصيدة، لكل منها وضعية.¶
قصيدة: [
		سطر(
			'ملف الحاسوب'
			Pose(opacity: 0% offset: مكان(y: -5m))
		)
		سطر('الذي' Pose(opacity: 0% offset: مكان(y: -5m)))
		سطر('لا أتذكره أبدًا' Pose(rotation: 10°))
		سطر(
			'أنقر عليه ليُفتح'
			تسلسل(
				{
					0%: Pose(scale: 1)
					50%: Pose(scale: 0.7)
					100%: Pose(scale: 1)
				}
				0.25s
			)
		)
		سطر('أنظر' Pose(opacity: 0% offset: مكان(y: -5m)))
		سطر(
			'أُنزّل النظر أكثر'
			Pose(opacity: 0% offset: مكان(y: 5m))
		)
		سطر('الشاشة' Pose(opacity: 0% offset: مكان(y: -5m)))
		سطر(
			'تبقى مضاءة من الخلف وفارغة'
			Pose(opacity: 0% offset: مكان(y: -5m))
			Color(0 0 0°)
			Color(100 100 0°)
		)
		سطر(
			'فألتقي بنفسي من جديد'
			Pose(opacity: 0% offset: مكان(y: -5m))
		)
		سطر(
			'مليئة بالأمل وعديمة الجدوى'
			Pose(opacity: 0% offset: مكان(y: -5m))
		)
		سطر('لغزًا' Pose(opacity: 0% offset: مكان(y: -5m)))
		سطر(
			'تمامًا كما لا بد أنني فعلت'
			Pose(opacity: 0% offset: مكان(y: -5m))
		)
		سطر('في 19 أغسطس 2010، الساعة 11:08 صباحًا' Pose())
	]

رقم2: 1 … ∆ زر() | ∆ مفتاح() …
		(رقم2 = (قصيدة.الطول() + 1)) ? 1 رقم2 + 1
سطر2: قصيدة[رقم2]

رقم2 ≤ قصيدة.الطول() ?
	مسرح(
		[
			عبارة(
				سطر2.نص2
				entering: سطر2.وضعية
				مدة: 1s
				اسم: رقم2 → ""
				نمط: 'cautious'
			)
		]
		background: سطر2.خلف
		resting: Pose(color: سطر2.أمام)
	)
	مسرح(
		[
			مجموعة(
				كومة()
				[عبارة('نصيحة لنفسي') عبارة('جين هيرشفيلد')]
				entering: Pose(scale: 0.75)
			)
		]
		background: Color(0% 0 0°)
		color: Color(100% 100 0°)
	)