		مستطيل(-8m 7m 8m 6.8m)
		الخلفية: Color(88% 5 130°)
	)
أسفلالجدار: شكل(
		مستطيل(-8m -6.8m 8m -7m)
		الخلفية: Color(88% 5 130°)
	)
يمينالجدار: شكل(
		مستطيل(7.8m 7m 8m -7m)
		الخلفية: Color(88% 5 130°)
	)

¶تصدٍّ: يقفز الرقم قليلًا إلى الأعلى ويبقى هناك لحظة قبل أن يستقر.¶
مرونةالتصدي: تسلسل(
		{
			0%: Pose(مقياس: 1)
			30%: Pose(مقياس: 1.5 إزاحة: مكان(0m 0.4m))
			65%: Pose(مقياس: 1.35 إزاحة: مكان(0m 0.25m))
			100%: Pose(مقياس: 1)
		}
		0.5s
	)

¶هدف: ينتفخ الرقم حتى يملأ الشاشة ويهتز، حتى لا تفوتك أبدًا تسديدة تمرّ من بجانبك.¶
اهتزازالهدف: تسلسل(
		{
			0%: Pose(مقياس: 1)
			8%: Pose(مقياس: 3.6 دوران: -10°)
			24%: Pose(مقياس: 3.6 دوران: 10° إزاحة: مكان(0.4m 0m))
			40%: Pose(
				مقياس: 3.6
				دوران: -10°
				إزاحة: مكان(-0.4m 0m)
			)
			56%: Pose(مقياس: 3.6 دوران: 8° إزاحة: مكان(0.3m 0m))
			72%: Pose(مقياس: 3.4 دوران: -6°)
			100%: Pose(مقياس: 1)
		}
		1s
	)

¶عدد التسديدات التي تم صدّها. يحمل اسمه رقم التمريرة، لذلك تمنحه كل تسديدة هوية جديدة وتُعاد حركته، أما الرقم الذي لا يتغير اسمه فيتحرك مرة واحدة ثم يبقى ساكنًا.¶
عرضالنتيجة: عبارة(
		"🧤 \جولة2.كتل\"
		1.4m
		اسم: "score\جولة2.إرسالات\"
		مكان: مكان(-1.4m 4m)
		مدة: 0.2s
		دخول: جولة2.الأخيرة ???
			1: مرونةالتصدي
			2: اهتزازالهدف
			Pose()
	)

¶تظهر التعليمات على الملعب لا في الطبقة العلوية، لأن الحافة السفلية للطبقة العلوية هي المكان الذي يظهر فيه عرض الموسيقى، وأي نص هناك سيُرسم فوقه.¶
التعليمات: عبارة(
		'اضغط ⬆ ⬇ لتحريك قفازك — وصُدّ كل تسديدة!'
		0.55m
		مكان: مكان(-6.4m -6.4m)
	)

¶ثلاثة أصوات: الركلة، والصدّ، والشبكة. يظهر كل صوت على المسرح طوال مدة المرحلة التي تسببه، ثم يُزال بعدها. يكفي أن يصل الصوت إلى المسرح حتى يُسمع. أما الصوت الذي يُشغَّل مرة واحدة وانتهى فيبقى صامتًا حتى يغادر المسرح ثم يعود. لذلك لا يحتاج أي صوت منها إلى @Music.replay، ولا يُسمع أي منها عند بدء البرنامج.

كتابتها بهذه الطريقة تقول شيئًا لا تقوله النغمات وحدها: كل صوت ينتمي إلى مرحلة من الجولة، ويستمر بقدر ما تستمر تلك المرحلة. أما @Music.replay فهي الطريقة الأخرى للكتابة، وتُستخدم لصوت يستجيب للحظة واحدة، لا لفترة ممتدة.¶
