بقع: بقعجديدة() … ∆ (الاسم2) … (الاسم2 = 'ResetButton') ? بقعجديدة(
			) بقع


مسرح(
	[
		عبارة(
			"🔁"
			قابلللتحديد
			مكان: مكان(4m -0.5m)
			سكون: تمالإمساك ? Pose(دوران: 180°) Pose()
			مدة: 0.5s
			اسم: 'ResetButton'
		)
		عبارة(
			'ابحث عن القميص البرتقالي'
			0.2m
			مكان: مكان(-6.2m 0.75m)
			شكل: 'Carter One'
		)
		عبارة(
			'الرجل (اسمه والدو) و'
			0.2m
			مكان: مكان(-6.4m 0.25m)
			شكل: 'Carter One'
		)
		عبارة(
			'انقر عليه لتفوز!🧍🏻'
			0.2m
			مكان: مكان(-6.0m -0.25m)
			شكل: 'Carter One'
		)
		عبارة(
			'النتيجة: ' + النتيجة → ''
			0.5m
			مكان: مكان(-5.9m -1m)
		)

		عبارة("🏀" مكان: بقع[1])
		عبارة("🦧" مكان: بقع[2])
		عبارة("🍊" مكان: بقع[3])
		عبارة("👻" مكان: بقع[4])
		عبارة("🤖" مكان: بقع[5])
		عبارة("👽" مكان: بقع[6])
		عبارة("🐀" مكان: بقع[7])
		عبارة("🦣" مكان: بقع[8])
		عبارة("🐸" مكان: بقع[9])
		عبارة("🍎" مكان: بقع[10])
		عبارة("💧" مكان: بقع[11])
		عبارة("🍔" مكان: بقع[12])
		عبارة("❤" مكان: بقع[13])
		عبارة("🍥" مكان: بقع[14])
		عبارة(
			"🧍🏻"
			قابلللتحديد: ~تمالإمساك
			مكان: بقع[15]
			سكون: تمالإمساك ? Pose(دوران: 180°) Pose()
			مدة: 0s
			اسم: 'Waldough'
		)
		عبارة("🔥" مكان: بقع[16])
		عبارة("🎂" مكان: بقع[17])
		عبارة("🐕" مكان: بقع[18])
		عبارة("🦈" مكان: بقع[19])
		شكل(مستطيل(-3.5m -3m 3.5m -3.5m))
		شكل(مستطيل(-3.5m 3.5m 3.5m 3m))
		شكل(مستطيل(-3.5m 3.5m -3m -3.5m))
		شكل(مستطيل(3m 3.5m 3.5m -3.5m))
	]
	مكان: مكان(0m 0m -5m)
