			(لعبة5.النتيجة + عددالمحوَّلين)
			الزومبيالتالي
		)
	)

مفتاح4: مفتاح()
نبضة2: الوقت(30ms)
المؤشر: مؤشر()
نقر: زر()

¶نبض اللعبة، ويحركه أربعة مدخلات: نبضة ساعة، ومفتاح، وحركة المؤشر، ونقرة أو لمسة. أثناء اللعب، تُحرّك النبضة العالم، وتجعل المفاتيح اللاعب يتحرك جانبيًا ويرمي، وتصوّب حركة المؤشر مسارك، وتجعلك اللمسة ترمي قلبًا. من القائمة، يبدأ مفتاح /Enter/ أو لمسة جولة جديدة. اللمسة ليبدأ لاعبو اللمس، و/Enter/ وليس /Space/ حتى لا تبدأ الجولة من جديد بالخطأ عند الضغط المتكرر على /Space/ للرمي.¶
لعبة6•لعبة: لعبة(
		1
		0m
		عمقالقائمة
		⊥
		0m
		0m
		0m
		0
		إظهارالزومبي()
	)
	… (∆ نبضة2 | ∆ مفتاح4 | ∆ المؤشر | ∆ نقر) …
		(لعبة6.مرحلة = 2)
		? (∆ نبضة2 ? تقدّمالعالم(لعبة6)
					(∆ مفتاح4 ? تطبيقضغطةالمفتاح(لعبة6 مفتاح4)
							(∆ المؤشر ? التركيزنحو(لعبة6 المؤشر.x) رميالقلب(
										لعبة6
									))))
			(∆ نبضة2 ? لعبة6
					(∆ مفتاح4 ? ((مفتاح4 = 'Enter') ? لعبةجديدة() لعبة6)
							(∆ نقر ? لعبةجديدة() لعبة6)))

¶شخصية واحدة على المسرح: يتمايل الزومبي، ويقفز الأشخاص المتحوّلون قفزة صغيرة سعيدة. أما العمق فيفعل الباقي، فالزومبي المهاجم يبدو أكبر كلما اقترب. تجعل المدة 0 ثانية كل خطوة تصل فورًا بدل أن تتباطأ، فتبدو الحركة إطارات سلسة وليست لحاقًا متأخرًا.¶
ƒ عرضالزومبي(زومبي11•زومبي)
	عبارة(
		زومبي11.الشكل
		2m
		مدة: 0s
		مكان: مكان(زومبي11.س 0m زومبي11.ع)
		سكون: زومبي11.حي
		? تسلسل.sway(4° 1s "zippy")
			تسلسل(
				{
					0%: Pose(مقياس: 1)
					50%: Pose(مقياس: 1.2)
					100%: Pose(مقياس: 1)
				}
				0.6s
			)
	)

¶الأرضية: أشرطة على أعماق متزايدة يقرؤها المنظور كأرض تتراجع نحو الأفق، وتتلاشى من الأخضر إلى الأزرق المخضر لتعطي جوًا. الشريط الأول هو الخط الذي يجب أن يعبره الزومبي لينهي اللعبة، ورُسم بالأحمر للتحذير ليكون القانون واضحًا: تُبعد الكاميرا على الشاشات الصغيرة ويستطيع المشاهد التصغير، والزومبي الذي يبدو بعيدًا يقف على هذا الخط حين يصل إليك.¶
أرض: [
		عبارة(
			"▬▬▬▬▬▬▬▬▬▬"
