🙂
وجه
===
¶رمز تعبيري يعكس وجهك عندما تبتسم، تعبس، تفتح فمك، أو تغمز.¶
وجه2: وجه()

مسرح(
	[
		عبارة(
			(وجه2.الفمُمفتوح ? '😮'
					وجه2.يبتسم ? '😀'
						وجه2.يعبس ? '🙁'
							وجه2.الحاجبانمرفوعان ? '😲'
								(وجه2.العينانمفتوحتان ? '🙂' '😑'))
			مكان: وجه2.مكان
			حجم: 4m
		)
		مجموعة(
			كومة('|')
			[
				عبارة((وجه2.العينانمفتوحتان ? '👀' '😑') حجم: 1.5m)
				عبارة('😊' حجم: (وجه2.مقدارالابتسامة · 2m) + 0.5m)
				عبارة('👄' حجم: (وجه2.مقدارفتحالفم · 2m) + 0.5m)
				عبارة('🤨' حجم: (وجه2.مقداررفعالحاجب · 2m) + 0.5m)
			]
			مكان: مكان(-9m 8m)
		)
		عبارة(
			'استدارة 🧭'
			مكان: مكان(9m 8m 0m)
			حجم: 2m
			دوران: وجه2.دوران
		)
		عبارة(
			'إمالة 🧭'
			مكان: مكان(9m 2m)
			دوران: وجه2.إمالة
			حجم: 2m
		)
		عبارة(
			`/أظهر وجهك للكاميرا/`
			مكان: مكان(-6m -12m)
			حجم: 1m
		)
	]
	مكان: مكان(0m 0m -20m)
)