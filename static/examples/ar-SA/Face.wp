🙂
الشكل
===
¶رمز تعبيري يقلّد وجهك عندما تبتسم وتعبس وتفتح فمك وترمش.¶

الشكل: وجه()

مسرح(
	[
		عبارة(
			(الشكل.الفمُمفتوح ? '😮'
					الشكل.يبتسم ? '😀'
						الشكل.يعبس ? '🙁'
							الشكل.الحاجبانمرفوعان ? '😲'
								(الشكل.العينانمفتوحتان ? '🙂' '😑'))
			مكان: الشكل.مكان
			حجم: 4m
		)
		مجموعة(
			كومة('|')
			[
				عبارة((الشكل.العينانمفتوحتان ? '👀' '😑') حجم: 1.5m)
				عبارة('😊' حجم: (الشكل.مقدارالابتسامة · 2m) + 0.5m)
				عبارة('👄' حجم: (الشكل.مقدارفتحالفم · 2m) + 0.5m)
				عبارة('🤨' حجم: (الشكل.مقداررفعالحاجب · 2m) + 0.5m)
			]
			مكان: مكان(-9m 8m)
		)
		عبارة(
			'الدوران 🧭'
			مكان: مكان(9m 8m 0m)
			حجم: 2m
			دوران: الشكل.دوران
		)
		عبارة(
			'الإمالة 🧭'
			مكان: مكان(9m 2m)
			دوران: الشكل.إمالة
			حجم: 2m
		)
		عبارة(
			`/أظهر وجهك للكاميرا/`
			مكان: مكان(-6m -12m)
			حجم: 1m
		)
	]
	مكان: مكان(0m 0m -20m)
)