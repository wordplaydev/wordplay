s
تدرّج التسلسل
===
¶نفس حركة السيارة بثماني طرق، طريقة واحدة لكل نمط تسارع.¶
الإطاراتالرئيسية: {
		0%: Pose(offset: مكان(-1m 0m))
		25%: Pose(offset: مكان(1m 0m))
		50%: Pose(offset: مكان(1m 0m))
		75%: Pose(offset: مكان(-1m 0m))
		100%: Pose(offset: مكان(-1m 0m))
	}

مسرح(
	[
		مجموعة(
			شبكة(4 2 حشوالخلية: 0.25m)
			[
				عبارة('مستقيم' حجم: 0.25m)
				عبارة(
					"🚗"
					resting: تسلسل(
						الإطاراتالرئيسية
						3s
						style: "straight"
					)
				)
				عبارة('حذر' حجم: 0.25m)
				عبارة(
					"🚚"
					resting: تسلسل(
						الإطاراتالرئيسية
						3s
						style: "cautious"
					)
				)
				عبارة('بطيء' حجم: 0.25m)
				عبارة(
					"🚙"
					resting: تسلسل(
						الإطاراتالرئيسية
						3s
						style: "pokey"
					)
				)
				عبارة('سريع' حجم: 0.25m)
				عبارة(
					"🏎"
					resting: تسلسل(
						الإطاراتالرئيسية
						3s
						style: "zippy"
					)
				)
			]
		)
	]
)