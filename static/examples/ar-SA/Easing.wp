s
تدرّج التسلسل
===
¶نفس حركة السيارة بثماني طرق، طريقة واحدة لكل نمط تسارع.¶

الإطاراتالرئيسية: {
		0%: Pose(إزاحة: مكان(-1m 0m))
		25%: Pose(إزاحة: مكان(1m 0m))
		50%: Pose(إزاحة: مكان(1m 0m))
		75%: Pose(إزاحة: مكان(-1m 0m))
		100%: Pose(إزاحة: مكان(-1m 0m))
	}

مسرح(
	[
		مجموعة(
			شبكة(4 2 حشوالخلية: 0.25m)
			[
				عبارة('مستقيم' حجم: 0.25m)
				عبارة(
					"🚗"
					سكون: تسلسل(
						الإطاراتالرئيسية
						3s
						نمط: "straight"
					)
				)
				عبارة('حذر' حجم: 0.25m)
				عبارة(
					"🚚"
					سكون: تسلسل(
						الإطاراتالرئيسية
						3s
						نمط: "cautious"
					)
				)
				عبارة('بطيء' حجم: 0.25m)
				عبارة(
					"🚙"
					سكون: تسلسل(
						الإطاراتالرئيسية
						3s
						نمط: "pokey"
					)
				)
				عبارة('سريع' حجم: 0.25m)
				عبارة(
					"🏎"
					سكون: تسلسل(
						الإطاراتالرئيسية
						3s
						نمط: "zippy"
					)
				)
			]
		)
	]
)