		(لعبة11.مرحلة = 2)
		? (∆ نبضة2 ? تقدّمالعالم(لعبة11)
					(∆ مفتاح3 ? تطبيقضغطالمفتاح(لعبة11 مفتاح3) فصل(
								لعبة11
							)))
			(∆ نبضة2 ? لعبة11
					(∆ مفتاح3 ? ((مفتاح3 = 'Enter') ? لعبةجديدة() لعبة11)
							(∆ نقر ? لعبةجديدة() لعبة11)))

¶كل شيء في العالم يُرسم بلا تسهيل حركي، لذا تهبط الخطوة في نفس الإطار الذي تضغط فيه بدلًا من الانزلاق بعدك، وكل قطعة تحمل اسمًا مبنيًا من خليتها. الاسم هو الجزء المهم: المسرح يميّز المخرجات عن طريق الاسم، أما القائمة بلا أسماء فتُميَّز حسب الموضع، لذا فإن إخراج كتلة من وسط الكومة سيمنح كل كتلة فوقها هوية جارتها ويجعلها كلها تنزلق إلى أسفل خانة واحدة.¶
¶A green emoji is about a quarter wider than it is tall, so the tiles are sized
down to land exactly one to a cell and keep the ground lined up with the blocks
standing on it.¶
حجمالبلاطة: 0.8m

صفوفالأرض: [:0‥4].filter(
		ƒ(صف2•#) صف2 ≥ (لعبة11.z4 - ارسمخلف)
	).translate(
		ƒ(صف3•#)
			عبارة(
				"🟩🟩🟩🟩🟩🟩🟩🟩🟩"
				حجمالبلاطة
				مدة: 0s
				اسم: "g\صف3\"
				مكان: مكان(عندX(أقلX) عندY(-1) عندZ(صف3))
			)
	)

مشاهدالكتل: لعبة11.كتل.filter(
		ƒ(b8•كتلة) b8.z2 ≥ (لعبة11.z4 - ارسمخلف)
	).translate(
		ƒ(b9•كتلة)
			عبارة(
				b9.نوع2
				1m
				مدة: 0s
				اسم: "b\b9.x2\,\b9.y2\,\b9.z2\"
				مكان: مكان(عندX(b9.x2) عندY(b9.y2) عندZ(b9.z2))
			)
	)

¶الأبراج التي تسعى إليها، باهتة، وفقط الأجزاء التي لم تبنِها بعد.¶
مشاهدالأشباح: هدفلميتحقق(لعبة11.كتل لعبة11.هدف).filter(
		ƒ(g2•كتلة) g2.z2 ≥ (لعبة11.z4 - ارسمخلف)
	).translate(
		ƒ(g3•كتلة)
			عبارة(
				g3.نوع2
				1m
				مدة: 0s
				عتامة: 35%
				اسم: "h\g3.x2\,\g3.y2\,\g3.z2\"
				مكان: مكان(عندX(g3.x2) عندY(g3.y2) عندZ(g3.z2))
			)
	)

¶قطعة حرة. هذا هو الشيء الوحيد على المسرح الذي يتحرك بتسهيل حركي بدلًا من القفز فجأة — إطارها الأول في المكان الذي انكسرت فيه الكتلة، وباقي الإطارات في المكان الذي هبطت فيه، والتسهيل بينهما هو التدحرج.¶
مشاهدالعناصر: لعبة11.عناصر.filter(
		ƒ(i6•عنصر2) i6.z3 ≥ (لعبة11.z4 - ارسمخلف)
	).translate(
		ƒ(i7•عنصر2)
			عبارة(
				i7.نوع3
				0.6m
				مدة: 0.3s
				اسم: "i\i7.معرّف2\"
				مكان: (i7.عمر = 0)
				? مكان(عندX(i7.منX) عندY(i7.منY) عندZ(i7.منZ))
					مكان(
						عندX(i7.x3)
						عندY(ارتفاعالعمود(لعبة11.كتل i7.x3 i7.z3))
						عندZ(i7.z3)
					)
			)
	)

¶المدة هي ما يحوّل الخطوة إلى حركة أصلًا: بلا مدة، يتجاوز المسرح بناء حركة له، وكل تحرك ينتقل فورًا. مدة أقل بقليل من نبضة واحدة تعني أن كل خطوة وكل قفزة تستقر قبل وصول التالية مباشرة. التمدد أثناء تحليقه فوق الأرض هو نفس حيلة تراجع المطرقة قبل الضربة — وضعية مختلفة تُحفظ طوال استمرار الحالة، بدلًا من حركة تبدأ وتتوقف.¶
مشهداللاعب: عبارة(
		'🚶🏻‍♀'
		1.1m
		مدة: 0.14s
		اسم: 'اللاعب'
		تحجيم: ((لعبة11.تعليق > 0) ? 1.08 1)
		flipx: لعبة11.مواجهلـX > 0
		مكان: مكان(
			عندX(لعبة11.x4)
			عندY(لعبة11.y3)
			عندZ(لعبة11.z4)
		)
	)

¶يحوم المؤشر فوق الخلية التي سيهبط فيها فعلك التالي — المساحة الفارغة أعلى الكومة التي تواجهها. الضربة تكسر الكتلة الواقعة مباشرة تحتها، والبناء يملأ الخلية التي يحددها، لذا لا يوجد أبدًا شك في ما ستكسره أو أين ستهبط الكتلة. يطفو المؤشر قليلًا فوق تلك الخلية كي يبقى ظاهرًا عندما تكون الخلية أمامك مباشرة وقد يحجبها جسمك. يتراجع للخلف لحظة ضربتك ثم يعود بتسهيل حركي من تلقاء نفسه، وينطلق تمامًا عند الإصابة بدلًا من التكرار المستمر. يختفي عندما تواجه حافة الميدان، إذ لا يوجد هناك ما يمكن التصرف فيه.¶
الهدفX4: لعبة11.x4 + لعبة11.مواجهلـX
الهدفZ4: لعبة11.z4 + لعبة11.مواجهلـZ
الهدفY: ارتفاعالعمود(لعبة11.كتل الهدفX4 الهدفZ4)

¶أيّ من المهمتين سيؤديها مفتاح المسافة للعمود الذي أمامك، وما إذا كان سيؤدي إلى نتيجة: الكسر يحتاج القمة أن تكون في متناول اليد، والبناء يحتاج بقاء شيء من المادة المختارة في جيوبك. يخفت المؤشر كلما كانت الإجابة لا، فيبدو الجيب الفارغ مثل قمة بعيدة عن المتناول تمامًا، بدلًا من ضغطة لا تفعل شيئًا بصمت.¶
يُبنىهنا: الهدفY ≤ لعبة11.y3
فيالمتناول: (الهدفY - 1) ≤ (لعبة11.y3 + مدى)
المخزونهنا: (لعبة11.مُحدَّد = '🪵') ? لعبة11.خشب لعبة11.طوب
يمكنهالتصرف: يُبنىهنا ? (المخزونهنا > 0) فيالمتناول

مشهدالمؤشر: عبارة(
		(يُبنىهنا ? '🔨' '🪏')
		0.85m
		مدة: 0.12s
		اسم: 'المؤشر'
		دوران: ((لعبة11.أرجحة > 0) ? -55° 0°)
		عتامة: (يمكنهالتصرف ? 100% 30%)
		مكان: مكان(
			عندX(الهدفX4)
			عندY(الهدفY + 0.55)
			عندZ(الهدفZ4)
		)
	)

قائمةالمؤشرات: داخلالحدود(الهدفX4 الهدفZ4) ? [مشهدالمؤشر] [
		]

¶الجيوب والمادة الحالية، مثبّتة بشكل مسطّح على الشاشة كي لا يصغّرها العمق أبدًا.¶
واجهةالعرض: [
		عبارة(
			"🪵 \لعبة11.خشب\   🧱 \لعبة11.طوب\   🔨 \لعبة11.مُحدَّد\"
			0.5m
			مكان: مكان(-6.6m 4.3m)
		)
	]

عنوانالشاشة: (لعبة11.مرحلة = 3) ? '🎉 لقد بنيته! 🎉' '🔨 كتل البناء 🔨'
سطرالبداية: (لعبة11.مرحلة = 3) ? 'اضغط زر الإدخال أو انقر لتبني من جديد' 'اضغط زر الإدخال أو انقر للبدء'

¶تجلس الشاشات بشكل مسطّح فوق حقل مليء بالأشجار والأشكال، لذلك تحمل المجموعة خلفية معتمة خاصة بها. الكلمات الداكنة فوق الأغصان والأسطح يصعب قراءتها، ولوحة صلبة تجعلها واضحة للقراءة مع بقاء العالم ظاهرًا حولها.¶
مشهدالشاشة: [
		مجموعة(
			كومة()
			[
				عبارة(عنوانالشاشة 1.1m اسم: 's1')
				عبارة(
					'الأسهم تمشي · أنت تواجه الاتجاه الذي مشيت فيه'
					0.5m
					اسم: 's2'
				)
				عبارة(
					'مفتاح المسافة يؤثر على المؤشر: 🪏 يكسر · 🔨 يبني'
					0.5m
					اسم: 's3'
				)
				عبارة(
					'مفتاح Shift يبدّل 🪵 🧱 · j يقفز للأعلى للوصول'
					0.5m
					اسم: 's4'
				)
				عبارة(
					'اصعد كتلة واحدة للأعلى · طابق الكتل الباهتة'
					0.5m
					اسم: 's5'
				)
				عبارة(سطرالبداية 0.7m اسم: 's6')
			]
			خلفية: Color(90% 10 240°)
		)
	]

¶تحافظ الكاميرا على مسافة ثابتة خلفك بدلًا من أن تبقى ثابتة في مكانها، لذلك تبقى بنفس الحجم على الشاشة مهما بعدت في مشيك، بينما ينزلق الحقل أمامك مباشرة فوق كتفك. كما أنها تتبعك جانبيًا، فالمشي إلى حافة الحقل يجعل العالم ينزلق عبر الشاشة بدلًا من أن يتركك خارج حافته.

خُمس الخلية هو دفعة لتوسيط الشكل: يُرسم الشكل من حافته اليسرى، التي تقع في منتصف خلية أخرى، ورمزه أعرض قليلًا من الخلية التي يقف فيها.

يُغيّر المسرح حجم كل شيء بحسب بعده عن الكاميرا، وأي شيء يقع في خلية واحدة أمام العدسة يُرسم بثمانية أضعاف حجمه الطبيعي — لذلك في هذا المدى، العالم الذي يبعد أكثر من صف واحد خلفك ببساطة لا يُرسم. الأبراج تقف دائمًا في الصف الخلفي، وهو الصف الوحيد الذي لا يمكن لمسافة الرسم أن تحذفه أبدًا، لذلك تبقى ظاهرة من أي مكان يمكنك المشي إليه.¶
الكاميراZ: ((لعبة11.z4 - خلفالعالم - خلفالكاميرا) · 1m)

¶تتحرك الكاميرا على ارتفاع ما تقف عليه بدلًا من ارتفاعك أنت، لذلك عندما تتسلق فوق كومة، ترتفع الكاميرا معك وتُبقيك ضمن الإطار، بينما القفزة تبقى تبدو قفزة حقيقية — فخلالها ترتفع فعليًا بعيدًا عن الكاميرا بدلًا من أن تسحبها معك.¶
الكاميراY: (ارتفاعالعمود(لعبة11.كتل لعبة11.x4 لعبة11.z4) · 1m)

¶يُرسم العالم بنفس الطريقة في كل مرحلة، لذلك تُظهر شاشتا العنوان والفوز الحقل تمامًا كما ستلعبه، بدلًا من مشهد قائمة منفصل.¶
طبقةالعالم: [
		:مشاهدالكتل
		:مشاهدالأشباح
		:مشاهدالعناصر
		مشهداللاعب
		:قائمةالمؤشرات
	]

¶كل شيء يتحدث إليك يظهر في طبقة المسرح العلوية، وهي مثبّتة بشكل مسطّح على الشاشة، لذلك لا تتأثر بالكاميرا ولا بالعمق. وضع الشاشة هنا بدلًا من داخل العالم هو ما يجعلها واضحة للقراءة: أي شيء يوضع داخل العالم يقع على عمق معين، وصفوف الأرض الأقرب إلى الكاميرا كانت سترسم فوقه.¶
الطبقةالعلوية: (لعبة11.مرحلة = 2) ? واجهةالعرض مشهدالشاشة

¶القطعة التي طُرحت أرضًا لا تزال في إطارها الأول، وهو الإطار الوحيد الذي يميّزها عن القطع الملقاة أصلًا من قبل — نفس العمر الذي يستخدمه الرسم ليقرر ما إذا كان سيبدأ تشغيلها من حيث انكسرت الكتلة.¶
معطّلالآن: لعبة11.عناصر.filter(ƒ(i8•عنصر2) i8.عمر = 0)

¶ما إذا كانت المطرقة قد ضُربت للتو. الكسر فقط هو ما يُفعّل هذا، لذلك تكون القيمة ⊥ عند ضغطة أدت إلى وضع كتلة بدلًا من ذلك.¶
تعطّل: لعبة11.أرجحة = نبضاتالتأرجح

¶كيف كان صوت الضربة. الخشب يصدر صوتًا يشبه الطبلة تام، والحجر يصدر صوتًا يشبه الطبلة الجهيرة، لذلك لا تبدو الشجرة والصخرة متشابهتين في الصوت، والضربة التي لم تلامس شيئًا تصدر نقرة خفيفة — فمن الأفضل سماع خطأ واضح بدلًا من سماع خطأ يبدو وكأن شيئًا لم يحدث.

يبقى فارغًا في بقية الأوقات، وهذا كل ما يلزم: النغمة التي بدأت تُشغَّل تكمل حتى نهايتها، لذلك يستمر صوت المطرقة حتى بعد أن تصبح هذه القائمة فارغة في اللحظة التالية مباشرة.¶
نوتاتالضربة: تعطّل
	? ((معطّلالآن.الطول() > 0) ? معطّلالآن.translate(
					ƒ(i9•عنصر2) (i9.نوع3 = '🪵') ? 5 1
				) [3])
		[]

¶الضغطة التي أدت إلى الضربة، وهي فقط. تبقى المطرقة مشدودة حتى اللحظة التالية، لذلك من دون هذا، أي مفتاح يُضغط في تلك الفترة سيجعل صوت الضربة يتكرر مرة ثانية.¶
تأرجح3: ((∆ مفتاح3) & (مفتاح3 = 'Space')) | (∆ نقر)

صوتالضربة: موسيقى(
		مسار(نوتاتالضربة آلة: آلة.طبول حلقة: ⊥)
		إعادةالتشغيل: تأرجح3
		اسم: 'إصابة'
	)

¶مكان تكون فيه أثناء عملك: لحن بطيء خماسي النغمات على الناي، جرس يجيبه بين الحين والآخر، ودندنة خافتة في الخلفية. سُمّي خماسيًا لأن أيًا من نغماته لا تتنافر مع الأخرى، لذلك لا تنتهي الحلقة أبدًا إلى شيء محدد، ولا تبدو خاطئة أبدًا مع وقع المطرقة فوقها. طولها ستة عشر إيقاعًا بدلًا من ثمانية، لذلك تستغرق وقتًا قبل أن تعود من جديد.¶
جومحيط: موسيقى(
		[
			مسار(
				[1 ø ø 3 ø ø 5 ø ø 3 ø ø 2 ø ø ø]
				آلة: آلة.ناي
				نبضة: 1beats
				مستوىالصوت: 30%
			)
			مسار(
				[ø ø ø ø ø ø 8 ø ø ø ø ø ø ø 6 ø]
				آلة: آلة.جرس
				نبضة: 1beats
				مستوىالصوت: 20%
			)
			مسار(
				[{1 5} {1 5} {4 8} {1 5}]
				آلة: آلة.مُركِّبباد
				نبضة: 4beats
				مستوىالصوت: 25%
			)
		]
		إيقاع: 60beats/min
		سلم: موسيقى.خماسي
		مستوىالصوت: 45%
		اسم: 'طبيعة'
	)

¶المكافأة عند مطابقة كل كتلة باهتة: عزف بوق يصعد على نفس السلم الخماسي الذي كان الحقل يدندن به طوال الوقت، وتناغم يستقر عليه، ولمعان جرس فوق كل ذلك.

لا شيء هنا يتكرر، وهذا ما يجعله زفة احتفال لا خلفية موسيقية جديدة. المقطع الذي يُشغَّل مرة واحدة ويكتمل يبقى صامتًا وهو على المسرح، لذلك تعود شاشة الفوز إلى الهدوء وتترك الأجواء تعمل من جديد؛ وبدء جولة جديدة يزيله من المسرح وينساه، لذلك الهيكل التالي الذي تُكمله يجعله يُسمع مجدداً من البداية.¶
صوتالفوز: موسيقى(
		[
			مسار(
				[1 3 5 8 ø 8 ø ø {1 5 8} ø ø ø ø ø ø ø]
				آلة: آلة.بوق
				نبضة: 0.5beats
				حلقة: ⊥
			)
			مسار(
				[ø ø ø ø ø ø ø ø 8 ø 10 ø 12 ø ø ø]
				آلة: آلة.جرس
				نبضة: 0.5beats
				مستوىالصوت: 45%
				حلقة: ⊥
			)
			مسار(
				[{1 3 5} ø {4 6 8} ø]
				آلة: آلة.بيانو
				نبضة: 2beats
				مستوىالصوت: 40%
				حلقة: ⊥
			)
			مسار(
				[1 ø 3 ø 1 3 1 ø 4 ø ø ø ø ø ø ø]
				آلة: آلة.طبول
				نبضة: 0.5beats
				مستوىالصوت: 35%
				حلقة: ⊥
			)
		]
		إيقاع: 132beats/min
		سلم: موسيقى.خماسي
		اسم: 'مبني'
	)

¶لا يظهر على المسرح إلا بعد فوزك، والقائمة الفارغة تنتشر إلى لا شيء.¶
قائمةالفوز: (لعبة11.مرحلة = 3) ? [صوتالفوز] []

مسرح(
	[:صفوفالأرض :طبقةالعالم جومحيط صوتالضربة :قائمةالفوز]
	مكان: مكان(((لعبة11.x4 + 0.2) · 1m) الكاميراY الكاميراZ)
	background: Color(78% 18 240°)
	color: Color(20% 0 0°)
	طبقةعلوية: الطبقةالعلوية
)
