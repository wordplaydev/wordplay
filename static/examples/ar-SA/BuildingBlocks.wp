¶إطار واحد: تقادم القطع الحرة كي تهبط وتتعلّق ثم تسقط إلى أعلى ما تقف فوقه، وضع في جيبك أي شيء على خليتك، أعد المطرقة إلى الخلف، وتفقّد الأبراج.¶
ƒ تقدّمالعالم(لعبة10•لعبة) (
		تقادم: لعبة10.عناصر.translate(
				ƒ(i•عنصر2) (i.عمر = 0) ? (i.عمر:1) i
			)
		واقف: ارتفاعالعمود(لعبة10.كتل لعبة10.x4 لعبة10.z4)
		التعليقالتالي: (لعبة10.تعليق > 0) ? (لعبة10.تعليق - 1) 0
		yالتالي: ((لعبة10.تعليق = 0) & (لعبة10.y3 > واقف)) ? (لعبة10.y3 - 1) لعبة10.y3
		¶أنت دائمًا في ارتفاع العمود الذي تقف عليه، وكذلك أي شيء موضوع هناك، لذا فإن مشاركة خلية واحدة هي كل ما يلزم لالتقاط شيء ما.¶
		تحتالقدم: تقادم.filter(
				ƒ(i2•عنصر2) (i2.x3 = لعبة10.x4) & (i2.z3 = لعبة10.z4) & (i2.عمر > 0)
			)
		محفوظ: تقادم.filter(
				ƒ(i3•عنصر2) ~((i3.x3 = لعبة10.x4) & (i3.z3 = لعبة10.z4) & (i3.عمر > 0))
			)
		حصلعلىخشب: تحتالقدم.filter(ƒ(i4•عنصر2) i4.نوع3 = '🪵').الطول(
			)
		حصلعلىطوب: تحتالقدم.filter(ƒ(i5•عنصر2) i5.نوع3 = '🧱').الطول(
			)
		لعبة(
			(تحققالهدف(لعبة10.كتل لعبة10.هدف) ? 3 لعبة10.مرحلة)
			لعبة10.x4
			yالتالي
			لعبة10.z4
			لعبة10.مواجهلـX
			لعبة10.مواجهلـZ
			التعليقالتالي
			(لعبة10.خشب + حصلعلىخشب)
			(لعبة10.طوب + حصلعلىطوب)
			لعبة10.مُحدَّد
			((لعبة10.أرجحة > 0) ? (لعبة10.أرجحة - 1) 0)
			لعبة10.المعرّفالتالي
			لعبة10.هدف
			لعبة10.كتل
			محفوظ
		)
	)

مفتاح3: مفتاح()
نبضة2: الوقت(150ms)
نقر: زر()

¶النبضة القلبية، مدفوعة بثلاث مدخلات. أثناء اللعب، تدفع نبضة العالم إلى الأمام، والمفاتيح تقوم بكل شيء آخر، والنقرة تُطلق الضربة. من شاشة العنوان أو شاشة الفوز، يبدأ زر الإدخال أو النقرة جولة جديدة.¶
