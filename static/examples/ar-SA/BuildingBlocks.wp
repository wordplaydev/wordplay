¶ضغطة مفتاح أثناء اللعب. يصل المفتاح كنص عادي هنا بدلًا من مقارنته داخل رد الفعل، مما يجعل اختبارات ∆ الخاصة بردّ الفعل تنظر إلى التدفّق نفسه فقط.¶
ƒ تطبيقضغطالمفتاح(لعبة9•لعبة مفتاح2•"")
	(مفتاح2 = 'ArrowLeft') ? حركة(لعبة9 -1 0)
		((مفتاح2 = 'ArrowRight') ? حركة(لعبة9 1 0)
				((مفتاح2 = 'ArrowUp') ? حركة(لعبة9 0 1)
						((مفتاح2 = 'ArrowDown') ? حركة(لعبة9 0 -1)
								((مفتاح2 = 'Space') ? فصل(لعبة9)
										((مفتاح2 = 'Shift') ? تبديل(لعبة9)
												((مفتاح2 = 'j') ? قفز(لعبة9) لعبة9))))))

