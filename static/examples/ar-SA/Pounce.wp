🧶
قفزة
=== start
¶وجّه القطة بمفاتيح الأسهم ودعها تثب.

تموء القطة في كل مرة تتحرك فيها. يرتبط المواء بأول @Pose في حركتها: يمكن أن يحمل @Pose @Music، فيُشغَّل في اللحظة التي تتخذ فيها القطة تلك الوضعية، وتتخذ الحركة وضعياتها كلما بدأت إحداها. كُتب التمايل بالتفصيل بدل تركه \تسلسل.sway(
)\ لأن الحركات الجاهزة تبني وضعياتها بنفسها، والوضعية هي المكان الذي يجب أن يوضع فيه الصوت.¶

¶صرخة قصيرة واحدة. تشترك حركتان متقاربتان في مواء واحد بدل مواءين متراكبين، لأن الثانية تصل بينما التمايل الأول ما زال مستمرًا.¶
مياو: موسيقى(
		مسار([1] آلة: آلة.قط)
		مستوىالصوت: 45%
		اسم: 'مياو'
	)

•موضعالقطة(موضع•#m الاتجاه2•#)

مفتاح3: مفتاح()
سرعة2: 1m

مكانالقطة: موضعالقطة(5m 1) … ∆ مفتاح3 …
		((مفتاح3 = "ArrowLeft") & (مكانالقطة.موضع > -10m)) ? موضعالقطة(
				مكانالقطة.موضع - سرعة2
				1
			)
			((مفتاح3 = "ArrowRight") & (مكانالقطة.موضع < 8m)) ? موضعالقطة(
					مكانالقطة.موضع + سرعة2
					-1
				)
				مكانالقطة

قطة: عبارة(
		"🐈"
		شكل: "Noto Color Emoji"
		اسم: 'قطة'
		حجم: 2m
		مكان: مكان(مكانالقطة.موضع 0m)
		سكون: Pose(قلبأفقي: مكانالقطة.الاتجاه2 < 0)
		تحرك: تسلسل(
			{
				0%: Pose(دوران: -5° موسيقى: مياو)
				50%: Pose(دوران: 5°)
				100%: Pose(دوران: -5°)
			}
			0.25s
			"zippy"
		)
		مادة: مادة(1000kg الاستدارة: 0.5)
	)

وثبة: تصادم('كرة' 'قطة')

مكانالكرة: الحركة(
		مكان(0m 9m)
		السرعةالتالية:
		وثبة•ø ? ø
			سرعة(
				((وثبة.الاتجاه.x ÷ -1m) × عشوائي(15m/s 25m/s)) + عشوائي(
						-3m/s
						3m/s
					)
				عشوائي(27m/s 30m/s)
				(وثبة.الاتجاه.x ÷ -1m) × عشوائي(0°/s 15°/s)
			)
	)

كرة: عبارة(
		"🧶"
		اسم: 'كرة'
		مكان: مكانالكرة
		مادة: مادة(1kg 0.5 0 1)
	)

مسرح(
	[
		شكل(مستطيل(-10m 0m 10m -3m))
		شكل(مستطيل(-10m -1m -9m 11m))
		شكل(مستطيل(10m -1m 9m 11m))
		شكل(مستطيل(-10m 10m 10m 11m))
		كرة
		قطة
		عبارة(
			'اضغط ← → للعب!'
			مكان: مكان(-4m -2m)
			لون: Color.white
		)
	]
	مكان: مكان(y: 5m z: -10m)
)