🧶
انقضاض
=== start
¶وجّه قطة بمفاتيح الأسهم واجعلها تنقضّ.

تموء القطة في كل مرة تتحرك فيها. يتعلّق المواء بأول @Pose من حركتها المتحركة: يمكن لـ @Pose أن يحمل @Music، الذي يُشغَّل في اللحظة التي تُتَّخذ فيها تلك الوضعية، وكل حركة تُنشئ وضعياتها في كل مرة تبدأ فيها. يُكتب التمايل صراحةً بدلاً من تركه كـ\تسلسل.sway(
)\ لأن الحركات الجاهزة تبني وضعياتها الخاصة بنفسها، والوضعية هي المكان الذي يجب أن يوضع فيه الصوت.¶

¶صرخة قصيرة واحدة. حركتان متقاربتان تشتركان في مواء واحد بدلاً من تكديس مواءين، لأن الحركة الثانية تصل بينما لا يزال التمايل الأول مستمراً.¶
مواء2: موسيقى(
		مسار([1] آلة: آلة.قط)
		مستوىالصوت: 45%
		اسم: 'مواء'
	)

•موضعالقط(الموضع2•#m اتجاه2•#)

مفتاح2: مفتاح()
سرعة2: 1m

مكانالقطة: موضعالقط(5m 1) … ∆ مفتاح2 …
		((مفتاح2 = "ArrowLeft") & (مكانالقطة.الموضع2 > -10m)) ? موضعالقط(
				مكانالقطة.الموضع2 - سرعة2
				1
			)
			((مفتاح2 = "ArrowRight") & (مكانالقطة.الموضع2 < 8m)) ? موضعالقط(
					مكانالقطة.الموضع2 + سرعة2
					-1
				)
				مكانالقطة

قطة: عبارة(
		"🐈"
		شكل: "Noto Color Emoji"
		اسم: 'قطة'
		حجم: 2m
		مكان: مكان(مكانالقطة.الموضع2 0m)
		resting: Pose(flipx: مكانالقطة.اتجاه2 < 0)
		moving: تسلسل(
			{
				0%: Pose(rotation: -5° موسيقى: مواء2)
				50%: Pose(rotation: 5°)
				100%: Pose(rotation: -5°)
			}
			0.25s
			"zippy"
		)
		مادة: مادة(1000kg roundedness: 0.5)
	)

انقضاض: تصادم('كرة' 'قطة')

موضعالكرة: الحركة(
		مكان(0m 9m)
		السرعةالتالية:
		انقضاض•ø ? ø
			سرعة(
				((انقضاض.الاتجاه.x ÷ -1m) × عشوائي(15m/s 25m/s)) + عشوائي(
						-3m/s
						3m/s
					)
				عشوائي(27m/s 30m/s)
				(انقضاض.الاتجاه.x ÷ -1m) × عشوائي(0°/s 15°/s)
			)
	)

كرة: عبارة(
		"🧶"
		اسم: 'كرة'
		مكان: موضعالكرة
		مادة: مادة(1kg 0.5 0 1)
	)

مسرح(
	[
		شكل(مستطيل(-10m 0m 10m -3m))
		شكل(مستطيل(-10m -1m -9m 11m))
		شكل(مستطيل(10m -1m 9m 11m))
		شكل(مستطيل(-10m 10m 10m 11m))
		كرة
		قطة
		عبارة(
			'اضغط ← → لتشغيل اللعب!'
			مكان: مكان(-4m -2m)
			لون: Color.white
		)
	]
	مكان: مكان(y: 5m z: -10m)
)