H
طول الجملة
===
¶اكتب في شريط الدردشة وسيحسب البرنامج عدد حروف جملتك.¶
جملة: الدردشة()
الطول2: الدردشة().الطول()

مجموعة(
	كومة()
	[
		عبارة(
			`*مرحبًا! أهلًا بك في حاسبة طول الجملة.*`
			مكان: مكان(0m 1m)
		)
		عبارة('اكتب شيئًا في شريط الرسائل!' مكان: مكان(0m -1m))
		عبارة(
			'طول جملتك ' + (الطول2 → '') + ' حرفًا!'
			resting: تسلسل.sway(duration: 3s)
			مكان: مكان(0m -3m)
		)
		عبارة(جملة مكان: مكان(0m -5m) لف: 25m)
	]
)