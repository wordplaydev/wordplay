🎵
نغمات مضبوطة
===
¶غنِّ أو دندن، وشاهد النغمة التي تصنعها — مرتين. النغمة اليسرى تقرأ @Pitch الخام وتهتز؛ والنغمة اليمنى تأخذ متوسط آخر عدة درجات صوتية وتبقى ثابتة. @Pitch يعطي 0hz عندما لا يسمع شيئًا واضحًا، لذلك تتخطى النغمتان تلك اللحظات وتعرضان · بدلًا منها.¶

نوتات: [
		'لا'
		'لا♯'
		'سي'
		'دو'
		'دو♯'
		'ري'
		'ري♯'
		'مي'
		'فا'
		'فا♯'
		'صول'
		'صول♯'
	]
نغمة2: ƒ(هرتز•#hz) هرتز > 0hz ? نوتات[(((((12 × (هرتز ÷ 440hz).لوغاريتم(
										2
									)).تقريب(
							)) % 12) + 12) % 12) + 1] '·'
سلس: ƒ(إشارة•…#hz) (
			مسموع: (←← 8 إشارة).بدون(0hz)
			مسموع.متوسط() ?? 0hz
		)
درجةالصوت: طبقةالصوت()
مسرح(
	[
		مجموعة(
			كومة()
			[
				عبارة('مشوَّش' لون: Color(60% 90 30°))
				عبارة(
					نغمة2(درجةالصوت)
					حجم: 6m
					لون: Color(60% 90 30°)
				)
			]
			مكان: مكان(-4m 0m)
		)
		مجموعة(
			كومة()
			[
				عبارة('سلس' لون: Color(70% 90 240°))
				عبارة(
					نغمة2(سلس(درجةالصوت))
					حجم: 6m
					لون: Color(70% 90 240°)
				)
			]
			مكان: مكان(4m 0m)
		)
	]
)
