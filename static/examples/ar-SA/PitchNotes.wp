🎵
نغمات الصوت
===
¶غنِّ أو دندِن، وشاهد النغمة التي تصنعها — مرتين. النغمة اليسرى تعرض @Pitch الخام وتتذبذب؛ والنغمة اليمنى تحسب متوسط آخر عدة نغمات وتبقى ثابتة. يقول @Pitch 0 هرتز عندما لا يسمع شيئًا واضحًا، فتتجاهل النغمتان تلك اللحظات وتُظهران · بدلًا من ذلك.¶
نوتات: [
		'لا'
		'لا♯'
		'سي'
		'دو'
		'دو♯'
		'ري'
		'ري♯'
		'مي'
		'فا'
		'فا♯'
		'صول'
		'صول♯'
	]
نغمةلـ: ƒ(هرتز•#hz) هرتز > 0hz ? نوتات[(((((12 × (هرتز ÷ 440hz).لوغاريتم(
										2
									)).تقريب(
							)) % 12) + 12) % 12) + 1] '·'
سلس: ƒ(إشارة•…#hz) (
			مسموع: (←← 8 إشارة).بدون(0hz)
			(مسموع.combined(0hz ƒ(المجموع•#hz v•#hz) المجموع + v) ÷ مسموع.الطول(
					)) ?? 0hz
		)
طبقةالصوت2: طبقةالصوت()
مسرح(
	[
		مجموعة(
			كومة()
			[
				عبارة('ضجيج' لون: Color(60% 90 30°))
				عبارة(
					نغمةلـ(طبقةالصوت2)
					حجم: 6m
					لون: Color(60% 90 30°)
				)
			]
			مكان: مكان(-4m 0m)
		)
		مجموعة(
			كومة()
			[
				عبارة('سلس' لون: Color(70% 90 240°))
				عبارة(
					نغمةلـ(سلس(طبقةالصوت2))
					حجم: 6m
					لون: Color(70% 90 240°)
				)
			]
			مكان: مكان(4m 0m)
		)
	]
)
