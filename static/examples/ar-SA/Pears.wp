M
الكمثرى
=== start/en
¶هذه قصة قصيرة تفاعلية. فيها عدة مشاهد مختلفة، وتنتقل بينها حسب تفاعلات مثل النقرات والتصادمات وأفعال أخرى. من متعة القصة أن تكتشف التفاعلات اللازمة لتتقدم الأحداث.¶

المقدمة: [
		عبارة(`أراد أبي أن يغادر.` مكان: مكان(-9m 0m))
	]

الصراع: [
		عبارة(`"أمي"، يجب أن نذهب.` مكان: مكان(-8m 7m))
		عبارة(`/"خذي وعودي إلى البيت."/` مكان: مكان(1m 4m))
		عبارة(`"أمي، نحن لا نريد شيئًا!"` مكان: مكان(-8m 1m))
		عبارة(
			`"خذي وعودي إلى البيت!"`
			حجم: 2m
			مكان: مكان(-6m -4m)
			سكون: تسلسل.shake()
		)
	]

تصاعدالأحداث1: [
		عبارة(
			`دخلت جدتي 炮炮👵🏽 إلى الفناء الخلفي`
			مكان: مكان(-9m 7m)
		)
		عبارة(`تبعتها وأنا فضولية` مكان: مكان(-6m 4m))
		عبارة(
			`👵🏽`
			اسم: 'باو باو'
			حجم: 2m
			مادة: مادة()
			مكان: مكان(6m -6m)
			فقاعة: `/"沙梨🍐، خذي وعودي إلى البيت!"/`
		)
		عبارة(
			`👧🏻`
			اسم: 'أنا'
			حجم: 1m
			مادة: مادة()
			مكان: الموضع(مكان(-8m -6m))
		)
	]

تصاعدالأحداث2: [
		عبارة(`توقفت عند شجرة صغيرة.` مكان: مكان(-9m 6m))
		عبارة(
			`كانت عليها عشرات من ثمار 沙梨 الصفراء الزاهية متشابكة`
			مكان: مكان(-9m 1m)
			لف: 10m
		)
		عبارة(
			`"يا أمي، نحن لا نريد أي كمثرى."`
			حجم: .75m
			مكان: مكان(-4m 0m)
		)
		عبارة(`/كنت أريد كمثرى./` حجم: 2m مكان: مكان(-8m -3m))
		عبارة(
			"🍐"
			حجم: 2m
			مكان: مكان(-1m -7m)
			اسم: 'pear'
			قابلللتحديد
		)
	]

¶نحدد الأماكن مسبقًا حتى نجعلها تسقط من النقطة نفسها.¶
الأماكن: (6 → []).ترجم(
		ƒ() مكان(عشوائي(-2m 2m) عشوائي(-3m -5m))
	)
الذروة: [
		عبارة(`جثت على التراب.` مكان: مكان(-9m 6m))
		عبارة(`أمسكت سكينًا` مكان: مكان(-9m 4m))
		عبارة(`وقطعت ست ثمرات بحذر` مكان: مكان(-9m 2m))
		عبارة(`وأسقطتها في سلتها في الأسفل` مكان: مكان(-9m 0m))
		عبارة("🧺" حجم: 4m مكان: مكان(-2m -12m))
		عبارة(
			"🌳"
			اسم: "tree"
			حجم: 5m
			مكان: مكان(-3m -7m)
			قابلللتحديد
		)
		:الأماكن.ترجم(
			ƒ(وضع فهرس2)
				عبارة(
					"🍐"
					اسم: "pear\فهرس2\"
					مكان: اختيار() = 'tree' ? الحركة(وضع) وضع
				)
		)
		عبارة("🔪" مكان: مؤشر())
	]

الحل: [
		عبارة(`حملتها إليّ` مكان: مكان(-9m 6m))
		عبارة(`جثت أمامي` مكان: مكان(-8m 4m))
		عبارة(`وأعطتني السلة` مكان: مكان(-7m 2m))
		عبارة(`/"خذها واذهب إلى البيت"/` مكان: مكان(0m -2m))
	]

الشكروالتقدير: [
		عبارة(`بقلم /Amy J. Ko/`)
	]

القصة: [
		المقدمة
		الصراع
		تصاعدالأحداث1
		تصاعدالأحداث2
		الذروة
		الحل
		الشكروالتقدير
	]

¶تتبّع النقرات واللمسات¶
نقرة: ∆ زر()
¶تتبّع المدة التي تمر بعد النقر على الشجرة¶
الوقتبعدالقطع: 0ms … اختيار() = 'tree' … الوقت(1000ms)
¶تتبّع الوقت الذي نصل فيه إلى Pau Pau¶
عندالجدةباوباو: ∆ تصادم('أنا')
¶تتبّع الوقت الذي يتم فيه اختيار الكمثرى¶
اختارالكمثرى: اختيار() = 'pear'
¶غيّر المقطع بناءً على المقطع الحالي¶
مقطع•#:
	1 …
	مقطع ???
		1: نقرة
		2: نقرة
		3: عندالجدةباوباو
		4: اختارالكمثرى
		5: الوقتبعدالقطع > 1500ms
		6: ∆ زر()
		⊥
		… مقطع + 1

مسرح(
	القصة[مقطع]
	وجه: 'Arvo'
	مكان: مكان(0m 0m -20m)
	إطار: مستطيل(-10m 10m 10m -10m)
)