M
إجاص
=== start/en
¶هذه قصة قصيرة تفاعلية. تحتوي على عدة مشاهد مختلفة، وتتحرك بينها حسب تفاعلات متنوعة، مثل النقرات والتصادمات وأفعال أخرى.

من متعة تجربة هذه القصة اكتشاف التفاعلات اللازمة لتقدّم القصة.¶
العرضالتمهيدي: [
		عبارة(`أبي أراد أن يرحل.` مكان: مكان(-9m 0m))
	]

التعارض: [
		عبارة(`"أمي"، يجب أن نذهب.` مكان: مكان(-8m 7m))
		عبارة(`/"خذ واذهب إلى البيت."/` مكان: مكان(1m 4m))
		عبارة(`"أمي، لا نريد شيئاً!"` مكان: مكان(-8m 1m))
		عبارة(
			`"خذ واذهب إلى البيت!"`
			حجم: 2m
			مكان: مكان(-6m -4m)
			resting: تسلسل.shake()
		)
	]

الحدثالمتصاعد١: [
		عبارة(
			`جدتي👵🏽 خرجت إلى الحديقة الخلفية`
			مكان: مكان(-9m 7m)
		)
		عبارة(`تبعتها، مليئة بالفضول` مكان: مكان(-6m 4m))
		عبارة(
			`👵🏽`
			اسم: 'باوباو'
			حجم: 2m
			مادة: مادة()
			مكان: مكان(6m -6m)
			فقاعة: `/"كمثرى🍐، خذ واذهب إلى البيت!"/`
		)
		عبارة(
			`👧🏻`
			اسم: 'أنا'
			حجم: 1m
			مادة: مادة()
			مكان: الموضع(مكان(-8m -6m))
		)
	]

الحدثالمتصاعد٢: [
		عبارة(`توقفت عند شجرة صغيرة.` مكان: مكان(-9m 6m))
		عبارة(
			`عليها تشابكت عشرات من ثمار الكمثرى الصفراء اللامعة`
			مكان: مكان(-9m 1m)
			لف: 10m
		)
		عبارة(
			`"يا أمي، لا نريد أي كمثرى."`
			حجم: .75m
			مكان: مكان(-4m 0m)
		)
		عبارة(`/كنت أريد كمثرى./` حجم: 2m مكان: مكان(-8m -3m))
		عبارة(
			"🍐"
			حجم: 2m
			مكان: مكان(-1m -7m)
			اسم: 'pear'
			قابلللتحديد: ⊤
		)
	]

¶نحدد الأماكن مسبقًا حتى نجعلها تسقط من نفس البقعة.¶
الأماكن: (6 → []).translate(
		ƒ() مكان(عشوائي(-2m 2m) عشوائي(-3m -5m))
	)
الذروة: [
		عبارة(`جثت على ركبتيها في التراب.` مكان: مكان(-9m 6m))
		عبارة(`أمسكت بسكين` مكان: مكان(-9m 4m))
		عبارة(`وقطعت بعناية ستّ ثمار` مكان: مكان(-9m 2m))
		عبارة(`وأسقطتهنّ في سلتها أسفلها` مكان: مكان(-9m 0m))
		عبارة("🧺" حجم: 4m مكان: مكان(-2m -12m))
		عبارة(
			"🌳"
			اسم: "tree"
			حجم: 5m
			مكان: مكان(-3m -7m)
			قابلللتحديد: ⊤
		)
		:الأماكن.translate(
			ƒ(مكان2 فهرس2)
				عبارة(
					"🍐"
					اسم: "pear\فهرس2\"
					مكان: اختيار() = 'tree' ? الحركة(مكان2) مكان2
				)
		)
		عبارة("🔪" مكان: مؤشر())
	]

الحل: [
		عبارة(`حملتهنّ إليّ` مكان: مكان(-9m 6m))
		عبارة(`جثت أمامي على ركبتيها` مكان: مكان(-8m 4m))
		عبارة(`وناولتني السلة` مكان: مكان(-7m 2m))
		عبارة(`/"خذيها واذهبي إلى البيت"/` مكان: مكان(0m -2m))
	]

شكروتقدير: [
		عبارة(`بقلم /إيمي جيه. كو/`)
	]

القصة: [
		العرضالتمهيدي
		التعارض
		الحدثالمتصاعد١
		الحدثالمتصاعد٢
		الذروة
		الحل
		شكروتقدير
	]

¶تتبّع النقرات واللمسات¶
نقرة: ∆ زر()
¶تتبّع كم من الوقت مرّ بعد النقر على الشجرة¶
الوقتبعدالقطع: 0ms … اختيار() = 'tree' … الوقت(1000ms)
¶تتبّع اللحظة التي نصل فيها إلى باو باو¶
عندباوباو: ∆ تصادم('أنا')
¶تتبّع اللحظة التي تُختار فيها الكمثرى¶
اختارتالكمثرى: اختيار() = 'pear'
¶غيّر المقطع بناءً على المقطع الحالي¶
جزء2•#:
	1 …
	جزء2 ???
		1: نقرة
		2: نقرة
		3: عندباوباو
		4: اختارتالكمثرى
		5: الوقتبعدالقطع > 1500ms
		6: ∆ زر()
		⊥
		… جزء2 + 1

مسرح(
	القصة[جزء2]
	face: 'Arvo'
	مكان: مكان(0m 0m -20m)
	frame: مستطيل(-10m 10m 10m -10m)
)