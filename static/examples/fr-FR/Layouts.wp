Mises en page
=== start
¶Des lignes, des piles et des groupes de phrases, chacun prenant des poses animées marquantes.¶

palpiter: Séquence(
		{
			0%: Pose(échelle: .9)
			50%: Pose(échelle: 1.1)
			100%: Pose(échelle: .9)
		}
	)
zrebond: Séquence(
		{
			0%: Pose(compenser: Lieu(j: 0m))
			50%: Pose(compenser: Lieu(j: -2m))
			100%: Pose(compenser: Lieu(j: 0m))
		}
		1s
	)

Groupe(
	Rangée()
	[
		Groupe(
			Empiler()
			[
				Phrase('Minou')
				Phrase('Chat' aurepos: zrebond)
				Groupe(
					Rangée()
					[Phrase('Chien') Phrase('Canin')]
					aurepos: palpiter
				)
				Phrase('Félin')
			]
		)
		Groupe(
			Empiler()
			[
				Phrase('Salut')
				Phrase('Bonjour')
			]
			aurepos: Séquence.tournoiement(2s "straight")
		)
	]
)