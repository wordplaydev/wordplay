T
Poème
=== start
¶Un poème dont les lignes arrivent doucement, chacune faisant sa propre entrée.¶

•ligne(texte2•"" pose•Pose|Séquence arrière: Couleur(
			100
			100
			100°
		) avant: Couleur(0 0 0°))

¶Une liste des lignes du poème, chacune avec une pose.¶
poème: [
		ligne(
			"Le fichier d'ordinateur"
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne(
			'dont'
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne("je n'ai aucun souvenir" Pose(rotation: 10°))
		ligne(
			"je clique pour l'ouvrir"
			Séquence(
				{
					0%: Pose(échelle: 1)
					50%: Pose(échelle: 0.7)
					100%: Pose(échelle: 1)
				}
				0.25s
			)
		)
		ligne(
			'regarde'
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne(
			'défile encore plus bas'
			Pose(opacité: 0% compenser: Lieu(et: 5m))
		)
		ligne(
			"l'écran"
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne(
			'reste éclairé et vide'
			Pose(opacité: 0% compenser: Lieu(et: -5m))
			Couleur(0 0 0°)
			Couleur(100 100 0°)
		)
		ligne(
			'ainsi je me retrouve moi-même'
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne(
			"plein d'espoir et inutile"
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne(
			'un mystère'
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne(
			"exactement comme j'ai dû le faire"
			Pose(opacité: 0% compenser: Lieu(et: -5m))
		)
		ligne('le 19 août 2010, à 11 h 08' Pose())
	]

nombre2: 1 … ∆ Bouton() | ∆ Clé() …
		(nombre2 = (poème.longueur() + 1)) ? 1 nombre2 + 1
ligne2: poème[nombre2]

nombre2 ≤ poème.longueur() ?
	Scène(
		[
			Phrase(
				ligne2.texte2
				entrer: ligne2.pose
				durée: 1s
				nom: nombre2 → ""
				style: 'cautious'
			)
		]
		arrièreplan: ligne2.arrière
		aurepos: Pose(couleur: ligne2.avant)
	)
	Scène(
		[
			Groupe(
				Empiler()
				[
					Phrase('CONSEIL À MOI-MÊME')
					Phrase('Jane Hirshfield')
				]
				entrer: Pose(échelle: 0.75)
			)
		]
		arrièreplan: Couleur(0% 0 0°)
		couleur: Couleur(100% 100 0°)
	)