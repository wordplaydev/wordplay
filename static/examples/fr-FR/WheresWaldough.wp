🔁
Où est Waldough ?
=== start/en
¶Trouve Waldough caché dans la foule : cherche l'homme au tee-shirt orange et clique sur lui pour gagner !¶

nom2: Choix()
attrapé: ⊥ … ∆ (nom2) … (nom2 = 'ResetButton') ? ⊥ ((nom2 = 'Waldough') | attrapé)
score: 0 … ∆ (nom2) … (nom2 = 'Waldough') ? 1 + score score

ƒ endroit() Lieu(
		((0.1 × Aléatoire(-9m 9m)) + Aléatoire(-2m 1m))
		((0.1 × Aléatoire(-9m 9m)) + Aléatoire(-2m 1m))
	)
ƒ nouveauxPoints() [
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
	]
points2: nouveauxPoints() … ∆ (nom2) … (nom2 = 'ResetButton') ? nouveauxPoints(
			) points2


Scène(
	[
		Phrase(
			"🔁"
			sélectionnable: ⊤
			lieu: Lieu(4m -0.5m)
			aurepos: attrapé ? Pose(rotation: 180°) Pose()
			durée: 0.5s
			nom: 'ResetButton'
		)
		Phrase(
			'Cherche le tee-shirt orange'
			0.2m
			lieu: Lieu(-6.2m 0.75m)
			affronter: 'Carter One'
		)
		Phrase(
			'homme (nommé Waldough) et'
			0.2m
			lieu: Lieu(-6.4m 0.25m)
			affronter: 'Carter One'
		)
		Phrase(
			'clique sur lui pour gagner !🧍🏻'
			0.2m
			lieu: Lieu(-6.0m -0.25m)
			affronter: 'Carter One'
		)
		Phrase(
			'Score : ' + score → ''
			0.5m
			lieu: Lieu(-5.9m -1m)
		)

		Phrase("🏀" lieu: points2[1])
		Phrase("🦧" lieu: points2[2])
		Phrase("🍊" lieu: points2[3])
		Phrase("👻" lieu: points2[4])
		Phrase("🤖" lieu: points2[5])
		Phrase("👽" lieu: points2[6])
		Phrase("🐀" lieu: points2[7])
		Phrase("🦣" lieu: points2[8])
		Phrase("🐸" lieu: points2[9])
		Phrase("🍎" lieu: points2[10])
		Phrase("💧" lieu: points2[11])
		Phrase("🍔" lieu: points2[12])
		Phrase("❤" lieu: points2[13])
		Phrase("🍥" lieu: points2[14])
		Phrase(
			"🧍🏻"
			sélectionnable: ~attrapé
			lieu: points2[15]
			aurepos: attrapé ? Pose(rotation: 180°) Pose()
			durée: 0s
			nom: 'Waldough'
		)
		Phrase("🔥" lieu: points2[16])
		Phrase("🎂" lieu: points2[17])
		Phrase("🐕" lieu: points2[18])
		Phrase("🦈" lieu: points2[19])
		Forme(Rectangle(-3.5m -3m 3.5m -3.5m))
		Forme(Rectangle(-3.5m 3.5m 3.5m 3m))
		Forme(Rectangle(-3.5m 3.5m -3m -3.5m))
		Forme(Rectangle(3m 3.5m 3.5m -3.5m))
	]
	lieu: Lieu(0m 0m -5m)
)