🔁
Où est Charlie la pâte ?
=== start/en
¶Trouve Waldough caché dans la foule : cherche l'homme en chemise orange et clique sur lui pour gagner !¶

nom2: Choix()
attrapée: ⊥ … ∆ (nom2) … (nom2 = 'ResetButton') ? ⊥ ((nom2 = 'Waldough') | attrapée)
score: 0 … ∆ (nom2) … (nom2 = 'Waldough') ? 1 + score score

ƒ endroit() Lieu(
		((0.1 × Aléatoire(-9m 9m)) + Aléatoire(-2m 1m))
		((0.1 × Aléatoire(-9m 9m)) + Aléatoire(-2m 1m))
	)
ƒ nouveauxEmplacements() [
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
		endroit()
	]
emplacements: nouveauxEmplacements() … ∆ (nom2) … (nom2 = 'ResetButton') ? nouveauxEmplacements(
			) emplacements


Scène(
	[
		Phrase(
			"🔁"
			sélectionnable
			lieu: Lieu(4m -0.5m)
			aurepos: attrapée ? Pose(rotation: 180°) Pose()
			durée: 0.5s
			nom: 'ResetButton'
		)
		Phrase(
			'Cherche la chemise orange'
			0.2m
			lieu: Lieu(-6.2m 0.75m)
			affronter: 'Carter One'
		)
		Phrase(
			'homme (nommé Waldough) et'
			0.2m
			lieu: Lieu(-6.4m 0.25m)
			affronter: 'Carter One'
		)
		Phrase(
			'clique sur lui pour gagner !🧍🏻'
			0.2m
			lieu: Lieu(-6.0m -0.25m)
			affronter: 'Carter One'
		)
		Phrase(
			'Score : ' + score → ''
			0.5m
			lieu: Lieu(-5.9m -1m)
		)

		Phrase("🏀" lieu: emplacements[1])
		Phrase("🦧" lieu: emplacements[2])
		Phrase("🍊" lieu: emplacements[3])
		Phrase("👻" lieu: emplacements[4])
		Phrase("🤖" lieu: emplacements[5])
		Phrase("👽" lieu: emplacements[6])
		Phrase("🐀" lieu: emplacements[7])
		Phrase("🦣" lieu: emplacements[8])
		Phrase("🐸" lieu: emplacements[9])
		Phrase("🍎" lieu: emplacements[10])
		Phrase("💧" lieu: emplacements[11])
		Phrase("🍔" lieu: emplacements[12])
		Phrase("❤" lieu: emplacements[13])
		Phrase("🍥" lieu: emplacements[14])
		Phrase(
			"🧍🏻"
			sélectionnable: ~attrapée
			lieu: emplacements[15]
			aurepos: attrapée ? Pose(rotation: 180°) Pose()
			durée: 0s
			nom: 'Waldough'
		)
		Phrase("🔥" lieu: emplacements[16])
		Phrase("🎂" lieu: emplacements[17])
		Phrase("🐕" lieu: emplacements[18])
		Phrase("🦈" lieu: emplacements[19])
		Forme(Rectangle(-3.5m -3m 3.5m -3.5m))
		Forme(Rectangle(-3.5m 3.5m 3.5m 3m))
		Forme(Rectangle(-3.5m 3.5m -3m -3.5m))
		Forme(Rectangle(3m 3.5m 3.5m -3.5m))
	]
	lieu: Lieu(0m 0m -5m)
)