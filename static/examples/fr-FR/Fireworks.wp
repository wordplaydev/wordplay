Scène(
	[
		:tir.traduire(ƒ(p6•Partie i2•#) éclat(p6 i2))
		Musique(
			[
				Piste(
					mélodie2
					instrument: Instrument.trompette
					volume: 90%
					boucle: ⊥
				)
				Piste(
					basse
					instrument: Instrument.piano
					clé: -12semitones
					volume: 50%
					balance: -0.4
					boucle: ⊥
				)
				Piste(
					cloche2
					instrument: Instrument.cloche
					volume: 55%
					boucle: ⊥
				)
				Piste(
					violon2
					instrument: Instrument.violon
					volume: 45%
					balance: 0.3
					boucle: ⊥
				)
				Piste(
					flûte2
					instrument: Instrument.flûte
					volume: 65%
					boucle: ⊥
				)
				Piste(
					tambours
					instrument: Instrument.batterie
					volume: 45%
					boucle: ⊥
				)
			]
			tempo: 84beats/min
			gamme: Musique.chromatique
			nom: 'hymne'
		)
	]
	arrièreplan: Couleur(10% 12 265°)
	couleur: Couleur(96% 0 0°)
)
