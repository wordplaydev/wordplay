Titres
=== start/en
¶Les titres en direct du New York Times, récupérés sur le web et empilés sur la scène.¶

titres: Pageweb(
		'https://www.nytimes.com'
		'.indicate-hover'
	)
titres•# ?
	Phrase('chargement')
	Groupe(
		Empiler('<')
		[
			Phrase(
				`*Titres du New York Times*`
				2m
				affronter: 'Arvo'
			)
		].avecListe(
			titres.sousséquence(1 7).traduire(
				ƒ(titre)
					Phrase(
						titre
						envelopper: 20m
						alignement: '<'
						affronter: 'Ubuntu'
						aurepos: Séquence(
							{
								0%: Pose(rotation: 3°)
								50%: Pose(rotation: -3°)
								100%: Pose(rotation: 3°)
							}
							durée: 3s
						)
					)
			)
		)
	)