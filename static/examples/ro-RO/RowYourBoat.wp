¶O barcă. Alunecă puțin mai departe la fiecare timp și se leagănă în cealaltă parte de fiecare dată, ceea ce arată ca o vâslire; culoarul stabilește cât de sus stă și cât de mult a pornit înainte, ca să nu se miște toate la fel.¶
ƒ barcă(culoar•# început2•#)•Fraza
	Fraza(
		'🚣'
		1.5m
		loc: Loc(
			((((vâslire + început2) % 16) - 8) · 1.1) · 1m
			((culoar · 1.9) - 1.9) · 1m
		)
		rotaţie: (((vâslire + culoar) % 2) = 0) ? 9° -9°
		durată: 0.2s
	)

flotă: [barcă(0 0) barcă(1 6) barcă(2 11)]

Etapă(
	[
		:flotă
		Fraza(
			'〰〰〰〰〰〰〰〰'
			1m
			loc: Loc(-8m -3.2m)
			culoare: Culoare(48% 22 240°)
		)
		Fraza(
			'Vâslește, vâslește, vâslește barca ta'
			0.9m
			loc: Loc(-4.4m 3.4m)
		)
		Muzică(
			[
				Pistă(
					melodie2
					instrument: Instrument.flaut
					bătaie: 0.5beats
				)
				Pistă(
					acorduri
					instrument: Instrument.pian
					bătaie: 1beats
					volum: 60%
				)
				Pistă(
					vâsle
					instrument: Instrument.tobe
					bătaie: 1beats
					volum: 45%
				)
			]
			tempo: 144beats/min
			nume: 'barcă'
		)
	]
	fundal: Culoare(22% 18 230°)
	culoare: Culoare(96% 0 0°)
)
