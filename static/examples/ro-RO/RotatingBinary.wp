1
RotatingBinary
=== start/en
¶Un câmp de unu și zero, care se rotește încet pe loc.¶
rotireLentă: Secvenţă.rotire(10s "straight")

Etapă(
	[
		Fraza(
			'1'
			loc: Loc(-0.5m -0.125m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'0'
			loc: Loc(1.25m -0.25m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'1'
			loc: Loc(-2.3125m 0.0625m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'0'
			loc: Loc(-1.6875m -1m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'1'
			loc: Loc(-1.4375m 0.75m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'0'
			loc: Loc(0.375m -1.3125m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'0'
			loc: Loc(-0.6875m -1.75m 0m)
			odihnă: rotireLentă
		)
		Fraza(
			'1'
			loc: Loc(0.4375m 1.125m 0m)
			odihnă: rotireLentă
		)
	]
)