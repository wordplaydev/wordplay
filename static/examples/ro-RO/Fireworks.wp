Etapă(
	[
		:declanșare.traduce(ƒ(p6•Parte i2•#) explozie(p6 i2))
		Muzică(
			[
				Pistă(
					melodie2
					instrument: Instrument.trompetă
					volum: 90%
					buclă: ⊥
				)
				Pistă(
					bas
					instrument: Instrument.pian
					cheie: -12semitones
					volum: 50%
					balans: -0.4
					buclă: ⊥
				)
				Pistă(
					clopot
					instrument: Instrument.clopoțel
					volum: 55%
					buclă: ⊥
				)
				Pistă(
					vioară2
					instrument: Instrument.vioară
					volum: 45%
					balans: 0.3
					buclă: ⊥
				)
				Pistă(
					flaut2
					instrument: Instrument.flaut
					volum: 65%
					buclă: ⊥
				)
				Pistă(
