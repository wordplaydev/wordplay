🖐
हात
===
¶तुमच्या कॅमेऱ्यासमोर बोटे दाखवा आणि एक इमोजी हात मोजणी करेल.¶
हात2: हात()

रंगमंच(
	[
		वाक्यांश(
			(हात2.बोटे = 0 ? '✊'
					हात2.बोटे = 1 ? '☝'
						हात2.बोटे = 2 ? '✌'
							हात2.बोटे = 3 ? '🤟'
								हात2.बोटे = 4 ? '🖖'
									'🖐')
			ठिकाण: हात2.ठिकाण
			आकार: 2m
			सरकाव: ठिकाण(-1m)
		)
		गट(
			रांग('<')
			[
				वाक्यांश('1⃣' सरकाव: ठिकाण(0m हात2.अंगठा ? 1m 0m))
				वाक्यांश('2⃣' सरकाव: ठिकाण(0m हात2.तर्जनी ? 1m 0m))
				वाक्यांश('3⃣' सरकाव: ठिकाण(0m हात2.मधलेबोट ? 1m 0m))
				वाक्यांश('4⃣' सरकाव: ठिकाण(0m हात2.अनामिका ? 1m 0m))
				वाक्यांश('5⃣' सरकाव: ठिकाण(0m हात2.करंगळी ? 1m 0m))
			]
			ठिकाण: ठिकाण(-4.5m 5m)
		)
		गट(
			थप्पी('|')
			[
				वाक्यांश((हात2.तळहात ? '🤚' '🤛') आकार: 2m)
				वाक्यांश((हात2.उघडे ? 'उघडा' 'बंद') आकार: 1.5m)
			]
			ठिकाण: ठिकाण(-2m -8m)
		)
		वाक्यांश(`/कॅमेऱ्याला तुमचा हात दाखवा/` ठिकाण: ठिकाण(-6m -10m) आकार: 1m)
	]
	ठिकाण: ठिकाण(0m 0m -20m)
)