↑
चक्रव्यूह
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•चक्रव्यूह() (
	जाळी2•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ कोठडी(ओळ2•# स्तंभ2•#) (
			कप्पे: जाळी2[ओळ2]
			कप्पे•[] ? कप्पे[स्तंभ2] ø
		)

	ƒ परवानगीदिलेले(ओळ3•# स्तंभ3•#) कोठडी(ओळ3 स्तंभ3)•''
)

चक्रव्यूह2: चक्रव्यूह()

•स्थिती(ओळ4•# स्तंभ4•# पायऱ्या•#)
(
	ƒ खाली2() स्थिती(ओळ4 + 1 स्तंभ4 पायऱ्या + 1)
	ƒ वर() स्थिती(ओळ4 - 1 स्तंभ4 पायऱ्या + 1)
	ƒ डावीकडे() स्थिती(ओळ4 स्तंभ4 - 1 पायऱ्या + 1)
	ƒ उजवीकडे() स्थिती(ओळ4 स्तंभ4 + 1 पायऱ्या + 1)
)

ƒ परवानगीदिलेले2(स्थिती2•स्थिती ओळ5•# स्तंभ5•#) चक्रव्यूह2.परवानगीदिलेले(
		स्थिती2.ओळ4 + ओळ5
		स्थिती2.स्तंभ4 + स्तंभ5
	)

दिशा2: निवड()
स्थिती3•स्थिती: स्थिती(1 1 0) … ∆ दिशा2 …
		((दिशा2 = "left") & परवानगीदिलेले2(स्थिती3 0 -1)) ? स्थिती3.डावीकडे()
			((दिशा2 = "right") & परवानगीदिलेले2(स्थिती3 0 1)) ? स्थिती3.उजवीकडे()
				((दिशा2 = "up") & परवानगीदिलेले2(स्थिती3 -1 0)) ? स्थिती3.वर()
					((दिशा2 = "down") & परवानगीदिलेले2(स्थिती3 1 0)) ? स्थिती3.खाली2()
						स्थिती3

सध्याचे: (
		कोठडी2: चक्रव्यूह2.कोठडी(स्थिती3.ओळ4 स्थिती3.स्तंभ4)
		कोठडी2 ?? ' ')
वर2: चक्रव्यूह2.कोठडी(स्थिती3.ओळ4 - 1 स्थिती3.स्तंभ4)•''
खाली3: चक्रव्यूह2.कोठडी(स्थिती3.ओळ4 + 1 स्थिती3.स्तंभ4)•''
डावीकडे2: चक्रव्यूह2.कोठडी(स्थिती3.ओळ4 स्थिती3.स्तंभ4 - 1)•''
उजवीकडे2: चक्रव्यूह2.कोठडी(स्थिती3.ओळ4 स्थिती3.स्तंभ4 + 1)•''
जिंकले: सध्याचे = '🤩'

रंगमंच(
	[
		गट(
			जाळी(3 3 0.25m)
			[
				ø
				वाक्यांश(
					'↑'
					नाव: 'up'
					निवडण्याजोगे: वर2
					स्थिर: मुद्रा(अपारदर्शकता: वर2 ? 1 0.2)
				)
				ø
				वाक्यांश(
					'←'
					नाव: 'left'
					निवडण्याजोगे: डावीकडे2
					स्थिर: मुद्रा(अपारदर्शकता: डावीकडे2 ? 1 0.2)
				)
				वाक्यांश(
					सध्याचे
					स्थिर: जिंकले ?
						क्रम.गिरकी(कालावधी: 1s शैली: 'straight')
						मुद्रा()
				)
				वाक्यांश(
					'→'
					नाव: 'right'
					निवडण्याजोगे: उजवीकडे2
					स्थिर: मुद्रा(अपारदर्शकता: उजवीकडे2 ? 1 0.2)
				)
				ø
				वाक्यांश(
					'↓'
					नाव: 'down'
					निवडण्याजोगे: खाली3
					स्थिर: मुद्रा(अपारदर्शकता: खाली3 ? 1 0.2)
				)
				ø
			]
		)
	]
	ठिकाण: ठिकाण(0m 0m -3m)
	चेहरा: 'Noto Emoji'
	पार्श्वभूमी: रंग(0 0 0°)
	विश्रांती: मुद्रा(रंग(100 100 0°))
)