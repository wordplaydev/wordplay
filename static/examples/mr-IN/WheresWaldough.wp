	]
जागा3: नवीनजागा() … ∆ (नाव3) … (नाव3 = 'ResetButton') ? नवीनजागा() जागा3


रंगमंच(
	[
		वाक्यांश(
			"🔁"
			निवडण्याजोगे: ⊤
			ठिकाण: ठिकाण(4m -0.5m)
			स्थिर: पकडले ? मुद्रा(फिरवणे: 180°) मुद्रा()
			कालावधी: 0.5s
			नाव: 'ResetButton'
		)
		वाक्यांश(
			'केशरी शर्ट शोधा'
			0.2m
			ठिकाण: ठिकाण(-6.2m 0.75m)
			चेहरा: 'Carter One'
		)
		वाक्यांश(
			'माणूस (नाव वाल्डो) आणि'
			0.2m
			ठिकाण: ठिकाण(-6.4m 0.25m)
			चेहरा: 'Carter One'
		)
		वाक्यांश(
			'जिंकण्यासाठी त्याच्यावर क्लिक करा!🧍🏻'
			0.2m
			ठिकाण: ठिकाण(-6.0m -0.25m)
			चेहरा: 'Carter One'
		)
		वाक्यांश(
			'गुण: ' + गुण → ''
			0.5m
			ठिकाण: ठिकाण(-5.9m -1m)
		)

		वाक्यांश("🏀" ठिकाण: जागा3[1])
		वाक्यांश("🦧" ठिकाण: जागा3[2])
		वाक्यांश("🍊" ठिकाण: जागा3[3])
		वाक्यांश("👻" ठिकाण: जागा3[4])
		वाक्यांश("🤖" ठिकाण: जागा3[5])
		वाक्यांश("👽" ठिकाण: जागा3[6])
		वाक्यांश("🐀" ठिकाण: जागा3[7])
		वाक्यांश("🦣" ठिकाण: जागा3[8])
		वाक्यांश("🐸" ठिकाण: जागा3[9])
		वाक्यांश("🍎" ठिकाण: जागा3[10])
		वाक्यांश("💧" ठिकाण: जागा3[11])
		वाक्यांश("🍔" ठिकाण: जागा3[12])
		वाक्यांश("❤" ठिकाण: जागा3[13])
		वाक्यांश("🍥" ठिकाण: जागा3[14])
		वाक्यांश(
			"🧍🏻"
			निवडण्याजोगे: ~पकडले
			ठिकाण: जागा3[15]
			स्थिर: पकडले ? मुद्रा(फिरवणे: 180°) मुद्रा()
			कालावधी: 0s
			नाव: 'Waldough'
		)
		वाक्यांश("🔥" ठिकाण: जागा3[16])
		वाक्यांश("🎂" ठिकाण: जागा3[17])
		वाक्यांश("🐕" ठिकाण: जागा3[18])
		वाक्यांश("🦈" ठिकाण: जागा3[19])
		आकृती(आयत(-3.5m -3m 3.5m -3.5m))
		आकृती(आयत(-3.5m 3.5m 3.5m 3m))
		आकृती(आयत(-3.5m 3.5m -3m -3.5m))
		आकृती(आयत(3m 3.5m 3.5m -3.5m))
	]
	ठिकाण: ठिकाण(0m 0m -5m)
)