¶اتاقی با این شناسه. اگر چیزی پیدا نشود، find() مقدار ø را برمی‌گرداند، و شناسه‌ای که نام هیچ اتاقی نیست، یک حفره در نقشه است، نه یک پیچ در داستان؛ پس اتاق نخست جای آن را می‌گیرد.¶
ƒ برو(می‌خواست•'')•اتاق2 اتاق‌ها.پیداکردن(
		ƒ(اتاق4•اتاق2) اتاق4.شناسه2 = می‌خواست
	) ?? اتاق‌ها[1]

¶درهایی که واقعاً می‌توانی از اینجا بروی. دری قفل‌شده که چیزی برایش نداری، اصلاً پیشنهاد نمی‌شود؛ پس مثل دیوار به‌نظر می‌رسد تا زمانی که چیزی که آن را باز می‌کند به دستت برسد.¶
ƒ راه‌ها(اینجا•اتاق2 بسته3•[''])•[در]
	اینجا.درها.صافی(
		ƒ(در2•در) (در2.نیازدارد = '') | بسته3.دارد(
					در2.نیازدارد
				)
	)

¶به اتاقی قدم بگذار و هرچه در آن است بردار. add() با خوشحالی یک چاقوی دوم هم به تو می‌دهد، پس اول بپرس.¶
ƒ برس(اینجا2•اتاق2 بسته4•[''])•سفر
	سفر(
		اینجا2.شناسه2
		((اینجا2.بردار ≠ '') & (~بسته4.دارد(اینجا2.بردار))) ? بسته4.با(
				اینجا2.بردار
			) بسته4
	)

کلید3: کلید()

¶فشردن یک کلید، به این ترتیب: در پایان داستان، هر کلیدی تو را دوباره در اتاق نخست بیدار می‌کند؛ کلیدی که ۱، ۲ یا ۳ نیست، هیچ معنایی ندارد؛ عددی بزرگ‌تر از شمار درهای این اتاق هم هیچ معنایی ندارد؛ و تنها پس از این آزمایش‌هاست که آن یک در است. آن آزمایش سوم است که ارزش نوشتن دارد، چون دسترسی به لیست دوباره از اول شروع می‌شود — بدون آن، فشردن ۳ در اتاقی با دو در، بی‌سروصدا اولی را انتخاب می‌کرد.¶
ƒ گام(ت•سفر ک•'')•سفر (
		اینجا3: برو(ت.اتاق3)
		درها2: راه‌ها(اینجا3 ت.بسته2)
		اینجا3.پایان2 ≠ '' ? سفر('سلول' [])
			~((ک = '1') | (ک = '2') | (ک = '3')) ? ت
				(ک → #) > درها2.طول() ? ت
					برس(برو(درها2[ک → #].اتاق) ت.بسته2)
	)

سفر2•سفر: سفر('سلول' []) … ∆ کلید3 … گام(سفر2 کلید3)

اینجا4: برو(سفر2.اتاق3)
درها3: راه‌ها(اینجا4 سفر2.بسته2)

¶آنچه همراه داری، فقط زمانی نشان داده می‌شود که چیزی همراه داشته باشی.¶
همراه‌داشتن:
	سفر2.بسته2.طول() > 0
	? [
			عبارت(
				`*همراه‌داشته*\سفر2.بسته2.پیوستن(' · ')\`
				اندازه: 0.3m
				ترازبندی: '|'
				رنگ: رنگ(60% 30 0°)
			)
		]
		[]

¶آنچه زیر اتاق نشسته: درهایش، شماره‌گذاری‌شده طوری که آنچه می‌خوانی همان چیزی است که فشار می‌دهی؛ یا، در پایان داستان، اینکه چگونه تمام شد و آن یک کلید که دوباره آغازش می‌کند.¶
پایین2:
	اینجا4.پایان2 ≠ ''
	? [
			عبارت(
				`*\اینجا4.پایان2\*`
				اندازه: 0.8m
				ترازبندی: '|'
				رنگ: اینجا4.برد ? رنگ(85% 50 90°) رنگ(45% 40 25°)
				مدت: 1.5s
				درحالورود: ژست(شفافیت: 0% گامموسیقی: 0.5)
			)
			عبارت(
				`برای بیدار شدن دوباره، هر کلیدی را فشار بده`
				اندازه: 0.3m
				ترازبندی: '|'
				مدت: 3s
				درحالورود: ژست(شفافیت: 0%)
			)
		]
		درها3.ترجمه‌کردن(
			ƒ(در3•در اندیس2•#)
				عبارت(
					`\اندیس2\. *\در3.برچسب\*`
					اندازه: 0.5m
					ترازبندی: '|'
					نام: در3.برچسب
					مدت: 1s
					درحالورود: ژست(شفافیت: 0%)
				)
		)

