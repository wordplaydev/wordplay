		)
		اتاق2(
			'دخمه'
			'فانوس یک اتاق کوتاه پر از صندوق‌های سنگی را پیدا می‌کند و کنار آخرین صندوق، روی یک قلاب، یک کلید زنگ‌زده آویزان است که تکه‌ای پارچه هنوز به آن بسته شده است.'
			[
				در2('به طرف آب ادامه بده' 'رود')
				در2('از راهرو برگرد بالا' 'گذرگاه')
			]
			برداشتن2: 'کلید'
