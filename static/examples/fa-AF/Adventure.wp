			پایان2: 'تاریکی تو را نگه می‌دارد.'
		)
		اتاق2(
			'بالا برو'
			'تقریباً تا بالا رسیده‌ای که زنجیر یادش می‌آید چقدر کهنه است. سحرگاه تو را پای دروازه پیدا می‌کنند و این بار به اندازهٔ دو نفر طناب می‌آورند.'
			پایان2: 'کنار دروازه گرفتار شدی.'
		)
		اتاق2(
			'رود'
			'راهرو به یک شبکهٔ آهنی روی آب روان می‌رسد. میله‌ها کهنه‌اند و چاقو صبور است. همراه رود بیرون می‌روی و پیش از آنکه آسمان خاکستری شود، خانه خیلی دور پشت سرت مانده است.'
			پایان2: 'همراه رود بیرون رفتی.'
			برد
		)
		اتاق2(
			'دامنهٔ تپه'
			'کلید می‌چرخد، زنجیر روی چمن‌ها می‌ریزد و دروازه بی‌صدا باز می‌شود، طوری که هیچ‌کس نمی‌شنود. دره در صبح خاکستری است و جاده مال توست.'
			پایان2: 'از دروازه بیرون رفتی.'
			برد
		)
	]

¶اتاقی که این شناسه را دارد. وقتی هیچ اتاقی پیدا نشود، find() مقدار ø را برمی‌گرداند. شناسه‌ای که اتاقی ندارد یک حفره در نقشه است، نه یک پیچ در داستان. برای همین، اتاق اول جای آن را می‌گیرد.¶
ƒ برو2(خواسته•'')•اتاق2 اتاق‌ها.پیداکردن(
		ƒ(اتاق4•اتاق2) اتاق4.شناسه2 = خواسته
	) ?? اتاق‌ها[1]

¶درهایی که واقعاً می‌توانی از اینجا از آن‌ها بروی. دری که قفل است و چیزی برایش نداری اصلاً نشان داده نمی‌شود. پس مثل یک دیوار به نظر می‌آید تا وقتی چیزی که آن را باز می‌کند در دستت باشد.¶
ƒ راه‌ها(اینجا•اتاق2 کوله2•[''])•[در2]
	اینجا.درها.صافی(
		ƒ(در3•در2) (در3.نیازدارد = '') | کوله2.دارد(
					در3.نیازدارد
				)
	)

¶وارد یک اتاق شو و هر چه در آن هست بردار. add() با کمال میل یک چاقوی دوم هم به تو می‌دهد، پس اول بپرس.¶
ƒ رسیدن(اینجا2•اتاق2 کوله3•[''])•سفر
	سفر(
		اینجا2.شناسه2
		((اینجا2.برداشتن2 ≠ '') & (~کوله3.دارد(اینجا2.برداشتن2))) ? کوله3.با(
				اینجا2.برداشتن2
			) کوله3
	)

کلید4: کلید()

¶یک فشار کلید، به ترتیب: در یک پایان، هر کلیدی تو را دوباره در اتاق اول بیدار می‌کند. کلیدی که ۱، ۲ یا ۳ نباشد معنایی ندارد. عددی بیشتر از تعداد درهای این اتاق هم معنایی ندارد. و فقط بعد از آن، یک در است. آن آزمون سوم ارزش نوشتن دارد، چون دسترسی به فهرست دور می‌زند. بدون آن، فشار دادن ۳ در اتاقی با دو در، بی‌صدا در اول را باز می‌کند.¶
ƒ قدم(س•سفر ک•'')•سفر (
		اینجا3: برو2(س.اتاق3)
		درها2: راه‌ها(اینجا3 س.کوله)
		اینجا3.پایان2 ≠ '' ? سفر('سلول' [])
			~((ک = '1') | (ک = '2') | (ک = '3')) ? س
				(ک → #) > درها2.طول() ? س
					رسیدن(برو2(درها2[ک → #].اتاق) س.کوله)
	)

سفر2•سفر: سفر('سلول' []) … ∆ کلید4 … قدم(سفر2 کلید4)

اینجا4: برو2(سفر2.اتاق3)
درها3: راه‌ها(اینجا4 سفر2.کوله)

¶چیزی که با خودت داری، فقط وقتی نشان داده می‌شود که چیزی همراه داشته باشی.¶
همراهداری:
	سفر2.کوله.طول() > 0
	? [
			عبارت(
				`*همراه دارم* \سفر2.کوله.پیوستن(' · ')\`
				اندازه: 0.3m
				ترازبندی: '|'
				رنگ: رنگ(60% 30 0°)
			)
		]
		[]

¶چیزی که زیر اتاق است: درهایش، شماره‌گذاری شده تا آنچه می‌خوانی همان چیزی باشد که فشار می‌دهی. یا در یک پایان، اینکه چگونه تمام شد و تنها کلیدی که دوباره شروعش می‌کند.¶
پایین2:
	اینجا4.پایان2 ≠ ''
	? [
			عبارت(
				`*\اینجا4.پایان2\*`
				اندازه: 0.8m
				ترازبندی: '|'
				رنگ: اینجا4.برد ? رنگ(85% 50 90°) رنگ(45% 40 25°)
				مدت: 1.5s
				درحالورود: ژست(شفافیت: 0% گامموسیقی: 0.5)
			)
			عبارت(
				`برای بیدار شدن دوباره، هر کلیدی را فشار بده`
				اندازه: 0.3m
				ترازبندی: '|'
				مدت: 3s
				درحالورود: ژست(شفافیت: 0%)
			)
		]
		درها3.ترجمه‌کردن(
			ƒ(در4•در2 اندیس2•#)
				عبارت(
					`\اندیس2\. *\در4.برچسب\*`
					اندازه: 0.5m
					ترازبندی: '|'
					نام: در4.برچسب
					مدت: 1s
					درحالورود: ژست(شفافیت: 0%)
				)
		)

صحنه(
	[
		گروه(
			پشته()
			[
				عبارت(
					اینجا4.توضیح2
					اندازه: 0.5m
					پیچیدن: 14m
					ترازبندی: '|'
					نام: اینجا4.شناسه2
					مدت: 0.5s
					درحالورود: ژست(فاصله: مکان(0m 2m))
				)
				:همراهداری
				:پایین2
			]
		)
	]
	پس‌زمینه: رنگ(0 0 0°)
	رنگ: رنگ(100% 0 0°)
	قلم: "Permanent Marker"
)
