K
چیدمان‌ها
=== start
¶ردیف‌ها، دسته‌ها و گروه‌های عبارت، هرکدام در یک حالت متحرک.¶
تپش2: دنباله(
		{
			0%: ژست(گامموسیقی: .9)
			50%: ژست(گامموسیقی: 1.1)
			100%: ژست(گامموسیقی: .9)
		}
	)
جهش‌ز: دنباله(
		{
			0%: ژست(فاصله: جای(z: 0m))
			50%: ژست(فاصله: جای(z: -2m))
			100%: ژست(فاصله: جای(z: 0m))
		}
		1s
	)

گروه(
	سطر()
	[
		گروه(
			پشته()
			[
				عبارت('بچه‌گربه')
				عبارت('گربه' درحالاستراحت: جهش‌ز)
				گروه(
					سطر()
					[عبارت('سگ') عبارت('سگ‌سان')]
					درحالاستراحت: تپش2
				)
				عبارت('گربه‌سان')
			]
		)
		گروه(
			پشته()
			[
				عبارت('سلام')
				عبارت('سلام')
			]
			درحالاستراحت: دنباله.چرخش(2s "straight")
		)
	]
)