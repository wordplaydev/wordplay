K
چیدمان‌ها
=== start
¶ردیف‌ها، پشته‌ها و گروه‌هایی از عبارت‌ها که هر کدام حالت‌های متحرک نمایشی می‌گیرند.¶

تپش2: دنباله(
		{
			0%: ژست(گامموسیقی: .9)
			50%: ژست(گامموسیقی: 1.1)
			100%: ژست(گامموسیقی: .9)
		}
	)
زبانس: دنباله(
		{
			0%: ژست(فاصله: مکان(z: 0m))
			50%: ژست(فاصله: مکان(z: -2m))
			100%: ژست(فاصله: مکان(z: 0m))
		}
		1s
	)

گروه(
	سطر()
	[
		گروه(
			پشته()
			[
				عبارت('گربه‌کوچولو')
				عبارت('گربه' درحالاستراحت: زبانس)
				گروه(
					سطر()
					[عبارت('سگ') عبارت('سگ‌سانان')]
					درحالاستراحت: تپش2
				)
				عبارت('گربه‌سانان')
			]
		)
		گروه(
			پشته()
			[
				عبارت('سلام')
				عبارت('درود')
			]
			درحالاستراحت: دنباله.چرخش(2s "straight")
		)
	]
)