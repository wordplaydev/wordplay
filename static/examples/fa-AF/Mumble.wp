=== start
¶کلیک کن تا زمزمه بلندتر شود.¶
کلیک‌ها•#: 0 … ∆ دکمه() … کلیک‌ها + 1

کلیک‌ها < 3 ?
	عبارت(
		'زمزمه کن'
		اندازه: 1m
		نام: 'زمزمه'
		درحالورود: ژست(گامموسیقی: 0)
		درحالاستراحت: دنباله(
			{
				0%: ژست(گامموسیقی: (کلیک‌ها + 1) × 1.1)
				50%: ژست(گامموسیقی: (کلیک‌ها + 1) × 0.9)
				100%: ژست(گامموسیقی: (کلیک‌ها + 1) × 1.1)
			}
			مدت: 0.5s
		)
		درحالخروج: دنباله(
			{
				0%: ژست(شفافیت: 1 گامموسیقی: 1)
				100%: ژست(شفافیت: 0 گامموسیقی: 10)
			}
			مدت: 2s
		)
	)
	عبارت('تمام شد')