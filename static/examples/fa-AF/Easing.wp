s
نرمی توالی
===
¶همان انیمیشن ماشین به هشت شکل، یکی برای هر سبک نرمی حرکت.¶
فریم‌هایکلیدی: {
		0%: ژست(فاصله: جای(-1m 0m))
		25%: ژست(فاصله: جای(1m 0m))
		50%: ژست(فاصله: جای(1m 0m))
		75%: ژست(فاصله: جای(-1m 0m))
		100%: ژست(فاصله: جای(-1m 0m))
	}

صحنه(
	[
		گروه(
			شبکه(4 2 فاصلهخانه: 0.25m)
			[
				عبارت('مستقیم' اندازه: 0.25m)
				عبارت(
					"🚗"
					درحالاستراحت: دنباله(
						فریم‌هایکلیدی
						3s
						سبک: "straight"
					)
				)
				عبارت('محتاط' اندازه: 0.25m)
				عبارت(
					"🚚"
					درحالاستراحت: دنباله(
						فریم‌هایکلیدی
						3s
						سبک: "cautious"
					)
				)
				عبارت('کند' اندازه: 0.25m)
				عبارت(
					"🚙"
					درحالاستراحت: دنباله(
						فریم‌هایکلیدی
						3s
						سبک: "pokey"
					)
				)
				عبارت('تندرو' اندازه: 0.25m)
				عبارت(
					"🏎"
					درحالاستراحت: دنباله(
						فریم‌هایکلیدی
						3s
						سبک: "zippy"
					)
				)
			]
		)
	]
)