s
نرمی حرکت در دنباله
===
¶همان انیمیشن موتر به هشت شکل، برای هر سبک نرم‌شدن حرکت یکی.¶

کلیدفریم‌ها: {
		0%: ژست(فاصله: مکان(-1m 0m))
		25%: ژست(فاصله: مکان(1m 0m))
		50%: ژست(فاصله: مکان(1m 0m))
		75%: ژست(فاصله: مکان(-1m 0m))
		100%: ژست(فاصله: مکان(-1m 0m))
	}

صحنه(
	[
		گروه(
			شبکه(4 2 فاصلهخانه: 0.25m)
			[
				عبارت('مستقیم' اندازه: 0.25m)
				عبارت(
					"🚗"
					درحالاستراحت: دنباله(
						کلیدفریم‌ها
						3s
						سبک: "straight"
					)
				)
				عبارت('محتاط' اندازه: 0.25m)
				عبارت(
					"🚚"
					درحالاستراحت: دنباله(
						کلیدفریم‌ها
						3s
						سبک: "cautious"
					)
				)
				عبارت('آهسته' اندازه: 0.25m)
				عبارت(
					"🚙"
					درحالاستراحت: دنباله(کلیدفریم‌ها 3s سبک: "pokey")
				)
				عبارت('تند و چابک' اندازه: 0.25m)
				عبارت(
					"🏎"
					درحالاستراحت: دنباله(کلیدفریم‌ها 3s سبک: "zippy")
				)
			]
		)
	]
)