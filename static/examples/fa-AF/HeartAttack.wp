		0m
		عمقمنو
		⊥
		0m
		0m
		0m
		0
		پیداکردنزامبی‌ها()
	)
	… (∆ تیک | ∆ کلید5 | ∆ اشاره‌گر2 | ∆ ضربه2) …
		(بازی6.مرحله = 2)
		? (∆ تیک ? پیشبردندنیا(بازی6)
					(∆ کلید5 ? اعمالفشارکلید(بازی6 کلید5)
							(∆ اشاره‌گر2 ? تمرکزبهسمت(بازی6 اشاره‌گر2.x) پرتابقلب(
										بازی6
									))))
			(∆ تیک ? بازی6
					(∆ کلید5 ? ((کلید5 = 'Enter') ? بازینو() بازی6)
							(∆ ضربه2 ? بازینو() بازی6)))

¶یک شکل روی صحنه: زامبی‌ها تاب می‌خورند و آدم‌های برگشته یک جهش کوچک و شاد می‌کنند. بقیه‌اش کار عمق است: زامبیِ در حال حمله وقتی نزدیک می‌شود بزرگ‌تر به نظر می‌رسد. مدت ۰ ثانیه هر قدم را فوری انجام می‌دهد، نه آرام‌آرام، پس حرکت مثل فریم‌های روان دیده می‌شود، نه مثل رسیدنِ کند و عقب‌مانده.¶
ƒ نمایزامبی(زامبی11•زامبی)
	عبارت(
		زامبی11.چهره3
		2m
		مدت: 0s
		مکان: مکان(زامبی11.x3 0m زامبی11.z2)
		درحالاستراحت: زامبی11.زنده
		? دنباله.تاب(4° 1s "zippy")
			دنباله(
				{
					0%: ژست(گامموسیقی: 1)
					50%: ژست(گامموسیقی: 1.2)
					100%: ژست(گامموسیقی: 1)
				}
				0.6s
			)
	)

¶کف: میله‌هایی در عمق‌های روبه‌افزایش که پرسپکتیو آن‌ها را مثل زمینی می‌بیند که تا افق دور می‌شود، با محو شدن از سبز به سبز-آبی برای حال‌وهوا. اولین میله همان خطی است که زامبی باید از آن رد شود تا بازی تمام شود، و با قرمزِ هشدار کشیده شده تا قانون دیده شود: دوربین در صفحه‌های کوچک عقب می‌رود و بیننده می‌تواند دور کند، و زامبیِ دور به نظر آمده هنگام رسیدن به تو هنوز روی همین خط ایستاده است.¶
