M
گلابی‌ها
=== start/en
¶این یک داستان کوتاه و تعاملی است. این داستان چند صحنهٔ جدا از هم دارد و بر اساس کارهای مختلف، مثل کلیک کردن، برخوردها، و دیگر کارها، بین آن‌ها حرکت می‌کند. بخشی از لذت این داستان، پیدا کردن کارهایی است که باید انجام دهی تا داستان جلو برود.¶

معرفی: [
		عبارت(`پدرم می‌خواست برود.` مکان: مکان(-9m 0m))
	]

تضاد: [
		عبارت(`«مامان»، باید برویم.` مکان: مکان(-8m 7m))
		عبارت(`/«بگیر و برو خانه.»/` مکان: مکان(1m 4m))
		عبارت(`«مامان ما چیزی نمی‌خواهیم!»` مکان: مکان(-8m 1m))
		عبارت(
			`«بگیر و برو خانه!»`
			اندازه: 2m
			مکان: مکان(-6m -4m)
			درحالاستراحت: دنباله.لرزیدن()
		)
	]

اوج‌گیری۱: [
		عبارت(
			`مادربزرگم 炮炮👵🏽 وارد حیاط پشتی شد`
			مکان: مکان(-9m 7m)
		)
		عبارت(`با کنجکاوی دنبالش رفتم` مکان: مکان(-6m 4m))
		عبارت(
			`👵🏽`
			نام: 'پاپو'
			اندازه: 2m
			ماده: ماده()
			مکان: مکان(6m -6m)
			حباب: `/«沙梨🍐، بگیر و برو خانه!»/`
		)
		عبارت(
			`👧🏻`
			نام: 'من'
			اندازه: 1m
			ماده: ماده()
			مکان: جای‌گذاری(مکان(-8m -6m))
		)
	]

اوج‌گیری۲: [
		عبارت(`او کنار یک درخت کوچک ایستاد.` مکان: مکان(-9m 6m))
		عبارت(
			`روی آن ده‌ها گلابی زرد و روشن به هم پیچیده بود.`
			مکان: مکان(-9m 1m)
			پیچیدن: 10m
		)
		عبارت(
			`«مادر، ما هیچ گلابی نمی‌خواهیم.»`
			اندازه: .75m
			مکان: مکان(-4m 0m)
		)
		عبارت(
			`/من یک گلابی می‌خواستم./`
			اندازه: 2m
			مکان: مکان(-8m -3m)
		)
		عبارت(
			"🍐"
			اندازه: 2m
			مکان: مکان(-1m -7m)
			نام: 'pear'
			قابلانتخاب
		)
	]

¶ما جاها را از پیش تعیین می‌کنیم تا بتوانیم آن‌ها را از همان جا بیندازیم.¶
جاها: (6 → []).ترجمه‌کردن(
		ƒ() مکان(تصادفی(-2m 2m) تصادفی(-3m -5m))
	)
نقطهٔاوج: [
		عبارت(`او روی خاک زانو زد.` مکان: مکان(-9m 6m))
		عبارت(`یک چاقو برداشت` مکان: مکان(-9m 4m))
		عبارت(`و با دقت شش تا را برید` مکان: مکان(-9m 2m))
		عبارت(
			`و آن‌ها را در سبدِ پایینِ خود انداخت`
			مکان: مکان(-9m 0m)
		)
		عبارت("🧺" اندازه: 4m مکان: مکان(-2m -12m))
		عبارت(
			"🌳"
			نام: "tree"
			اندازه: 5m
			مکان: مکان(-3m -7m)
			قابلانتخاب
		)
		:جاها.ترجمه‌کردن(
			ƒ(جا اندیس2)
				عبارت(
					"🍐"
					نام: "pear\اندیس2\"
					مکان: انتخاب() = 'tree' ? حرکت(جا) جا
				)
		)
		عبارت("🔪" مکان: اشاره‌گر())
	]

پایان‌بندی: [
		عبارت(`او آن‌ها را نزد من آورد` مکان: مکان(-9m 6m))
		عبارت(`کنار من زانو زد` مکان: مکان(-8m 4m))
		عبارت(`و سبد را به من داد` مکان: مکان(-7m 2m))
		عبارت(`/«بگیر، برو خانه»/` مکان: مکان(0m -2m))
	]

اسامیسازندگان: [
		عبارت(`از /امی جی. کو/`)
	]

داستان: [
		معرفی
		تضاد
		اوج‌گیری۱
		اوج‌گیری۲
		نقطهٔاوج
		پایان‌بندی
		اسامیسازندگان
	]

¶شمار کلیک‌ها و ضربه‌ها را نگه دار¶
کلیک2: ∆ دکمه()
¶مدت زمانی که بعد از کلیک روی درخت می‌گذرد را ثبت کن¶
زمانبعدازقطعصحنه: 0ms … انتخاب() = 'tree' … زمان(1000ms)
¶وقتی به پائو پائو می‌رسیم را ثبت کن¶
درخانهٔپاپو: ∆ برخورد('من')
¶وقتی گلابی انتخاب می‌شود را ثبت کن¶
گلابیراانتخابکرد: انتخاب() = 'pear'
¶بخش را بر اساس بخش کنونی تغییر بده¶
بخش2•#:
	1 …
	بخش2 ???
		1: کلیک2
		2: کلیک2
		3: درخانهٔپاپو
		4: گلابیراانتخابکرد
		5: زمانبعدازقطعصحنه > 1500ms
		6: ∆ دکمه()
		⊥
		… بخش2 + 1

