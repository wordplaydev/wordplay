M
ناک
=== start/en
¶این یک داستان کوتاه تعاملی است. در آن چند صحنهٔ جدا تعریف شده است و با کارهای مختلف مثل کلیک، برخورد و کارهای دیگر، بین صحنه‌ها جابه‌جا می‌شود. بخشی از لذت این داستان این است که خودت پیدا کنی چه کاری داستان را جلو می‌برد.¶

مقدمه: [
		عبارت(`بابایم می‌خواست برود.` مکان: مکان(-9m 0m))
	]

تضاد: [
		عبارت(`«مامان»، باید برویم.` مکان: مکان(-8m 7m))
		عبارت(`/«این را بگیر و برو خانه.»/` مکان: مکان(1m 4m))
		عبارت(
			`«مامان، ما هیچ چیز نمی‌خواهیم!»`
			مکان: مکان(-8m 1m)
		)
		عبارت(
			`«این را بگیر و برو خانه!»`
			اندازه: 2m
			مکان: مکان(-6m -4m)
			درحالاستراحت: دنباله.لرزیدن()
		)
	]

اوج‌گیری۱: [
		عبارت(
			`پوپوی من 炮炮👵🏽 وارد حیاط پشتی شد`
			مکان: مکان(-9m 7m)
		)
		عبارت(`من با کنجکاوی دنبالش رفتم` مکان: مکان(-6m 4m))
		عبارت(
			`👵🏽`
			نام: 'پوپو'
			اندازه: 2m
			ماده: ماده()
			مکان: مکان(6m -6m)
			حباب: `/«沙梨🍐، این را بگیر و برو خانه!»/`
		)
		عبارت(
			`👧🏻`
			نام: 'مرا'
			اندازه: 1m
			ماده: ماده()
			مکان: جای‌گذاری(مکان(-8m -6m))
		)
	]

اوج‌گیری۲: [
		عبارت(`او کنار یک درخت کوچک ایستاد.` مکان: مکان(-9m 6m))
		عبارت(
			`روی آن دهن‌ها گلابی زرد و روشن 沙梨 درهم پیچیده بود`
			مکان: مکان(-9m 1m)
			پیچیدن: 10m
		)
		عبارت(
			`«مادر، ما هیچ گلابی‌ای نمی‌خواهیم.»`
			اندازه: .75m
			مکان: مکان(-4m 0m)
		)
		عبارت(
			`/من یک گلابی می‌خواستم./`
			اندازه: 2m
			مکان: مکان(-8m -3m)
		)
		عبارت(
			"🍐"
			اندازه: 2m
			مکان: مکان(-1m -7m)
			نام: 'pear'
			قابلانتخاب
		)
	]

¶ما جاها را از پیش تعیین می‌کنیم تا بتوانیم آن‌ها را از یک نقطهٔ یکسان بیندازیم.¶
مکان‌ها: (6 → []).ترجمه‌کردن(
		ƒ() مکان(تصادفی(-2m 2m) تصادفی(-3m -5m))
	)
اوجداستان: [
		عبارت(`او روی خاک زانو زد.` مکان: مکان(-9m 6m))
		عبارت(`یک چاقو را برداشت` مکان: مکان(-9m 4m))
		عبارت(`و با دقت شش‌تا را برید` مکان: مکان(-9m 2m))
		عبارت(
			`و آن‌ها را در سبد پایینش انداخت`
			مکان: مکان(-9m 0m)
		)
		عبارت("🧺" اندازه: 4m مکان: مکان(-2m -12m))
		عبارت(
			"🌳"
			نام: "tree"
			اندازه: 5m
			مکان: مکان(-3m -7m)
			قابلانتخاب
		)
		:مکان‌ها.ترجمه‌کردن(
			ƒ(قراردادن اندیس2)
				عبارت(
					"🍐"
					نام: "pear\اندیس2\"
					مکان: انتخاب() = 'tree' ? حرکت(قراردادن) قراردادن
				)
		)
		عبارت("🔪" مکان: اشاره‌گر())
	]

گره‌گشایی: [
		عبارت(`آن‌ها را نزد من آورد` مکان: مکان(-9m 6m))
		عبارت(`پیش من زانو زد` مکان: مکان(-8m 4m))
		عبارت(`و سبد را به من داد` مکان: مکان(-7m 2m))
		عبارت(`/«بگیر، برو خانه»/` مکان: مکان(0m -2m))
	]

عنوان‌بندیپایانی: [
		عبارت(`نوشتهٔ /Amy J. Ko/`)
	]

داستان: [
		مقدمه
		تضاد
		اوج‌گیری۱
		اوج‌گیری۲
		اوجداستان
		گره‌گشایی
		عنوان‌بندیپایانی
	]

¶کلیک‌ها و ضربه‌ها را دنبال کن¶
کلیک: ∆ دکمه()
¶دنبال کن که بعد از کلیک روی درخت چقدر زمان می‌گذرد¶
زمانبعدازبرش: 0ms … انتخاب() = 'tree' … زمان(1000ms)
¶دنبال کن که چه وقت به پاو پاو می‌رسیم¶
نزدپوپو: ∆ برخورد('مرا')
¶دنبال کن که چه وقت گلابی انتخاب می‌شود¶
گلابیرابرگزید: انتخاب() = 'pear'
¶بخش را بر اساس بخش فعلی تغییر بده¶
بخش2•#:
	1 …
	بخش2 ???
		1: کلیک
		2: کلیک
		3: نزدپوپو
		4: گلابیرابرگزید
		5: زمانبعدازبرش > 1500ms
		6: ∆ دکمه()
		⊥
		… بخش2 + 1

صحنه(
	داستان[بخش2]
	قلم: 'Arvo'
	مکان: مکان(0m 0m -20m)
	قاب: مستطیل(-10m 10m 10m -10m)
)