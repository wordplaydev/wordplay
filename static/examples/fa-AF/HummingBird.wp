¶آیا مانعی همین الان از کنار پرنده گذشت؟¶
ƒ ردشد(x4•#m) (x4 ≤ -5m) & (x4 > (-5m - سرعت2))

امتیاز•#: 0 …
	(بازی2.مرحله = 1) | ((بازی2.مرحله = 2) & ∆ تیک) …
		(بازی2.مرحله = 1) ? 0
			(ردشد(لوله۱.x3) | ردشد(لوله۲.x3) | ردشد(لوله۳.x3) | ردشد(
						لوله۴.x3
					)) ? امتیاز + 1
				امتیاز

¶یک ستون از ایموجی‌ها را مثل ستونی واقعی بساز. مدتِ ۰ ثانیه باعث می‌شود برگشتن به سمت راست فوری باشد و لغزیدنی دیده نشود.¶
ƒ ستون(خانه‌ها•# ژانر2•# x5•#m y3•#m)
	گروه(
		پشته('|' 0m)
		(خانه‌ها → []).ترجمه‌کردن(
			ƒ(سلول•#) عبارت(
					ژانرها[ژانر2][1 + ((سلول - 1) % 5)]
					1m
				)
		)
		مکان: مکان(x5 y3)
		ماده: ماده()
		مدت: 0s
	)

¶هر مانع دو ستون است: یکی از آسمان آویزان است و یکی از زمین بالا می‌آید. فاصلهٔ میان آن‌ها حدود ۶ متر است.¶
ƒ پشته‌ها(لوله2•لوله) [
		ستون(
			لوله2.بالا2
			لوله2.ژانر
			لوله2.x3
			6m - (لوله2.بالا2 × 1m)
		)
		ستون(6 - لوله2.بالا2 لوله2.ژانر لوله2.x3 -6m)
	]

¶زمین پرنده را تصادف می‌دهد و آسمان آن را به پایین برمی‌گرداند.¶
زمین2: شکل(
		مستطیل(-8m -5.7m 8m -6m)
		پس‌زمینه: رنگ(60% 60 130°)
	)
آسمان: شکل(مستطیل(-8m 7m 8m 6m) نام: 'sky')
دیوارچپ: شکل(مستطیل(-8.4m 6m -8m -6m))
دیوارراست: شکل(مستطیل(8m 6m 8.4m -6m))

نمایامتیاز: عبارت("\امتیاز\" 1.5m مکان: مکان(-0.5m 4m))
لایه‌هایرویی:
	بازی2.مرحله ???
		1: [عبارت("\شمارش\" 3m مکان: مکان(-1m -1.5m))]
		3: [عبارت('💥' 3m مکان: مکان(-1.5m -1.5m))]
		[]

¶تعویض‌کنندهٔ حالت: شیوهٔ بازیِ انتخاب‌شده روشن است و دیگری کم‌نور.¶
دکمهٔزمزمه: عبارت(
		'🎤'
		0.8m
		نام: 'hum'
		قابلانتخاب
		مکان: مکان(-4.2m 4.7m)
