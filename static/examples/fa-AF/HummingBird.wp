🐤
مرغ مگس‌خوار
=== start/en
¶یک بازی با پرندهٔ زمزمه‌کن! کلیک کن یا کلیدی را بزن تا بال بزند، یا در میکروفون زمزمه کن — پرنده تا ارتفاع بلندی صدای زمزمهٔ تو اوج می‌گیرد. از میان شکاف‌های بین ستون‌های ایموجی رد شو. برخورد با یک ستون یا با زمین بازی را تمام می‌کند؛ پس از برخورد، شمارش معکوس شروع می‌شود و بازی از نو آغاز می‌شود.¶

¶هر مانع یک ستون از ایموجی‌هاست که از یکی از این مجموعه‌ها گرفته شده.¶
سبک‌ها: [
		['🌵' '🌱' '🌿' '🍀' '🎋']
		['🍩' '🧁' '🍰' '🍪' '🍦']
		['🐙' '🐟' '🦀' '🐡' '🦑']
		['🚗' '🚌' '🚕' '🚙' '🚓']
		['🌸' '🌼' '🌻' '🌷' '💐']
		['⭐' '🌟' '✨' '☁' '🌙']
	]

¶مانع در هر تیک چقدر به سمت چپ حرکت می‌کند.¶
سرعت2: 0.2m

¶هر برخورد با پرنده. سقف را 'آسمان' نامیده‌ایم، پس برخورد با آن پرنده را فقط پس می‌زند، نه اینکه بازی را تمام کند.¶
سقوط: برخورد('پرنده')
مرگ‌بار: سقوط•ø ? ⊥ (سقوط.شیء ≠ 'sky')

تیک: زمان(40ms)
ضربانبازی: زمان(100ms)

¶حالت بازی: یک مرحله (۱ = شمارش معکوس، ۲ = در حال بازی، ۳ = برخورد کرده) و اینکه چند دهم ثانیه در آن مرحله بوده‌ایم. به‌جای کم کردن زمان‌ها، تیک‌های یک ساعت را می‌شماریم، چون هر Time() از صفر شروع می‌شود.¶
•بازی(مرحله•# تیک‌ها•#)
بازی2•بازی: بازی(1 0) …
	∆ ضربانبازی | مرگ‌بار …
		بازی2.مرحله ???
			1: (بازی2.تیک‌ها ≥ 36) ? بازی(2 0) بازی(
					1
					بازی2.تیک‌ها + 1
				)
			2: مرگ‌بار ? بازی(3 0) بازی2
			3: (بازی2.تیک‌ها ≥ 25) ? بازی(1 0)
				¶وقتی پرنده روی چیزی آرام گرفته، برخوردها این واکنش را همیشه مشغول نگه می‌دارند؛ فقط تیک‌های واقعی ساعت را بشمار تا مکث همیشه به یک اندازه باشد.¶
				بازی(3 بازی2.تیک‌ها + (∆ ضربانبازی ? 1 0))
			بازی2

¶عدد شمارش معکوس برای نمایش: ۳، ۲، ۱.¶
شمارش: (بازی2.تیک‌ها < 12) ? 3 (بازی2.تیک‌ها < 24) ? 2 1

¶با انتخاب دکمهٔ 🎤 یا ⌨ نحوهٔ بازی را انتخاب کن: زمزمه کردن پرنده را حرکت می‌دهد، یا کلیک‌ها و کلیدها آن را به بال‌زدن وامی‌دارند. این دو حالت از هم جدا هستند، تا صحبت کردن نزدیک میکروفون با صفحه‌کلید تداخل نکند.¶
انتخاب‌شده: انتخاب()
حالت•'': 'tap' … (انتخاب‌شده = 'hum') | (انتخاب‌شده = 'tap') … انتخاب‌شده

¶در حالت ضربه‌ای، با کلیک یا فشردن هر کلیدی بال بزن.¶
بالزدن: (حالت = 'tap') & (∆ دکمه() | ∆ کلید())

¶در حالت زمزمه، پرنده تا ارتفاعی که صدای زمزمهٔ تو نشان می‌دهد شناور می‌شود — نت‌های پایین نزدیک زمین، نت‌های بالا نزدیک آسمان — و بالاتر از آن نمی‌رود.¶
زیروبمی2: زیروبمی()
زمزمه: (حالت = 'hum') & (زیروبمی2 > 50hz)

ƒ زیروبمیبهارتفاع(هرتز•#hz)
	(هرتز < 80hz) ? -4m
		(هرتز > 400hz) ? 5m
			-4m + (((هرتز - 80hz) ÷ 320hz) × 9m)

¶پرنده کم‌کم به سمت ارتفاعِ زمزمه‌شده حرکت می‌کند، تا به‌جای لرزیدن با هر تغییر کوچک صدا، به آرامی سُر بخورد.¶
زیروبمیوای•#m: 1m … ∆ زیروبمی2 … زمزمه ? (0.8 × زیروبمیوای) + (0.2 × زیروبمیبهارتفاع(
							زیروبمی2
						)) زیروبمیوای

¶پرنده در زمان شمارش معکوس معلق می‌ماند، هنگام بازی به سمت بالا بال می‌زند یا در ارتفاعِ صدای زمزمه شناور می‌شود، و بعد از برخورد زیر نیروی جاذبه سقوط می‌کند.¶
جایپرنده: حرکت(
		جای(-4m 1m)
		مکان‌بعدی:
		(بازی2.مرحله = 1) ? جای(-4m 1m)
			((بازی2.مرحله = 2) & زمزمه) ? جای(-4m زیروبمیوای) ø
		سرعت‌بعدی:
		(بازی2.مرحله = 1) ? سرعت(0m/s 0m/s)
			((بازی2.مرحله = 2) & زمزمه) ? سرعت(0m/s 0m/s)
				((بازی2.مرحله = 2) & بالزدن) ? سرعت(0m/s 15m/s) ø
	)

¶ایموجی جوجه رو به چپ است، پس هر حالت آن را وارونه می‌کند تا رو به مسیری باشد که می‌رود.¶
پرنده: عبارت(
		'🐤'
		1m
		نام: 'پرنده'
		مکان: جایپرنده
		ماده: ماده(1kg 0.4 0)
		درحالاستراحت:
		(بازی2.مرحله = 3) ? ژست(چرخش: 180° برگردانافقی: ⊤)
			دنباله(
				{
					0%: ژست(برگردانافقی: ⊤ چرخش: -12°)
					50%: ژست(برگردانافقی: ⊤ چرخش: 12°)
					100%: ژست(برگردانافقی: ⊤ چرخش: -12°)
				}
				0.35s
			)
	)

¶هر مانع این‌ها را دارد: یک موقعیت افقی، اینکه چند ایموجی از بالا آویزان است، و از کدام مجموعهٔ ایموجی ساخته شده. موانع هنگام بازی به سمت چپ حرکت می‌کنند، دوباره با شکلی تصادفی تازه از سمت راست پدیدار می‌شوند، و برای بازی جدید از نو تنظیم می‌شوند.¶
•pipe(x3•#m بالا2•# سبک2•#)

لولهٔ۱•pipe: pipe(10m تصادفی(1 5) تصادفی(1 6)) …
	((بازی2.مرحله = 1) & (لولهٔ۱.x3 ≠ 10m)) | ((بازی2.مرحله = 2) & ∆ تیک) …
		(بازی2.مرحله = 1) ? pipe(10m تصادفی(1 5) تصادفی(1 6))
			(لولهٔ۱.x3 < -13m) ? pipe(
					لولهٔ۱.x3 + 24m
					تصادفی(1 5)
					تصادفی(1 6)
				)
				pipe(لولهٔ۱.x3 - سرعت2 لولهٔ۱.بالا2 لولهٔ۱.سبک2)

لولهٔ۲•pipe: pipe(16m تصادفی(1 5) تصادفی(1 6)) …
	((بازی2.مرحله = 1) & (لولهٔ۲.x3 ≠ 16m)) | ((بازی2.مرحله = 2) & ∆ تیک) …
		(بازی2.مرحله = 1) ? pipe(16m تصادفی(1 5) تصادفی(1 6))
			(لولهٔ۲.x3 < -13m) ? pipe(
					لولهٔ۲.x3 + 24m
					تصادفی(1 5)
					تصادفی(1 6)
				)
				pipe(لولهٔ۲.x3 - سرعت2 لولهٔ۲.بالا2 لولهٔ۲.سبک2)

لولهٔ۳•pipe: pipe(22m تصادفی(1 5) تصادفی(1 6)) …
	((بازی2.مرحله = 1) & (لولهٔ۳.x3 ≠ 22m)) | ((بازی2.مرحله = 2) & ∆ تیک) …
		(بازی2.مرحله = 1) ? pipe(22m تصادفی(1 5) تصادفی(1 6))
			(لولهٔ۳.x3 < -13m) ? pipe(
					لولهٔ۳.x3 + 24m
					تصادفی(1 5)
					تصادفی(1 6)
				)
				pipe(لولهٔ۳.x3 - سرعت2 لولهٔ۳.بالا2 لولهٔ۳.سبک2)

لولهٔ۴•pipe: pipe(28m تصادفی(1 5) تصادفی(1 6)) …
	((بازی2.مرحله = 1) & (لولهٔ۴.x3 ≠ 28m)) | ((بازی2.مرحله = 2) & ∆ تیک) …
		(بازی2.مرحله = 1) ? pipe(28m تصادفی(1 5) تصادفی(1 6))
			(لولهٔ۴.x3 < -13m) ? pipe(
					لولهٔ۴.x3 + 24m
					تصادفی(1 5)
					تصادفی(1 6)
				)
				pipe(لولهٔ۴.x3 - سرعت2 لولهٔ۴.بالا2 لولهٔ۴.سبک2)

¶آیا مانعی همین الان از کنار پرنده گذشت؟¶
ƒ ردشده(x4•#m) (x4 ≤ -5m) & (x4 > (-5m - سرعت2))

امتیاز•#: 0 …
	(بازی2.مرحله = 1) | ((بازی2.مرحله = 2) & ∆ تیک) …
		(بازی2.مرحله = 1) ? 0
			(ردشده(لولهٔ۱.x3) | ردشده(لولهٔ۲.x3) | ردشده(لولهٔ۳.x3) | ردشده(
						لولهٔ۴.x3
					)) ? امتیاز + 1
				امتیاز

¶یک دستهٔ ایموجی را مانند یک ستون فیزیکی بساز. مدت زمان ۰ باعث می‌شود بازگشت به سمت راست به‌جای یک سُر خوردنِ دیدنی، آنی اتفاق بیفتد.¶
ƒ ستون(خانه‌ها•# سبک3•# x5•#m y3•#m)
	گروه(
		پشته('|' 0m)
		(خانه‌ها → []).ترجمه‌کردن(
			ƒ(سلول•#) عبارت(سبک‌ها[سبک3][1 + ((سلول - 1) % 5)] 1m)
		)
		مکان: جای(x5 y3)
		ماده: ماده()
		مدت: 0s
	)

¶یک مانع از دو ستون تشکیل شده: یکی آویزان از آسمان، یکی روییده از زمین، با فاصله‌ای تقریباً ۶ متری بین آن‌ها.¶
ƒ دسته‌ها(لوله•pipe) [
		ستون(
			لوله.بالا2
			لوله.سبک2
			لوله.x3
			6m - (لوله.بالا2 × 1m)
		)
		ستون(6 - لوله.بالا2 لوله.سبک2 لوله.x3 -6m)
	]

¶زمین پرنده را می‌کوبد؛ آسمان آن را دوباره به پایین برمی‌گرداند.¶
زمین2: شکل(
		مستطیل(-8m -5.7m 8m -6m)
		پس‌زمینه: رنگ(60% 60 130°)
	)
آسمان: شکل(مستطیل(-8m 7m 8m 6m) نام: 'sky')
دیوارچپ: شکل(مستطیل(-8.4m 6m -8m -6m))
دیوارراست: شکل(مستطیل(8m 6m 8.4m -6m))

نمایشامتیاز: عبارت("\امتیاز\" 1.5m مکان: جای(-0.5m 4m))
لایه‌هایرویی:
	بازی2.مرحله ???
		1: [عبارت("\شمارش\" 3m مکان: جای(-1m -1.5m))]
		3: [عبارت('💥' 3m مکان: جای(-1.5m -1.5m))]
		[]

¶تعویض‌کنندهٔ حالت: راه انتخاب‌شده برای بازی روشن است، دیگری کم‌نور.¶
دکمهٔزمزمه: عبارت(
		'🎤'
		0.8m
		نام: 'hum'
		قابلانتخاب: ⊤
		مکان: جای(-4.2m 4.7m)
		درحالاستراحت: (حالت = 'hum') ? ژست() ژست(شفافیت: 40%)
