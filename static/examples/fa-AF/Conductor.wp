		پشته('<' 0.16m)
		[
			عبارت(نشانه2(ویژه) 0.9m رنگ: رنگ(56% 65 25°))
			عبارت(وضعیت() 0.38m رنگ: رنگ(70% 25 30°))
			سطر2('دستت را بالا ببر — سازهای بیشتری از ارکستر')
			سطر2('پایین بیاور — فقط ملودی')
			سطر2('دست به چپ — کندتر · دست به راست — تندتر')
			سطر2('انگشت‌های بالا — ۱ 🎹 · ۲ 🎻 · ۳ 🪈 · ۴ ⚡ · ۵ 🎺')
		]
	)

¶یک کشتی که از صحنه می‌گذرد. در نواری خیلی بالاتر از راهنماها پرواز می‌کند تا هرگز از روی متن نگذرد. مسیرش تعیین می‌کند چقدر بالا پرواز کند و از کجا شروع کند، پس هرگز در یک صف پرواز نمی‌کنند.¶
