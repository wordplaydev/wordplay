🖐
دست
===
¶انگشت‌های خود را جلوی دوربین بگیرید تا یک ایموجی دست همراه با شما بشمارد.¶
دست3: دست()

صحنه(
	[
		عبارت(
			(دست3.انگشتان = 0 ? '✊'
					دست3.انگشتان = 1 ? '☝'
						دست3.انگشتان = 2 ? '✌'
							دست3.انگشتان = 3 ? '🤟'
								دست3.انگشتان = 4 ? '🖖'
									'🖐')
			مکان: دست3.مکان
			اندازه: 2m
			فاصله: جای(-1m)
		)
		گروه(
			سطر('<')
			[
				عبارت('1⃣' فاصله: جای(0m دست3.شست ? 1m 0m))
				عبارت('2⃣' فاصله: جای(0m دست3.اندیس ? 1m 0m))
				عبارت('3⃣' فاصله: جای(0m دست3.میانه ? 1m 0m))
				عبارت('4⃣' فاصله: جای(0m دست3.انگشتری ? 1m 0m))
				عبارت('5⃣' فاصله: جای(0m دست3.کوچک ? 1m 0m))
			]
			مکان: جای(-4.5m 5m)
		)
		گروه(
			پشته('|')
			[
				عبارت((دست3.کف‌دست ? '🤚' '🤛') اندازه: 2m)
				عبارت((دست3.باز ? 'باز' 'بسته') اندازه: 1.5m)
			]
			مکان: جای(-2m -8m)
		)
		عبارت(
			`/دست خود را جلوی دوربین بگیرید/`
			مکان: جای(-6m -10m)
			اندازه: 1m
		)
	]
	مکان: جای(0m 0m -20m)
)