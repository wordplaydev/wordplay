¶کیک در هر ضرب بزرگ می‌شود و بین ضرب‌ها آرام می‌گیرد.¶
ƒ کیک() عبارت('🎂' (4m + ((شمارش % 2) · 0.4m)) مدت: 0.2s)

صحنه(
	[
		گروه(
			پشته(فاصله‌گذاری: 0.5m)
			[
				کیک()
				عبارت('تولدت مبارک' 1.3m)
			]
		)
		موسیقی(
			[
				آهنگ(آهنگ3 ساز: ساز.فلوت ضرب: 0.5beats)
				آهنگ(
					صدایآلتو
					ساز: ساز.ویولن
					ضرب: 0.5beats
					بلندیصدا: 65%
				)
				آهنگ(
					آکوردها
					ساز: ساز.پیانو
					ضرب: 1beats
					بلندیصدا: 55%
				)
			]
			سرعت: 116beats/min
			نام: 'تولد'
		)
	]
	پس‌زمینه: رنگ(18% 20 330°)
	رنگ: رنگ(96% 0 0°)
)
