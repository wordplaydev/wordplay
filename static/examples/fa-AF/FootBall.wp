				(دور3.شوت2.sx - نیمهٔتوپ)
				(دور3.شوت2.sy - نیمهٔتوپ)
			) ø
		سرعت‌بعدی:
		(دور3.مرحله = 1) ? سرعت(0m/s 0m/s 0°/s)
			ضربه‌خورده ? سرعت(
					(دور3.شوت2.سرعت2 · -1)
					((دور3.شوت2.سرعت2 · -1) × دور3.شوت2.شیب)
					تصادفی(-45°/s 45°/s)
				)
				(گرفتهشد | گلشد) ? سرعت(
						تصادفی(8m/s 14m/s)
						تصادفی(-5m/s 5m/s)
						تصادفی(-45°/s 45°/s)
					)
					ø
	)

