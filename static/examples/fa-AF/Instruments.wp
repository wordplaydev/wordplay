		آواز('پیانو' '🎹' ساز.پیانو 260°)
		آواز('گیتار' '🎸' ساز.گیتارصوتی 20°)
		آواز('الکتریک' '⚡' ساز.گیتاربرقی 5°)
		آواز('ویولن' '🎻' ساز.ویولن 40°)
		آواز('فلوت' '🪈' ساز.فلوت 180°)
		آواز('ترومپت' '🎺' ساز.ترومپت 50°)
		آواز('ساکسیفون' '🎷' ساز.ساکسیفون 70°)
		آواز('سازدهنی' '🌬' ساز.هارمونیکا 150°)
		آواز('زنگ' '🔔' ساز.زنگ 55°)
		آواز('طبل‌ها' '🥁' ساز.طبل 0°)
		آواز('دیجریدو' '🎶' ساز.دیجریدو 15°)
		آواز('گربه' '🐱' ساز.پشک 330°)
