هزارتو
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•هزارتو() (
	شبکه2•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ سلول(ردیف2•# ستون•#) (
			خانه‌ها: شبکه2[ردیف2]
			خانه‌ها•[] ? خانه‌ها[ستون] ø
		)

	ƒ مجاز(ردیف3•# ستون2•#) سلول(ردیف3 ستون2)•''
)

هزارتو2: هزارتو()

•حالت(ردیف4•# ستون3•# گام‌ها•#)
(
	ƒ پایین2() حالت(ردیف4 + 1 ستون3 گام‌ها + 1)
	ƒ بالا2() حالت(ردیف4 - 1 ستون3 گام‌ها + 1)
	ƒ چپ2() حالت(ردیف4 ستون3 - 1 گام‌ها + 1)
	ƒ راست2() حالت(ردیف4 ستون3 + 1 گام‌ها + 1)
)

ƒ مجاز2(حالت2•حالت ردیف5•# ستون4•#) هزارتو2.مجاز(
		حالت2.ردیف4 + ردیف5
		حالت2.ستون3 + ستون4
	)

جهت2: انتخاب()
حالت3•حالت: حالت(1 1 0) … ∆ جهت2 …
		((جهت2 = "left") & مجاز2(حالت3 0 -1)) ? حالت3.چپ2()
			((جهت2 = "right") & مجاز2(حالت3 0 1)) ? حالت3.راست2()
				((جهت2 = "up") & مجاز2(حالت3 -1 0)) ? حالت3.بالا2()
					((جهت2 = "down") & مجاز2(حالت3 1 0)) ? حالت3.پایین2(
						)
						حالت3

فعلی: (
		سلول2: هزارتو2.سلول(حالت3.ردیف4 حالت3.ستون3)
		سلول2 ?? ' ')
بالا3: هزارتو2.سلول(حالت3.ردیف4 - 1 حالت3.ستون3)•''
پایین3: هزارتو2.سلول(حالت3.ردیف4 + 1 حالت3.ستون3)•''
چپ3: هزارتو2.سلول(حالت3.ردیف4 حالت3.ستون3 - 1)•''
راست3: هزارتو2.سلول(حالت3.ردیف4 حالت3.ستون3 + 1)•''
برد: فعلی = '🤩'

