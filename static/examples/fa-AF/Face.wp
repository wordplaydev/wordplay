🙂
چهره
===
¶یک ایموجی که چهرهٔ شما را نشان می‌دهد، وقتی لبخند می‌زنید، اخم می‌کنید، دهانتان را باز می‌کنید، یا پلک می‌زنید.¶

چهره3: چهره()

صحنه(
	[
		عبارت(
			(چهره3.mouthOpen ? '😮'
					چهره3.smiling ? '😀'
						چهره3.frowning ? '🙁'
							چهره3.browsRaised ? '😲'
								(چهره3.eyesOpen ? '🙂' '😑'))
			مکان: چهره3.مکان
			اندازه: 4m
		)
		گروه(
			پشته('|')
			[
				عبارت((چهره3.eyesOpen ? '👀' '😑') اندازه: 1.5m)
				عبارت('😊' اندازه: (چهره3.smileAmount · 2m) + 0.5m)
				عبارت(
					'👄'
					اندازه: (چهره3.mouthOpenAmount · 2m) + 0.5m
				)
				عبارت(
					'🤨'
					اندازه: (چهره3.browRaiseAmount · 2m) + 0.5m
				)
			]
			مکان: مکان(-9m 8m)
		)
		عبارت(
			'چرخش 🧭'
			مکان: مکان(9m 8m 0m)
			اندازه: 2m
			چرخش: چهره3.چرخش
		)
		عبارت(
			'خم‌شدن 🧭'
			مکان: مکان(9m 2m)
			چرخش: چهره3.کجی
			اندازه: 2m
		)
		عبارت(
			`/چهرهٔ خود را به دوربین نشان دهید/`
			مکان: مکان(-6m -12m)
			اندازه: 1m
		)
	]
	مکان: مکان(0m 0m -20m)
)