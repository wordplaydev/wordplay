T
شعر
=== start
¶شعری که خط‌هایش یکی‌یکی از راه می‌رسند و هر کدام ورود خودش را دارد.¶

•سطر2(متن2•"" ژست2•ژست|دنباله پشت: رنگ(100 100 100°) جلو: رنگ(
			0
			0
			0°
		))

¶فهرستی از خط‌های شعر که هر کدام یک ژست دارند.¶
شعر: [
		سطر2('فایل رایانه' ژست(شفافیت: 0% فاصله: مکان(y: -5m)))
		سطر2('که از آن' ژست(شفافیت: 0% فاصله: مکان(y: -5m)))
		سطر2('هیچ خاطره‌ای ندارم' ژست(چرخش: 10°))
		سطر2(
			'بازش می‌کنم'
			دنباله(
				{
					0%: ژست(گامموسیقی: 1)
					50%: ژست(گامموسیقی: 0.7)
					100%: ژست(گامموسیقی: 1)
				}
				0.25s
			)
		)
		سطر2('نگاه کن' ژست(شفافیت: 0% فاصله: مکان(y: -5m)))
		سطر2(
			'بیشتر به پایین بکش'
			ژست(شفافیت: 0% فاصله: مکان(y: 5m))
		)
		سطر2('صفحه' ژست(شفافیت: 0% فاصله: مکان(y: -5m)))
		سطر2(
			'روشن و خالی می‌ماند'
			ژست(شفافیت: 0% فاصله: مکان(y: -5m))
			رنگ(0 0 0°)
			رنگ(100 100 0°)
		)
		سطر2(
			'و این‌طور دوباره خودم را می‌بینم'
			ژست(شفافیت: 0% فاصله: مکان(y: -5m))
		)
		سطر2(
			'امیدوار و بی‌فایده'
			ژست(شفافیت: 0% فاصله: مکان(y: -5m))
		)
		سطر2('یک راز' ژست(شفافیت: 0% فاصله: مکان(y: -5m)))
		سطر2(
			'درست همان‌طور که حتماً قبلاً کرده‌ام'
			ژست(شفافیت: 0% فاصله: مکان(y: -5m))
		)
		سطر2('در ۱۹ اوت ۲۰۱۰، ساعت ۱۱:۰۸ صبح' ژست())
	]

عدد3: 1 … ∆ دکمه() | ∆ کلید() …
		(عدد3 = (شعر.طول() + 1)) ? 1 عدد3 + 1
سطر3: شعر[عدد3]

عدد3 ≤ شعر.طول() ?
	صحنه(
		[
			عبارت(
				سطر3.متن2
				درحالورود: سطر3.ژست2
				مدت: 1s
				نام: عدد3 → ""
				سبک: 'cautious'
			)
		]
		پس‌زمینه: سطر3.پشت
		درحالاستراحت: ژست(رنگ: سطر3.جلو)
	)
	صحنه(
		[
			گروه(
				پشته()
				[عبارت('نصیحت به خودم') عبارت('Jane Hirshfield')]
				درحالورود: ژست(گامموسیقی: 0.75)
			)
		]
		پس‌زمینه: رنگ(0% 0 0°)
		رنگ: رنگ(100% 100 0°)
	)