T
شعر
=== start
¶شعری که خط‌هایش آرام‌آرام می‌آیند، هر کدام با آمدنی خاص خودش.¶
•سطر2(متن2•"" حالت•ژست|دنباله پشت: رنگ(100 100 100°) جلو: رنگ(
			0
			0
			0°
		))

¶فهرستی از خط‌های شعر، که هر کدام حالتی دارد.¶
شعر: [
		سطر2('فایل کمپیوتر' ژست(شفافیت: 0% فاصله: جای(y: -5m)))
		سطر2('که' ژست(شفافیت: 0% فاصله: جای(y: -5m)))
		سطر2('هیچ یادم نمی‌آید' ژست(چرخش: 10°))
		سطر2(
			'من آن را باز می‌کنم'
			دنباله(
				{
					0%: ژست(گامموسیقی: 1)
					50%: ژست(گامموسیقی: 0.7)
					100%: ژست(گامموسیقی: 1)
				}
				0.25s
			)
		)
		سطر2('نگاه کن' ژست(شفافیت: 0% فاصله: جای(y: -5m)))
		سطر2(
			'بازهم پایین‌تر برو'
			ژست(شفافیت: 0% فاصله: جای(y: 5m))
		)
		سطر2('صفحه' ژست(شفافیت: 0% فاصله: جای(y: -5m)))
		سطر2(
			'روشن و خالی می‌ماند'
			ژست(شفافیت: 0% فاصله: جای(y: -5m))
			رنگ(0 0 0°)
			رنگ(100 100 0°)
		)
		سطر2(
			'این‌گونه دوباره خودم را می‌بینم'
			ژست(شفافیت: 0% فاصله: جای(y: -5m))
		)
		سطر2(
			'پُر از امید و بی‌فایده'
			ژست(شفافیت: 0% فاصله: جای(y: -5m))
		)
		سطر2('یک راز' ژست(شفافیت: 0% فاصله: جای(y: -5m)))
		سطر2(
			'درست همان‌گونه که خودم کرده بودم'
			ژست(شفافیت: 0% فاصله: جای(y: -5m))
		)
		سطر2('در ۱۹ آگست ۲۰۱۰، ساعت ۱۱:۰۸ صبح' ژست())
	]

عدد3: 1 … ∆ دکمه() | ∆ کلید() …
		(عدد3 = (شعر.طول() + 1)) ? 1 عدد3 + 1
سطر3: شعر[عدد3]

عدد3 ≤ شعر.طول() ?
	صحنه(
		[
			عبارت(
				سطر3.متن2
				درحالورود: سطر3.حالت
				مدت: 1s
				نام: عدد3 → ""
				سبک: 'cautious'
			)
		]
		پس‌زمینه: سطر3.پشت
		درحالاستراحت: ژست(رنگ: سطر3.جلو)
	)
	صحنه(
		[
			گروه(
				پشته()
				[عبارت('نصیحتی به خودم') عبارت('جین هیرشفیلد')]
				درحالورود: ژست(گامموسیقی: 0.75)
			)
		]
		پس‌زمینه: رنگ(0% 0 0°)
		رنگ: رنگ(100% 100 0°)
	)