¶یک قایق. با هر ضرب کمی جلوتر می‌رود و هر بار به سمت مخالف تکان می‌خورد، و همین حس پارو زدن را می‌سازد؛ مسیر تعیین می‌کند چه‌قدر بالا بنشیند و چه‌قدر جلوتر شروع کند، تا همه با هم یکسان حرکت نکنند.¶
ƒ قایق(مسیر2•# آغاز2•#)•عبارت
	عبارت(
		'🚣'
		1.5m
		مکان: جای(
			((((ضربهپارو + آغاز2) % 16) - 8) · 1.1) · 1m
			((مسیر2 · 1.9) - 1.9) · 1m
		)
		چرخش: (((ضربهپارو + مسیر2) % 2) = 0) ? 9° -9°
		مدت: 0.2s
	)

ناوگان: [قایق(0 0) قایق(1 6) قایق(2 11)]

صحنه(
	[
		:ناوگان
		عبارت(
			'〰〰〰〰〰〰〰〰'
			1m
			مکان: جای(-8m -3.2m)
			رنگ: رنگ(48% 22 240°)
		)
		عبارت(
			'بشین پارو بزن، بشین پارو بزن، بشین پارو بزن قایقت را'
			0.9m
			مکان: جای(-4.4m 3.4m)
		)
		موسیقی(
			[
				آهنگ(آهنگ3 ساز: ساز.فلوت ضرب: 0.5beats)
				آهنگ(
					آکوردها
					ساز: ساز.پیانو
					ضرب: 1beats
					بلندیصدا: 60%
				)
				آهنگ(پارو‌ها ساز: ساز.طبل ضرب: 1beats بلندیصدا: 45%)
			]
			سرعت: 144beats/min
			نام: 'قایق'
		)
	]
	پس‌زمینه: رنگ(22% 18 230°)
	رنگ: رنگ(96% 0 0°)
