¶Lumalaki ang keyk sa bawat tibok at humuhupa sa pagitan ng mga ito.¶
ƒ keyk() Parirala(
		'🎂'
		(4m + ((bilang2 % 2) · 0.4m))
		tagal: 0.2s
	)

Entablado(
	[
		Grupo(
			Patongpatong(padding: 0.5m)
			[
				keyk()
				Parirala('Happy Birthday' 1.3m)
			]
		)
		Musika(
			[
				Track(
					himig2
					instrumento: Instrumento.plauta
					beat: 0.5beats
				)
				Track(
					alto
					instrumento: Instrumento.biyolin
					beat: 0.5beats
					lakasNgTunog: 65%
				)
				Track(
					mgaKord
					instrumento: Instrumento.piyano
					beat: 1beats
					lakasNgTunog: 55%
				)
			]
			tempo: 116beats/min
			pangalan: 'kaarawan'
		)
	]
	background: Kulay(18% 20 330°)
	kulay: Kulay(96% 0 0°)
)
