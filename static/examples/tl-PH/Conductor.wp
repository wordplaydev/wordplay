		17𝅗𝅥
	]

kanta: Musika(
		[
			Track(
				martsa
				instrumento: boses2(itinatampok)
				lakasNgTunog: 55%
				beat: 1𝅘𝅥
			)
			Track(
				bass
				instrumento: Instrumento.synthBass
				beat: 1𝅘𝅥
				susi: -24semitones
				lakasNgTunog: narinig(2 30%)
			)
			Track(
				mgaTambol2
				instrumento: Instrumento.mgaTambol
				beat: 1𝅘𝅥
				lakasNgTunog: narinig(3 20%)
			)
			Track(
				martsa
				instrumento: Instrumento.saksopon
				beat: 1𝅘𝅥
				susi: -12semitones
				lakasNgTunog: narinig(4 22%)
			)
			Track(
				pad
				instrumento: Instrumento.synthPad
				beat: 1𝅝
				susi: -12semitones
				lakasNgTunog: narinig(5 16%)
			)
			Track(
				mgaKwerdas
				instrumento: Instrumento.biyolin
				beat: 1𝅘𝅥
				lakasNgTunog: narinig(6 18%)
			)
			Track(
				mgaKampanilya
				instrumento: Instrumento.kampana
				beat: 1𝅝
				susi: 12semitones
				lakasNgTunog: narinig(7 12%)
			)
			Track(
				counter
				instrumento: Instrumento.plauta
				beat: 1𝅘𝅥
				lakasNgTunog: narinig(8 14%)
			)
		]
		tempo: bilis2 · 1beats/min
		iskala: Musika.chromatic
		pangalan: 'imperyal na martsa'
	)

¶Kung gaano na kalayo ang narating ng hukbo. Binibilang nito ang sarili nitong tick sa halip na basahin ang orasan, at mas mabilis itong binibilang kapag mas mabilis ang martsa, kaya lumilipad ang mga barko ayon sa tempo.¶
maglakbay: 0 … ∆ Oras(40ms) … maglakbay + (bilis2 ÷ 72)

ƒ katayuan()•'' '\mgaLayer\ of 8 playing · \bilis2\ beats a minute'

¶Isang linya ng mga panuto, madilim para mauna munang mabasa ang hukbo at ang pangunahing manlalaro.¶
ƒ linya(teksto2•'')•Parirala Parirala(
		teksto2
		0.3m
		kulay: Kulay(64% 4 265°)
	)

¶Ang mga panuto, nakasalansan sa kaliwang gilid sa halip na nasa gitna, para tuluy-tuloy na mabasa ito pababa.¶
ipakita: Grupo(
		Patongpatong('<' 0.16m)
		[
			Parirala(
				icon(itinatampok)
				0.9m
				kulay: Kulay(56% 65 25°)
			)
			Parirala(katayuan() 0.38m kulay: Kulay(70% 25 30°))
			linya(
				'itaas ang iyong kamay — mas maraming orkestra'
			)
			linya('ibaba ito — nag-iisang himig')
			linya(
				'kamay pakaliwa — mas mabagal · kamay pakanan — mas mabilis'
			)
			linya(
				'mga daliring nakataas — 1 🎹 · 2 🎻 · 3 🪈 · 4 ⚡ · 5 🎺'
			)
		]
	)

¶Isang barko na tumatawid sa entablado, lumilipad sa isang bandang mataas nang husto sa itaas ng mga panuto para hindi ito dumaan sa teksto. Itinatakda ng lane nito kung gaano ito kataas lumipad at kung gaano ito kalayo magsimula, kaya hindi sila kailanman lumilipad nang magkasabay.¶
ƒ barko(glyph•'' linya2•# bilis3•#)•Parirala
	Parirala(
		glyph
		0.7m
		lugar: Lugar(
			(((((maglakbay · bilis3) + (linya2 · 47)) % 200) - 100) · 0.045) · 1m
			((linya2 · 0.65) + 2.2) · 1m
		)
	)

plota: [
		barko('🛸' 0 3)
		barko('🚀' 1 2)
		barko('🛰' 2 4)
		barko('🛸' 3 5)
	]

ƒ bituin(x2•# y2•# sukat2•#)•Parirala
	Parirala(
		'✦'
		sukat2 · 1m
		lugar: Lugar(x2 · 1m y2 · 1m)
		kulay: Kulay(46% 8 275°)
	)

¶Nagla-zoom ang entablado para bumagay sa kahit anong nasa loob nito, kaya kung may gumagalaw, muling babagayin ang buong larawan sa bawat tick at magpapalutang-lutang sa mga salita. Ang apat na sulok na bituin ay mas malayo pa kaysa sa kahit saang lipad ng mga barko at mas malayo pa kaysa sa pinakamahabang linya ng teksto, kaya may isang balangkas ang pagbagay na hindi kailanman nagbabago, at nananatiling matatag ang larawan. Ang natitira ay langit lamang.¶
mgaBituin: [
		bituin(-5.6 -2.3 0.18)
		bituin(5.6 -2.3 0.18)
		bituin(-5.6 5 0.18)
		bituin(5.6 5 0.18)
		bituin(-4.9 2.1 0.22)
		bituin(-3.9 3.9 0.14)
		bituin(-2.2 2.5 0.18)
		bituin(1.1 3.4 0.14)
		bituin(2.7 4.4 0.22)
		bituin(4.6 2.7 0.14)
	]

Entablado(
	[:mgaBituin :plota ipakita kanta]
	background: Kulay(7% 6 275°)
	kulay: Kulay(88% 3 265°)
)
