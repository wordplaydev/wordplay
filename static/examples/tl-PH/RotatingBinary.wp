1
RotatingBinary
=== start/en
¶Isang larangan ng mga isa at sero, dahan-dahang umiikot sa lugar.¶
mabagalNaIkot: Pagkakasunodsunod.iikot(10s "straight")

Entablado(
	[
		Parirala(
			'1'
			lugar: Lugar(-0.5m -0.125m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'0'
			lugar: Lugar(1.25m -0.25m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'1'
			lugar: Lugar(-2.3125m 0.0625m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'0'
			lugar: Lugar(-1.6875m -1m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'1'
			lugar: Lugar(-1.4375m 0.75m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'0'
			lugar: Lugar(0.375m -1.3125m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'0'
			lugar: Lugar(-0.6875m -1.75m 0m)
			nagpapahinga: mabagalNaIkot
		)
		Parirala(
			'1'
			lugar: Lugar(0.4375m 1.125m 0m)
			nagpapahinga: mabagalNaIkot
		)
	]
)