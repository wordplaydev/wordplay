¶Bir tekne. Her vuruşta biraz daha ileri kayıyor ve her seferinde ters yöne sallanıyor; kürek çekmek gibi görünmesini sağlayan da bu. Şerit, teknenin ne kadar yükseğe oturduğunu ve ne kadar önde başladığını belirliyor, böylece hep birlikte hareket etmiyorlar.¶
ƒ tekne(şerit•# başlangıç2•#)•İfadeetmek
	İfadeetmek(
		'🚣'
		1.5m
		yer: Yer(
			((((kürekÇekişi + başlangıç2) % 16) - 8) · 1.1) · 1m
			((şerit · 1.9) - 1.9) · 1m
		)
		rotasyon: (((kürekÇekişi + şerit) % 2) = 0) ? 9° -9°
		süre: 0.2s
	)

filo: [tekne(0 0) tekne(1 6) tekne(2 11)]

Sahne(
	[
		:filo
		İfadeetmek(
			'〰〰〰〰〰〰〰〰'
			1m
			yer: Yer(-8m -3.2m)
			renk: Renk(48% 22 240°)
		)
		İfadeetmek(
			'Row, row, row your boat'
			0.9m
			yer: Yer(-4.4m 3.4m)
		)
		Müzik(
			[
				Parça(ezgi çalgı: Çalgı.flüt vuruş: 0.5beats)
				Parça(
					akorlar
					çalgı: Çalgı.piyano
					vuruş: 1beats
					sesDüzeyi: 60%
				)
				Parça(
					kürekler
					çalgı: Çalgı.davul
					vuruş: 1beats
					sesDüzeyi: 45%
				)
			]
			tempo: 144beats/min
			isim: 'tekne'
		)
	]
	arkaplan: Renk(22% 18 230°)
	renk: Renk(96% 0 0°)
)
