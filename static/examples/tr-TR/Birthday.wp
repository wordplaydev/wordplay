¶Pasta her vuruşta büyür ve aralarında sakinleşir.¶
ƒ pasta() İfadeetmek(
		'🎂'
		(4m + ((sayaç % 2) · 0.4m))
		süre: 0.2s
	)

Sahne(
	[
		Grup(
			Yığın(dolgu: 0.5m)
			[
				pasta()
				İfadeetmek('İyi ki Doğdun' 1.3m)
			]
		)
		Müzik(
			[
				Parça(ezgi çalgı: Çalgı.flüt vuruş: 0.5beats)
				Parça(
					alto
					çalgı: Çalgı.keman
					vuruş: 0.5beats
					sesDüzeyi: 65%
				)
				Parça(
					akorlar
					çalgı: Çalgı.piyano
					vuruş: 1beats
					sesDüzeyi: 55%
				)
			]
			tempo: 116beats/min
			isim: 'doğum günü'
		)
	]
	arkaplan: Renk(18% 20 330°)
	renk: Renk(96% 0 0°)
)
