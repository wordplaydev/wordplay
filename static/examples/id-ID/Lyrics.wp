		)
		baris2('Dalam ledakan antarbintang' 275 4.5 5)
		baris2(
			'Aku kembali untuk menyelamatkan alam semesta'
			283
			5
			1
		)
	]

¶Baris yang jendelanya mencakup ketukan ini, atau ø di antaranya — yang merupakan sebagian besar lagu ini, karena sebagian besar bersifat instrumental.¶
menampilkan: garis.menemukan(
		ƒ(l2•baris2) (hitungan2 ≥ l2.awal2) & (hitungan2 < (l2.awal2 + l2.tahan))
	)

¶Perlakuannya, satu untuk setiap jenis.¶
ƒ ucapkan(l3•baris2)•Frasa
	(l3.jenis2 = 2) ?
		Frasa(
			l3.kata2
			rotasi: 5°
			memasuki: Pose(kegelapan: 0 rotasi: 0°)
		)
		(l3.jenis2 = 3) ? Frasa(
				l3.kata2
				memasuki: Pose(skala: 2)
			)
			(l3.jenis2 = 4) ?
				Frasa(
					l3.kata2
					warna: Warna(50% 136 337°)
					memasuki: Urutan(
						{
							0%: Pose(mengimbangi: Tempat(0m -2m))
							50%: Pose(mengimbangi: Tempat(0m 2m))
							100%: Pose(mengimbangi: Tempat(0m -2m))
						}
						lamanya: 3s
					)
				)
				(l3.jenis2 = 5) ? Frasa(
						l3.kata2
						memasuki: Urutan.menggoyang(
							0.75s
							menghitung: 5x
						)
					)
					(l3.jenis2 = 6) ?
						Frasa(
							l3.kata2
							memasuki: Urutan(
								{
									0%: Pose(mengimbangi: Tempat(-10m 0m))
									50%: Pose(mengimbangi: Tempat(1m 0m))
									100%: Pose(mengimbangi: Tempat(0m 0m))
								}
								lamanya: 3s
							)
						)
						(l3.jenis2 = 7) ?
							¶Ia muncul seperti benda yang dinamainya: dari jauh dan hampir tidak terlihat menjadi lebih besar dari ukuran aslinya dalam seperempat detik, lalu memantul kecil saat mengendap. Pergeseran z inilah yang membuatnya terasa datang ke arahmu, bukan sekadar membesar — panggung mengubah skala berdasarkan kedalaman, jadi gerakan menuju penonton membuatnya membesar dengan sendirinya.¶
							Frasa(
								l3.kata2
								1.5m
								memasuki: Urutan(
									{
										0%: Pose(
											mengimbangi: Tempat(0m 0m 6m)
											skala: 0.1
											kegelapan: 0
										)
										55%: Pose(
											mengimbangi: Tempat(0m 0m -1.5m)
											skala: 1.3
											kegelapan: 1
										)
										75%: Pose(
											mengimbangi: Tempat(0m 0m 0.5m)
											skala: 0.92
										)
										100%: Pose(
											mengimbangi: Tempat(0m 0m 0m)
											skala: 1
										)
									}
									lamanya: 0.45s
								)
								beristirahat: Urutan.menggoyang(0.4s)
							)
							(l3.jenis2 = 8) ? Frasa(l3.kata2 0.7m)
								Frasa(l3.kata2)

¶Memberi nama pada sebuah baris sesuai kata-katanya sendiri membuatnya menjadi keluarannya sendiri, sehingga panggung tahu bahwa baris itu telah pergi dan bisa memainkan animasi keluarnya @Pose. Tanpa nama itu, setiap baris dari jenis yang sama akan menjadi keluaran yang sama, dan kata-katanya akan berganti tanpa pernah memudar.¶
ƒ dinyanyikan(l4•baris2)•Frasa (
		diucapkan: ucapkan(l4)
		((diucapkan.nama:l4.kata2).keluar:Pose(kegelapan: 0)).lamanya:0.75s
	)

¶Empat lambang nada, berputar mengikuti ketukan. @List/length tidak bisa memastikan bahwa nilainya bukan nol, jadi sisa baginya mungkin berupa ø; angka 0 adalah bentuk ø tersebut.¶
glif2: ['♩' '♪' '♫' '♬']
glif3: glif2[((hitungan2 % glif2.panjang()) ?? 0) + 1]

¶Panggung tidak punya kata-kata untuk sebagian besar lagu ini — intro yang panjang, jeda antar baris, dan outro-nya — jadi alih-alih menjadi gelap, ia menampilkan ketukan. Lambangnya adalah namanya sendiri, jadi setiap lambang muncul dan pergi saat tiba waktunya.¶
ƒ nada2()•Frasa
	Frasa(
		glif3
		2m
		nama: glif3
		warna: Warna(50% 0 0°)
		memasuki: Pose(kegelapan: 0 skala: 0.6)
		keluar: Pose(kegelapan: 0)
		lamanya: 0.3s
	)

¶Isi dari sebuah @Stage tidak bisa kosong (ø), jadi di bagian yang tidak ada kata-katanya, panggung menampilkan ketukan, bukan kekosongan.¶
ƒ kata3()•Frasa
	menampilkan•ø ? nada2() dinyanyikan(menampilkan)

¶Partitur ini: setiap trek pinjaman, dimainkan dengan tempo yang mengikuti hitungan liriknya. Setiap nada punya panjang dan volumenya sendiri, jadi tidak ada bagian di sini yang butuh ketukan — hanya @Music/tempo yang menentukan seberapa cepat semuanya berjalan.¶
