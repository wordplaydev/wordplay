lagu: Musik(
		[
			Trek(
				berbaris
				alatMusik: suara2(unggulan)
				volume: 55%
				ketukan: 1𝅘𝅥
			)
			Trek(
				bas
				alatMusik: AlatMusik.synthBass
				ketukan: 1𝅘𝅥
				kunci: -24semitones
				volume: terdengar(2 30%)
			)
			Trek(
				drum2
				alatMusik: AlatMusik.drum
				ketukan: 1𝅘𝅥
				volume: terdengar(3 20%)
			)
			Trek(
				berbaris
				alatMusik: AlatMusik.saksofon
				ketukan: 1𝅘𝅥
				kunci: -12semitones
				volume: terdengar(4 22%)
			)
			Trek(
				bantalan
				alatMusik: AlatMusik.synthPad
				ketukan: 1𝅝
				kunci: -12semitones
				volume: terdengar(5 16%)
			)
			Trek(
				senar
				alatMusik: AlatMusik.biola
				ketukan: 1𝅘𝅥
				volume: terdengar(6 18%)
			)
			Trek(
				lonceng2
				alatMusik: AlatMusik.lonceng
				ketukan: 1𝅝
				kunci: 12semitones
				volume: terdengar(7 12%)
			)
			Trek(
				penghitung
				alatMusik: AlatMusik.seruling
				ketukan: 1𝅘𝅥
				volume: terdengar(8 14%)
			)
		]
		tempo: kecepatan2 · 1beats/min
		tanggaNada: Musik.kromatik
		nama: 'maret kekaisaran'
	)

¶Seberapa jauh armada telah bergerak. Ia menghitung ketukannya sendiri, bukan membaca jam, dan menghitung lebih cepat saat lagu marétnya lebih cepat, sehingga kapal-kapal terbang mengikuti tempo.¶
berjalan: 0 … ∆ Waktu(40ms) … berjalan + (kecepatan2 ÷ 72)

ƒ status()•'' '\lapisan2\ of 8 playing · \kecepatan2\ beats a minute'

¶Satu baris petunjuk, diredupkan supaya armada dan pemain utama terbaca lebih dulu.¶
ƒ baris2(teks2•'')•Frasa Frasa(
		teks2
		0.3m
		warna: Warna(64% 4 265°)
	)

¶Petunjuk-petunjuk ini disusun rapat ke tepi kiri, bukan di tengah, supaya mata bisa membacanya lurus ke bawah.¶
tampilan: Kelompok(
		Tumpukan('<' 0.16m)
		[
			Frasa(ikon(unggulan) 0.9m warna: Warna(56% 65 25°))
			Frasa(status() 0.38m warna: Warna(70% 25 30°))
			baris2('angkat tanganmu — lebih banyak orkestra')
			baris2('turunkan tanganmu — melodi sendirian')
			baris2(
				'tangan ke kiri — lebih lambat · tangan ke kanan — lebih cepat'
			)
			baris2('jari ke atas — 1 🎹 · 2 🎻 · 3 🪈 · 4 ⚡ · 5 🎺')
		]
	)

¶Sebuah kapal melintasi panggung, terbang pada jalur jauh di atas petunjuk-petunjuk supaya tidak pernah melintasi teksnya. Jalurnya menentukan seberapa tinggi ia terbang dan seberapa jauh titik mulainya, sehingga kapal-kapal tidak pernah terbang berbarisan rapi.¶
ƒ kapal(glif2•'' jalur•# kecepatan3•#)•Frasa
	Frasa(
		glif2
		0.7m
		tempat: Tempat(
			(((((berjalan · kecepatan3) + (jalur · 47)) % 200) - 100) · 0.045) · 1m
			((jalur · 0.65) + 2.2) · 1m
		)
	)

armada: [
		kapal('🛸' 0 3)
		kapal('🚀' 1 2)
		kapal('🛰' 2 4)
		kapal('🛸' 3 5)
	]

ƒ bintang(x2•# y2•# ukuran2•#)•Frasa
	Frasa(
		'✦'
		ukuran2 · 1m
		tempat: Tempat(x2 · 1m y2 · 1m)
		warna: Warna(46% 8 275°)
	)

¶Panggung memperbesar tampilan supaya pas dengan apa pun yang ada di dalamnya, jadi apa pun yang bergerak akan mengubah skala seluruh gambar pada setiap ketukan dan membuat kata-katanya terlihat goyah. Keempat bintang di sudut lebih jauh dari jangkauan terbang kapal mana pun dan lebih jauh dari baris teks terpanjang, jadi tampilannya memiliki bingkai yang tidak pernah berubah dan gambar tetap diam. Sisanya hanyalah langit.¶
stars: [
		bintang(-5.6 -2.3 0.18)
		bintang(5.6 -2.3 0.18)
		bintang(-5.6 5 0.18)
		bintang(5.6 5 0.18)
		bintang(-4.9 2.1 0.22)
		bintang(-3.9 3.9 0.14)
		bintang(-2.2 2.5 0.18)
		bintang(1.1 3.4 0.14)
		bintang(2.7 4.4 0.22)
		bintang(4.6 2.7 0.14)
	]

Panggung(
	[:stars :armada tampilan lagu]
	latarbelakang: Warna(7% 6 275°)
	warna: Warna(88% 3 265°)
)
