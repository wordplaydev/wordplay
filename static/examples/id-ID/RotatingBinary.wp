1
RotatingBinary
=== start/en
¶Sekumpulan angka satu dan nol, berputar perlahan di tempat.¶
spinLambat: Urutan.putaran(10s "straight")

Panggung(
	[
		Frasa(
			'1'
			tempat: Tempat(-0.5m -0.125m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'0'
			tempat: Tempat(1.25m -0.25m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'1'
			tempat: Tempat(-2.3125m 0.0625m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'0'
			tempat: Tempat(-1.6875m -1m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'1'
			tempat: Tempat(-1.4375m 0.75m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'0'
			tempat: Tempat(0.375m -1.3125m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'0'
			tempat: Tempat(-0.6875m -1.75m 0m)
			beristirahat: spinLambat
		)
		Frasa(
			'1'
			tempat: Tempat(0.4375m 1.125m 0m)
			beristirahat: spinLambat
		)
	]
)