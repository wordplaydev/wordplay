Panggung(
	[
		:meletus.menerjemahkan(ƒ(p6•Bagian i2•#) ledakan(p6 i2))
		Musik(
			[
				Trek(
					melodi
					alatMusik: AlatMusik.terompet
					volume: 90%
					perulangan: ⊥
				)
				Trek(
					bas
					alatMusik: AlatMusik.piano
					kunci: -12semitones
					volume: 50%
					geser: -0.4
					perulangan: ⊥
				)
				Trek(
					lonceng2
