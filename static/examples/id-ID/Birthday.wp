	]

¶Kue membesar pada setiap ketukan dan mengecil kembali di antara ketukan.¶
ƒ kue() Frasa(
		'🎂'
		(4m + ((hitungan2 % 2) · 0.4m))
		lamanya: 0.2s
	)

Panggung(
	[
		Kelompok(
			Tumpukan(lapisan: 0.5m)
			[
				kue()
				Frasa('Selamat Ulang Tahun' 1.3m)
			]
		)
		Musik(
			[
				Trek(
					melodi
					alatMusik: AlatMusik.seruling
					ketukan: 0.5beats
				)
				Trek(
					alto
					alatMusik: AlatMusik.biola
					ketukan: 0.5beats
					volume: 65%
				)
				Trek(
					akor
					alatMusik: AlatMusik.piano
					ketukan: 1beats
					volume: 55%
				)
			]
			tempo: 116beats/min
			nama: 'ulang tahun'
		)
	]
	latarbelakang: Warna(18% 20 330°)
	warna: Warna(96% 0 0°)
)
