		人声('小号' '🎺' 乐器.小号 50°)
		人声('萨克斯' '🎷' 乐器.萨克斯管 70°)
		人声('口琴' '🌬' 乐器.口琴 150°)
		人声('铃' '🔔' 乐器.铃 55°)
		人声('鼓' '🥁' 乐器.鼓 0°)
		人声('迪吉里杜管' '🎶' 乐器.迪吉里杜管 15°)
		人声('猫' '🐱' 乐器.猫 330°)
		人声('有音高的猫' '😺' 乐器.有音高的猫 350°)
		人声('狗' '🐶' 乐器.狗 35°)
		人声('有音高的狗' '🐕' 乐器.有音高的狗 125°)
		人声('合成器' '🎛' 乐器.合成器 290°)
