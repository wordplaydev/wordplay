¶蛋糕在每拍时膨胀，在拍与拍之间恢复平静。¶
ƒ 蛋糕() 短语('🎂' (4m + ((计数2 % 2) · 0.4m)) 持续时间: 0.2s)

舞台(
	[
		组合(
			堆叠(填充: 0.5m)
			[
				蛋糕()
				短语('生日快乐' 1.3m)
			]
		)
		音乐(
			[
				音轨(旋律 乐器: 乐器.长笛 节拍: 0.5beats)
				音轨(中音 乐器: 乐器.小提琴 节拍: 0.5beats 音量: 65%)
				音轨(和弦 乐器: 乐器.钢琴 节拍: 1beats 音量: 55%)
			]
			速度: 116beats/min
			名字: '生日'
		)
	]
	背景: 颜色(18% 20 330°)
	颜色: 颜色(96% 0 0°)
)
