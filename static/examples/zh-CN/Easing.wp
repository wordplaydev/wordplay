s
序列缓动
===
¶同一个汽车动画，用了八种不同的缓动方式来表现。¶
关键帧: {
		0%: 姿势(偏移: 位置(-1m 0m))
		25%: 姿势(偏移: 位置(1m 0m))
		50%: 姿势(偏移: 位置(1m 0m))
		75%: 姿势(偏移: 位置(-1m 0m))
		100%: 姿势(偏移: 位置(-1m 0m))
	}

舞台(
	[
		组合(
			网格(4 2 单元格高度: 0.25m)
			[
				短语('直线式' 尺寸: 0.25m)
				短语("🚗" 休息: 排序(关键帧 3s 风格: "straight"))
				短语('谨慎式' 尺寸: 0.25m)
				短语("🚚" 休息: 排序(关键帧 3s 风格: "cautious"))
				短语('慢吞吞式' 尺寸: 0.25m)
				短语("🚙" 休息: 排序(关键帧 3s 风格: "pokey"))
				短语('飞快式' 尺寸: 0.25m)
				短语("🏎" 休息: 排序(关键帧 3s 风格: "zippy"))
			]
		)
	]
)