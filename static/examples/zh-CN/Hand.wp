🖐
手
===
¶对着相机举起手指，一个表情符号手就会跟着数数呀！¶
手2: Hand()

舞台(
	[
		短语(
			(手2.fingers = 0 ? '✊'
					手2.fingers = 1 ? '☝'
						手2.fingers = 2 ? '✌'
							手2.fingers = 3 ? '🤟'
								手2.fingers = 4 ? '🖖'
									'🖐')
			位置: 手2.位置
			尺寸: 2m
			偏移: 位置(-1m)
		)
		组合(
			横排('<')
			[
				短语('1⃣' 偏移: 位置(0m 手2.thumb ? 1m 0m))
				短语('2⃣' 偏移: 位置(0m 手2.index ? 1m 0m))
				短语('3⃣' 偏移: 位置(0m 手2.middle ? 1m 0m))
				短语('4⃣' 偏移: 位置(0m 手2.ring ? 1m 0m))
				短语('5⃣' 偏移: 位置(0m 手2.pinky ? 1m 0m))
			]
			位置: 位置(-4.5m 5m)
		)
		组合(
			堆叠('|')
			[
				短语((手2.palm ? '🤚' '🤛') 尺寸: 2m)
				短语((手2.open ? '张开' '合拢') 尺寸: 1.5m)
			]
			位置: 位置(-2m -8m)
		)
		短语(`/让相机看看你的手/` 位置: 位置(-6m -10m) 尺寸: 1m)
	]
	位置: 位置(0m 0m -20m)
)