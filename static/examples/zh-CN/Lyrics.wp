						进入: 排序.抖动(0.75s 计数: 5x)
					)
					(l3.种类2 = 6) ?
						短语(
							l3.words2
							进入: 排序(
								{
									0%: 姿势(偏移: 位置(-10m 0m))
									50%: 姿势(偏移: 位置(1m 0m))
