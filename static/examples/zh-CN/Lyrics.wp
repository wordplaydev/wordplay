		(l3.种类2 = 3) ? 短语(l3.words2 进入: 姿势(缩放: 2))
			(l3.种类2 = 4) ?
				短语(
					l3.words2
					颜色: 颜色(50% 136 337°)
					进入: 排序(
						{
							0%: 姿势(偏移: 位置(0m -2m))
							50%: 姿势(偏移: 位置(0m 2m))
							100%: 姿势(偏移: 位置(0m -2m))
						}
						时长: 3s
					)
				)
				(l3.种类2 = 5) ? 短语(
