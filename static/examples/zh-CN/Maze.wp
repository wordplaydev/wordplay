=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•迷宫() (
	网格2•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ 单元格2(行•# 列•#) (
			单元格3: 网格2[行]
			单元格3•[] ? 单元格3[列] ø
		)

	ƒ 允许(行2•# 列2•#) 单元格2(行2 列2)•''
)

迷宫2: 迷宫()

•状态(行3•# 列3•# 步数•#)
(
	ƒ 下2() 状态(行3 + 1 列3 步数 + 1)
	ƒ 上() 状态(行3 - 1 列3 步数 + 1)
	ƒ 左() 状态(行3 列3 - 1 步数 + 1)
	ƒ 右() 状态(行3 列3 + 1 步数 + 1)
)

ƒ 允许2(state•状态 行4•# 列4•#) 迷宫2.允许(
		state.行3 + 行4
		state.列3 + 列4
	)

方向2: 选择()
state2•状态: 状态(1 1 0) … ∆ 方向2 …
		((方向2 = "left") & 允许2(state2 0 -1)) ? state2.左()
			((方向2 = "right") & 允许2(state2 0 1)) ? state2.右()
				((方向2 = "up") & 允许2(state2 -1 0)) ? state2.上()
					((方向2 = "down") & 允许2(state2 1 0)) ? state2.下2()
						state2

当前: (
		单元格4: 迷宫2.单元格2(state2.行3 state2.列3)
		单元格4 ?? ' ')
上2: 迷宫2.单元格2(state2.行3 - 1 state2.列3)•''
下3: 迷宫2.单元格2(state2.行3 + 1 state2.列3)•''
左2: 迷宫2.单元格2(state2.行3 state2.列3 - 1)•''
右2: 迷宫2.单元格2(state2.行3 state2.列3 + 1)•''
胜利了: 当前 = '🤩'

舞台(
	[
		组合(
			网格(3 3 0.25m)
			[
				ø
				短语('↑' 名字: 'up' 可选择的: 上2 休息: 姿势(不透明度: 上2 ? 1 0.2))
				ø
				短语(
					'←'
					名字: 'left'
					可选择的: 左2
					休息: 姿势(不透明度: 左2 ? 1 0.2)
				)
				短语(
					当前
					休息: 胜利了 ?
						排序.旋转(时长: 1s 风格: 'straight')
						姿势()
				)
				短语(
					'→'
					名字: 'right'
					可选择的: 右2
					休息: 姿势(不透明度: 右2 ? 1 0.2)
				)
				ø
				短语(
					'↓'
					名字: 'down'
					可选择的: 下3
					休息: 姿势(不透明度: 下3 ? 1 0.2)
				)
				ø
			]
		)
	]
	位置: 位置(0m 0m -3m)
	朝向: 'Noto Emoji'
