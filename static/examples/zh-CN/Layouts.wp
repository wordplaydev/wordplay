K
布局
=== start
¶一行行、一叠叠、一组组的短语，各自摆出生动的姿势。¶
心跳2: 排序({0%: 姿势(缩放: .9) 50%: 姿势(缩放: 1.1) 100%: 姿势(缩放: .9)})
z弹跳: 排序(
		{
			0%: 姿势(偏移: 位置(z: 0m))
			50%: 姿势(偏移: 位置(z: -2m))
			100%: 姿势(偏移: 位置(z: 0m))
		}
		1s
	)

组合(
	横排()
	[
		组合(
			堆叠()
			[
				短语('小猫咪')
				短语('猫' 休息: z弹跳)
				组合(横排() [短语('狗') 短语('犬类')] 休息: 心跳2)
				短语('猫科动物')
			]
		)
		组合(
			堆叠()
			[
				短语('嗨')
				短语('你好')
			]
			休息: 排序.旋转(2s "straight")
		)
	]
)