¶Acordes, um por batida. Um conjunto soa os seus graus em simultâneo, por isso {1 3 5} é a tríade tónica e {4 5 7 9} é a que quer resolver de volta para ela.¶
acordes: [
		ø
		{1 3 5}
		ø
		ø
		{4 5 7 9}
		ø
		ø
		ø
		ø
		ø
		{1 3 5}
		ø
		ø
		ø
		ø
		ø
		{4 6 8}
		ø
		ø
		ø
		{1 3 5}
		ø
		{4 5 7 9}
		{1 3 5}
		ø
		ø
	]

¶O bolo aumenta a cada batida e assenta entre elas.¶
ƒ bolo() Frase(
		'🎂'
		(4m + ((contagem2 % 2) · 0.4m))
		duração: 0.2s
	)

Fase(
	[
		Grupo(
			Monte(preenchimento: 0.5m)
			[
				bolo()
				Frase('Parabéns a Você' 1.3m)
			]
		)
		Música(
			[
				Faixa(
					melodia2
					instrumento: Instrumento.flauta
					batida: 0.5beats
				)
				Faixa(
					alto
					instrumento: Instrumento.violino
					batida: 0.5beats
					volume: 65%
				)
				Faixa(
					acordes
					instrumento: Instrumento.piano
					batida: 1beats
					volume: 55%
				)
			]
			andamento: 116beats/min
			nome: 'aniversário'
		)
	]
	fundo: Cor(18% 20 330°)
	cor: Cor(96% 0 0°)
)
