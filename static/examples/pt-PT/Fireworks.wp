	[
		:aDisparar.traduzir(ƒ(p6•Parte i2•#) explosão(p6 i2))
		Música(
			[
				Faixa(
					melodia2
					instrumento: Instrumento.trompete
					volume: 90%
					ciclo: ⊥
				)
				Faixa(
					baixo
					instrumento: Instrumento.piano
					chave: -12semitones
					volume: 50%
					panorâmica: -0.4
					ciclo: ⊥
				)
				Faixa(
					sino2
					instrumento: Instrumento.sino
					volume: 55%
					ciclo: ⊥
				)
				Faixa(
					violino2
					instrumento: Instrumento.violino
