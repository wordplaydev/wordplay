¶Um barco. Desliza um pouco mais a cada tempo e balança para o outro lado de cada vez, o que dá a sensação de remar; a raia define a altura a que fica e a distância à frente com que começou, para que não se movam todos ao mesmo tempo.¶
ƒ barco(faixa•# iniciar2•#)•Frase
	Frase(
		'🚣'
		1.5m
		local: Local(
			((((remada + iniciar2) % 16) - 8) · 1.1) · 1m
			((faixa · 1.9) - 1.9) · 1m
		)
		rotação: (((remada + faixa) % 2) = 0) ? 9° -9°
		duração: 0.2s
	)

frota: [barco(0 0) barco(1 6) barco(2 11)]

Fase(
	[
		:frota
		Frase(
			'〰〰〰〰〰〰〰〰'
			1m
			local: Local(-8m -3.2m)
			cor: Cor(48% 22 240°)
		)
		Frase(
			'Rema, rema, rema o teu barco'
			0.9m
			local: Local(-4.4m 3.4m)
		)
		Música(
			[
				Faixa(
					melodia2
					instrumento: Instrumento.flauta
					batida: 0.5beats
				)
				Faixa(
					acordes
					instrumento: Instrumento.piano
					batida: 1beats
					volume: 60%
				)
				Faixa(
					remos
					instrumento: Instrumento.bateria
					batida: 1beats
					volume: 45%
				)
			]
			andamento: 144beats/min
			nome: 'barco'
		)
	]
	fundo: Cor(22% 18 230°)
	cor: Cor(96% 0 0°)
)
