🖐
手
===
¶カメラに指を向けると、絵文字の手が数を数えます。¶
手2: 手()

ステージ(
	[
		フレーズ(
			(手2.指 = 0 ? '✊'
					手2.指 = 1 ? '☝'
						手2.指 = 2 ? '✌'
							手2.指 = 3 ? '🤟'
								手2.指 = 4 ? '🖖'
									'🖐')
			位置: 手2.位置
			大きさ: 2m
			ずれ: 位置(-1m)
		)
		グループ(
			行('<')
			[
				フレーズ('1⃣' ずれ: 位置(0m 手2.親指 ? 1m 0m))
				フレーズ('2⃣' ずれ: 位置(0m 手2.人差し指 ? 1m 0m))
				フレーズ('3⃣' ずれ: 位置(0m 手2.中指 ? 1m 0m))
				フレーズ('4⃣' ずれ: 位置(0m 手2.薬指 ? 1m 0m))
				フレーズ('5⃣' ずれ: 位置(0m 手2.小指 ? 1m 0m))
			]
			位置: 位置(-4.5m 5m)
		)
		グループ(
			積み重ね('|')
			[
				フレーズ((手2.手のひら ? '🤚' '🤛') 大きさ: 2m)
				フレーズ((手2.ひらく ? '開く' '閉じる') 大きさ: 1.5m)
			]
			位置: 位置(-2m -8m)
		)
		フレーズ(`/カメラに手を見せてください/` 位置: 位置(-6m -10m) 大きさ: 1m)
	]
	位置: 位置(0m 0m -20m)
)