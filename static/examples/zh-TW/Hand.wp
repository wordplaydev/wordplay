🖐
手
===
¶對著攝影機比出手指，表情符號小手就會跟著你數數。¶
手2: 手()

舞台(
	[
		短語(
			(手2.手指 = 0 ? '✊'
					手2.手指 = 1 ? '☝'
						手2.手指 = 2 ? '✌'
							手2.手指 = 3 ? '🤟'
								手2.手指 = 4 ? '🖖'
									'🖐')
			位置: 手2.位置
			尺寸: 2m
			抵銷: 位置(-1m)
		)
		組合(
			行('<')
			[
				短語('1⃣' 抵銷: 位置(0m 手2.拇指 ? 1m 0m))
				短語('2⃣' 抵銷: 位置(0m 手2.食指 ? 1m 0m))
				短語('3⃣' 抵銷: 位置(0m 手2.中指 ? 1m 0m))
				短語('4⃣' 抵銷: 位置(0m 手2.無名指 ? 1m 0m))
				短語('5⃣' 抵銷: 位置(0m 手2.小指 ? 1m 0m))
			]
			位置: 位置(-4.5m 5m)
		)
		組合(
			堆疊('|')
			[
				短語((手2.手掌 ? '🤚' '🤛') 尺寸: 2m)
				短語((手2.張開 ? '打開' '合上') 尺寸: 1.5m)
			]
			位置: 位置(-2m -8m)
		)
		短語(`／讓攝影機看看你的手／` 位置: 位置(-6m -10m) 尺寸: 1m)
	]
	位置: 位置(0m 0m -20m)
)