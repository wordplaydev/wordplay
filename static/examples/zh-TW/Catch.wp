		短語(
			"🐭"
			可選擇的: ⊤
			位置: 放置
			休息: 抓到了 ? 姿勢(旋轉: 180° 音樂: 撲抓) 姿勢(
				)
			移動: 抓到了 ? 姿勢() 排序(
					{
						0%: 姿勢(旋轉: 0°)
						50%: 姿勢(旋轉: 180° 音樂: 竄逃)
						100%: 姿勢(旋轉: 360°)
					}
				)
			持續時間: 1s
			名字: 'mouse'
		)
	]
	位置: 位置(0m 0m -5m)
	邊框: 矩形(-3m 3m 3m -3m)
)