投影片3: 投影片2[索引2]

舞台(
	[
		組合(
			堆疊('|' 0.4m)
			[
				短語(投影片3.表情符號 尺寸: 2m)
				短語(`*\投影片3.標題\*` 尺寸: 1.2m 對齊: '|')
				短語(投影片3.內文 尺寸: 0.5m 包裹: 12m 對齊: '|')
				短語(`\索引2\ 之 \總計\` 尺寸: 0.25m 對齊: '|')
			]
		)
	]
)
