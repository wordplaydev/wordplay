s
Ομαλή Ροή Ακολουθίας
===
¶Η ίδια κινούμενη εικόνα αυτοκινήτου με οκτώ τρόπους, έναν για κάθε στυλ ομαλής κίνησης.¶
keyframes: {
		0%: Στάση(όφσετ: Θέση(-1m 0m))
		25%: Στάση(όφσετ: Θέση(1m 0m))
		50%: Στάση(όφσετ: Θέση(1m 0m))
		75%: Στάση(όφσετ: Θέση(-1m 0m))
		100%: Στάση(όφσετ: Θέση(-1m 0m))
	}

Στάδιο(
	[
		Ομάδα(
			Πλέγμα(4 2 επένδυσηκελιών: 0.25m)
			[
				Φράση('ευθεία' μέγεθος: 0.25m)
				Φράση(
					"🚗"
					ανάπαυση: Αλληλουχία(
						keyframes
						3s
						στυλ: "straight"
					)
				)
				Φράση('προσεκτικό' μέγεθος: 0.25m)
				Φράση(
					"🚚"
					ανάπαυση: Αλληλουχία(
						keyframes
						3s
						στυλ: "cautious"
					)
				)
				Φράση('αργόστροφο' μέγεθος: 0.25m)
				Φράση(
					"🚙"
					ανάπαυση: Αλληλουχία(keyframes 3s στυλ: "pokey")
				)
				Φράση('γρήγορο' μέγεθος: 0.25m)
				Φράση(
					"🏎"
					ανάπαυση: Αλληλουχία(keyframes 3s στυλ: "zippy")
				)
			]
		)
	]
)