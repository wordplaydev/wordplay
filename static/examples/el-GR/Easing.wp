s
Ομαλή Κίνηση Ακολουθίας
===
¶Η ίδια κίνηση αυτοκινήτου με οκτώ τρόπους, έναν για κάθε στυλ ομαλότητας.¶

βασικάΚαρέ: {
		0%: Στάση(όφσετ: Θέση(-1m 0m))
		25%: Στάση(όφσετ: Θέση(1m 0m))
		50%: Στάση(όφσετ: Θέση(1m 0m))
		75%: Στάση(όφσετ: Θέση(-1m 0m))
		100%: Στάση(όφσετ: Θέση(-1m 0m))
	}

Στάδιο(
	[
		Ομάδα(
			Πλέγμα(4 2 επένδυσηκελιών: 0.25m)
			[
				Φράση('ευθεία' μέγεθος: 0.25m)
				Φράση(
					"🚗"
					ανάπαυση: Αλληλουχία(
						βασικάΚαρέ
						3s
						στυλ: "straight"
					)
				)
				Φράση('προσεκτική' μέγεθος: 0.25m)
				Φράση(
					"🚚"
					ανάπαυση: Αλληλουχία(
						βασικάΚαρέ
						3s
						στυλ: "cautious"
					)
				)
				Φράση('αργή' μέγεθος: 0.25m)
				Φράση(
					"🚙"
					ανάπαυση: Αλληλουχία(βασικάΚαρέ 3s στυλ: "pokey")
				)
				Φράση('γρήγορη' μέγεθος: 0.25m)
				Φράση(
					"🏎"
					ανάπαυση: Αλληλουχία(βασικάΚαρέ 3s στυλ: "zippy")
				)
			]
		)
	]
)