🖐
Χέρι
===
¶Δείξε δάχτυλα στην κάμερά σου και ένα emoji χέρι μετράει μαζί σου.¶
χέρι: Χέρι()

Στάδιο(
	[
		Φράση(
			(χέρι.δάχτυλα = 0 ? '✊'
					χέρι.δάχτυλα = 1 ? '☝'
						χέρι.δάχτυλα = 2 ? '✌'
							χέρι.δάχτυλα = 3 ? '🤟'
								χέρι.δάχτυλα = 4 ? '🖖'
									'🖐')
			θέση: χέρι.θέση
			μέγεθος: 2m
			όφσετ: Θέση(-1m)
		)
		Ομάδα(
			Σειρά('<')
			[
				Φράση('1⃣' όφσετ: Θέση(0m χέρι.αντίχειρας ? 1m 0m))
				Φράση('2⃣' όφσετ: Θέση(0m χέρι.δείκτης ? 1m 0m))
				Φράση('3⃣' όφσετ: Θέση(0m χέρι.μέσο ? 1m 0m))
				Φράση('4⃣' όφσετ: Θέση(0m χέρι.δαχτυλίδι ? 1m 0m))
				Φράση(
					'5⃣'
					όφσετ: Θέση(0m χέρι.μικρόςκόμπος ? 1m 0m)
				)
			]
			θέση: Θέση(-4.5m 5m)
		)
		Ομάδα(
			Σωρός('|')
			[
				Φράση((χέρι.παλάμη ? '🤚' '🤛') μέγεθος: 2m)
				Φράση(
					(χέρι.ανοιχτό ? 'ανοιχτό' 'κλειστό')
					μέγεθος: 1.5m
				)
			]
			θέση: Θέση(-2m -8m)
		)
		Φράση(
			`/Δείξε το χέρι σου στην κάμερα/`
			θέση: Θέση(-6m -10m)
			μέγεθος: 1m
		)
	]
	θέση: Θέση(0m 0m -20m)
)