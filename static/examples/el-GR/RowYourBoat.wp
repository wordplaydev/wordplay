¶Μια βάρκα. Γλιστράει λίγο πιο μπροστά σε κάθε παλμό και λικνίζεται προς την άλλη μεριά κάθε φορά, κάτι που μοιάζει με κωπηλασία. Η λωρίδα ορίζει πόσο ψηλά βρίσκεται και πόσο μπροστά ξεκίνησε, ώστε να μην κινούνται όλες μαζί.¶
ƒ βάρκα(λωρίδα•# αρχή2•#)•Φράση
	Φράση(
		'🚣'
		1.5m
		θέση: Θέση(
			((((κουπί + αρχή2) % 16) - 8) · 1.1) · 1m
			((λωρίδα · 1.9) - 1.9) · 1m
		)
		περιστροφή: (((κουπί + λωρίδα) % 2) = 0) ? 9° -9°
		διάρκεια: 0.2s
	)

στόλος: [βάρκα(0 0) βάρκα(1 6) βάρκα(2 11)]

Στάδιο(
	[
		:στόλος
		Φράση(
			'〰〰〰〰〰〰〰〰'
			1m
			θέση: Θέση(-8m -3.2m)
			χρώμα: Χρώμα(48% 22 240°)
		)
		Φράση(
			'Row, row, row your boat'
			0.9m
			θέση: Θέση(-4.4m 3.4m)
		)
		Μουσική(
			[
				Κομμάτι(
					μελωδία2
					όργανο: Όργανο.φλάουτο
					χτύπος: 0.5beats
				)
				Κομμάτι(
					συγχορδίες
					όργανο: Όργανο.πιάνο
					χτύπος: 1beats
					ένταση: 60%
				)
				Κομμάτι(
					κουπιά
					όργανο: Όργανο.τύμπανα
					χτύπος: 1beats
					ένταση: 45%
				)
			]
			ρυθμός: 144beats/min
			όνομα: 'βάρκα'
		)
	]
	φόντο: Χρώμα(22% 18 230°)
	χρώμα: Χρώμα(96% 0 0°)
)
