¶Η τούρτα φουσκώνει σε κάθε παλμό και ηρεμεί ανάμεσά τους.¶
ƒ τούρτα() Φράση(
		'🎂'
		(4m + ((μέτρημα2 % 2) · 0.4m))
		διάρκεια: 0.2s
	)

Στάδιο(
	[
		Ομάδα(
			Σωρός(υλικόπαραγεμίσματος: 0.5m)
			[
				τούρτα()
				Φράση('Χρόνια Πολλά' 1.3m)
			]
		)
		Μουσική(
			[
				Κομμάτι(
					μελωδία2
					όργανο: Όργανο.φλάουτο
					χτύπος: 0.5beats
				)
				Κομμάτι(
					άλτο
					όργανο: Όργανο.βιολί
					χτύπος: 0.5beats
					ένταση: 65%
				)
				Κομμάτι(
					συγχορδίες
					όργανο: Όργανο.πιάνο
					χτύπος: 1beats
					ένταση: 55%
				)
			]
			ρυθμός: 116beats/min
			όνομα: 'γενέθλια'
		)
	]
	φόντο: Χρώμα(18% 20 330°)
	χρώμα: Χρώμα(96% 0 0°)
)
