מספר2: 1 … ∆ לחצן() | ∆ מפתח() …
		(מספר2 = (שיר.משך() + 1)) ? 1 מספר2 + 1
שורה3: שיר[מספר2]

מספר2 ≤ שיר.משך() ?
	שלב(
		[
			משפט(
				שורה3.טקסט2
				כניסה: שורה3.תנוחה
				משך: 1s
				שם: מספר2 → ""
				סגנון: 'cautious'
			)
		]
		רקע: שורה3.אחורה
		מנוחה: פוזה(צבע: שורה3.קדימה)
	)
	שלב(
