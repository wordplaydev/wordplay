🎵
תווי גובה צליל
===
¶שירו או זמזמו, וראו את התו שאתם משמיעים — פעמיים. התו השמאלי קורא את @Pitch הגולמי ורוטט; התו הימני מחשב ממוצע של כמה גבהי צליל אחרונים ונשאר יציב. @Pitch מציג 0 הרץ כשאינו שומע דבר ברור, ולכן שני התווים מדלגים על רגעים אלו ומראים · במקום.¶
תווים2: [
		'לה'
		'לה♯'
		'סי'
		'דו'
		'דו♯'
		'רה'
		'רה♯'
		'מי'
		'פה'
		'פה♯'
		'סול'
		'סול♯'
	]
תושל: ƒ(הרץ•#hz) הרץ > 0hz ? תווים2[(((((12 × (הרץ ÷ 440hz).לוגריתם(
										2
									)).עגול(
							)) % 12) + 12) % 12) + 1] '·'
חלק2: ƒ(אות•…#hz) (
			נשמע: (←← 8 אות).ללא(0hz)
			(נשמע.משולב(0hz ƒ(סכוםכולל•#hz v•#hz) סכוםכולל + v) ÷ נשמע.משך(
					)) ?? 0hz
		)
גובהצליל2: פסיעה()
שלב(
	[
		קבוצה(
			לערום()
			[
				משפט('רועש' צבע: צבע(60% 90 30°))
				משפט(תושל(גובהצליל2) גודל: 6m צבע: צבע(60% 90 30°))
			]
			מקום: מקום(-4m 0m)
		)
		קבוצה(
			לערום()
			[
				משפט('חלק' צבע: צבע(70% 90 240°))
				משפט(
					תושל(חלק2(גובהצליל2))
					גודל: 6m
					צבע: צבע(70% 90 240°)
				)
			]
			מקום: מקום(4m 0m)
		)
	]
)
