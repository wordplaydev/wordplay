¶סירה. היא מחליקה מעט קדימה בכל פעימה ומתנדנדת לצד השני בכל פעם, וזה מה שנראה כמו חתירה; הנתיב קובע באיזה גובה היא נמצאת וכמה רחוק היא התחילה, כך שהסירות לא נעות יחד כגוף אחד.¶
ƒ סירה(נתיב2•# התחלה•#)•משפט
	משפט(
		'🚣'
		1.5m
		מקום: מקום(
			((((משיכתמשוט + התחלה) % 16) - 8) · 1.1) · 1m
			((נתיב2 · 1.9) - 1.9) · 1m
		)
		רוטציה: (((משיכתמשוט + נתיב2) % 2) = 0) ? 9° -9°
		משך: 0.2s
	)

