				קבוצה(
					רשת(עמודות: 5 ריפוד: 0.4m)
					קולות.לתרגם(ƒ(קול5•קול2) כפתור(קול5))
				)
			]
		)
		מוזיקה(
			רצועה(מנגינה2 כלינגינה: נוכחי.צליל מילים: מילותשיר)
			קצב: 120beats/min
			סולם: מוזיקה.פנטטוני
			שם: 'מנגינה'
		)
	]
