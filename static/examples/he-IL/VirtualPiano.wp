🎹
פסנתר וירטואלי
=== start
¶פסנתר באוקטבה אחת שאפשר לנגן בו! לחוויה הטובה ביותר, כבו את הדמיית המוזיקה.¶

¶קשירה זו שומרת זרם Key שמזהה איזה מקש נלחץ.¶
נלחץ: מפתח()

¶כאן נשמרת התאמה בין המקשים שלוחצים עליהם לבין התווים שיתנגנו, גם בצורת טקסט (כדי להציג את התו המתנגן) וגם כמילת טקסט מספרית (כדי להמיר למספר (#) ולהזין לרשימת Track).

הסידור נבחר כך שידמה מקשי פסנתר: מקשים לבנים מיוצגים באותיות, ומקשים שחורים מיוצגים בספרות.¶
מפתתווים: {
		'w': ['דו' "1"]
		'3': ['C# / Db' "2"]
		'e': ['רה' "3"]
		'4': ['D# / Eb' "4"]
		'r': ['מי' "5"]
		't': ['פה' "6"]
		'6': ['F# / Gb' "7"]
		'y': ['סול' "8"]
		'7': ['G# / Ab' "9"]
		'u': ['לה' "10"]
		'8': ['A# / Bb' "11"]
		'i': ['סי' "12"]
		'o': ['C5' "13"]
	}

¶פונקציה זו מחזירה את שם התו, לפי המקש שנלחץ. אם המקש לא היה תו תקין, היא מחזירה טקסט ריק.¶
ƒ מחזירטקסט(מפתח3•"")•"" (מפתתווים{מפתח3} ≠ ø) ? מפתתווים{מפתח3}[1] ""

¶פונקציה זו מחזירה את מספר התו המתאים למקש שנלחץ בתוך רשימה, כדי לשמש כקלט ב-Track. אם המקש שנלחץ אינו תקין, היא מחזירה רשימה ריקה.¶
ƒ מחזירתומוזיקלי(מפתח4•"")•[] [
		(מפתתווים{מפתח4} ≠ ø) ? (מפתתווים{מפתח4}[2] → #) []
	]

¶פונקציה זו מקבלת רשימה מספרית ומחזירה Track עם רשימת התווים הזו. הלולאה כבויה כך שהתו מתנגן פעם אחת בלבד כשהמקש נלחץ.¶
ƒ מחזיררצועה(תו2•[#]) רצועה(תו2 לולאה: ⊥)

¶שתי הקשירות האלה קובעות את הצבע שמקבל המקש המתאים כשלוחצים עליו וכשלא לוחצים עליו.¶
צבעבלחיצה: צבע(10 270 50°)
צבעריק: צבע(0 0 0°)

¶פעולה זו מנגנת את הרצועה המתאימה למקש שנלחץ. הסולם הוא כרומטי, כך שהרצועות יכולות להשתמש בכל חצאי הטונים. הניגון החוזר מוגדר כך שכל פעם שנלחץ מקש תקין, הרצועה מתנגנת, אפילו פעמיים ברצף.¶
מוזיקה(
	מחזיררצועה(מחזירתומוזיקלי(נלחץ))
	סולם: מוזיקה.כרומטי
	נגןשוב: מפתתווים{נלחץ} ≠ ø
)

¶מציג את הפסנתר, את המקשים ללחיצה, ואת התו שמתנגן כשלוחצים על מקש.¶
קבוצה(
	לערום('>' 1m)
	[
		קבוצה(
			שורה('>' -.3m)
			[
				משפט(
					'▯'
					שם: 'w'
					גודל: 3m
					צבע: נלחץ = 'w' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▮'
					שם: '3'
					גודל: 3m
					צבע: נלחץ = '3' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 'e'
					גודל: 3m
					צבע: נלחץ = 'e' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▮'
					שם: '4'
					גודל: 3m
					צבע: נלחץ = '4' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 'r'
					גודל: 3m
					צבע: נלחץ = 'r' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 't'
					גודל: 3m
					צבע: נלחץ = 't' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▮'
					שם: '6'
					גודל: 3m
					צבע: נלחץ = '6' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 'y'
					גודל: 3m
					צבע: נלחץ = 'y' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▮'
					שם: '7'
					גודל: 3m
					צבע: נלחץ = '7' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 'u'
					גודל: 3m
					צבע: נלחץ = 'u' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▮'
					שם: '8'
					גודל: 3m
					צבע: נלחץ = '8' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 'i'
					גודל: 3m
					צבע: נלחץ = 'i' ? צבעבלחיצה צבעריק
				)
				משפט(
					'▯'
					שם: 'o'
					גודל: 3m
					צבע: נלחץ = 'o' ? צבעבלחיצה צבעריק
				)
			]
		)

		קבוצה(
			שורה('>' 1.1m)
			[
				משפט('w')
				משפט('3')
				משפט('e')
				משפט('4')
				משפט('r t')
				משפט('6')
				משפט('y')
				משפט('7')
				משפט('u')
				משפט('8')
				משפט('i  o')
			]
		)
		משפט(מחזירטקסט(נלחץ))
	]
)
