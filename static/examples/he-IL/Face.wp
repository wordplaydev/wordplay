🙂
פרצוף
===
¶אימוג'י שמשקף את הפנים שלך כשאתה מחייך, זועף, פוער פה, וממצמץ.¶
פנים3: פנים()

שלב(
	[
		משפט(
			(פנים3.פהפתוח ? '😮'
					פנים3.מחייך ? '😀'
						פנים3.זועף ? '🙁'
							פנים3.גבותמורמות ? '😲'
								(פנים3.עינייםפתוחות ? '🙂' '😑'))
			מקום: פנים3.מקום
			גודל: 4m
		)
		קבוצה(
			לערום('|')
			[
				משפט((פנים3.עינייםפתוחות ? '👀' '😑') גודל: 1.5m)
				משפט('😊' גודל: (פנים3.כמותחיוך · 2m) + 0.5m)
				משפט('👄' גודל: (פנים3.כמותפהפתוח · 2m) + 0.5m)
				משפט('🤨' גודל: (פנים3.כמותהרמתגבה · 2m) + 0.5m)
			]
			מקום: מקום(-9m 8m)
		)
		משפט(
			'סיבוב 🧭'
			מקום: מקום(9m 8m 0m)
			גודל: 2m
			רוטציה: פנים3.סיבוב
		)
		משפט(
			'הטיה 🧭'
			מקום: מקום(9m 2m)
			רוטציה: פנים3.הטיה
			גודל: 2m
		)
		משפט(
			`/הראה למצלמה את הפנים שלך/`
			מקום: מקום(-6m -12m)
			גודל: 1m
		)
	]
	מקום: מקום(0m 0m -20m)
)