🔁
איפה וולדו?
=== start/en
¶מצאו את וולדוֹ מסתתר בקהל: חפשו את האיש עם החולצה הכתומה ולחצו עליו כדי לנצח!¶

שם: בחירה()
נתפס: ⊥ … ∆ (שם) … (שם = 'ResetButton') ? ⊥ ((שם = 'Waldough') | נתפס)
תוצאה2: 0 … ∆ (שם) … (שם = 'Waldough') ? 1 + תוצאה2 תוצאה2

ƒ מיקום2() מקום(
		((0.1 × אקראי(-9m 9m)) + אקראי(-2m 1m))
		((0.1 × אקראי(-9m 9m)) + אקראי(-2m 1m))
	)
ƒ כתמיםחדשים() [
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
		מיקום2()
	]
כתמים: כתמיםחדשים() … ∆ (שם) … (שם = 'ResetButton') ? כתמיםחדשים(
			) כתמים


שלב(
	[
		משפט(
			"🔁"
			ניתןלבחירה: ⊤
			מקום: מקום(4m -0.5m)
			מנוחה: נתפס ? פוזה(רוטציה: 180°) פוזה()
			משך: 0.5s
			שם: 'ResetButton'
		)
		משפט(
			'חפשו את החולצה הכתומה'
			0.2m
			מקום: מקום(-6.2m 0.75m)
			פנים: 'Carter One'
		)
		משפט(
			'איש (בשם וולדוֹ) ו'
			0.2m
			מקום: מקום(-6.4m 0.25m)
			פנים: 'Carter One'
		)
		משפט(
			'לחצו עליו כדי לנצח! 🧍🏻'
			0.2m
			מקום: מקום(-6.0m -0.25m)
			פנים: 'Carter One'
		)
		משפט(
			'תוצאה: ' + תוצאה2 → ''
			0.5m
			מקום: מקום(-5.9m -1m)
		)

		משפט("🏀" מקום: כתמים[1])
		משפט("🦧" מקום: כתמים[2])
		משפט("🍊" מקום: כתמים[3])
		משפט("👻" מקום: כתמים[4])
		משפט("🤖" מקום: כתמים[5])
		משפט("👽" מקום: כתמים[6])
		משפט("🐀" מקום: כתמים[7])
		משפט("🦣" מקום: כתמים[8])
		משפט("🐸" מקום: כתמים[9])
		משפט("🍎" מקום: כתמים[10])
		משפט("💧" מקום: כתמים[11])
		משפט("🍔" מקום: כתמים[12])
		משפט("❤" מקום: כתמים[13])
		משפט("🍥" מקום: כתמים[14])
		משפט(
			"🧍🏻"
			ניתןלבחירה: ~נתפס
			מקום: כתמים[15]
			מנוחה: נתפס ? פוזה(רוטציה: 180°) פוזה()
			משך: 0s
			שם: 'Waldough'
		)
		משפט("🔥" מקום: כתמים[16])
		משפט("🎂" מקום: כתמים[17])
		משפט("🐕" מקום: כתמים[18])
		משפט("🦈" מקום: כתמים[19])
		צורה(מלבן(-3.5m -3m 3.5m -3.5m))
		צורה(מלבן(-3.5m 3.5m 3.5m 3m))
		צורה(מלבן(-3.5m 3.5m -3m -3.5m))
		צורה(מלבן(3m 3.5m 3.5m -3.5m))
	]
	מקום: מקום(0m 0m -5m)
)