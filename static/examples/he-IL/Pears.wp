M
אגסים
=== start/en
¶זהו סיפור קצר ואינטראקטיבי. הוא מגדיר כמה סצנות שונות ועובר ביניהן בהתאם לפעולות שונות, כמו לחיצות, התנגשויות ופעולות נוספות. חלק מהכיף בחוויית הסיפור הוא לגלות אילו פעולות צריך לעשות כדי להמשיך בסיפור.¶
תערוכה: [
		משפט(`אבא שלי רצה ללכת.` מקום: מקום(-9m 0m))
	]

התנגשות2: [
		משפט(`"אמא", אנחנו צריכים ללכת.` מקום: מקום(-8m 7m))
		משפט(`/"קחי, לכי הביתה."/` מקום: מקום(1m 4m))
		משפט(`"אמא, אנחנו לא רוצים כלום!"` מקום: מקום(-8m 1m))
		משפט(
			`"קחי, לכי הביתה!"`
			גודל: 2m
			מקום: מקום(-6m -4m)
			מנוחה: רצף.לנער()
		)
	]

עלילהמתפתחת1: [
		משפט(
			`הסבתא 炮炮👵🏽 שלי יצאה לחצר האחורית`
			מקום: מקום(-9m 7m)
		)
		משפט(`הלכתי אחריה, סקרנית` מקום: מקום(-6m 4m))
		משפט(
			`👵🏽`
			שם: 'פאופאו'
			גודל: 2m
			חומר: חומר()
			מקום: מקום(6m -6m)
			בועה: `/"沙梨🍐, קחי, לכי הביתה!"/`
		)
		משפט(
			`👧🏻`
			שם: 'אני'
			גודל: 1m
			חומר: חומר()
			מקום: מיקום(מקום(-8m -6m))
		)
	]

עלילהמתפתחת2: [
		משפט(`היא נעצרה לצד עץ קטן.` מקום: מקום(-9m 6m))
		משפט(
			`עליו התפתלו עשרות 沙梨 צהובים ובוהקים`
			מקום: מקום(-9m 1m)
			לעטוף: 10m
		)
		משפט(
			`"אמא, אנחנו לא רוצים אגסים."`
			גודל: .75m
			מקום: מקום(-4m 0m)
		)
		משפט(`/רציתי אגס./` גודל: 2m מקום: מקום(-8m -3m))
		משפט(
			"🍐"
			גודל: 2m
			מקום: מקום(-1m -7m)
			שם: 'pear'
			ניתןלבחירה: ⊤
		)
	]

¶אנחנו קובעים מקומות מראש כדי שנוכל להפיל אותם מאותה נקודה.¶
מקומות: (6 → []).לתרגם(
		ƒ() מקום(אקראי(-2m 2m) אקראי(-3m -5m))
	)
שיא: [
		משפט(`היא כרעה על הקרקע.` מקום: מקום(-9m 6m))
		משפט(`אחזה בסכין` מקום: מקום(-9m 4m))
		משפט(`ובזהירות קטפה שישה` מקום: מקום(-9m 2m))
		משפט(`הפילה אותם לסל שלמטה` מקום: מקום(-9m 0m))
		משפט("🧺" גודל: 4m מקום: מקום(-2m -12m))
		משפט(
			"🌳"
			שם: "tree"
			גודל: 5m
			מקום: מקום(-3m -7m)
			ניתןלבחירה: ⊤
		)
		:מקומות.לתרגם(
			ƒ(מקום2 מדד2)
				משפט(
					"🍐"
					שם: "pear\מדד2\"
					מקום: בחירה() = 'tree' ? תנועה(מקום2) מקום2
				)
		)
		משפט("🔪" מקום: מצביע())
	]

פתרון: [
		משפט(`היא הביאה אותם אליי` מקום: מקום(-9m 6m))
		משפט(`כרעה לידי` מקום: מקום(-8m 4m))
		משפט(`ומסרה לי את הסל` מקום: מקום(-7m 2m))
		משפט(`/"קחי, לכי הביתה"/` מקום: מקום(0m -2m))
	]

קרדיטים: [
		משפט(`מאת /איימי ג'יי קו/`)
	]

סיפור: [
		תערוכה
		התנגשות2
		עלילהמתפתחת1
		עלילהמתפתחת2
		שיא
		פתרון
		קרדיטים
	]

¶עקבו אחרי קליקים ולחיצות¶
קליק: ∆ לחצן()
¶עקבו אחרי הזמן שעובר מאז שלוחצים על העץ¶
הזמןאחריהחיתוך: 0ms … בחירה() = 'tree' … זמן(1000ms)
¶עקבו אחרי הרגע שבו אנחנו מגיעים לפַּאוּ פַּאוּ¶
אצלפאופאו: ∆ התנגשות('אני')
¶עקבו אחרי הרגע שבו האגס נבחר¶
בחרהבאגס: בחירה() = 'pear'
¶שנו את הקטע בהתאם לקטע הנוכחי¶
קטע•#:
	1 …
	קטע ???
		1: קליק
		2: קליק
		3: אצלפאופאו
		4: בחרהבאגס
		5: הזמןאחריהחיתוך > 1500ms
		6: ∆ לחצן()
		⊥
		… קטע + 1

שלב(
	סיפור[קטע]
	פנים: 'Arvo'
	מקום: מקום(0m 0m -20m)
	מסגרת: מלבן(-10m 10m 10m -10m)
)