K
פריסות
=== start
¶שורות, ערימות וקבוצות של ביטויים, וכל אחד מהם מציג תנוחות מונפשות מרשימות.¶

פעימה2: רצף(
		{
			0%: פוזה(סולם: .9)
			50%: פוזה(סולם: 1.1)
			100%: פוזה(סולם: .9)
		}
	)
קפיצה: רצף(
		{
			0%: פוזה(לקזז: מקום(ז: 0m))
			50%: פוזה(לקזז: מקום(ז: -2m))
			100%: פוזה(לקזז: מקום(ז: 0m))
		}
		1s
	)

קבוצה(
	שורה()
	[
		קבוצה(
			לערום()
			[
				משפט('חתלתול')
				משפט('חתול' מנוחה: קפיצה)
				קבוצה(
					שורה()
					[משפט('כלב') משפט('כלבי')]
					מנוחה: פעימה2
				)
				משפט('חתולי')
			]
		)
		קבוצה(
			לערום()
			[
				משפט('היי')
				משפט('שלום')
			]
			מנוחה: רצף.לסובב(2s "straight")
		)
	]
)