s
האטה והאצה ברצף
===
¶אותה אנימציית מכונית בשמונה דרכים, אחת לכל סגנון האטה והאצה.¶

פריימיםמרכזיים: {
		0%: פוזה(לקזז: מקום(-1m 0m))
		25%: פוזה(לקזז: מקום(1m 0m))
		50%: פוזה(לקזז: מקום(1m 0m))
		75%: פוזה(לקזז: מקום(-1m 0m))
		100%: פוזה(לקזז: מקום(-1m 0m))
	}

שלב(
	[
		קבוצה(
			רשת(4 2 ריפודתאים: 0.25m)
			[
				משפט('ישר' גודל: 0.25m)
				משפט(
					"🚗"
					מנוחה: רצף(פריימיםמרכזיים 3s סגנון: "straight")
				)
				משפט('זהיר' גודל: 0.25m)
				משפט(
					"🚚"
					מנוחה: רצף(פריימיםמרכזיים 3s סגנון: "cautious")
				)
				משפט('איטי' גודל: 0.25m)
				משפט(
					"🚙"
					מנוחה: רצף(פריימיםמרכזיים 3s סגנון: "pokey")
				)
				משפט('זריז' גודל: 0.25m)
				משפט(
					"🏎"
					מנוחה: רצף(פריימיםמרכזיים 3s סגנון: "zippy")
				)
			]
		)
	]
)