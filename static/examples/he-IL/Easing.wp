החלקת רצף
===
¶אותה הנפשה של מכונית בשמונה דרכים, אחת לכל סוג של החלשה.¶
פריימימפתח: {
		0%: פוזה(לקזז: מקום(-1m 0m))
		25%: פוזה(לקזז: מקום(1m 0m))
		50%: פוזה(לקזז: מקום(1m 0m))
		75%: פוזה(לקזז: מקום(-1m 0m))
		100%: פוזה(לקזז: מקום(-1m 0m))
	}

שלב(
	[
		קבוצה(
			רשת(4 2 ריפודתאים: 0.25m)
			[
				משפט('ישר' גודל: 0.25m)
				משפט(
					"🚗"
					מנוחה: רצף(פריימימפתח 3s סגנון: "straight")
				)
				משפט('נִזהָר' גודל: 0.25m)
				משפט(
					"🚚"
					מנוחה: רצף(פריימימפתח 3s סגנון: "cautious")
				)
				משפט('אִיטִי' גודל: 0.25m)
				משפט("🚙" מנוחה: רצף(פריימימפתח 3s סגנון: "pokey"))
				משפט('מָהִיר' גודל: 0.25m)
				משפט("🏎" מנוחה: רצף(פריימימפתח 3s סגנון: "zippy"))
			]
		)
	]
)