🖐
יד
===
¶הרימו אצבעות מול המצלמה, ויד אימוג'י תספור יחד איתכם.¶
יד2: יד()

שלב(
	[
		משפט(
			(יד2.אצבעות = 0 ? '✊'
					יד2.אצבעות = 1 ? '☝'
						יד2.אצבעות = 2 ? '✌'
							יד2.אצבעות = 3 ? '🤟'
								יד2.אצבעות = 4 ? '🖖'
									'🖐')
			מקום: יד2.מקום
			גודל: 2m
			לקזז: מקום(-1m)
		)
		קבוצה(
			שורה('<')
			[
				משפט('1⃣' לקזז: מקום(0m יד2.אגודל ? 1m 0m))
				משפט('2⃣' לקזז: מקום(0m יד2.מדד ? 1m 0m))
				משפט('3⃣' לקזז: מקום(0m יד2.אמצע ? 1m 0m))
				משפט('4⃣' לקזז: מקום(0m יד2.טבעת ? 1m 0m))
				משפט('5⃣' לקזז: מקום(0m יד2.הזרת ? 1m 0m))
			]
			מקום: מקום(-4.5m 5m)
		)
		קבוצה(
			לערום('|')
			[
				משפט((יד2.כףהיד ? '🤚' '🤛') גודל: 2m)
				משפט((יד2.לפתוח ? 'פתוחה' 'סגורה') גודל: 1.5m)
			]
			מקום: מקום(-2m -8m)
		)
		משפט(
			`/הראו למצלמה את היד שלכם/`
			מקום: מקום(-6m -10m)
			גודל: 1m
		)
	]
	מקום: מקום(0m 0m -20m)
)