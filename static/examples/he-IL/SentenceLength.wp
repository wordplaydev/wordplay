H
אורך משפט
===
¶הקלד/י בשורת הצ'אט, והתוכנית תספור את התווים במשפט שלך.¶
משפט2: לשוחח()
אורך: לשוחח().משך()

קבוצה(
	לערום()
	[
		משפט(
			`*שלום! ברוכים הבאים למחשבון אורך המשפט.*`
			מקום: מקום(0m 1m)
		)
		משפט('הקלד/י משהו בשורת ההודעה!' מקום: מקום(0m -1m))
		משפט(
			'אורך המשפט שלך הוא ' + (אורך → '') + ' תווים!'
			מנוחה: רצף.להתנדנד(משך: 3s)
			מקום: מקום(0m -3m)
		)
		משפט(משפט2 מקום: מקום(0m -5m) לעטוף: 25m)
	]
)