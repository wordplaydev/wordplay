						((ચાવી2 = 'એરોડાઉન') ? ખસેડો(રમત9 0 -1)
								((ચાવી2 = 'જગ્યા') ? કાર્ય(રમત9)
										((ચાવી2 = 'શિફ્ટ') ? બદલો2(રમત9)
												((ચાવી2 = 'j') ? કૂદકો(રમત9) રમત9))))))

