🖐
Рука
===
¶Покажи прсте камери и емоџи рука ће бројати са тобом.¶
рука: Рука()

Стаге(
	[
		Фраза(
			(рука.прсти = 0 ? '✊'
					рука.прсти = 1 ? '☝'
						рука.прсти = 2 ? '✌'
							рука.прсти = 3 ? '🤟'
								рука.прсти = 4 ? '🖖'
									'🖐')
			место: рука.место
			величина: 2m
			оффсет: Место(-1m)
		)
		Група(
			Ред('<')
			[
				Фраза('1⃣' оффсет: Место(0m рука.палац ? 1m 0m))
				Фраза('2⃣' оффсет: Место(0m рука.индекс ? 1m 0m))
				Фраза('3⃣' оффсет: Место(0m рука.средњи ? 1m 0m))
				Фраза('4⃣' оффсет: Место(0m рука.прстен ? 1m 0m))
				Фраза('5⃣' оффсет: Место(0m рука.малипрст ? 1m 0m))
			]
			место: Место(-4.5m 5m)
		)
		Група(
			Стацк('|')
			[
				Фраза((рука.длан ? '🤚' '🤛') величина: 2m)
				Фраза(
					(рука.отворено ? 'отворено' 'затворено')
					величина: 1.5m
				)
			]
			место: Место(-2m -8m)
		)
		Фраза(
			`/Покажи камери своју руку/`
			место: Место(-6m -10m)
			величина: 1m
		)
	]
	место: Место(0m 0m -20m)
)