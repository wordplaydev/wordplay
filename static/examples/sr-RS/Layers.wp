o
Слојеви
=== start
¶Лопте које скакућу на различитим дубинама и приказују слојеве паралаксе.¶
број2: 10 → []

ƒ лопте(z2•#m) број2.преводити(
		ƒ()
			Фраза(
				'о'
				место: Мотион(
					Место(Рандом(-10 10) × 1m Рандом(0 10) × 1m z2)
					Брзина(Рандом(-10 10) × 1m/s Рандом(-5 5) × 1m/s)
				)
				материја: Материја(поскочност: 0.8 трење: 0)
			)
	)

Стаге(
	[
		:лопте(0m)
		:лопте(-10m)
		:лопте(10m)
		Облик(Цирцле(2m 0m 1m 0m))
		Облик(Цирцле(2m 9m -3m 10m))
		Облик(Полигон(2m 5 -5m 0m -10m))
		Облик(Правоугаоник(-20m 0m 20m -1m 0m))
		Облик(Правоугаоник(-20m 0m 20m -1m 10m) ротација: 25°)
		Облик(
			Правоугаоник(-20m 0m 20m -1m -10m)
			ротација: -10°
		)
	]
	место: Место(0m 10m -30m)
)