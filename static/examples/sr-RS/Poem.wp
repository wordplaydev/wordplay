T
Песма
=== start
¶Песма чији стихови долутају унутра, сваки на свој начин.¶
•линија(текст2•"" поза•Посе|Секуенце назад: Боја(
			100
			100
			100°
		) напред: Боја(0 0 0°))

¶Списак стихова песме, сваки са својом позом.¶
песма: [
		линија(
			'Рачунарска датотека'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија(
			'о којој'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија('немам никакво сећање' Посе(ротација: 10°))
		линија(
			'Кликнем да је отворим'
			Секуенце(
				{
					0%: Посе(размера: 1)
					50%: Посе(размера: 0.7)
					100%: Посе(размера: 1)
				}
				0.25s
			)
		)
		линија(
			'погледам'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија(
			'клизим даље надоле'
			Посе(непрозирност: 0% оффсет: Место(и: 5m))
		)
		линија(
			'екран'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија(
			'остаје осветљен и празан'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
			Боја(0 0 0°)
			Боја(100 100 0°)
		)
		линија(
			'тако поново срећем себе'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија(
			'пуног наде и бескорисног'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија(
			'загонетка'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија(
			'баш као што сам сигурно и урадио'
			Посе(непрозирност: 0% оффсет: Место(и: -5m))
		)
		линија('19. августа 2010, у 11:08' Посе())
	]

број2: 1 … ∆ Дугме() | ∆ Кључ() …
		(број2 = (песма.дужина() + 1)) ? 1 број2 + 1
линија2: песма[број2]

број2 ≤ песма.дужина() ?
	Стаге(
		[
			Фраза(
				линија2.текст2
				улазећи: линија2.поза
				трајање: 1s
				име: број2 → ""
				стил: 'cautious'
			)
		]
		позадини: линија2.назад
		одмара: Посе(боја: линија2.напред)
	)
	Стаге(
		[
			Група(
				Стацк()
				[Фраза('САВЕТ САМОМ СЕБИ') Фраза('Џејн Хиршфилд')]
				улазећи: Посе(размера: 0.75)
			)
		]
		позадини: Боја(0% 0 0°)
		боја: Боја(100% 100 0°)
	)