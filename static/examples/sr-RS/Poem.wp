T
Песма
=== start
¶Песма чији стихови долутају унутра, сваки на свој начин.¶

•линија(текст2•"" поза•Поза|Секвенца назад: Боја(
			100
			100
			100°
		) напред: Боја(0 0 0°))

¶Списак стихова песме, сваки са својом позом.¶
песма: [
		линија(
			'Рачунарска датотека'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија(
			'о којој'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија('немам никакво сећање' Поза(ротација: 10°))
		линија(
			'Кликнем да је отворим'
			Секвенца(
				{
					0%: Поза(размера: 1)
					50%: Поза(размера: 0.7)
					100%: Поза(размера: 1)
				}
				0.25s
			)
		)
		линија(
			'погледам'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија(
			'клизим даље надоле'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: 5m))
		)
		линија(
			'екран'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија(
			'остаје осветљен и празан'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
			Боја(0 0 0°)
			Боја(100 100 0°)
		)
		линија(
			'тако поново срећем себе'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија(
			'пуног наде и бескорисног'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија(
			'загонетка'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија(
			'баш као што сам сигурно и урадио'
			Поза(непрозирност: 0% оффсет: Место(ипсилон: -5m))
		)
		линија('19. августа 2010, у 11:08' Поза())
	]

број2: 1 … ∆ Дугме() | ∆ Тастер() …
		(број2 = (песма.дужина() + 1)) ? 1 број2 + 1
линија2: песма[број2]

број2 ≤ песма.дужина() ?
	Позорница(
		[
			Фраза(
				линија2.текст2
				улазећи: линија2.поза
				трајање: 1s
				име: број2 → ""
				стил: 'cautious'
			)
		]
		позадини: линија2.назад
		одмара: Поза(боја: линија2.напред)
	)
	Позорница(
		[
			Група(
				Наслага()
				[Фраза('САВЕТ САМОМ СЕБИ') Фраза('Џејн Хиршфилд')]
				улазећи: Поза(размера: 0.75)
			)
		]
		позадини: Боја(0% 0 0°)
		боја: Боја(100% 100 0°)
	)