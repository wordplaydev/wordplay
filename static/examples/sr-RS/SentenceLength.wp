H
ДужинаРечнице
===
¶Куцај у пољу за ћаскање и то ће избројати знакове твоје реченице.¶
реченица: Ћаскање()
дужина2: Ћаскање().дужина()

Група(
	Стацк()
	[
		Фраза(
			`*Здраво! Добро дошли у израчунавач дужине реченице.*`
			место: Место(0m 1m)
		)
		Фраза(
			'Укуцај нешто у пољу за поруке!'
			место: Место(0m -1m)
		)
		Фраза(
			'Твоја реченица има ' + (дужина2 → '') + ' знакова!'
			мировање: Секуенце.љуљатисе(трајање: 3s)
			место: Место(0m -3m)
		)
		Фраза(реченица место: Место(0m -5m) замотати: 25m)
	]
)