s
Ублажавање низа
===
¶Иста анимација аутомобила на осам начина, по један за сваки стил успоравања.¶

кључниКадрови: {
		0%: Поза(оффсет: Место(-1m 0m))
		25%: Поза(оффсет: Место(1m 0m))
		50%: Поза(оффсет: Место(1m 0m))
		75%: Поза(оффсет: Место(-1m 0m))
		100%: Поза(оффсет: Место(-1m 0m))
	}

Позорница(
	[
		Група(
			Мрежа(4 2 целлпаддинг: 0.25m)
			[
				Фраза('равно' величина: 0.25m)
				Фраза(
					"🚗"
					мировање: Секвенца(
						кључниКадрови
						3s
						стил: "straight"
					)
				)
				Фраза('опрезно' величина: 0.25m)
				Фраза(
					"🚚"
					мировање: Секвенца(
						кључниКадрови
						3s
						стил: "cautious"
					)
				)
				Фраза('спорачко' величина: 0.25m)
				Фраза(
					"🚙"
					мировање: Секвенца(
						кључниКадрови
						3s
						стил: "pokey"
					)
				)
				Фраза('брзачко' величина: 0.25m)
				Фраза(
					"🏎"
					мировање: Секвенца(
						кључниКадрови
						3s
						стил: "zippy"
					)
				)
			]
		)
	]
)