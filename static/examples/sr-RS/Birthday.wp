		{1 3 5}
		ø
		ø
	]

¶Торта набубри на сваки такт и смири се између тактова.¶
ƒ торта() Фраза(
		'🎂'
		(4m + ((бројање % 2) · 0.4m))
		трајање: 0.2s
	)

Стаге(
	[
		Група(
			Стацк(паддинг: 0.5m)
			[
				торта()
				Фраза('Срећан рођендан' 1.3m)
			]
		)
		Музика(
			[
				Нумера(
					мелодија2
					инструмент: Инструмент.флаута
					такт: 0.5beats
				)
				Нумера(
					алт
					инструмент: Инструмент.виолина
					такт: 0.5beats
					јачина: 65%
				)
				Нумера(
					акорди
					инструмент: Инструмент.клавир
					такт: 1beats
					јачина: 55%
				)
			]
			темпо: 116beats/min
			име: 'рођендан'
		)
	]
	позадини: Боја(18% 20 330°)
	боја: Боја(96% 0 0°)
)
