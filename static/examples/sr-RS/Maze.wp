↑
Лавиринт
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•лавиринт() (
	мрежа•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ ћелија2(ред•# колона•#) (
			ћелије: мрежа[ред]
			ћелије•[] ? ћелије[колона] ø
		)

	ƒ дозвољено(ред2•# колона2•#) ћелија2(ред2 колона2)•''
)

лавиринт2: лавиринт()

•стање(ред3•# колона3•# кораци•#)
(
	ƒ доле2() стање(ред3 + 1 колона3 кораци + 1)
	ƒ горе() стање(ред3 - 1 колона3 кораци + 1)
	ƒ лево2() стање(ред3 колона3 - 1 кораци + 1)
	ƒ десно() стање(ред3 колона3 + 1 кораци + 1)
)

ƒ дозвољено2(стање2•стање ред4•# колона4•#) лавиринт2.дозвољено(
		стање2.ред3 + ред4
		стање2.колона3 + колона4
	)

смер: Избор()
стање3•стање: стање(1 1 0) … ∆ смер …
		((смер = "left") & дозвољено2(стање3 0 -1)) ? стање3.лево2(
			)
			((смер = "right") & дозвољено2(стање3 0 1)) ? стање3.десно(
				)
				((смер = "up") & дозвољено2(стање3 -1 0)) ? стање3.горе(
					)
					((смер = "down") & дозвољено2(стање3 1 0)) ? стање3.доле2(
						)
						стање3

тренутно: (
		ћелија3: лавиринт2.ћелија2(стање3.ред3 стање3.колона3)
		ћелија3 ?? ' ')
горе2: лавиринт2.ћелија2(стање3.ред3 - 1 стање3.колона3)•''
доле3: лавиринт2.ћелија2(стање3.ред3 + 1 стање3.колона3)•''
лево3: лавиринт2.ћелија2(стање3.ред3 стање3.колона3 - 1)•''
десно2: лавиринт2.ћелија2(стање3.ред3 стање3.колона3 + 1)•''
победио: тренутно = '🤩'

Стаге(
	[
		Група(
			Грид(3 3 0.25m)
			[
				ø
				Фраза(
					'↑'
					име: 'up'
					избор: горе2
					мировање: Посе(непрозирност: горе2 ? 1 0.2)
				)
				ø
				Фраза(
					'←'
					име: 'left'
					избор: лево3
					мировање: Посе(непрозирност: лево3 ? 1 0.2)
				)
				Фраза(
					тренутно
					мировање: победио ?
						Секуенце.спин(трајање: 1s стил: 'straight')
						Посе()
				)
				Фраза(
					'→'
					име: 'right'
					избор: десно2
					мировање: Посе(непрозирност: десно2 ? 1 0.2)
				)
				ø
				Фраза(
					'↓'
					име: 'down'
					избор: доле3
					мировање: Посе(непрозирност: доле3 ? 1 0.2)
				)
				ø
			]
		)
	]
	место: Место(0m 0m -3m)
	лице: 'Noto Emoji'
	позадини: Боја(0 0 0°)
	одмара: Посе(Боја(100 100 0°))
)