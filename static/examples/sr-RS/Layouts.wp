K
Распореди
=== start
¶Редови, гомиле и групе фраза, свака у другачијем анимираном положају.¶

пулс2: Секвенца(
		{
			0%: Поза(размера: .9)
			50%: Поза(размера: 1.1)
			100%: Поза(размера: .9)
		}
	)
збаунс: Секвенца(
		{
			0%: Поза(оффсет: Место(з: 0m))
			50%: Поза(оффсет: Место(з: -2m))
			100%: Поза(оффсет: Место(з: 0m))
		}
		1s
	)

Група(
	Ред()
	[
		Група(
			Наслага()
			[
				Фраза('Маца')
				Фраза('Мачка' мировање: збаунс)
				Група(
					Ред()
					[Фраза('Пас') Фраза('Пас')]
					одмара: пулс2
				)
				Фраза('Мачка')
			]
		)
		Група(
			Наслага()
			[
				Фраза('Ћао')
				Фраза('Здраво')
			]
			одмара: Секвенца.спин(2s "straight")
		)
	]
)