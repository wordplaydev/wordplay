M
Крушке
=== start/en
¶Ово је интерактивна кратка прича. У њој постоји неколико засебних сцена, а прича прелази из једне у другу зависно од различитих радњи, као што су кликови, судари и друге акције. Део забаве у овој причи јесте откривање радњи потребних да прича напредује.¶
увод: [
		Фраза(`Мој тата је хтео да оде.` место: Место(-9m 0m))
	]

сукоб: [
		Фраза(`„Мама, морамо да идемо.“` место: Место(-8m 7m))
		Фраза(`/„Узми, иди кући.“/` место: Место(1m 4m))
		Фраза(`„Мама, не желимо ништа!“` место: Место(-8m 1m))
		Фраза(
			`„Узми, иди кући!“`
			величина: 2m
			место: Место(-6m -4m)
			мировање: Секуенце.трести()
		)
	]

радњаСеРазвија1: [
		Фраза(
			`Моја 炮炮👵🏽 је изашла у двориште`
			место: Место(-9m 7m)
		)
		Фраза(`Радознало сам је пратила` место: Место(-6m 4m))
		Фраза(
			`👵🏽`
			име: 'паупау'
			величина: 2m
			материја: Материја()
			место: Место(6m -6m)
			облачић: `/„沙梨🍐, узми, иди кући!“/`
		)
		Фраза(
			`👧🏻`
			име: 'ја'
			величина: 1m
			материја: Материја()
			место: Пласман(Место(-8m -6m))
		)
	]

радњаСеРазвија2: [
		Фраза(
			`Застала је код малог дрвета.`
			место: Место(-9m 6m)
		)
		Фраза(
			`На њему су висиле десетине светложутих 沙梨`
			место: Место(-9m 1m)
			замотати: 10m
		)
		Фраза(
			`„Мама, не желимо крушке.“`
			величина: .75m
			место: Место(-4m 0m)
		)
		Фраза(
			`/Хтела сам крушку./`
			величина: 2m
			место: Место(-8m -3m)
		)
		Фраза(
			"🍐"
			величина: 2m
			место: Место(-1m -7m)
			име: 'pear'
			избор: ⊤
		)
	]

¶Унапред одређујемо места, да бисмо их пустили да падну са истог места.¶
места: (6 → []).преводити(
		ƒ() Место(Рандом(-2m 2m) Рандом(-3m -5m))
	)
врхунац: [
		Фраза(`Клекнула је у земљу.` место: Место(-9m 6m))
		Фраза(`Узела је нож` место: Место(-9m 4m))
		Фраза(`И пажљиво исекла шест` место: Место(-9m 2m))
		Фраза(
			`Убацивала их је у своју корпу испод`
			место: Место(-9m 0m)
		)
		Фраза("🧺" величина: 4m место: Место(-2m -12m))
		Фраза(
			"🌳"
			име: "tree"
			величина: 5m
			место: Место(-3m -7m)
			избор: ⊤
		)
		:места.преводити(
			ƒ(место2 индекс2)
				Фраза(
					"🍐"
					име: "pear\индекс2\"
					место: Избор() = 'tree' ? Мотион(место2) место2
				)
		)
		Фраза("🔪" место: Поинтер())
	]

разрешење: [
		Фраза(`Донела их је мени` место: Место(-9m 6m))
		Фраза(`Клекнула је поред мене` место: Место(-8m 4m))
		Фраза(`И пружила ми корпу` место: Место(-7m 2m))
		Фраза(`/„Узми, иди кући“/` место: Место(0m -2m))
	]

заслуге: [
		Фраза(`од /Ејми Џ. Ко/`)
	]

прича: [
		увод
		сукоб
		радњаСеРазвија1
		радњаСеРазвија2
		врхунац
		разрешење
		заслуге
	]

¶Прати кликове и додире¶
клик: ∆ Дугме()
¶Прати колико времена прође након што се кликне на дрво¶
времеПослеРеза: 0ms … Избор() = 'tree' … Време(1000ms)
¶Прати када стигнемо до Пау Пау¶
кодПауПау: ∆ Судар('ја')
¶Прати када се крушка изабере¶
изабралаКрушку: Избор() = 'pear'
¶Промени сегмент на основу тренутног сегмента¶
део•#:
	1 …
	део ???
		1: клик
		2: клик
		3: кодПауПау
		4: изабралаКрушку
		5: времеПослеРеза > 1500ms
		6: ∆ Дугме()
		⊥
		… део + 1

Стаге(
	прича[део]
	лице: 'Arvo'
	место: Место(0m 0m -20m)
	оквир: Правоугаоник(-10m 10m 10m -10m)
)