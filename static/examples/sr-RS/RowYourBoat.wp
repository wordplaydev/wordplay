¶Чамац. На сваки удар клизне мало даље и љуља се на другу страну сваки пут, што делује као веслање. Трака одређује колико високо стоји и колико далеко напред је почео, тако да се сви чамци не крећу заједно.¶
ƒ чамац(трака•# почети2•#)•Фраза
	Фраза(
		'🚣'
		1.5m
		место: Место(
			((((замах + почети2) % 16) - 8) · 1.1) · 1m
			((трака · 1.9) - 1.9) · 1m
		)
		ротација: (((замах + трака) % 2) = 0) ? 9° -9°
		трајање: 0.2s
	)

флота: [чамац(0 0) чамац(1 6) чамац(2 11)]

Стаге(
	[
		:флота
		Фраза(
			'〰〰〰〰〰〰〰〰'
			1m
			место: Место(-8m -3.2m)
			боја: Боја(48% 22 240°)
		)
		Фраза(
			'Row, row, row your boat'
			0.9m
			место: Место(-4.4m 3.4m)
		)
		Музика(
			[
				Нумера(
					мелодија2
					инструмент: Инструмент.флаута
					такт: 0.5beats
				)
				Нумера(
					акорди
					инструмент: Инструмент.клавир
					такт: 1beats
					јачина: 60%
				)
				Нумера(
					весла
					инструмент: Инструмент.бубњеви
					такт: 1beats
					јачина: 45%
				)
			]
			темпо: 144beats/min
			име: 'чамац'
		)
	]
	позадини: Боја(22% 18 230°)
	боја: Боја(96% 0 0°)
)
