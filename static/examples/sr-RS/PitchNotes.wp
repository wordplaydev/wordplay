🎵
Висина тонова
===
¶Певај или певуши, и погледај ноту коју правиш — двапут. Лева нота чита сирову вредност @Pitch и трепери; десна нота рачуна просек последњих неколико висина тона и остаје стабилна. @Pitch каже 0hz кад не чује ништа јасно, па обе ноте прескачу те тренутке и уместо тога показују · .¶
ноте2: [
		'А'
		'А♯'
		'Б'
		'Ц'
		'Ц♯'
		'Д'
		'Д♯'
		'Е'
		'Ф'
		'Ф♯'
		'Г'
		'Г♯'
	]
нотаОд: ƒ(hz•#hz) hz > 0hz ? ноте2[(((((12 × (hz ÷ 440hz).лог(
										2
									)).округли(
							)) % 12) + 12) % 12) + 1] '·'
глатко2: ƒ(сигнал•…#hz) (
			чуо: (←← 8 сигнал).без(0hz)
			(чуо.комбиновано(0hz ƒ(укупно•#hz в•#hz) укупно + в) ÷ чуо.дужина(
					)) ?? 0hz
		)
висинаТона: Питцх()
Стаге(
	[
		Група(
			Стацк()
			[
				Фраза('бучно' боја: Боја(60% 90 30°))
				Фраза(
					нотаОд(висинаТона)
					величина: 6m
					боја: Боја(60% 90 30°)
				)
			]
			место: Место(-4m 0m)
		)
		Група(
			Стацк()
			[
				Фраза('глатко' боја: Боја(70% 90 240°))
				Фраза(
					нотаОд(глатко2(висинаТона))
					величина: 6m
					боја: Боја(70% 90 240°)
				)
			]
			место: Место(4m 0m)
		)
	]
)
