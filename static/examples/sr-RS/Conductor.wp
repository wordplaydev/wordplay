		17𝅗𝅥
	]

песма: Музика(
		[
			Нумера(
				марш
				инструмент: глас2(истакнуто)
				јачина: 55%
				такт: 1𝅘𝅥
			)
			Нумера(
				бас
				инструмент: Инструмент.синтБас
				такт: 1𝅘𝅥
				кључ: -24semitones
				јачина: чуо(2 30%)
			)
			Нумера(
				бубњеви2
				инструмент: Инструмент.бубњеви
				такт: 1𝅘𝅥
				јачина: чуо(3 20%)
			)
			Нумера(
				марш
				инструмент: Инструмент.саксофон
				такт: 1𝅘𝅥
				кључ: -12semitones
				јачина: чуо(4 22%)
			)
			Нумера(
				јастуче
				инструмент: Инструмент.синтПад
				такт: 1𝅝
				кључ: -12semitones
				јачина: чуо(5 16%)
			)
			Нумера(
				жице
				инструмент: Инструмент.виолина
				такт: 1𝅘𝅥
				јачина: чуо(6 18%)
			)
			Нумера(
				звона
				инструмент: Инструмент.звоно
				такт: 1𝅝
				кључ: 12semitones
				јачина: чуо(7 12%)
			)
			Нумера(
				бројач
				инструмент: Инструмент.флаута
				такт: 1𝅘𝅥
				јачина: чуо(8 14%)
			)
		]
		темпо: темпо2 · 1beats/min
		скала: Музика.хроматска
		име: 'царски марш'
	)

¶Колико је флота одмакла. Она рачуна своје сопствене откуцаје уместо да чита сат, и рачуна их брже кад је марш бржи, тако да бродови лете у складу с темпом.¶
путовање: 0 … ∆ Време(40ms) … путовање + (темпо2 ÷ 72)

ƒ статус()•'' '\слојеви\ of 8 playing · \темпо2\ beats a minute'

¶Један ред упутства, затамњен да флота и истакнути свирач буду прочитани прво.¶
ƒ линија(текст2•'')•Фраза Фраза(
		текст2
		0.3m
		боја: Боја(64% 4 265°)
	)

¶Упутства, поређана уз леви руб уместо центрирано, тако да око може да их прати право надоле.¶
приказ: Група(
		Стацк('<' 0.16m)
		[
			Фраза(икона(истакнуто) 0.9m боја: Боја(56% 65 25°))
			Фраза(статус() 0.38m боја: Боја(70% 25 30°))
			линија('подигни руку — више оркестра')
			линија('спусти је — само мелодија')
			линија('рука лево — спорије · рука десно — брже')
			линија('прсти горе — 1 🎹 · 2 🎻 · 3 🪈 · 4 ⚡ · 5 🎺')
		]
	)

¶Брод који прелети позорницу, летећи у појасу знатно изнад упутства, тако да никада не пресеца текст. Његова путања одређује на којој висини лети и одакле полази, тако да никад не лете у строју.¶
ƒ брод(глиф•'' трака•# брзина2•#)•Фраза
	Фраза(
		глиф
		0.7m
		место: Место(
			(((((путовање · брзина2) + (трака · 47)) % 200) - 100) · 0.045) · 1m
			((трака · 0.65) + 2.2) · 1m
		)
	)

флота: [
		брод('🛸' 0 3)
		брод('🚀' 1 2)
		брод('🛰' 2 4)
		брод('🛸' 3 5)
	]

ƒ звезда(x2•# y2•# величина2•#)•Фраза
	Фраза(
		'✦'
		величина2 · 1m
		место: Место(x2 · 1m y2 · 1m)
		боја: Боја(46% 8 275°)
	)

¶Позорница зумира да обухвати све што се на њој налази, тако да би свака покретна ствар изнова размеравала целу слику при сваком откуцаjу и оставила речи да лебде. Четири угаоне звезде су даље него што бродови икада лете и даље него најдужи ред текста, тако да оквир увек остаје исти и слика стоји мирно. Остало је само небо.¶
звезде: [
		звезда(-5.6 -2.3 0.18)
		звезда(5.6 -2.3 0.18)
		звезда(-5.6 5 0.18)
		звезда(5.6 5 0.18)
		звезда(-4.9 2.1 0.22)
		звезда(-3.9 3.9 0.14)
		звезда(-2.2 2.5 0.18)
		звезда(1.1 3.4 0.14)
		звезда(2.7 4.4 0.22)
		звезда(4.6 2.7 0.14)
	]

Стаге(
	[:звезде :флота приказ песма]
	позадини: Боја(7% 6 275°)
	боја: Боја(88% 3 265°)
)
