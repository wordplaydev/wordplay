🎹
Виртуелни клавир
=== start
¶Клавир од једне октаве на коме можеш свирати!За најбоље искуство, искључи приказ музике.¶

¶Ово повезивање чува ток типа Key који препознаје које дугме си притиснуо.¶
притиснуто: Кључ()

¶Ово чува пресликавање дугмића које притиснеш у ноте које ће свирати,у облику текста (да прикаже ноту која свира) и као бројевну текстуалнувредност (да је претвори у број (#) и убаци у листу типа Track).

Овакав распоред је изабран да подсећа на дугмиће клавира, где белим дугмићима одговарају слова, а црним дугмићима одговарају бројеви.¶
мапаНота: {
		'w': ['C' "1"]
		'3': ['C# / Db' "2"]
		'e': ['D' "3"]
		'4': ['D# / Eb' "4"]
		'r': ['E' "5"]
		't': ['F' "6"]
		'6': ['F# / Gb' "7"]
		'y': ['G' "8"]
		'7': ['G# / Ab' "9"]
		'u': ['A' "10"]
		'8': ['A# / Bb' "11"]
		'i': ['B' "12"]
		'o': ['C5' "13"]
	}

¶Ова функција враћа име ноте, у зависности од притиснутог дугмета.Ако дугме није важило за ноту, враћа празан текст.¶
ƒ вратиText(кључ2•"")•"" (мапаНота{кључ2} ≠ ø) ? мапаНота{кључ2}[1] ""

¶Ова функција враћа број ноте који одговара притиснутом тастеру на списку, да би се користио као улаз у Track. Ако притиснути тастер није важећи, враћа празан списак.¶
ƒ вратиNote(кључ3•"")•[] [
		(мапаНота{кључ3} ≠ ø) ? (мапаНота{кључ3}[2] → #) []
	]

¶Ова функција прима бројчани списак и враћа Track са тим списком нота. Loop је искључен, тако да се нота свира само једном када се тастер притисне.¶
ƒ вратиTrack(нота•[#]) Нумера(нота петља: ⊥)

¶Ова два повезивања дефинишу боју коју ће имати одговарајући тастер када је притиснут и када није.¶
притисниColor: Боја(10 270 50°)
nullColor: Боја(0 0 0°)

¶Ово свира трак који одговара притиснутом тастеру. Scale је хроматска, тако да тракови могу да користе све полустепене. Replay је постављен за случај када се притисне важећи тастер, тако да се трак свира сваки пут кад се тастер притисне, чак и два пута заредом.¶
Музика(
	вратиTrack(вратиNote(притиснуто))
	скала: Музика.хроматска
	понови: мапаНота{притиснуто} ≠ ø
)

¶Приказ клавира, тастера за притискање и ноте која се свира када се тастер притисне.¶
Група(
	Стацк('>' 1m)
	[
		Група(
			Ред('>' -.3m)
			[
				Фраза(
					'▯'
					име: 'w'
					величина: 3m
					боја: притиснуто = 'w' ? притисниColor nullColor
				)
				Фраза(
					'▮'
					име: '3'
					величина: 3m
					боја: притиснуто = '3' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 'e'
					величина: 3m
					боја: притиснуто = 'e' ? притисниColor nullColor
				)
				Фраза(
					'▮'
					име: '4'
					величина: 3m
					боја: притиснуто = '4' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 'r'
					величина: 3m
					боја: притиснуто = 'r' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 't'
					величина: 3m
					боја: притиснуто = 't' ? притисниColor nullColor
				)
				Фраза(
					'▮'
					име: '6'
					величина: 3m
					боја: притиснуто = '6' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 'y'
					величина: 3m
					боја: притиснуто = 'y' ? притисниColor nullColor
				)
				Фраза(
					'▮'
					име: '7'
					величина: 3m
					боја: притиснуто = '7' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 'u'
					величина: 3m
					боја: притиснуто = 'u' ? притисниColor nullColor
				)
				Фраза(
					'▮'
					име: '8'
					величина: 3m
					боја: притиснуто = '8' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 'i'
					величина: 3m
					боја: притиснуто = 'i' ? притисниColor nullColor
				)
				Фраза(
					'▯'
					име: 'o'
					величина: 3m
					боја: притиснуто = 'o' ? притисниColor nullColor
				)
			]
		)

		Група(
			Ред('>' 1.1m)
			[
				Фраза('w')
				Фраза('3')
				Фраза('e')
				Фраза('4')
				Фраза('р т')
				Фраза('6')
				Фраза('y')
				Фраза('7')
				Фраза('u')
				Фраза('8')
				Фраза('и  о')
			]
		)
		Фраза(вратиText(притиснуто))
	]
)
