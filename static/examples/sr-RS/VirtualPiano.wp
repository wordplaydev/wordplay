🎹
Виртуелни клавир
=== start
¶Клавир са једном октавом на коме можеш да свираш! За најбољи доживљај, искључи визуелизацију музике.¶

¶Ова веза чува ток тастера који открива који си тастер притиснуо.¶
притиснут: Кључ()

¶Ово чува мапу од тастера које притискаш до нота које ће свирати, и као текст (да се прикаже нота која свира) и као нумерички текстуални литерал (да се претвори у број (#) и унесе у листу Нумере).

Распоред је изабран тако да личи на клавирске тастере: бели тастери су слова, а црни тастери су цифре.¶
мапаНота: {
		'w': ['Ц' "1"]
		'3': ['Ц# / Дб' "2"]
		'e': ['Д' "3"]
		'4': ['Д# / Еб' "4"]
		'r': ['Е' "5"]
		't': ['Ф' "6"]
		'6': ['Ф# / Гб' "7"]
		'y': ['Г' "8"]
		'7': ['Г# / Аб' "9"]
		'u': ['А' "10"]
		'8': ['А# / Бб' "11"]
		'i': ['Х' "12"]
		'o': ['Ц5' "13"]
	}

¶Ова функција враћа име ноте на основу тастера који је притиснут. Ако тастер није исправна нота, враћа празан текст.¶
ƒ вратиТекст(тастер2•"")•"" (мапаНота{тастер2} ≠ ø) ? мапаНота{тастер2}[1] ""

¶Ова функција враћа број ноте који одговара притиснутом тастеру, у листи, да би се користио као улаз у Track. Ако је притиснут неисправан тастер, враћа празну листу.¶
ƒ вратиНоту(тастер3•"")•[] [
		(мапаНота{тастер3} ≠ ø) ? (мапаНота{тастер3}[2] → #) []
	]

¶Ова функција прима нумеричку листу и враћа Track са том листом нота. Петља је искључена, па се нота одсвира једном када се притисне тастер.¶
ƒ вратиНумеру(нота•[#]) Нумера(нота петља: ⊥)

¶Ова два везивања у мапи одређују коју боју добија одговарајући тастер када је притиснут и када није.¶
притисниБоју: Боја(10 270 50°)
празнаБоја: Боја(0 0 0°)

¶Ово пушта одговарајући Track за притиснути тастер. Скала је хроматска да би трекови могли да користе све полутонове. Понављање је подешено за случај када се притисне исправан тастер, па се Track пушта сваки пут када се тастер притисне, чак и два пута заредом.¶
Музика(
	вратиНумеру(вратиНоту(притиснут))
	скала: Музика.хроматска
	понови: мапаНота{притиснут} ≠ ø
)

¶Приказује клавир, тастере које треба притиснути и ноту која се свира када се притисне тастер.¶
Група(
	Стацк('>' 1m)
	[
		Група(
			Ред('>' -.3m)
			[
				Фраза(
					'▯'
					име: 'w'
					величина: 3m
					боја: притиснут = 'w' ? притисниБоју празнаБоја
				)
				Фраза(
					'▮'
					име: '3'
					величина: 3m
					боја: притиснут = '3' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 'e'
					величина: 3m
					боја: притиснут = 'e' ? притисниБоју празнаБоја
				)
				Фраза(
					'▮'
					име: '4'
					величина: 3m
					боја: притиснут = '4' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 'r'
					величина: 3m
					боја: притиснут = 'r' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 't'
					величина: 3m
					боја: притиснут = 't' ? притисниБоју празнаБоја
				)
				Фраза(
					'▮'
					име: '6'
					величина: 3m
					боја: притиснут = '6' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 'y'
					величина: 3m
					боја: притиснут = 'y' ? притисниБоју празнаБоја
				)
				Фраза(
					'▮'
					име: '7'
					величина: 3m
					боја: притиснут = '7' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 'u'
					величина: 3m
					боја: притиснут = 'u' ? притисниБоју празнаБоја
				)
				Фраза(
					'▮'
					име: '8'
					величина: 3m
					боја: притиснут = '8' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 'i'
					величина: 3m
					боја: притиснут = 'i' ? притисниБоју празнаБоја
				)
				Фраза(
					'▯'
					име: 'o'
					величина: 3m
					боја: притиснут = 'o' ? притисниБоју празнаБоја
				)
			]
		)

		Група(
			Ред('>' 1.1m)
			[
				Фраза('w')
				Фраза('3')
				Фраза('e')
				Фраза('4')
				Фраза('r t')
				Фраза('6')
				Фраза('y')
				Фраза('7')
				Фраза('u')
				Фраза('8')
				Фраза('i  o')
			]
		)
		Фраза(вратиТекст(притиснут))
	]
)
