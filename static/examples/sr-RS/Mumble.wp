m
Мрмљање
=== start
¶Настави да кликћеш како би мрмљање постајало смелије.¶

кликова•#: 0 … ∆ Дугме() … кликова + 1

кликова < 3 ?
	Фраза(
		'мрмљај'
		величина: 1m
		име: 'мама'
		улазећи: Поза(размера: 0)
		мировање: Секвенца(
			{
				0%: Поза(размера: (кликова + 1) × 1.1)
				50%: Поза(размера: (кликова + 1) × 0.9)
				100%: Поза(размера: (кликова + 1) × 1.1)
			}
			трајање: 0.5s
		)
		излазећи: Секвенца(
			{
				0%: Поза(непрозирност: 1 размера: 1)
				100%: Поза(непрозирност: 0 размера: 10)
			}
			трајање: 2s
		)
	)
	Фраза('готово')