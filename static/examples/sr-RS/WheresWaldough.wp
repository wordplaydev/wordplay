🔁
Где је Валдо?
=== start/en
¶Пронађи Валдоуа скривеног у гужви: потражи човека у наранџастој мајици и кликни на њега да победиш!¶

име3: Избор()
ухваћен: ⊥ … ∆ (име3) … (име3 = 'ResetButton') ? ⊥ ((име3 = 'Waldough') | ухваћен)
резултат: 0 … ∆ (име3) … (име3 = 'Waldough') ? 1 + резултат резултат

ƒ место2() Место(
		((0.1 × Рандом(-9m 9m)) + Рандом(-2m 1m))
		((0.1 × Рандом(-9m 9m)) + Рандом(-2m 1m))
	)
ƒ новеТачке() [
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
		место2()
	]
тачке2: новеТачке() … ∆ (име3) … (име3 = 'ResetButton') ? новеТачке(
			) тачке2


Стаге(
	[
		Фраза(
			"🔁"
			избор: ⊤
			место: Место(4m -0.5m)
			мировање: ухваћен ? Посе(ротација: 180°) Посе()
			трајање: 0.5s
			име: 'ResetButton'
		)
		Фраза(
			'Потражи наранџасту мајицу'
			0.2m
			место: Место(-6.2m 0.75m)
			лице: 'Carter One'
		)
		Фраза(
			'човек (по имену Валдоу) и'
			0.2m
			место: Место(-6.4m 0.25m)
			лице: 'Carter One'
		)
		Фраза(
			'кликни на њега да победиш!🧍🏻'
			0.2m
			место: Место(-6.0m -0.25m)
			лице: 'Carter One'
		)
		Фраза(
			'Резултат: ' + резултат → ''
			0.5m
			место: Место(-5.9m -1m)
		)

		Фраза("🏀" место: тачке2[1])
		Фраза("🦧" место: тачке2[2])
		Фраза("🍊" место: тачке2[3])
		Фраза("👻" место: тачке2[4])
		Фраза("🤖" место: тачке2[5])
		Фраза("👽" место: тачке2[6])
		Фраза("🐀" место: тачке2[7])
		Фраза("🦣" место: тачке2[8])
		Фраза("🐸" место: тачке2[9])
		Фраза("🍎" место: тачке2[10])
		Фраза("💧" место: тачке2[11])
		Фраза("🍔" место: тачке2[12])
		Фраза("❤" место: тачке2[13])
		Фраза("🍥" место: тачке2[14])
		Фраза(
			"🧍🏻"
			избор: ~ухваћен
			место: тачке2[15]
			мировање: ухваћен ? Посе(ротација: 180°) Посе()
			трајање: 0s
			име: 'Waldough'
		)
		Фраза("🔥" место: тачке2[16])
		Фраза("🎂" место: тачке2[17])
		Фраза("🐕" место: тачке2[18])
		Фраза("🦈" место: тачке2[19])
		Облик(Правоугаоник(-3.5m -3m 3.5m -3.5m))
		Облик(Правоугаоник(-3.5m 3.5m 3.5m 3m))
		Облик(Правоугаоник(-3.5m 3.5m -3m -3.5m))
		Облик(Правоугаоник(3m 3.5m 3.5m -3.5m))
	]
	место: Место(0m 0m -5m)
)