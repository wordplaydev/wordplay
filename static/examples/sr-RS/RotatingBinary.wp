RotatingBinary
=== start/en
¶Поље јединица и нула, које се споро окреће у месту.¶
спороОкретање: Секуенце.спин(10s "straight")

Стаге(
	[
		Фраза(
			'1'
			место: Место(-0.5m -0.125m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'0'
			место: Место(1.25m -0.25m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'1'
			место: Место(-2.3125m 0.0625m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'0'
			место: Место(-1.6875m -1m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'1'
			место: Место(-1.4375m 0.75m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'0'
			место: Место(0.375m -1.3125m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'0'
			место: Место(-0.6875m -1.75m 0m)
			мировање: спороОкретање
		)
		Фраза(
			'1'
			место: Место(0.4375m 1.125m 0m)
			мировање: спороОкретање
		)
	]
)