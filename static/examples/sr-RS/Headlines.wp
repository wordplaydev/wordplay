l
Наслови
=== start/en
¶Наслови из New York Times-а уживо, преузети са веба и наслагани на позорници.¶
наслови: Вебпаге(
		'https://www.nytimes.com'
		'.indicate-hover'
	)
наслови•# ?
	Фраза('учитавање')
	Група(
		Стацк('<')
		[
			Фраза(`*Наслови New York Times-а*` 2m лице: 'Arvo')
		].витхЛист(
			наслови.подсеквенца(1 7).преводити(
				ƒ(наслов)
					Фраза(
						наслов
						замотати: 20m
						поравнање: '<'
						лице: 'Ubuntu'
						мировање: Секуенце(
							{
								0%: Посе(ротација: 3°)
								50%: Посе(ротација: -3°)
								100%: Посе(ротација: 3°)
							}
							трајање: 3s
						)
					)
			)
		)
	)