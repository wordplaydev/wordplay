🙂
Лице
===
¶Емоџи који опонаша твоје лице док се смешиш, мрштиш, зјапиш и трепћеш.¶
лице2: Лице()

Стаге(
	[
		Фраза(
			(лице2.устаОтворена ? '😮'
					лице2.осмех ? '😀'
						лице2.мрштење ? '🙁'
							лице2.подигнутеОбрве ? '😲'
								(лице2.очиОтворене ? '🙂' '😑'))
			место: лице2.место
			величина: 4m
		)
		Група(
			Стацк('|')
			[
				Фраза((лице2.очиОтворене ? '👀' '😑') величина: 1.5m)
				Фраза(
					'😊'
					величина: (лице2.количинаОсмеха · 2m) + 0.5m
				)
				Фраза(
					'👄'
					величина: (лице2.количинаОтворенихУста · 2m) + 0.5m
				)
				Фраза(
					'🤨'
					величина: (лице2.количинаПодизањаОбрва · 2m) + 0.5m
				)
			]
			место: Место(-9m 8m)
		)
		Фраза(
			'окрени 🧭'
			место: Место(9m 8m 0m)
			величина: 2m
			ротација: лице2.окрет
		)
		Фраза(
			'нагни 🧭'
			место: Место(9m 2m)
			ротација: лице2.нагиб
			величина: 2m
		)
		Фраза(
			`/Покажи камери своје лице/`
			место: Место(-6m -12m)
			величина: 1m
		)
	]
	место: Место(0m 0m -20m)
)