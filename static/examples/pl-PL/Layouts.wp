K
Układy
=== start
¶Rzędy, stosy i grupy fraz, każda w ruchomej, efektownej pozie.¶

pulsuj: Sekwencja(
		{
			0%: Poza(skala: .9)
			50%: Poza(skala: 1.1)
			100%: Poza(skala: .9)
		}
	)
odbijaj: Sekwencja(
		{
			0%: Poza(zrównoważyć: Miejsce(z: 0m))
			50%: Poza(zrównoważyć: Miejsce(z: -2m))
			100%: Poza(zrównoważyć: Miejsce(z: 0m))
		}
		1s
	)

Grupa(
	Wiersz()
	[
		Grupa(
			Stos()
			[
				Fraza('Kotek')
				Fraza('Kot' spoczynkowy: odbijaj)
				Grupa(
					Wiersz()
					[Fraza('Pies') Fraza('Psowaty')]
					spoczynkowy: pulsuj
				)
				Fraza('Kotowaty')
			]
		)
		Grupa(
			Stos()
			[
				Fraza('Cześć')
				Fraza('Witaj')
			]
			spoczynkowy: Sekwencja.obrót(2s "straight")
		)
	]
)