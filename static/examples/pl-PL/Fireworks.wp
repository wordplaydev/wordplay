	[
		:odpalanie.tłumaczyć(ƒ(p6•Część i3•#) wybuch(p6 i3))
		Muzyka(
			[
				Ścieżka(
					melodia2
					instrument: Instrument.trąbka
					głośność: 90%
					pętla: ⊥
				)
				Ścieżka(
