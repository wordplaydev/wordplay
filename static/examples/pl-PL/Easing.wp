s
Płynność sekwencji
===
¶Ta sama animacja samochodu na osiem sposobów, po jednym dla każdego stylu łagodzenia ruchu.¶

klatkiKluczowe: {
		0%: Poza(zrównoważyć: Miejsce(-1m 0m))
		25%: Poza(zrównoważyć: Miejsce(1m 0m))
		50%: Poza(zrównoważyć: Miejsce(1m 0m))
		75%: Poza(zrównoważyć: Miejsce(-1m 0m))
		100%: Poza(zrównoważyć: Miejsce(-1m 0m))
	}

Scena(
	[
		Grupa(
			Siatka(4 2 wypełnieniekomórek: 0.25m)
			[
				Fraza('prosto' rozmiar: 0.25m)
				Fraza(
					"🚗"
					spoczynkowy: Sekwencja(
						klatkiKluczowe
						3s
						styl: "straight"
					)
				)
				Fraza('ostrożnie' rozmiar: 0.25m)
				Fraza(
					"🚚"
					spoczynkowy: Sekwencja(
						klatkiKluczowe
						3s
						styl: "cautious"
					)
				)
				Fraza('powoli' rozmiar: 0.25m)
				Fraza(
					"🚙"
					spoczynkowy: Sekwencja(
						klatkiKluczowe
						3s
						styl: "pokey"
					)
				)
				Fraza('żwawo' rozmiar: 0.25m)
				Fraza(
					"🏎"
					spoczynkowy: Sekwencja(
						klatkiKluczowe
						3s
						styl: "zippy"
					)
				)
			]
		)
	]
)