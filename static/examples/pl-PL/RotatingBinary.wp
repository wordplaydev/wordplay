1
RotatingBinary
=== start/en
¶Pole jedynek i zer, powoli obracające się w miejscu.¶
powolnyObrót: Sekwencja.obrót(10s "straight")

Scena(
	[
		Wyrażenie(
			'1'
			miejsce: Miejsce(-0.5m -0.125m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'0'
			miejsce: Miejsce(1.25m -0.25m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'1'
			miejsce: Miejsce(-2.3125m 0.0625m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'0'
			miejsce: Miejsce(-1.6875m -1m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'1'
			miejsce: Miejsce(-1.4375m 0.75m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'0'
			miejsce: Miejsce(0.375m -1.3125m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'0'
			miejsce: Miejsce(-0.6875m -1.75m 0m)
			spoczynkowy: powolnyObrót
		)
		Wyrażenie(
			'1'
			miejsce: Miejsce(0.4375m 1.125m 0m)
			spoczynkowy: powolnyObrót
		)
	]
)