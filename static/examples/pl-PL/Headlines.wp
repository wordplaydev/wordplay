Nagłówki
=== start/en
¶Aktualne nagłówki z New York Times, pobrane z internetu i ułożone na scenie.¶

nagłówki: Stronainternetowa(
		'https://www.nytimes.com'
		'.indicate-hover'
	)
nagłówki•# ?
	Fraza('ładowanie')
	Grupa(
		Stos('<')
		[
			Fraza(
				`*Nagłówki New York Times*`
				2m
				twarz: 'Arvo'
			)
		].zListą(
			nagłówki.podsekwencja(1 7).przekształć(
				ƒ(nagłówek)
					Fraza(
						nagłówek
						zawinąć: 20m
						wyrównanie: '<'
						twarz: 'Ubuntu'
						spoczynkowy: Sekwencja(
							{
								0%: Poza(obrót: 3°)
								50%: Poza(obrót: -3°)
								100%: Poza(obrót: 3°)
							}
							czastrwania: 3s
						)
					)
			)
		)
	)