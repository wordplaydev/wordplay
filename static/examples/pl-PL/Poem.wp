T
Wiersz
=== start
¶Wiersz, którego wersy wpływają powoli, a każdy z nich wchodzi po swojemu.¶

•linia(tekst2•"" poza•Poza|Sekwencja tył: Kolor(
			100
			100
			100°
		) przód: Kolor(0 0 0°))

¶Lista wersów wiersza, a każdy z nich ma swoją pozę.¶
wiersz: [
		linia(
			'Plik komputerowy'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia(
			'o którym'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia('nic nie pamiętam' Poza(obrót: 10°))
		linia(
			'klikam, żeby go otworzyć'
			Sekwencja(
				{
					0%: Poza(skala: 1)
					50%: Poza(skala: 0.7)
					100%: Poza(skala: 1)
				}
				0.25s
			)
		)
		linia(
			'patrz'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia(
			'przewijam jeszcze niżej'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: 5m)
			)
		)
		linia(
			'ekran'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia(
			'świeci pusty'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
			Kolor(0 0 0°)
			Kolor(100 100 0°)
		)
		linia(
			'tak spotykam siebie znowu'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia(
			'pełen nadziei i bezużyteczny'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia(
			'tajemnica'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia(
			'dokładnie tak, jak musiałem to zrobić'
			Poza(
				nieprzezroczystość: 0%
				zrównoważyć: Miejsce(y: -5m)
			)
		)
		linia('19 sierpnia 2010 roku, godz. 11:08' Poza())
	]

liczba2: 1 … ∆ Przycisk() | ∆ Klawisz() …
		(liczba2 = (wiersz.długość() + 1)) ? 1 liczba2 + 1
linijka: wiersz[liczba2]

liczba2 ≤ wiersz.długość() ?
	Scena(
		[
			Wyrażenie(
				linijka.tekst2
				wstępowanie: linijka.poza
				czastrwania: 1s
				nazwa: liczba2 → ""
				styl: 'cautious'
			)
		]
		tło: linijka.tył
		spoczynkowy: Poza(kolor: linijka.przód)
	)
	Scena(
		[
			Grupa(
				Stos()
				[
					Wyrażenie('RADA DLA SIEBIE SAMEGO')
					Wyrażenie('Jane Hirshfield')
				]
				wstępowanie: Poza(skala: 0.75)
			)
		]
		tło: Kolor(0% 0 0°)
		kolor: Kolor(100% 100 0°)
	)