¶Tort powiększa się na każdym takcie i opada między nimi.¶
ƒ tort() Wyrażenie(
		'🎂'
		(4m + ((liczba2 % 2) · 0.4m))
		czastrwania: 0.2s
	)

Scena(
	[
		Grupa(
			Stos(wyściółka: 0.5m)
			[
				tort()
				Wyrażenie('Sto lat' 1.3m)
			]
		)
		Muzyka(
			[
				Ścieżka(
					melodia2
					instrument: Instrument.flet
					rytm: 0.5beats
				)
				Ścieżka(
					alt
					instrument: Instrument.skrzypce
					rytm: 0.5beats
					głośność: 65%
				)
				Ścieżka(
					akordy
					instrument: Instrument.pianino
					rytm: 1beats
					głośność: 55%
				)
			]
			tempo: 116beats/min
			nazwa: 'urodziny'
		)
	]
	tło: Kolor(18% 20 330°)
	kolor: Kolor(96% 0 0°)
)
