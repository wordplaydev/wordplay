¶اصنع عالمًا مع الشاشة بداخله¶/ar
Scena(
	[screen ścieżkaDźwiękowa]
	miejsce: Miejsce(0m 0m -12m)
	twarz: "Poor Story"
	tło: Kolor(0% 0 0°)
	kolor: Kolor(100% 0 0°)
)
