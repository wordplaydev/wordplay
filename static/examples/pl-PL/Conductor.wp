			Ścieżka(
				bas
				instrument: Instrument.basSyntezatora
				rytm: 1𝅘𝅥
				tonacja: -24semitones
				głośność: usłyszany(2 30%)
			)
			Ścieżka(
				perkusja2
				instrument: Instrument.perkusja
				rytm: 1𝅘𝅥
				głośność: usłyszany(3 20%)
			)
