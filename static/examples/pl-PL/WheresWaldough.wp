🔁
Gdzie jest Waldough?
=== start/en
¶Znajdź Waldka skrytego w tłumie: szukaj mężczyzny w pomarańczowej koszulce i kliknij na niego, aby wygrać!¶

nazwa3: Wybór()
złapany: ⊥ … ∆ (nazwa3) … (nazwa3 = 'ResetButton') ? ⊥ ((nazwa3 = 'Waldough') | złapany)
wynik: 0 … ∆ (nazwa3) … (nazwa3 = 'Waldough') ? 1 + wynik wynik

ƒ punktów() Miejsce(
		((0.1 × Losowy(-9m 9m)) + Losowy(-2m 1m))
		((0.1 × Losowy(-9m 9m)) + Losowy(-2m 1m))
	)
ƒ nowePlamki() [
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
		punktów()
	]
plamki: nowePlamki() … ∆ (nazwa3) … (nazwa3 = 'ResetButton') ? nowePlamki(
			) plamki


Scena(
	[
		Wyrażenie(
			"🔁"
			wybieralny: ⊤
			miejsce: Miejsce(4m -0.5m)
			spoczynkowy: złapany ? Poza(obrót: 180°) Poza()
			czastrwania: 0.5s
			nazwa: 'ResetButton'
		)
		Wyrażenie(
			'Szukaj pomarańczowej koszulki'
			0.2m
			miejsce: Miejsce(-6.2m 0.75m)
			twarz: 'Carter One'
		)
		Wyrażenie(
			'mężczyzna (imieniem Waldek) i'
			0.2m
			miejsce: Miejsce(-6.4m 0.25m)
			twarz: 'Carter One'
		)
		Wyrażenie(
			'kliknij na niego, aby wygrać!🧍🏻'
			0.2m
			miejsce: Miejsce(-6.0m -0.25m)
			twarz: 'Carter One'
		)
		Wyrażenie(
			'Wynik: ' + wynik → ''
			0.5m
			miejsce: Miejsce(-5.9m -1m)
		)

		Wyrażenie("🏀" miejsce: plamki[1])
		Wyrażenie("🦧" miejsce: plamki[2])
		Wyrażenie("🍊" miejsce: plamki[3])
		Wyrażenie("👻" miejsce: plamki[4])
		Wyrażenie("🤖" miejsce: plamki[5])
		Wyrażenie("👽" miejsce: plamki[6])
		Wyrażenie("🐀" miejsce: plamki[7])
		Wyrażenie("🦣" miejsce: plamki[8])
		Wyrażenie("🐸" miejsce: plamki[9])
		Wyrażenie("🍎" miejsce: plamki[10])
		Wyrażenie("💧" miejsce: plamki[11])
		Wyrażenie("🍔" miejsce: plamki[12])
		Wyrażenie("❤" miejsce: plamki[13])
		Wyrażenie("🍥" miejsce: plamki[14])
		Wyrażenie(
			"🧍🏻"
			wybieralny: ~złapany
			miejsce: plamki[15]
			spoczynkowy: złapany ? Poza(obrót: 180°) Poza()
			czastrwania: 0s
			nazwa: 'Waldough'
		)
		Wyrażenie("🔥" miejsce: plamki[16])
		Wyrażenie("🎂" miejsce: plamki[17])
		Wyrażenie("🐕" miejsce: plamki[18])
		Wyrażenie("🦈" miejsce: plamki[19])
		Kształt(Prostokąt(-3.5m -3m 3.5m -3.5m))
		Kształt(Prostokąt(-3.5m 3.5m 3.5m 3m))
		Kształt(Prostokąt(-3.5m 3.5m -3m -3.5m))
		Kształt(Prostokąt(3m 3.5m 3.5m -3.5m))
	]
	miejsce: Miejsce(0m 0m -5m)
)