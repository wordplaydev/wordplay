🙂
रूप
===
¶एक इमोजी जो आपके चेहरे की नकल करता है, जब आप मुस्कुराते हैं, मुँह बनाते हैं, मुँह खोलते हैं और पलकें झपकाते हैं।¶

रूप2: चेहरा()

मंच(
	[
		वाक्यांश(
			(रूप2.मुँहखुला ? '😮'
					रूप2.मुस्कुराना ? '😀'
						रूप2.भौंहेंतानना ? '🙁'
							रूप2.भौंहेंउठीं ? '😲'
								(रूप2.आँखेंखुली ? '🙂' '😑'))
			स्थल: रूप2.स्थल
			आकार: 4m
		)
		समूह(
			ढेर('|')
			[
				वाक्यांश((रूप2.आँखेंखुली ? '👀' '😑') आकार: 1.5m)
				वाक्यांश('😊' आकार: (रूप2.मुस्कानकीमात्रा · 2m) + 0.5m)
				वाक्यांश('👄' आकार: (रूप2.मुँहखुलनेकीमात्रा · 2m) + 0.5m)
				वाक्यांश('🤨' आकार: (रूप2.भौंहेंउठनेकीमात्रा · 2m) + 0.5m)
			]
			स्थल: स्थल(-9m 8m)
		)
		वाक्यांश('मुड़ना 🧭' स्थल: स्थल(9m 8m 0m) आकार: 2m घुमाव: रूप2.घुमाव)
		वाक्यांश('झुकना 🧭' स्थल: स्थल(9m 2m) घुमाव: रूप2.झुकाव आकार: 2m)
		वाक्यांश(`/कैमरे को अपना चेहरा दिखाएँ/` स्थल: स्थल(-6m -12m) आकार: 1m)
	]
	स्थल: स्थल(0m 0m -20m)
)