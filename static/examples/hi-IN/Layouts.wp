K
लेआउट
=== start
¶वाक्यांशों की पंक्तियाँ, ढेर और समूह, जो हर बार एनिमेशन वाली नई मुद्राएँ बनाते हैं।¶

धड़कना: अनुक्रम(
		{0%: मुद्रा(स्केल: .9) 50%: मुद्रा(स्केल: 1.1) 100%: मुद्रा(स्केल: .9)}
	)
उछलना: अनुक्रम(
		{
			0%: मुद्रा(ऑफ़सेट: स्थल(z: 0m))
			50%: मुद्रा(ऑफ़सेट: स्थल(z: -2m))
			100%: मुद्रा(ऑफ़सेट: स्थल(z: 0m))
		}
		1s
	)

समूह(
	पंक्ति()
	[
		समूह(
			ढेर()
			[
				वाक्यांश('बिल्लू')
				वाक्यांश('बिल्ली' विश्राम: उछलना)
				समूह(पंक्ति() [वाक्यांश('कुत्ता') वाक्यांश('श्वान')] आराम: धड़कना)
				वाक्यांश('मार्जार')
			]
		)
		समूह(
			ढेर()
			[
				वाक्यांश('हाय')
				वाक्यांश('नमस्ते')
			]
			आराम: अनुक्रम.घुमाव(2s "straight")
		)
	]
)