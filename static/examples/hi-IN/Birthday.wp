¶केक हर ताल पर फूलता है और तालों के बीच शांत हो जाता है।¶
ƒ केक() वाक्यांश('🎂' (4m + ((गिनती2 % 2) · 0.4m)) अवधि: 0.2s)

मंच(
	[
		समूह(
			ढेर(अंतराल: 0.5m)
			[
				केक()
				वाक्यांश('जन्मदिन मुबारक' 1.3m)
			]
		)
		संगीत(
			[
				ट्रैक(धुन2 वाद्य: वाद्य.बांसुरी ताल: 0.5beats)
				ट्रैक(ऑल्टो वाद्य: वाद्य.वायलिन ताल: 0.5beats आवाज़: 65%)
				ट्रैक(chords वाद्य: वाद्य.पियानो ताल: 1beats आवाज़: 55%)
			]
			गति: 116beats/min
			नाम: 'जन्मदिन'
		)
	]
	पृष्ठभूमि: रंग(18% 20 330°)
	रंग: रंग(96% 0 0°)
)
