↑
भूलभुलैया
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•भूलभुलैया() (
	ग्रिड•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ कोठरी(पंक्ति2•# कॉलम2•#) (
			कोष्ठिकाएँ: ग्रिड[पंक्ति2]
			कोष्ठिकाएँ•[] ? कोष्ठिकाएँ[कॉलम2] ø
		)

	ƒ अनुमतिहै(पंक्ति3•# कॉलम3•#) कोठरी(पंक्ति3 कॉलम3)•''
)

भूलभुलैया2: भूलभुलैया()

•स्थिति(पंक्ति4•# कॉलम4•# कदम•#)
(
	ƒ नीचे2() स्थिति(पंक्ति4 + 1 कॉलम4 कदम + 1)
	ƒ ऊपर2() स्थिति(पंक्ति4 - 1 कॉलम4 कदम + 1)
	ƒ बाएँ() स्थिति(पंक्ति4 कॉलम4 - 1 कदम + 1)
	ƒ दाएँ() स्थिति(पंक्ति4 कॉलम4 + 1 कदम + 1)
)

ƒ अनुमतिहै2(स्थिति2•स्थिति पंक्ति5•# कॉलम5•#) भूलभुलैया2.अनुमतिहै(
		स्थिति2.पंक्ति4 + पंक्ति5
		स्थिति2.कॉलम4 + कॉलम5
	)

दिशा2: चयन()
स्थिति3•स्थिति: स्थिति(1 1 0) … ∆ दिशा2 …
		((दिशा2 = "left") & अनुमतिहै2(स्थिति3 0 -1)) ? स्थिति3.बाएँ()
			((दिशा2 = "right") & अनुमतिहै2(स्थिति3 0 1)) ? स्थिति3.दाएँ()
				((दिशा2 = "up") & अनुमतिहै2(स्थिति3 -1 0)) ? स्थिति3.ऊपर2()
					((दिशा2 = "down") & अनुमतिहै2(स्थिति3 1 0)) ? स्थिति3.नीचे2()
						स्थिति3

मौजूदा: (
		कोठरी2: भूलभुलैया2.कोठरी(स्थिति3.पंक्ति4 स्थिति3.कॉलम4)
		कोठरी2 ?? ' ')
ऊपर3: भूलभुलैया2.कोठरी(स्थिति3.पंक्ति4 - 1 स्थिति3.कॉलम4)•''
नीचे3: भूलभुलैया2.कोठरी(स्थिति3.पंक्ति4 + 1 स्थिति3.कॉलम4)•''
बाएँ2: भूलभुलैया2.कोठरी(स्थिति3.पंक्ति4 स्थिति3.कॉलम4 - 1)•''
दाएँ2: भूलभुलैया2.कोठरी(स्थिति3.पंक्ति4 स्थिति3.कॉलम4 + 1)•''
जीता: मौजूदा = '🤩'

मंच(
	[
		समूह(
			जाल(3 3 0.25m)
			[
				ø
				वाक्यांश(
					'↑'
					नाम: 'up'
					चुननेयोग्य: ऊपर3
					विश्राम: मुद्रा(अपारदर्शिता: ऊपर3 ? 1 0.2)
				)
				ø
				वाक्यांश(
					'←'
					नाम: 'left'
					चुननेयोग्य: बाएँ2
					विश्राम: मुद्रा(अपारदर्शिता: बाएँ2 ? 1 0.2)
				)
				वाक्यांश(
					मौजूदा
					विश्राम: जीता ?
						अनुक्रम.घुमाव(अवधि: 1s शैली: 'straight')
						मुद्रा()
				)
				वाक्यांश(
					'→'
					नाम: 'right'
					चुननेयोग्य: दाएँ2
					विश्राम: मुद्रा(अपारदर्शिता: दाएँ2 ? 1 0.2)
				)
				ø
				वाक्यांश(
					'↓'
					नाम: 'down'
					चुननेयोग्य: नीचे3
					विश्राम: मुद्रा(अपारदर्शिता: नीचे3 ? 1 0.2)
				)
				ø
			]
		)
	]
	स्थल: स्थल(0m 0m -3m)
	फलक: 'Noto Emoji'
	पृष्ठभूमि: रंग(0 0 0°)
	आराम: मुद्रा(रंग(100 100 0°))
)