M
नाशपाती
=== start/en
¶यह एक इंटरैक्टिव छोटी कहानी है। इसमें कई अलग-अलग दृश्य बनाए गए हैं, और यह क्लिक, टक्कर, और दूसरी क्रियाओं जैसी अलग-अलग इंटरैक्शन के आधार पर एक दृश्य से दूसरे दृश्य में जाती है। इस कहानी का एक मज़ा यह पता लगाना है कि कहानी को आगे बढ़ाने के लिए कौन-सी इंटरैक्शन ज़रूरी है।¶
आरंभपरिचय: [
		वाक्यांश(`मेरे पापा जाना चाहते थे।` स्थल: स्थल(-9m 0m))
	]

टकराव: [
		वाक्यांश(`"माँ", हमें जाना होगा।` स्थल: स्थल(-8m 7m))
		वाक्यांश(`/"ले जाओ घर।"/` स्थल: स्थल(1m 4m))
		वाक्यांश(`"माँ हमें कुछ नहीं चाहिए!"` स्थल: स्थल(-8m 1m))
		वाक्यांश(
			`"ले जाओ घर!"`
			आकार: 2m
			स्थल: स्थल(-6m -4m)
			विश्राम: अनुक्रम.कंपन()
		)
	]

बढ़तीघटना1: [
		वाक्यांश(`मेरी 炮炮👵🏽 आँगन में चली गई` स्थल: स्थल(-9m 7m))
		वाक्यांश(`मैं उत्सुक होकर उसके पीछे गई` स्थल: स्थल(-6m 4m))
		वाक्यांश(
			`👵🏽`
			नाम: 'पाउपाउ'
			आकार: 2m
			पदार्थ: पदार्थ()
			स्थल: स्थल(6m -6m)
			बुलबुला: `/"沙梨🍐, ले जाओ घर!"/`
		)
		वाक्यांश(
			`👧🏻`
			नाम: 'मैं'
			आकार: 1m
			पदार्थ: पदार्थ()
			स्थल: स्थाननिर्धारण(स्थल(-8m -6m))
		)
	]

बढ़तीघटना2: [
		वाक्यांश(`वह एक छोटे पेड़ के पास रुकी।` स्थल: स्थल(-9m 6m))
		वाक्यांश(
			`उस पर चमकीले पीले 沙梨 (नाशपाती) के दर्जनों गुच्छे उलझे हुए थे`
			स्थल: स्थल(-9m 1m)
			लपेटना: 10m
		)
		वाक्यांश(`"माँ, हमें कोई नाशपाती नहीं चाहिए।"` आकार: .75m स्थल: स्थल(-4m 0m))
		वाक्यांश(`/मुझे एक नाशपाती चाहिए थी।/` आकार: 2m स्थल: स्थल(-8m -3m))
		वाक्यांश("🍐" आकार: 2m स्थल: स्थल(-1m -7m) नाम: 'pear' चुननेयोग्य: ⊤)
	]

¶हम पहले से जगहें तय कर लेते हैं ताकि वे एक ही जगह से गिरें।¶
जगहें: (6 → []).बदलो(ƒ() स्थल(यादृच्छिक(-2m 2m) यादृच्छिक(-3m -5m)))
चरमबिंदु: [
		वाक्यांश(`वह मिट्टी में घुटनों के बल बैठ गई।` स्थल: स्थल(-9m 6m))
		वाक्यांश(`एक चाकू उठाया` स्थल: स्थल(-9m 4m))
		वाक्यांश(`और ध्यान से छह काटे` स्थल: स्थल(-9m 2m))
		वाक्यांश(`उन्हें नीचे अपनी टोकरी में गिराते हुए` स्थल: स्थल(-9m 0m))
		वाक्यांश("🧺" आकार: 4m स्थल: स्थल(-2m -12m))
		वाक्यांश("🌳" नाम: "tree" आकार: 5m स्थल: स्थल(-3m -7m) चुननेयोग्य: ⊤)
		:जगहें.बदलो(
			ƒ(जगह अनुक्रमणिका2)
				वाक्यांश(
					"🍐"
					नाम: "pear\अनुक्रमणिका2\"
					स्थल: चयन() = 'tree' ? चाल(जगह) जगह
				)
		)
		वाक्यांश("🔪" स्थल: पॉइंटर())
	]

समाधान: [
		वाक्यांश(`वह उन्हें मेरे पास लाई` स्थल: स्थल(-9m 6m))
		वाक्यांश(`मेरे सामने घुटनों के बल बैठी` स्थल: स्थल(-8m 4m))
		वाक्यांश(`और मुझे टोकरी थमा दी` स्थल: स्थल(-7m 2m))
		वाक्यांश(`/"लो, घर जाओ"/` स्थल: स्थल(0m -2m))
	]

श्रेय: [
		वाक्यांश(`लेखिका /एमी जे. को/`)
	]

कहानी: [
		आरंभपरिचय
		टकराव
		बढ़तीघटना1
		बढ़तीघटना2
		चरमबिंदु
		समाधान
		श्रेय
	]

¶क्लिक और टैप का हिसाब रखें¶
क्लिक: ∆ बटन()
¶पेड़ पर क्लिक करने के कितनी देर बाद हुआ, इसका हिसाब रखें¶
कटकेबादकासमय: 0ms … चयन() = 'tree' … समय(1000ms)
¶नज़र रखें कि हम पाउ पाउ तक कब पहुँचते हैं¶
पाउपाउकेपास: ∆ टक्कर('मैं')
¶नज़र रखें कि नाशपाती कब चुनी जाती है¶
नाशपातीचुनी: चयन() = 'pear'
¶मौजूदा हिस्से के आधार पर हिस्सा बदलें¶
हिस्सा•#:
	1 …
	हिस्सा ???
		1: क्लिक
		2: क्लिक
		3: पाउपाउकेपास
		4: नाशपातीचुनी
		5: कटकेबादकासमय > 1500ms
		6: ∆ बटन()
		⊥
		… हिस्सा + 1

मंच(
	कहानी[हिस्सा]
	फलक: 'Arvo'
	स्थल: स्थल(0m 0m -20m)
	फ़्रेम: आयत(-10m 10m 10m -10m)
)