s
क्रम की सहज गति
===
¶एक ही कार का एनिमेशन आठ तरीकों से, हर ईज़िंग शैली के लिए एक।¶

कीफ़्रेम: {
		0%: मुद्रा(ऑफ़सेट: स्थल(-1m 0m))
		25%: मुद्रा(ऑफ़सेट: स्थल(1m 0m))
		50%: मुद्रा(ऑफ़सेट: स्थल(1m 0m))
		75%: मुद्रा(ऑफ़सेट: स्थल(-1m 0m))
		100%: मुद्रा(ऑफ़सेट: स्थल(-1m 0m))
	}

मंच(
	[
		समूह(
			जाल(4 2 कोष्ठिकाअंतराल: 0.25m)
			[
				वाक्यांश('सीधा' आकार: 0.25m)
				वाक्यांश("🚗" विश्राम: अनुक्रम(कीफ़्रेम 3s शैली: "straight"))
				वाक्यांश('सतर्क' आकार: 0.25m)
				वाक्यांश("🚚" विश्राम: अनुक्रम(कीफ़्रेम 3s शैली: "cautious"))
				वाक्यांश('धीमा' आकार: 0.25m)
				वाक्यांश("🚙" विश्राम: अनुक्रम(कीफ़्रेम 3s शैली: "pokey"))
				वाक्यांश('फुर्तीला' आकार: 0.25m)
				वाक्यांश("🏎" विश्राम: अनुक्रम(कीफ़्रेम 3s शैली: "zippy"))
			]
		)
	]
)