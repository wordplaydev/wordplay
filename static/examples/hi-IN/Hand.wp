🖐
हाथ
===
¶अपने कैमरे के सामने उंगलियाँ दिखाओ और एक इमोजी हाथ साथ में गिनती करेगा।¶
हाथ2: हाथ()

मंच(
	[
		वाक्यांश(
			(हाथ2.fingers = 0 ? '✊'
					हाथ2.fingers = 1 ? '☝'
						हाथ2.fingers = 2 ? '✌'
							हाथ2.fingers = 3 ? '🤟'
								हाथ2.fingers = 4 ? '🖖'
									'🖐')
			स्थल: हाथ2.स्थल
			आकार: 2m
			हटाव: स्थल(-1m)
		)
		समूह(
			पंक्ति('<')
			[
				वाक्यांश('1⃣' हटाव: स्थल(0m हाथ2.thumb ? 1m 0m))
				वाक्यांश('2⃣' हटाव: स्थल(0m हाथ2.index ? 1m 0m))
				वाक्यांश('3⃣' हटाव: स्थल(0m हाथ2.middle ? 1m 0m))
				वाक्यांश('4⃣' हटाव: स्थल(0m हाथ2.ring ? 1m 0m))
				वाक्यांश('5⃣' हटाव: स्थल(0m हाथ2.pinky ? 1m 0m))
			]
			स्थल: स्थल(-4.5m 5m)
		)
		समूह(
			ढेर('|')
			[
				वाक्यांश((हाथ2.palm ? '🤚' '🤛') आकार: 2m)
				वाक्यांश((हाथ2.open ? 'खुला' 'बंद') आकार: 1.5m)
			]
			स्थल: स्थल(-2m -8m)
		)
		वाक्यांश(`/कैमरे को अपना हाथ दिखाओ/` स्थल: स्थल(-6m -10m) आकार: 1m)
	]
	स्थल: स्थल(0m 0m -20m)
)