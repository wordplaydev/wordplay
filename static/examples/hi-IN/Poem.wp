T
कविता
=== start
¶एक कविता जिसकी पंक्तियाँ बहती हुई आती हैं, हर एक अपने ही अंदाज़ में।¶
•पंक्ति2(पाठ2•"" मुद्रा2•मुद्रा|अनुक्रम पीछे: रंग(100 100 100°) आगे: रंग(0 0 0°))

¶कविता की पंक्तियों की एक सूची, हर एक की अपनी मुद्रा।¶
कविता: [
		पंक्ति2('कंप्यूटर फ़ाइल' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m)))
		पंक्ति2('जिसकी' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m)))
		पंक्ति2('मुझे कोई याद नहीं' मुद्रा(घुमाव: 10°))
		पंक्ति2(
			'मैं इसे खोलने के लिए क्लिक करता हूँ'
			अनुक्रम(
				{0%: मुद्रा(स्केल: 1) 50%: मुद्रा(स्केल: 0.7) 100%: मुद्रा(स्केल: 1)}
				0.25s
			)
		)
		पंक्ति2('देखो' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m)))
		पंक्ति2('थोड़ा और नीचे स्क्रॉल करो' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: 5m)))
		पंक्ति2('स्क्रीन' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m)))
		पंक्ति2(
			'जगमगाती और खाली बनी रहती है'
			मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m))
			रंग(0 0 0°)
			रंग(100 100 0°)
		)
		पंक्ति2(
			'इस तरह मैं फिर से खुद से मिलता हूँ'
			मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m))
		)
		पंक्ति2('आशाभरा और बेकार' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m)))
		पंक्ति2('एक रहस्य' मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m)))
		पंक्ति2(
			'ठीक वैसे ही जैसे मैंने पहले भी किया होगा'
			मुद्रा(अपारदर्शिता: 0% ऑफ़सेट: स्थल(y: -5m))
		)
		पंक्ति2('19 अगस्त, 2010, सुबह 11:08 बजे' मुद्रा())
	]

संख्या2: 1 … ∆ बटन() | ∆ चाबी() …
		(संख्या2 = (कविता.length() + 1)) ? 1 संख्या2 + 1
पंक्ति3: कविता[संख्या2]

संख्या2 ≤ कविता.length() ?
	मंच(
		[
			वाक्यांश(
				पंक्ति3.पाठ2
				आना: पंक्ति3.मुद्रा2
				अवधि: 1s
				नाम: संख्या2 → ""
				शैली: 'cautious'
			)
		]
		पृष्ठभूमि: पंक्ति3.पीछे
		आराम: मुद्रा(रंग: पंक्ति3.आगे)
	)
	मंच(
		[
			समूह(
				ढेर()
				[वाक्यांश('खुद को सलाह') वाक्यांश('जेन हर्शफील्ड')]
				प्रवेश: मुद्रा(स्केल: 0.75)
			)
		]
		पृष्ठभूमि: रंग(0% 0 0°)
		रंग: रंग(100% 100 0°)
	)