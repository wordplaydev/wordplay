¶एक नाव। यह हर धड़कन पर थोड़ा और आगे खिसकती है और हर बार दूसरी तरफ़ हिलती है, जिससे यह चप्पू खेते हुए जैसी दिखती है। लेन तय करती है कि यह कितनी ऊँचाई पर है और कितना आगे से शुरू हुई थी, ताकि सब नावें एक साथ न चलें।¶
ƒ नाव(लेन•# start•#)•वाक्यांश
	वाक्यांश(
		'🚣'
		1.5m
		स्थल: स्थल(
			((((चप्पूखींचना + start) % 16) - 8) · 1.1) · 1m
			((लेन · 1.9) - 1.9) · 1m
		)
		घुमाव: (((चप्पूखींचना + लेन) % 2) = 0) ? 9° -9°
		अवधि: 0.2s
	)

बेड़ा: [नाव(0 0) नाव(1 6) नाव(2 11)]

मंच(
	[
		:बेड़ा
		वाक्यांश(
			'〰〰〰〰〰〰〰〰'
			1m
			स्थल: स्थल(-8m -3.2m)
			रंग: रंग(48% 22 240°)
		)
		वाक्यांश('Row, row, row your boat' 0.9m स्थल: स्थल(-4.4m 3.4m))
		संगीत(
			[
				ट्रैक(धुन2 वाद्य: वाद्य.बांसुरी ताल: 0.5beats)
				ट्रैक(कॉर्ड वाद्य: वाद्य.पियानो ताल: 1beats आवाज़: 60%)
				ट्रैक(चप्पू वाद्य: वाद्य.ड्रम ताल: 1beats आवाज़: 45%)
			]
			गति: 144beats/min
			नाम: 'नाव'
		)
	]
	पृष्ठभूमि: रंग(22% 18 230°)
	रंग: रंग(96% 0 0°)
)
