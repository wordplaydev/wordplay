🔁
वाल्डो कहाँ है?
=== start/en
¶भीड़ में छिपे वाल्डो को ढूँढ़ो: नारंगी कमीज़ पहने आदमी को देखो और जीतने के लिए उस पर क्लिक करो!¶

नाम2: चयन()
पकड़ागया: ⊥ … ∆ (नाम2) … (नाम2 = 'ResetButton') ? ⊥ ((नाम2 = 'Waldough') | पकड़ागया)
स्कोर: 0 … ∆ (नाम2) … (नाम2 = 'Waldough') ? 1 + स्कोर स्कोर

ƒ जगह() स्थल(
		((0.1 × यादृच्छिक(-9m 9m)) + यादृच्छिक(-2m 1m))
		((0.1 × यादृच्छिक(-9m 9m)) + यादृच्छिक(-2m 1m))
	)
ƒ नएधब्बे() [
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
		जगह()
	]
धब्बे: नएधब्बे() … ∆ (नाम2) … (नाम2 = 'ResetButton') ? नएधब्बे() धब्बे


मंच(
	[
		वाक्यांश(
			"🔁"
			चुननेयोग्य: ⊤
			स्थल: स्थल(4m -0.5m)
			विश्राम: पकड़ागया ? मुद्रा(घुमाव: 180°) मुद्रा()
			अवधि: 0.5s
			नाम: 'ResetButton'
		)
		वाक्यांश(
			'नारंगी कमीज़ को ढूँढ़ो'
			0.2m
			स्थल: स्थल(-6.2m 0.75m)
			चेहरा: 'Carter One'
		)
		वाक्यांश(
			'आदमी (जिसका नाम वाल्डो है) और'
			0.2m
			स्थल: स्थल(-6.4m 0.25m)
			चेहरा: 'Carter One'
		)
		वाक्यांश(
			'जीतने के लिए उस पर क्लिक करो!🧍🏻'
			0.2m
			स्थल: स्थल(-6.0m -0.25m)
			चेहरा: 'Carter One'
		)
		वाक्यांश(
			'स्कोर: ' + स्कोर → ''
			0.5m
			स्थल: स्थल(-5.9m -1m)
		)

		वाक्यांश("🏀" स्थल: धब्बे[1])
		वाक्यांश("🦧" स्थल: धब्बे[2])
		वाक्यांश("🍊" स्थल: धब्बे[3])
		वाक्यांश("👻" स्थल: धब्बे[4])
		वाक्यांश("🤖" स्थल: धब्बे[5])
		वाक्यांश("👽" स्थल: धब्बे[6])
		वाक्यांश("🐀" स्थल: धब्बे[7])
		वाक्यांश("🦣" स्थल: धब्बे[8])
		वाक्यांश("🐸" स्थल: धब्बे[9])
		वाक्यांश("🍎" स्थल: धब्बे[10])
		वाक्यांश("💧" स्थल: धब्बे[11])
		वाक्यांश("🍔" स्थल: धब्बे[12])
		वाक्यांश("❤" स्थल: धब्बे[13])
		वाक्यांश("🍥" स्थल: धब्बे[14])
		वाक्यांश(
			"🧍🏻"
			चुननेयोग्य: ~पकड़ागया
			स्थल: धब्बे[15]
			विश्राम: पकड़ागया ? मुद्रा(घुमाव: 180°) मुद्रा()
			अवधि: 0s
			नाम: 'Waldough'
		)
		वाक्यांश("🔥" स्थल: धब्बे[16])
		वाक्यांश("🎂" स्थल: धब्बे[17])
		वाक्यांश("🐕" स्थल: धब्बे[18])
		वाक्यांश("🦈" स्थल: धब्बे[19])
		आकार(आयत(-3.5m -3m 3.5m -3.5m))
		आकार(आयत(-3.5m 3.5m 3.5m 3m))
		आकार(आयत(-3.5m 3.5m -3m -3.5m))
		आकार(आयत(3m 3.5m 3.5m -3.5m))
	]
	स्थल: स्थल(0m 0m -5m)
)