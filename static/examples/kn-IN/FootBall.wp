			((ಬಿಡುಗಡೆ = 'ಮೇಲಿನ ಬಾಣ') & (ಜಾರುವಿಕೆ = 1)) ? 0
				((ಬಿಡುಗಡೆ = 'ಕೆಳಗೆ ಬಾಣದ ಗುರುತು') & (ಜಾರುವಿಕೆ = -1)) ? 0
