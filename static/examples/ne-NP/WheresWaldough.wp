	]
थोप्लाहरू: नयाँथोप्लाहरू() … ∆ (नाम3) … (नाम3 = 'ResetButton') ? नयाँथोप्लाहरू() थोप्लाहरू


Stage(
	[
		वाक्यांश(
			"🔁"
			छनोटगर्नमिल्ने: ⊤
			स्थान: स्थान(4m -0.5m)
			विश्राममा: समातियो ? Pose(घुमाइ: 180°) Pose()
			अवधि: 0.5s
			नाम: 'ResetButton'
		)
		वाक्यांश(
			'सुन्तला रङको सर्ट खोज्नुहोस्'
			0.2m
			स्थान: स्थान(-6.2m 0.75m)
			रूप: 'Carter One'
		)
		वाक्यांश(
			'मान्छे (नाम वाल्डोघ) र'
			0.2m
			स्थान: स्थान(-6.4m 0.25m)
			रूप: 'Carter One'
		)
		वाक्यांश(
			'जित्नको लागि उसमाथि क्लिक गर्नुहोस्!🧍🏻'
			0.2m
			स्थान: स्थान(-6.0m -0.25m)
			रूप: 'Carter One'
		)
		वाक्यांश(
			'अंक: ' + अंक → ''
			0.5m
			स्थान: स्थान(-5.9m -1m)
		)

		वाक्यांश("🏀" स्थान: थोप्लाहरू[1])
		वाक्यांश("🦧" स्थान: थोप्लाहरू[2])
