M
नाशपाती
=== start/en
¶यो एक अन्तरक्रियात्मक छोटो कथा हो। यसले धेरै फरक-फरक दृश्यहरू बनाउँछ र क्लिक, ठक्कर, र अन्य क्रियाहरू जस्ता फरक-फरक अन्तरक्रियाहरूको आधारमा तिनीहरूबीच सर्छ। यो कथा अनुभव गर्दाको एउटा रमाइलो कुरा भनेको कथालाई अगाडि बढाउन चाहिने अन्तरक्रियाहरू पत्ता लगाउनु हो।¶
परिचय: [
		वाक्यांश(`मेरा बाबा जान चाहनुहुन्थ्यो।` स्थान: स्थान(-9m 0m))
	]

द्वन्द्व: [
		वाक्यांश(`"आमा", हामी जानुपर्छ।` स्थान: स्थान(-8m 7m))
		वाक्यांश(`/"घर लैजा।"/` स्थान: स्थान(1m 4m))
		वाक्यांश(`"आमा हामीलाई केही चाहिँदैन!"` स्थान: स्थान(-8m 1m))
		वाक्यांश(`"घर लैजा!"` आकार: 2m स्थान: स्थान(-6m -4m) विश्राममा: शृङ्खला.कम्पन())
	]

बढ्दोघटना१: [
		वाक्यांश(`मेरी 炮炮👵🏽 पछिल्तिरको बगैँचामा पस्नुभयो` स्थान: स्थान(-9m 7m))
		वाक्यांश(`म उहाँलाई पछ्याएँ, जिज्ञासुसाथ` स्थान: स्थान(-6m 4m))
		वाक्यांश(
			`👵🏽`
			नाम: 'पाउपाउ'
			आकार: 2m
			पदार्थ: पदार्थ()
			स्थान: स्थान(6m -6m)
			बुलबुला: `/"沙梨🍐, घर लैजा!"/`
		)
		वाक्यांश(
			`👧🏻`
			नाम: 'म'
			आकार: 1m
			पदार्थ: पदार्थ()
			स्थान: स्थापना(स्थान(-8m -6m))
		)
	]

बढ्दोघटना२: [
		वाक्यांश(`उनी एउटा सानो रुखमा रोकिइन्।` स्थान: स्थान(-9m 6m))
		वाक्यांश(
			`त्यसमा दर्जनौं चम्किलो पहेँलो 沙梨 झुण्डिएका थिए`
			स्थान: स्थान(-9m 1m)
			बेर्ने: 10m
		)
		वाक्यांश(`"आमा, हामीलाई नाशपाती चाहिँदैन।"` आकार: .75m स्थान: स्थान(-4m 0m))
		वाक्यांश(`/मलाई एउटा नाशपाती चाहिन्थ्यो।/` आकार: 2m स्थान: स्थान(-8m -3m))
		वाक्यांश("🍐" आकार: 2m स्थान: स्थान(-1m -7m) नाम: 'pear' छनोटगर्नमिल्ने: ⊤)
	]

¶हामी ठाउँहरू पहिले नै तय गर्छौं ताकि तिनीहरू एउटै ठाउँबाट खस्न सकून्।¶
ठाउँहरू: (6 → []).अनुवाद(ƒ() स्थान(अनियमित(-2m 2m) अनियमित(-3m -5m)))
उत्कर्ष: [
		वाक्यांश(`उनी माटोमा घुँडा टेकेर बसिन्।` स्थान: स्थान(-9m 6m))
		वाक्यांश(`एउटा चक्कु समातिन्` स्थान: स्थान(-9m 4m))
		वाक्यांश(`र होसियारीसाथ छवटा काटिन्` स्थान: स्थान(-9m 2m))
		वाक्यांश(`तिनलाई तल आफ्नो डालोमा खसालिन्` स्थान: स्थान(-9m 0m))
		वाक्यांश("🧺" आकार: 4m स्थान: स्थान(-2m -12m))
		वाक्यांश("🌳" नाम: "tree" आकार: 5m स्थान: स्थान(-3m -7m) छनोटगर्नमिल्ने: ⊤)
		:ठाउँहरू.अनुवाद(
			ƒ(राख्नु अनुक्रमणिका2)
				वाक्यांश(
					"🍐"
					नाम: "pear\अनुक्रमणिका2\"
					स्थान: छनोट() = 'tree' ? गति(राख्नु) राख्नु
				)
		)
		वाक्यांश("🔪" स्थान: सूचक())
	]

समाधान: [
		वाक्यांश(`उनले तिनलाई मकहाँ ल्याइन्` स्थान: स्थान(-9m 6m))
		वाक्यांश(`मेरो अगाडि घुँडा टेकिन्` स्थान: स्थान(-8m 4m))
