🎵
स्वरहरू (पिच नोटहरू)
===
¶गीत गाउनुहोस् वा गुनगुनाउनुहोस्, र आफूले बनाइरहेको नोट दुई पटक हेर्नुहोस्। बायाँको नोटले कच्चा @Pitch पढ्छ र काँपिरहन्छ; दायाँको नोटले पछिल्लो धेरै स्वरहरूको औसत निकाल्छ र स्थिर रहन्छ। जब @Pitch ले केही स्पष्ट सुन्दैन, यसले 0hz भन्छ, त्यसैले दुवै नोटले ती क्षणहरू छाड्छन् र बदलामा · देखाउँछन्।¶
स्वरहरू: [
		'A'
		'A♯'
		'B'
		'C'
		'C♯'
		'D'
		'D♯'
		'E'
		'F'
		'F♯'
		'G'
		'G♯'
	]
नोटOf: ƒ(हर्ज•#hz) हर्ज > 0hz ? स्वरहरू[(((((12 × (हर्ज ÷ 440hz).लग(
										2
									)).गोलो(
							)) % 12) + 12) % 12) + 1] '·'
चिल्लो2: ƒ(संकेत•…#hz) (
			सुनियो: (←← 8 संकेत).बिना(0hz)
			(सुनियो.जोडिएको(0hz ƒ(जम्मा•#hz v•#hz) जम्मा + v) ÷ सुनियो.लम्बाइ()) ?? 0hz
		)
स्वर2: पिच()
Stage(
	[
		समूह(
			Stack()
			[
				वाक्यांश('हल्लाखल्ला' रङ: रङ(60% 90 30°))
				वाक्यांश(नोटOf(स्वर2) आकार: 6m रङ: रङ(60% 90 30°))
			]
			स्थान: स्थान(-4m 0m)
		)
		समूह(
			Stack()
			[
				वाक्यांश('चिल्लो' रङ: रङ(70% 90 240°))
				वाक्यांश(नोटOf(चिल्लो2(स्वर2)) आकार: 6m रङ: रङ(70% 90 240°))
			]
			स्थान: स्थान(4m 0m)
		)
	]
)
