¶एक डुङ्गा। यो हरेक धड्कामा अलिकति अगाडि चिप्लिन्छ र हरेक पटक विपरीत दिशामा हल्लिन्छ, जसले नै डाँड़ हानेको जस्तो देखाउँछ; लेनले यो कति उच्चोमा बस्छ र कहाँबाट सुरु भयो भन्ने कुरा तय गर्छ, त्यसैले सबै डुङ्गा एकैसाथ चलिरहँदैनन्।¶
ƒ डुङ्गा(लेन•# सुरु2•#)•वाक्यांश
	वाक्यांश(
		'🚣'
		1.5m
		स्थान: स्थान(
			((((डाँड़हान्नु + सुरु2) % 16) - 8) · 1.1) · 1m
			((लेन · 1.9) - 1.9) · 1m
		)
		घुमाइ: (((डाँड़हान्नु + लेन) % 2) = 0) ? 9° -9°
		अवधि: 0.2s
	)

समूह2: [डुङ्गा(0 0) डुङ्गा(1 6) डुङ्गा(2 11)]

Stage(
	[
		:समूह2
		वाक्यांश(
			'〰〰〰〰〰〰〰〰'
			1m
			स्थान: स्थान(-8m -3.2m)
			रङ: रङ(48% 22 240°)
		)
		वाक्यांश('Row, row, row your boat' 0.9m स्थान: स्थान(-4.4m 3.4m))
		संगीत(
			[
				ट्र्याक(धुन2 बाजा: बाजा.बाँसुरी बिट: 0.5beats)
				ट्र्याक(स्वरसमूह बाजा: बाजा.पियानो बिट: 1beats आवाज: 60%)
				ट्र्याक(डाँड़हरू बाजा: बाजा.ड्रम बिट: 1beats आवाज: 45%)
			]
			गति: 144beats/min
			नाम: 'डुङ्गा'
		)
	]
	पृष्ठभूमि: रङ(22% 18 230°)
	रङ: रङ(96% 0 0°)
)
