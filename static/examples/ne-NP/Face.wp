🙂
अनुहार
===
¶तपाईंको अनुहार जस्तै हाँस्ने, मुख बिगार्ने, मुख खोल्ने, र आँखा झिम्क्याउने इमोजी।¶
अनुहार2: अनुहार()

Stage(
	[
		वाक्यांश(
			(अनुहार2.मुखखुला ? '😮'
					अनुहार2.मुस्कुराउँदै ? '😀'
						अनुहार2.निधारखुम्च्याउँदै ? '🙁'
							अनुहार2.आँखीभौँउठेको ? '😲'
								(अनुहार2.आँखाखुला ? '🙂' '😑'))
			स्थान: अनुहार2.स्थान
			आकार: 4m
		)
		समूह(
			Stack('|')
			[
				वाक्यांश((अनुहार2.आँखाखुला ? '👀' '😑') आकार: 1.5m)
				वाक्यांश('😊' आकार: (अनुहार2.मुस्कानमात्रा · 2m) + 0.5m)
				वाक्यांश('👄' आकार: (अनुहार2.मुखखुलामात्रा · 2m) + 0.5m)
				वाक्यांश('🤨' आकार: (अनुहार2.आँखीभौँउठाइमात्रा · 2m) + 0.5m)
			]
			स्थान: स्थान(-9m 8m)
		)
		वाक्यांश(
			'घुमाउनुहोस् 🧭'
			स्थान: स्थान(9m 8m 0m)
			आकार: 2m
			घुमाइ: अनुहार2.घुमाउनु
		)
		वाक्यांश('झुकाउनुहोस् 🧭' स्थान: स्थान(9m 2m) घुमाइ: अनुहार2.ढल्काउनु आकार: 2m)
		वाक्यांश(`/क्यामेरालाई आफ्नो अनुहार देखाउनुहोस्/` स्थान: स्थान(-6m -12m) आकार: 1m)
	]
	स्थान: स्थान(0m 0m -20m)
)