↑
भूलभुलैया
=== start/en
¶A maze is a 2D grid of emoji, with some functions for checking the state at particular grid postions.
Mazes are generated randomly.¶/en
•भूलभुलैया() (
	जाली•[[''|ø]]:
		[
			['🎬' '❤' '❌' ø ø]
			['❤' ø ø ø ø]
			['🐈' '😀' '💬' '🫥' '😞']
			[ø '👍' ø ø '😕']
			['🤩' '🥹' ø '😫' '😡']
		]

	ƒ कोठा(पङ्क्ति•# स्तम्भ•#) (
			कक्षहरू: जाली[पङ्क्ति]
			कक्षहरू•[] ? कक्षहरू[स्तम्भ] ø
		)

	ƒ अनुमतिदिइएको(पङ्क्ति2•# स्तम्भ2•#) कोठा(पङ्क्ति2 स्तम्भ2)•''
)

भूलभुलैया2: भूलभुलैया()

•अवस्था(पङ्क्ति3•# स्तम्भ3•# कदमहरू•#)
(
	ƒ तल2() अवस्था(पङ्क्ति3 + 1 स्तम्भ3 कदमहरू + 1)
	ƒ माथि() अवस्था(पङ्क्ति3 - 1 स्तम्भ3 कदमहरू + 1)
	ƒ बायाँ() अवस्था(पङ्क्ति3 स्तम्भ3 - 1 कदमहरू + 1)
	ƒ दायाँ() अवस्था(पङ्क्ति3 स्तम्भ3 + 1 कदमहरू + 1)
)

ƒ अनुमतिदिइएको2(अवस्था2•अवस्था पङ्क्ति4•# स्तम्भ4•#) भूलभुलैया2.अनुमतिदिइएको(
		अवस्था2.पङ्क्ति3 + पङ्क्ति4
		अवस्था2.स्तम्भ3 + स्तम्भ4
	)

दिशा2: छनोट()
अवस्था3•अवस्था: अवस्था(1 1 0) … ∆ दिशा2 …
		((दिशा2 = "left") & अनुमतिदिइएको2(अवस्था3 0 -1)) ? अवस्था3.बायाँ()
			((दिशा2 = "right") & अनुमतिदिइएको2(अवस्था3 0 1)) ? अवस्था3.दायाँ()
				((दिशा2 = "up") & अनुमतिदिइएको2(अवस्था3 -1 0)) ? अवस्था3.माथि()
					((दिशा2 = "down") & अनुमतिदिइएको2(अवस्था3 1 0)) ? अवस्था3.तल2(
						)
						अवस्था3

हालको: (
		कोठा2: भूलभुलैया2.कोठा(अवस्था3.पङ्क्ति3 अवस्था3.स्तम्भ3)
		कोठा2 ?? ' ')
माथि2: भूलभुलैया2.कोठा(अवस्था3.पङ्क्ति3 - 1 अवस्था3.स्तम्भ3)•''
तल3: भूलभुलैया2.कोठा(अवस्था3.पङ्क्ति3 + 1 अवस्था3.स्तम्भ3)•''
बायाँ2: भूलभुलैया2.कोठा(अवस्था3.पङ्क्ति3 अवस्था3.स्तम्भ3 - 1)•''
दायाँ2: भूलभुलैया2.कोठा(अवस्था3.पङ्क्ति3 अवस्था3.स्तम्भ3 + 1)•''
जित्यो: हालको = '🤩'

Stage(
	[
		समूह(
			Grid(3 3 0.25m)
			[
				ø
				वाक्यांश(
					'↑'
					नाम: 'up'
					छनोटगर्नमिल्ने: माथि2
					विश्राममा: Pose(पारदर्शिता: माथि2 ? 1 0.2)
				)
				ø
				वाक्यांश(
					'←'
					नाम: 'left'
					छनोटगर्नमिल्ने: बायाँ2
					विश्राममा: Pose(पारदर्शिता: बायाँ2 ? 1 0.2)
				)
				वाक्यांश(
					हालको
					विश्राममा: जित्यो ?
						शृङ्खला.घुम्नु(अवधि: 1s शैली: 'straight')
						Pose()
				)
				वाक्यांश(
					'→'
					नाम: 'right'
					छनोटगर्नमिल्ने: दायाँ2
					विश्राममा: Pose(पारदर्शिता: दायाँ2 ? 1 0.2)
				)
				ø
				वाक्यांश(
					'↓'
					नाम: 'down'
					छनोटगर्नमिल्ने: तल3
					विश्राममा: Pose(पारदर्शिता: तल3 ? 1 0.2)
				)
				ø
			]
		)
	]
	स्थान: स्थान(0m 0m -3m)
	अनुहार: 'Noto Emoji'
	पृष्ठभूमि: रङ(0 0 0°)
	विश्राम: Pose(रङ(100 100 0°))
)