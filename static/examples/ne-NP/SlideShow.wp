🎬
चित्र प्रस्तुति
=== start
¶वर्डप्ले कसरी बन्यो भन्ने कुरा बताउने एक स्लाइडशो; यसमा अगाडि जान → र पछाडि जान ← थिच्नुहोस्।¶

¶शोको एक स्लाइड: एक पात्र, एक शीर्षक, र मुनि केही शब्दहरू।¶
•स्लाइड(इमोजी•'' शीर्षक•'' मुख्यभाग•''|`…`)

¶यो कथा हो। आफ्नै कथा भन्नका लागि यी स्लाइडहरू थपेर, हटाएर, वा बदलेर हेर्नुहोस्।¶
स्लाइडहरू: [
		स्लाइड(
			'🎭'
			'वर्डप्ले'
			'यो भाषा कसरी बन्यो भन्ने कथा। अगाडि जान → र पछाडि जान ← थिच्नुहोस्।'
		)
		स्लाइड(
			'✒'
			'अक्षरहरूप्रतिको माया'
			'धेरै पहिले, एमी टाइपोग्राफीको माया गर्न थालिन्: अक्षरहरूको आकार, र पानामा शब्दहरूको लयको।'
		)
		स्लाइड(
			'💻'
			'कोडप्रतिको माया'
			'उनी प्रोग्रामिङको पनि माया गर्न थालिन्, र थोरै शब्दहरूले कुराहरूलाई कसरी चलाउन सकिन्छ भन्ने कुराको।'
		)
		स्लाइड(
			'🧭'
			'दुई माया, अलग-अलग'
			'तर टाइपोग्राफी र प्रोग्रामिङ फरक-फरक संसारमा बस्थे, र दुवैलाई एकैसाथ माया गर्न मन लाग्ने साधन थोरै मात्र थिए।'
		)
		स्लाइड(
			'😄'
			'एक युवा व्यक्ति'
			'धेरै वर्षपछि, उनी इमोजी मन पराउने एक युवा व्यक्तिलाई भेटिन्, जो इमोजीहरूलाई नाच्न लगाउन चाहन्थे।'
		)
		स्लाइड(
			'💡'
			'एउटा विचार'
			'यदि कुनै प्रोग्रामिङ भाषाले इमोजीहरूलाई नाच्न लगाउने काम सजिलो बनाइदिए त?'
		)
		स्लाइड(
			'🌱'
			'वर्डप्लेको सुरुवात'
			'त्यसैले उनले एउटा भाषा बनाउन थालिन्, जहाँ कोड लेख्नु भनेको मञ्चमा शब्द र अक्षरहरू चलाउनु हो।'
		)
		स्लाइड(
			'🧑‍🏫'
			'सँगै डिजाइन गरिएको'
			'उनले धेरै युवा र शिक्षकहरूसँग मिलेर यो डिजाइन गरिन्, जसले आफूले के बनाउन चाहेको हो र आफूलाई के कुराले रोकेको हो भनेर बताए।'
		)
		स्लाइड(
			'🌏'
			'सधैं बढ्दै'
			'त्यसयता यो निरन्तर बढ्दै आएको छ, ताकि थप मानिसहरूले आफूले कल्पना गरेका थप कुराहरू बनाउन सकून्।'
		)
		स्लाइड(
			'✨'
			'तिम्रो पालो'
			`तिमीले के बनाउने सपना देखेका छौ, जुन अहिले सम्भव छैन? हामीलाई यहाँ बताऊ <GitHub@https://github.com/wordplaydev/wordplay/issues>`
		)
	]

जम्मा: स्लाइडहरू.लम्बाइ()

कुञ्जी2: कुञ्जी()

¶अहिले देखाइरहेको स्लाइड। दायाँले अगाडि बढाउँछ, बायाँले पछाडि लैजान्छ, र दुवैले अन्त्यमा पुगेपछि रोकिन्छन्, फेरि सुरुमा फर्किंदैनन्।¶
अनुक्रमणिका2•#: 1 … ∆ कुञ्जी2 …
		(कुञ्जी2 = 'ArrowRight') ? ((अनुक्रमणिका2 < जम्मा) ? अनुक्रमणिका2 + 1 अनुक्रमणिका2)
			(कुञ्जी2 = 'ArrowLeft') ? ((अनुक्रमणिका2 > 1) ? अनुक्रमणिका2 - 1 अनुक्रमणिका2)
				अनुक्रमणिका2

स्लाइड2: स्लाइडहरू[अनुक्रमणिका2]

Stage(
	[
		समूह(
			Stack('|' 0.4m)
			[
				वाक्यांश(स्लाइड2.इमोजी आकार: 2m)
				वाक्यांश(`*\स्लाइड2.शीर्षक\*` आकार: 1.2m पङ्क्तिबद्धता: '|')
				वाक्यांश(स्लाइड2.मुख्यभाग आकार: 0.5m बेर्ने: 12m पङ्क्तिबद्धता: '|')
				वाक्यांश(`\अनुक्रमणिका2\ को \जम्मा\` आकार: 0.25m पङ्क्तिबद्धता: '|')
			]
		)
	]
)
