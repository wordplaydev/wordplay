¶केक हरेक बीटमा फुलिन्छ र बीचमा स्थिर हुन्छ।¶
ƒ केक() वाक्यांश('🎂' (4m + ((गणना2 % 2) · 0.4m)) अवधि: 0.2s)

Stage(
	[
		समूह(
			Stack(प्याडिङ: 0.5m)
			[
				केक()
				वाक्यांश('जन्मदिनको शुभकामना' 1.3m)
			]
		)
		संगीत(
			[
				ट्र्याक(धुन2 बाजा: बाजा.बाँसुरी बिट: 0.5beats)
				ट्र्याक(आल्टो बाजा: बाजा.भ्वाइलिन बिट: 0.5beats आवाज: 65%)
				ट्र्याक(स्वरसमूह बाजा: बाजा.पियानो बिट: 1beats आवाज: 55%)
			]
			गति: 116beats/min
			नाम: 'जन्मदिन'
		)
	]
	पृष्ठभूमि: रङ(18% 20 330°)
	रङ: रङ(96% 0 0°)
)
