🖐
हात
===
¶आफ्नो क्यामेरामा औंलाहरू देखाउनुहोस्, र इमोजी हातले गन्ती गर्नेछ।¶
हात2: हात()

Stage(
	[
		वाक्यांश(
			(हात2.fingers = 0 ? '✊'
					हात2.fingers = 1 ? '☝'
						हात2.fingers = 2 ? '✌'
							हात2.fingers = 3 ? '🤟'
								हात2.fingers = 4 ? '🖖'
									'🖐')
			स्थान: हात2.स्थान
			आकार: 2m
			अफसेट: स्थान(-1m)
		)
		समूह(
			Row('<')
			[
				वाक्यांश('1⃣' अफसेट: स्थान(0m हात2.thumb ? 1m 0m))
				वाक्यांश('2⃣' अफसेट: स्थान(0m हात2.index ? 1m 0m))
				वाक्यांश('3⃣' अफसेट: स्थान(0m हात2.middle ? 1m 0m))
				वाक्यांश('4⃣' अफसेट: स्थान(0m हात2.ring ? 1m 0m))
				वाक्यांश('5⃣' अफसेट: स्थान(0m हात2.pinky ? 1m 0m))
			]
			स्थान: स्थान(-4.5m 5m)
		)
		समूह(
			Stack('|')
			[
				वाक्यांश((हात2.palm ? '🤚' '🤛') आकार: 2m)
				वाक्यांश((हात2.open ? 'खुला' 'बन्द') आकार: 1.5m)
			]
			स्थान: स्थान(-2m -8m)
		)
		वाक्यांश(`/क्यामेरालाई आफ्नो हात देखाउनुहोस्/` स्थान: स्थान(-6m -10m) आकार: 1m)
	]
	स्थान: स्थान(0m 0m -20m)
)