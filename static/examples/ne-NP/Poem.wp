T
कविता
=== start
¶एउटा कविता जसका पंक्तिहरू बगेर आउँछन्, हरेक आफ्नै तरिकाले देखा पर्दै।¶
•रेखा(पाठ2•"" पोज•Pose|शृङ्खला पछाडि: रङ(100 100 100°) अगाडि: रङ(
			0
			0
			0°
		))

¶कविताका पंक्तिहरूको सूची, हरेकसँग आफ्नो पोज।¶
कविता: [
		रेखा('कम्प्युटर फाइल' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा('जसको बारेमा' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा('मलाई केही सम्झना छैन' Pose(घुमाइ: 10°))
		रेखा(
			'म यसलाई क्लिक गरी खोल्छु'
			शृङ्खला(
				{
					0%: Pose(आकार: 1)
					50%: Pose(आकार: 0.7)
					100%: Pose(आकार: 1)
				}
				0.25s
			)
		)
		रेखा('हेर्छु' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा('अझ तल स्क्रोल गर्छु' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: 5m)))
		रेखा('पर्दा' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा(
			'उज्यालो तर खाली नै रहन्छ'
			Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m))
			रङ(0 0 0°)
			रङ(100 100 0°)
		)
		रेखा('यसरी म आफैलाई फेरि भेट्छु' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा('आशावान तर बेकामको' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा('एउटा रहस्य' Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m)))
		रेखा(
			'ठीक जसरी मैले पहिले पनि गरेको हुनुपर्छ'
			Pose(पारदर्शिता: 0% अफसेट: स्थान(y: -5m))
		)
		रेखा('अगस्ट १९, २०१०, बिहान ११:०८ बजे' Pose())
	]

संख्या2: 1 … ∆ बटन() | ∆ कुञ्जी() …
		(संख्या2 = (कविता.लम्बाइ() + 1)) ? 1 संख्या2 + 1
रेखा2: कविता[संख्या2]

संख्या2 ≤ कविता.लम्बाइ() ?
	Stage(
		[
			वाक्यांश(
				रेखा2.पाठ2
				प्रवेशगर्दै: रेखा2.पोज
				अवधि: 1s
				नाम: संख्या2 → ""
				शैली: 'cautious'
			)
		]
		पृष्ठभूमि: रेखा2.पछाडि
		विश्राम: Pose(रङ: रेखा2.अगाडि)
	)
	Stage(
		[
			समूह(
				Stack()
				[वाक्यांश('आफैलाई सल्लाह') वाक्यांश('जेन हर्शफिल्ड')]
				प्रवेशगर्दै: Pose(आकार: 0.75)
			)
		]
		पृष्ठभूमि: रङ(0% 0 0°)
		रङ: रङ(100% 100 0°)
	)