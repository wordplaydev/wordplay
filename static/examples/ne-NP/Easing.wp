s
अनुक्रम सहजता
===
¶एउटै कारको एनिमेसन आठ तरिकाले, हरेक इजिङ शैलीका लागि एउटा।¶
मुख्यफ्रेमहरू: {
		0%: Pose(अफसेट: स्थान(-1m 0m))
		25%: Pose(अफसेट: स्थान(1m 0m))
		50%: Pose(अफसेट: स्थान(1m 0m))
		75%: Pose(अफसेट: स्थान(-1m 0m))
		100%: Pose(अफसेट: स्थान(-1m 0m))
	}

Stage(
	[
		समूह(
			Grid(4 2 cellpadding: 0.25m)
			[
				वाक्यांश('सोझो' आकार: 0.25m)
				वाक्यांश("🚗" विश्राममा: शृङ्खला(मुख्यफ्रेमहरू 3s शैली: "straight"))
				वाक्यांश('सावधानी' आकार: 0.25m)
				वाक्यांश("🚚" विश्राममा: शृङ्खला(मुख्यफ्रेमहरू 3s शैली: "cautious"))
				वाक्यांश('ढिलो' आकार: 0.25m)
				वाक्यांश("🚙" विश्राममा: शृङ्खला(मुख्यफ्रेमहरू 3s शैली: "pokey"))
				वाक्यांश('छिटो' आकार: 0.25m)
				वाक्यांश("🏎" विश्राममा: शृङ्खला(मुख्यफ्रेमहरू 3s शैली: "zippy"))
			]
		)
	]
)