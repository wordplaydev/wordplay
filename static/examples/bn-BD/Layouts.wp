K
লেআউট
=== start
¶সারি, স্তূপ, আর দলবদ্ধ বাক্যাংশ, প্রতিটি নিজের অ্যানিমেটেড ভঙ্গিতে।¶
স্পন্দন2: ধারা(
		{0%: ভঙ্গি(মাপ: .9) 50%: ভঙ্গি(মাপ: 1.1) 100%: ভঙ্গি(মাপ: .9)}
	)
zbounce: ধারা(
		{
			0%: ভঙ্গি(সরণ: স্থান(z: 0m))
			50%: ভঙ্গি(সরণ: স্থান(z: -2m))
			100%: ভঙ্গি(সরণ: স্থান(z: 0m))
		}
		1s
	)

দল(
	সারি()
	[
		দল(
			স্তূপ()
			[
				বাক্যাংশ('বিড়ালছানা')
				বাক্যাংশ('বিড়াল' বিশ্রাম: zbounce)
				দল(সারি() [বাক্যাংশ('কুকুর') বাক্যাংশ('কুকুরজাতীয়')] বিশ্রাম: স্পন্দন2)
				বাক্যাংশ('বিড়ালজাতীয়')
			]
		)
		দল(
			স্তূপ()
			[
				বাক্যাংশ('হাই')
				বাক্যাংশ('হ্যালো')
			]
			বিশ্রাম: ধারা.ঘোরা(2s "straight")
		)
	]
)