মঞ্চ(
	[
		বাক্যাংশ(
			"🔁"
			নির্বাচনযোগ্য
			স্থান: স্থান(4m -0.5m)
			বিশ্রাম: ধরাপড়েছে ? ভঙ্গি(ঘূর্ণন: 180°) ভঙ্গি()
			সময়কাল: 0.5s
			নাম: 'ResetButton'
		)
		বাক্যাংশ(
			'কমলা রঙের শার্ট খুঁজো'
			0.2m
			স্থান: স্থান(-6.2m 0.75m)
			মুখ: 'Carter One'
		)
		বাক্যাংশ(
			'লোকটিকে (নাম ওয়াল্ডো) খুঁজো এবং'
			0.2m
			স্থান: স্থান(-6.4m 0.25m)
			মুখ: 'Carter One'
		)
		বাক্যাংশ(
			'জিততে তার ওপর ক্লিক করো!🧍🏻'
			0.2m
			স্থান: স্থান(-6.0m -0.25m)
			মুখ: 'Carter One'
		)
		বাক্যাংশ(
			'স্কোর: ' + স্কোর → ''
			0.5m
			স্থান: স্থান(-5.9m -1m)
		)

		বাক্যাংশ("🏀" স্থান: দাগ[1])
		বাক্যাংশ("🦧" স্থান: দাগ[2])
