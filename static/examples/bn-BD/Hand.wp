🖐
হাত
===
¶তোমার ক্যামেরার সামনে আঙুল তুলে ধরো, আর একটা ইমোজি হাত সেই সংখ্যা গুনবে।¶
হাত2: হাত()

মঞ্চ(
	[
		বাক্যাংশ(
			(হাত2.আঙুল = 0 ? '✊'
					হাত2.আঙুল = 1 ? '☝'
						হাত2.আঙুল = 2 ? '✌'
							হাত2.আঙুল = 3 ? '🤟'
								হাত2.আঙুল = 4 ? '🖖'
									'🖐')
			স্থান: হাত2.স্থান
			আকার: 2m
			অফসেট: স্থান(-1m)
		)
		দল(
			সারি('<')
			[
				বাক্যাংশ('1⃣' অফসেট: স্থান(0m হাত2.বুড়োআঙুল ? 1m 0m))
				বাক্যাংশ('2⃣' অফসেট: স্থান(0m হাত2.তর্জনী ? 1m 0m))
				বাক্যাংশ('3⃣' অফসেট: স্থান(0m হাত2.মধ্যমা ? 1m 0m))
				বাক্যাংশ('4⃣' অফসেট: স্থান(0m হাত2.অনামিকা ? 1m 0m))
				বাক্যাংশ('5⃣' অফসেট: স্থান(0m হাত2.কনিষ্ঠা ? 1m 0m))
			]
			স্থান: স্থান(-4.5m 5m)
		)
		দল(
			স্তূপ('|')
			[
				বাক্যাংশ((হাত2.হাতেরতালু ? '🤚' '🤛') আকার: 2m)
				বাক্যাংশ((হাত2.খোলা ? 'খোলা' 'বন্ধ') আকার: 1.5m)
			]
			স্থান: স্থান(-2m -8m)
		)
		বাক্যাংশ(`/ক্যামেরাকে তোমার হাত দেখাও/` স্থান: স্থান(-6m -10m) আকার: 1m)
	]
	স্থান: স্থান(0m 0m -20m)
)