				বাক্যাংশ(সুরনির্ণয়ক(পিচ) আকার: 6m রঙ: রঙ(60% 90 30°))
			]
			স্থান: স্থান(-4m 0m)
		)
		দল(
			স্তূপ()
			[
				বাক্যাংশ('মসৃণ' রঙ: রঙ(70% 90 240°))
				বাক্যাংশ(সুরনির্ণয়ক(মসৃণ2(পিচ)) আকার: 6m রঙ: রঙ(70% 90 240°))
			]
			স্থান: স্থান(4m 0m)
