K
Layouts
=== start
¶Reihen, Stapel und Gruppen von Sätzen, die jeweils auffällige animierte Posen zeigen.¶

pochen: Reihenfolge(
		{
			0%: Pose(Skala: .9)
			50%: Pose(Skala: 1.1)
			100%: Pose(Skala: .9)
		}
	)
zhüpfen: Reihenfolge(
		{
			0%: Pose(Versatz: Ort(z: 0m))
			50%: Pose(Versatz: Ort(z: -2m))
			100%: Pose(Versatz: Ort(z: 0m))
		}
		1s
	)

Gruppe(
	Reihe()
	[
		Gruppe(
			Stapel()
			[
				Satzglied('Kätzchen')
				Satzglied('Katze' Ruhen: zhüpfen)
				Gruppe(
					Reihe()
					[Satzglied('Hund') Satzglied('Hundeartig')]
					Ruhen: pochen
				)
				Satzglied('Katzenartig')
			]
		)
		Gruppe(
			Stapel()
			[
				Satzglied('Hi')
				Satzglied('Hallo')
			]
			Ruhen: Reihenfolge.drehen(2s "straight")
		)
	]
)