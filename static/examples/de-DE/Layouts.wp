K
Layouts
=== start
¶Reihen, Stapel und Gruppen von Sätzen, die jeweils auffällige animierte Posen zeigen.¶

pochen: Abfolge(
		{
			0%: Pose(Skala: .9)
			50%: Pose(Skala: 1.1)
			100%: Pose(Skala: .9)
		}
	)
zhüpfen: Abfolge(
		{
			0%: Pose(Versatz: Ort(z: 0m))
			50%: Pose(Versatz: Ort(z: -2m))
			100%: Pose(Versatz: Ort(z: 0m))
		}
		1s
	)

Gruppe(
	Reihe()
	[
		Gruppe(
			Stapel()
			[
				Phrase('Kätzchen')
				Phrase('Katze' Ruhen: zhüpfen)
				Gruppe(
					Reihe()
					[Phrase('Hund') Phrase('Hundeartig')]
					Ruhen: pochen
				)
				Phrase('Katzenartig')
			]
		)
		Gruppe(
			Stapel()
			[
				Phrase('Hi')
				Phrase('Hallo')
			]
			Ruhen: Abfolge.drehen(2s "straight")
		)
	]
)