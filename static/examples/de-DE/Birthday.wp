		{1 3 5}
		ø
		{4 5 7 9}
		{1 3 5}
		ø
		ø
	]

¶Der Kuchen schwillt bei jedem Schlag an und beruhigt sich dazwischen.¶
ƒ kuchen() Satzglied(
		'🎂'
		(4m + ((zählung % 2) · 0.4m))
		Dauer: 0.2s
	)

Bühne(
	[
		Gruppe(
			Stapel(Polsterung: 0.5m)
			[
				kuchen()
				Satzglied('Happy Birthday' 1.3m)
			]
		)
		Musik(
			[
				Spur(
					melodie2
					Instrument: Instrument.Flöte
					Schlag: 0.5beats
				)
				Spur(
					alt
					Instrument: Instrument.Geige
					Schlag: 0.5beats
					Lautstärke: 65%
				)
				Spur(
					akkorde
					Instrument: Instrument.Klavier
					Schlag: 1beats
					Lautstärke: 55%
				)
			]
			Tempo: 116beats/min
			Name: 'Geburtstag'
		)
	]
	Hintergrund: Farbe(18% 20 330°)
	Farbe: Farbe(96% 0 0°)
)
