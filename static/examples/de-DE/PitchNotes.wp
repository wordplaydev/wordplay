🎵
Tonhöhen der Noten
===
¶Sing oder summe und sieh die Note, die du machst – zweimal. Die linke Note liest das rohe @Pitch und zittert. Die rechte Note bildet den Durchschnitt der letzten Tonhöhen und bleibt ruhig. @Pitch meldet 0hz, wenn es nichts Klares hört. Deshalb überspringen beide Noten diese Momente und zeigen stattdessen · an.¶

noten: [
		'A'
		'Ais'
		'H'
		'C'
		'Cis'
		'D'
		'Dis'
		'E'
		'F'
		'Fis'
		'G'
		'Gis'
	]
noteVon: ƒ(hz•#hz) hz > 0hz ? noten[(((((12 × (hz ÷ 440hz).log(
										2
									)).runden(
							)) % 12) + 12) % 12) + 1] '·'
glatt2: ƒ(signal•…#hz) (
			gehört: (←← 8 signal).ohne(0hz)
			gehört.Durchschnitt() ?? 0hz
		)
tonhöhe: Tonhöhe()
Bühne(
	[
		Gruppe(
			Stapel()
			[
				Satzglied('verrauscht' Farbe: Farbe(60% 90 30°))
				Satzglied(
					noteVon(tonhöhe)
					Größe: 6m
					Farbe: Farbe(60% 90 30°)
				)
			]
			Ort: Ort(-4m 0m)
		)
		Gruppe(
			Stapel()
			[
				Satzglied('glatt' Farbe: Farbe(70% 90 240°))
				Satzglied(
					noteVon(glatt2(tonhöhe))
					Größe: 6m
					Farbe: Farbe(70% 90 240°)
				)
			]
			Ort: Ort(4m 0m)
		)
	]
)
