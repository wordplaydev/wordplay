Bühne(
	[
		:feuern.übersetzen(ƒ(p6•Teil i2•#) ausbruch(p6 i2))
		Musik(
			[
				Spur(
					melodie2
					Instrument: Instrument.Trompete
					Lautstärke: 90%
					Schleife: ⊥
				)
				Spur(
					bass
					Instrument: Instrument.Klavier
					Tonart: -12semitones
					Lautstärke: 50%
					Balance: -0.4
					Schleife: ⊥
				)
				Spur(
					glocke
					Instrument: Instrument.Glocke
					Lautstärke: 55%
					Schleife: ⊥
				)
				Spur(
					geige
					Instrument: Instrument.Geige
					Lautstärke: 45%
					Balance: 0.3
					Schleife: ⊥
				)
				Spur(
					flöte
					Instrument: Instrument.Flöte
					Lautstärke: 65%
					Schleife: ⊥
				)
				Spur(
					schlagzeug
					Instrument: Instrument.Schlagzeug
					Lautstärke: 45%
					Schleife: ⊥
				)
			]
			Tempo: 84beats/min
			Tonleiter: Musik.chromatisch
			Name: 'Hymne'
		)
	]
	Hintergrund: Farbe(10% 12 265°)
	Farbe: Farbe(96% 0 0°)
)
