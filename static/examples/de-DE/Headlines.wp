l
Schlagzeilen
=== start/en
¶Aktuelle Schlagzeilen der New York Times, aus dem Web geholt und auf der Bühne gestapelt.¶

schlagzeilen: Website(
		'https://www.nytimes.com'
		'.indicate-hover'
	)
schlagzeilen•# ?
	Phrase('lädt')
	Gruppe(
		Stapel('<')
		[
			Phrase(
				`*Schlagzeilen der New York Times*`
				2m
				gesicht: 'Arvo'
			)
		].mitListe(
			schlagzeilen.Folge(1 7).übersetzen(
				ƒ(schlagzeile)
					Phrase(
						schlagzeile
						wickeln: 20m
						Ausrichtung: '<'
						gesicht: 'Ubuntu'
						Ruhen: Abfolge(
							{
								0%: Pose(Drehung: 3°)
								50%: Pose(Drehung: -3°)
								100%: Pose(Drehung: 3°)
							}
							Dauer: 3s
						)
					)
			)
		)
	)