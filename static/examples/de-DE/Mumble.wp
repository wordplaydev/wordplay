m
Nuscheln
=== start
¶Klicke weiter, damit das Murmeln lauter und mutiger wird.¶

klicks•#: 0 … ∆ Taste() … klicks + 1

klicks < 3 ?
	Phrase(
		'murmeln'
		Größe: 1m
		Name: 'murmel'
		Eingabe: Pose(Skala: 0)
		Ruhen: Abfolge(
			{
				0%: Pose(Skala: (klicks + 1) × 1.1)
				50%: Pose(Skala: (klicks + 1) × 0.9)
				100%: Pose(Skala: (klicks + 1) × 1.1)
			}
			Dauer: 0.5s
		)
		Ausstieg: Abfolge(
			{
				0%: Pose(Opazität: 1 Skala: 1)
				100%: Pose(Opazität: 0 Skala: 10)
			}
			Dauer: 2s
		)
	)
	Phrase('fertig')