s
Ablauf-Beschleunigung
===
¶Dieselbe Auto-Animation auf acht Arten, eine für jeden Beschleunigungsstil.¶

schlüsselbilder: {
		0%: Pose(Versatz: Ort(-1m 0m))
		25%: Pose(Versatz: Ort(1m 0m))
		50%: Pose(Versatz: Ort(1m 0m))
		75%: Pose(Versatz: Ort(-1m 0m))
		100%: Pose(Versatz: Ort(-1m 0m))
	}

Bühne(
	[
		Gruppe(
			Netz(4 2 Zellenpolsterung: 0.25m)
			[
				Satzglied('gleichmäßig' Größe: 0.25m)
				Satzglied(
					"🚗"
					Ruhen: Reihenfolge(
						schlüsselbilder
						3s
						Stil: "straight"
					)
				)
				Satzglied('vorsichtig' Größe: 0.25m)
				Satzglied(
					"🚚"
					Ruhen: Reihenfolge(
						schlüsselbilder
						3s
						Stil: "cautious"
					)
				)
				Satzglied('lahm' Größe: 0.25m)
				Satzglied(
					"🚙"
					Ruhen: Reihenfolge(
						schlüsselbilder
						3s
						Stil: "pokey"
					)
				)
				Satzglied('flott' Größe: 0.25m)
				Satzglied(
					"🏎"
					Ruhen: Reihenfolge(
						schlüsselbilder
						3s
						Stil: "zippy"
					)
				)
			]
		)
	]
)