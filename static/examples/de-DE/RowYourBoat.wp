¶Ein Boot. Es gleitet bei jedem Schlag ein Stück weiter und schaukelt jedes Mal zur anderen Seite. Das sieht dann wie Rudern aus. Die Spur legt fest, wie hoch es liegt und wie weit vorne es gestartet ist, damit sie sich nicht alle gleich bewegen.¶
ƒ boot(spur•# anfang•#)•Satzglied
	Satzglied(
		'🚣'
		1.5m
		Ort: Ort(
			((((ruderschlag + anfang) % 16) - 8) · 1.1) · 1m
			((spur · 1.9) - 1.9) · 1m
		)
		Drehung: (((ruderschlag + spur) % 2) = 0) ? 9° -9°
		Dauer: 0.2s
	)

flotte: [boot(0 0) boot(1 6) boot(2 11)]

Bühne(
	[
		:flotte
		Satzglied(
			'〰〰〰〰〰〰〰〰'
			1m
			Ort: Ort(-8m -3.2m)
			Farbe: Farbe(48% 22 240°)
		)
		Satzglied(
			'Row, row, row your boat'
			0.9m
			Ort: Ort(-4.4m 3.4m)
		)
		Musik(
			[
				Spur(
					melodie2
					Instrument: Instrument.Flöte
					Schlag: 0.5beats
				)
				Spur(
					akkorde
					Instrument: Instrument.Klavier
					Schlag: 1beats
					Lautstärke: 60%
				)
				Spur(
					ruder
					Instrument: Instrument.Schlagzeug
					Schlag: 1beats
					Lautstärke: 45%
				)
			]
			Tempo: 144beats/min
			Name: 'Boot'
		)
	]
	Hintergrund: Farbe(22% 18 230°)
	Farbe: Farbe(96% 0 0°)
)
