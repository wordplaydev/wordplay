			bell7
			bell8
			bell9
			bell10
			pad1
			pad2
			pad3
			sax1
			sax2
			sax3
		]
		Tempo: 84beats/min
		Tonleiter: Musik.chromatisch
		Name: 'Airbag'
	)

Bühne(
	[
		wörter2()
		lied
	]
	gesicht: 'Phudu'
	Hintergrund: Farbe(0 0 0°)
	Farbe: Farbe(100 0 0°)
)
