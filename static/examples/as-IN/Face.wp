🙂
মুখ
===
¶এটা ইমোজি যিয়ে আপুনি হাঁহিলে, মুখ বেজাৰ কৰিলে, মুখ মেলি ধৰিলে, বা চকু ৰাংকিলে সেয়া অনুকৰণ কৰে।¶
মুখ2: মুখ()

মঞ্চ(
	[
		বাক্যাংশ(
			(মুখ2.মুখমেলা ? '😮'
					মুখ2.হাঁহি ? '😀'
						মুখ2.গোমা ? '🙁'
							মুখ2.ভ্ৰূওপৰউঠা ? '😲'
								(মুখ2.চকুমেলা ? '🙂' '😑'))
			স্থান: মুখ2.স্থান
			আকাৰ: 4m
		)
		গোট(
			স্তূপ('|')
			[
				বাক্যাংশ((মুখ2.চকুমেলা ? '👀' '😑') আকাৰ: 1.5m)
				বাক্যাংশ('😊' আকাৰ: (মুখ2.হাঁহিপৰিমাণ · 2m) + 0.5m)
				বাক্যাংশ('👄' আকাৰ: (মুখ2.মুখমেলাপৰিমাণ · 2m) + 0.5m)
				বাক্যাংশ('🤨' আকাৰ: (মুখ2.ভ্ৰূউঠাপৰিমাণ · 2m) + 0.5m)
			]
			স্থান: স্থান(-9m 8m)
		)
		বাক্যাংশ('ঘূৰাওক 🧭' স্থান: স্থান(9m 8m 0m) আকাৰ: 2m ঘূৰ্ণন: মুখ2.ঘূৰোৱা)
		বাক্যাংশ('বেঁকা কৰক 🧭' স্থান: স্থান(9m 2m) ঘূৰ্ণন: মুখ2.হেলোৱা আকাৰ: 2m)
		বাক্যাংশ(`/কেমেৰাটোক আপোনাৰ মুখ দেখুৱাওক/` স্থান: স্থান(-6m -12m) আকাৰ: 1m)
	]
	স্থান: স্থান(0m 0m -20m)
)