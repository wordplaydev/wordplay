K
পৰিকল্পনা
=== start
¶শাৰী, স্তূপ, আৰু বাক্যাংশৰ দল, প্ৰতিটোৱে এনিমেশ্বনযুক্ত ভংগিমা দেখুওৱা।¶
স্পন্দন: ক্ৰম(
		{0%: ভংগীমা(মাপন: .9) 50%: ভংগীমা(মাপন: 1.1) 100%: ভংগীমা(মাপন: .9)}
	)
zbounce: ক্ৰম(
		{
			0%: ভংগীমা(অফছেট: স্থান(z: 0m))
			50%: ভংগীমা(অফছেট: স্থান(z: -2m))
			100%: ভংগীমা(অফছেট: স্থান(z: 0m))
		}
		1s
	)

গোট(
	শাৰী()
	[
		গোট(
			স্তূপ()
			[
				বাক্যাংশ('সৰু মেকুৰী')
				বাক্যাংশ('মেকুৰী' জিৰণিলোৱা: zbounce)
				গোট(শাৰী() [বাক্যাংশ('কুকুৰ') বাক্যাংশ('কুকুৰজাতীয়')] জিৰণিলোৱা: স্পন্দন)
				বাক্যাংশ('মেকুৰীজাতীয়')
			]
		)
		গোট(
			স্তূপ()
			[
				বাক্যাংশ('নমস্কাৰ')
				বাক্যাংশ('হেল্লো')
			]
			জিৰণিলোৱা: ক্ৰম.ঘূৰ্ণন(2s "straight")
		)
	]
)