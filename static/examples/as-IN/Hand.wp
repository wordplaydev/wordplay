🖐
হাত
===
¶আপোনাৰ কেমেৰাৰ সন্মুখত আঙুলি দেখুৱাওক, আৰু এটা ইম'জি হাতে সৈতে গণনা কৰিব।¶

হাত2: হাত()

মঞ্চ(
	[
		বাক্যাংশ(
			(হাত2.আঙুলি = 0 ? '✊'
					হাত2.আঙুলি = 1 ? '☝'
						হাত2.আঙুলি = 2 ? '✌'
							হাত2.আঙুলি = 3 ? '🤟'
								হাত2.আঙুলি = 4 ? '🖖'
									'🖐')
			স্থান: হাত2.স্থান
			আকাৰ: 2m
			অফছেট: স্থান(-1m)
		)
		গোট(
			শাৰী('<')
			[
				বাক্যাংশ('1⃣' অফছেট: স্থান(0m হাত2.বুঢ়াআঙুলি ? 1m 0m))
				বাক্যাংশ('2⃣' অফছেট: স্থান(0m হাত2.সূচী ? 1m 0m))
				বাক্যাংশ('3⃣' অফছেট: স্থান(0m হাত2.মাজ ? 1m 0m))
				বাক্যাংশ('4⃣' অফছেট: স্থান(0m হাত2.আঙুঠি ? 1m 0m))
				বাক্যাংশ('5⃣' অফছেট: স্থান(0m হাত2.পিংকি ? 1m 0m))
			]
			স্থান: স্থান(-4.5m 5m)
		)
		গোট(
			স্তূপ('|')
			[
				বাক্যাংশ((হাত2.তলুৱা ? '🤚' '🤛') আকাৰ: 2m)
				বাক্যাংশ((হাত2.খোলা ? 'খোলা' 'বন্ধ') আকাৰ: 1.5m)
			]
			স্থান: স্থান(-2m -8m)
		)
		বাক্যাংশ(`/কেমেৰাক আপোনাৰ হাত দেখুৱাওক/` স্থান: স্থান(-6m -10m) আকাৰ: 1m)
	]
	স্থান: স্থান(0m 0m -20m)
)