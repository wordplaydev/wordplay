rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{project} {
      // Whether the given project data's gallery grants `uid` read access:
      // restricted projects admit only that gallery's curators; unrestricted
      // ones also admit the gallery's creators and anyone if the gallery is
      // public. Takes project data as a parameter (rather than reading
      // `resource.data`) so the nested `updates`/`presence` matches can apply
      // it to their parent project. Costs one get() per distinct gallery per
      // evaluation; the client keeps its `gallery in [...]` query chunks small
      // enough that a query never needs more than the rules' document-access
      // budget (10 per query request) of distinct gallery get()s.
      function galleryGrantsRead(uid, data) {
        let gallery = get(/databases/$(database)/documents/galleries/$(data.gallery)).data;
        return gallery != null && (
          ("restrictedGallery" in data && data.restrictedGallery && uid in gallery.curators) ||
          ((gallery.public || uid in gallery.creators || uid in gallery.curators) &&
            (!("restrictedGallery" in data) || !data.restrictedGallery))
        );
      }

      function isCuratorOf(uid, galleryID) {
        let gallery = get(/databases/$(database)/documents/galleries/$(galleryID)).data;
        return gallery != null && (uid in gallery.curators);
      }

      // Projects are readable if:
      // 1) They are public
      // 2) The requestor is the owner, a collaborator, a commenter, or a viewer
      // 3) The requestor is a curator or creator of the gallery that the project is in, or that gallery is public, and access to the project has not been restricted by its owner
      // 4) The requestor is a curator of the gallery that the project is in and access to the project is restricted
      // Shared by the project doc's read rule and the `updates`/`presence`
      // subcollections below, so that subcollection read access is always
      // exactly parent project read access.
      function canReadProject(data) {
        return
          (data != null && 'public' in data && data.public) ||
          (data != null && request.auth != null &&
            (
              ("mod" in request.auth.token && request.auth.token.mod) ||
              ('owner' in data && data.owner == request.auth.uid) ||
              ('collaborators' in data && request.auth.uid in data.collaborators) ||
              ('commenters' in data && request.auth.uid in data.commenters) ||
              ('viewers' in data && request.auth.uid in data.viewers) ||
              ('gallery' in data && data.gallery != null && galleryGrantsRead(request.auth.uid, data))
            )
          );
      }

      allow create: if request.auth != null && mayCreatePublic();
      allow read: if canReadProject(resource.data);
      // Research consent is the owner's to give: it permits Wordplay to show
      // *their* work anonymously, so a collaborator, curator, or moderator —
      // all of whom may update the doc for other reasons — must not be able to
      // flip it. Comparing the two values costs no document reads.
      //
      // Every field access here is guarded with `in`, for the same reason
      // canReadProject guards its own: reading a property that isn't on the
      // document is a hard CEL evaluation error, not a null. It fails closed,
      // so one unguarded access blocks every save of a document that predates
      // the field — including saves that have nothing to do with it.
      function researchConsentUnchangedOrOwner() {
        return (('owner' in resource.data) && resource.data.owner == request.auth.uid) ||
          // Unchanged: the same value on both sides of the write.
          (('researchConsent' in resource.data) &&
            ('researchConsent' in request.resource.data) &&
            request.resource.data.researchConsent == resource.data.researchConsent) ||
          // Absent before, because the document predates the field. Someone
          // other than the owner may still save it — they just can't be the
          // one who turns consent on. Passing the whole write here (which is
          // what `!('researchConsent' in resource.data)` alone did) let any
          // collaborator or curator consent on the owner's behalf.
          (!('researchConsent' in resource.data) &&
            (!('researchConsent' in request.resource.data) ||
              request.resource.data.researchConsent != true));
      }

      // Losing the ability to make anything public (#193). The check is the
      // `banned` custom claim rather than a read of strikes/{uid}: rules would
      // have to get() that document on every project write, which is the app's
      // hottest path, and this file's budget is already spent on the gallery
      // read above. A banned creator can still write, edit, and collaborate —
      // they simply can't write `public == true`.
      function notBanned() {
        return !("banned" in request.auth.token) || request.auth.token.banned != true;
      }
      // A write that doesn't leave the document public is never a publish.
      function notPublic() {
        return !('public' in request.resource.data) ||
          request.resource.data.public != true;
      }
      // On create there is nothing to compare against, so a banned creator
      // simply can't make public content.
      function mayCreatePublic() {
        return notBanned() || notPublic();
      }
      // On update, what a ban forbids is *making* something public, not editing
      // something that already is. A banned creator may still be a collaborator
      // on someone else's public project, or curate a gallery full of them, and
      // comparing the new value alone locked them out of both. Un-publishing
      // then re-publishing doesn't get around it: the second write sees a
      // private document and is refused.
      function mayUpdatePublic() {
        return notBanned() || notPublic() ||
          (('public' in resource.data) && resource.data.public == true);
      }

      // Ownership is the owner's to hand over (#189). Collaborators can update
      // the doc for every other reason, so without this any collaborator could
      // simply write themselves in as owner and lock the owner out of deleting
      // their own project. Comparing the two values costs no document reads.
      function ownerUnchangedOrOwner() {
        return !('owner' in resource.data) ||
          resource.data.owner == request.auth.uid ||
          ("mod" in request.auth.token && request.auth.token.mod) ||
          (('owner' in request.resource.data) &&
            request.resource.data.owner == resource.data.owner);
      }

      allow update:
        if request.auth != null &&
          mayUpdatePublic() &&
          researchConsentUnchangedOrOwner() &&
          ownerUnchangedOrOwner() &&
          (
            resource.data.owner == request.auth.uid ||
            request.auth.uid in resource.data.collaborators ||
            ("mod" in request.auth.token && request.auth.token.mod) ||
            (resource.data.gallery != null && isCuratorOf(request.auth.uid, resource.data.gallery))
          );
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Realtime CRDT updates for collaborative editing (#135). Each doc is
      // a small Yjs binary update (base64) emitted by one collaborator's
      // editor and consumed by all others. Anyone who can read the parent
      // project can read its updates (canReadProject, so gallery curators,
      // creators, and public viewers are included); only collaborators +
      // owner can append updates tagged with their own writer ID.
      //
      // Every field access on parent() is guarded with `'X' in parent()`
      // for the same reason canReadProject guards every field access on
      // its data: pre-v5 project docs predate `commenters` and `viewers`,
      // and `request.auth.uid in null` is a CEL evaluation error that
      // fails closed but in a confusing way. Guarding short-circuits
      // cleanly before any null reach.
      match /updates/{updateID} {
        function parent() {
          return get(/databases/$(database)/documents/projects/$(project)).data;
        }
        // parent() + gallery get = 2 distinct document accesses per
        // evaluation, well within the rules budget.
        allow read: if canReadProject(parent());
        allow create: if
          request.auth != null && (
            ('owner' in parent() && parent().owner == request.auth.uid) ||
            ('collaborators' in parent() && request.auth.uid in parent().collaborators)
          );
        // Updates are immutable once written — compaction (Stage 5
        // follow-up: Cloud Function) replaces them by writing a new
        // snapshot to the parent doc and deleting consumed updates.
        allow update: if false;
        allow delete: if request.auth != null && (
          ('owner' in parent() && parent().owner == request.auth.uid) ||
          ("mod" in request.auth.token && request.auth.token.mod)
        );
      }

      // Presence: one doc per collaborator's clientID, with their caret
      // position and a heartbeat lastSeen. Readable by anyone who can read
      // the parent project (canReadProject, so gallery curators, creators,
      // and public viewers are included); writable by anyone who can edit
      // the project (owner, collaborators, and gallery curators — who can
      // already update the project doc itself), and only as themselves.
      match /presence/{clientID} {
        function parent() {
          return get(/databases/$(database)/documents/projects/$(project)).data;
        }
        allow read: if canReadProject(parent());
        allow write: if
          request.auth != null && (
            ('owner' in parent() && parent().owner == request.auth.uid) ||
            ('collaborators' in parent() && request.auth.uid in parent().collaborators) ||
            ('gallery' in parent() && parent().gallery != null && isCuratorOf(request.auth.uid, parent().gallery))
          ) && 'userID' in request.resource.data
            && request.resource.data.userID == request.auth.uid;
        allow delete: if
          request.auth != null && (
            ('userID' in resource.data && resource.data.userID == request.auth.uid) ||
            ('owner' in parent() && parent().owner == request.auth.uid)
          );
      }
    }
    match /creators/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Server-authoritative usage counters, currently the daily translation
    // budget (#1073). Readable by its owner so the meter is live without a
    // round trip; never client-writable, since a creator who could write this
    // could reset their own budget. Only the Admin SDK writes it, which
    // bypasses rules. Deliberately not a field on creators/{uid}: that document
    // is client-writable and the client overwrites it wholesale when settings
    // change, so a counter there would be both forgeable and clobbered.
    match /usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // A creator's moderation record (#193). Server-authoritative for the same
    // reason usage/{uid} is: a creator who could write this could clear their
    // own strikes. Readable by its subject, so the app can explain why public
    // sharing is unavailable, and by moderators, so they can see the
    // consequence of the decision they're about to make. Written only by the
    // moderateProject callable, through the Admin SDK.
    match /strikes/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || ("mod" in request.auth.token && request.auth.token.mod));
      allow write: if false;
    }
    // A creator's inbox (#938). Server-written, self-readable — the same shape
    // as usage/{uid} and strikes/{uid}, and a document rather than a
    // subcollection because the whole access pattern is "read all of mine",
    // which needs no index and no second rules block.
    //
    // A notice is delivered rather than derived exactly when its recipient
    // cannot read what it is about: a reporter may never read `reports`, so the
    // outcome of their report has to be sent to them.
    match /notices/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // The reader may start their own empty inbox, so a dismissal of a
      // *derived* notice has somewhere to land before the server has ever
      // written them anything. Empty only: the notices are not theirs to write.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.notices.size() == 0;
      // Marking read and dismissing are the reader's; the notices are not. A
      // creator who could append one could forge a moderator's decision to
      // themselves, or delete the warning they were just given.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['readAt', 'dismissed']);
      allow delete: if false;
    }
    // Requests that someone review a piece of content (#938, generalizing
    // #193). A separate collection because the person reporting can't write the
    // project document — the project rules admit only its owner, collaborators,
    // curators, and moderators — so a `reported` field on the thing itself is
    // not expressible.
    //
    // A report is a request for review, not a public accusation, so neither the
    // reporter nor the author may read one; only whoever is responsible for the
    // content can.
    //
    // Written only by the `report` and `moderate` callables through the Admin
    // SDK, which bypasses these rules. No client may write one: a reporter who
    // could name their own reviewers is the same mistake as a creator who could
    // clear their own strikes, and a chat report moves someone else's words out
    // of the chat document.
    match /reports/{report} {
      allow create, update, delete: if false;
      // `moderators` is denormalized onto the report exactly so this is an
      // array-contains and not a get() of the gallery: rules allow only ~10
      // document accesses per query request (see src/db/firestoreLimits.ts),
      // and a curator's queue spanning more galleries than that budget would be
      // denied whole rather than partially.
      allow read: if request.auth != null && (
        (("mod" in request.auth.token) && request.auth.token.mod
          && ("platform" in resource.data) && resource.data.platform) ||
        (("moderators" in resource.data) && request.auth.uid in resource.data.moderators)
      );
    }
    match /galleries/{gallery} {
      // The same ban as on projects (#193): a creator who has lost public
      // sharing can still curate a gallery, but can't publish one. Checked
      // against the custom claim, so it costs no document reads.
      function galleryMayBePublic() {
        return (!("banned" in request.auth.token) || request.auth.token.banned != true)
          || !('public' in request.resource.data)
          || request.resource.data.public != true;
      }
      // A gallery's moderation state (#1311) is written by the moderateGallery
      // function and the galleryEdited trigger, both of which use the Admin SDK
      // and so bypass these rules. No client may write it: a curator who could
      // approve their own gallery is the whole thing this curation prevents.
      // `public` stays theirs to set — it's the request, not the decision.
      function galleryServerFieldsUnchanged() {
        return (!("moderation" in request.resource.data) || request.resource.data.moderation == resource.data.moderation)
          && (!("moderatedAt" in request.resource.data) || request.resource.data.moderatedAt == resource.data.moderatedAt)
          && (!("flags" in request.resource.data) || request.resource.data.flags == resource.data.flags)
          && (!("words" in request.resource.data) || request.resource.data.words == resource.data.words);
      }
      allow create: if request.auth != null && galleryMayBePublic();
      // Public galleries can be read, as can private ones if the creator is a curator, creator, or a how to viewer.
      // Moderators can read any of them, since a gallery awaiting a decision is
      // by definition not yet public — the same access the mod claim already
      // grants on projects and how-tos.
      allow read: if (resource.data != null && "public" in resource.data && resource.data.public) || (
        request.auth != null && (
          ("mod" in request.auth.token && request.auth.token.mod) ||
          ("curators" in resource.data && request.auth.uid in resource.data.curators) || 
          ("creators" in resource.data && request.auth.uid in resource.data.creators) || 
          (
            "howToExpandedVisibility" in resource.data && 
            "howToViewersFlat" in resource.data && 
            resource.data.howToExpandedVisibility && 
            request.auth.uid in resource.data.howToViewersFlat
          )
        )
      );
      
      allow update: 
        if request.auth != null && 
          galleryMayBePublic() &&
          galleryServerFieldsUnchanged() &&
          // Curators can update anything
          // Creators can't update public status or creator or curator list.
          (
            request.auth.uid in resource.data.curators || 
            (
              request.auth.uid in resource.data.creators && 
              request.resource.data.public == resource.data.public && 
              request.resource.data.curators == resource.data.curators && 
              request.resource.data.creators == resource.data.creators
            )
          );
      allow delete: if request.auth != null && request.auth.uid in resource.data.curators;
    }
    match /chats/{chat} {
      // A chat's document id is its project's id, so the project's ownership is
      // what governs deleting it. Deleting a project is the only path that
      // deletes a chat, and the project rules admit only its owner there; with
      // delete open to every participant, anyone in a class conversation could
      // destroy it for everyone. One get(), on a rare single-document path —
      // nowhere near the per-query access budget src/db/firestoreLimits.ts
      // describes, which is spent on the project and how-to read rules.
      function ownsChatsProject() {
        let project = get(/databases/$(database)/documents/projects/$(chat));
        return project != null
          && "owner" in project.data
          && project.data.owner == request.auth.uid;
      }
      // Anyone logged in can create chats
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource == null || (resource.data != null && request.auth.uid in resource.data.participants));
      // Participants send messages, mark themselves read, and keep the
      // participant list in step with the project's own permissions. What was
      // *decided* about a message is the server's alone.
      //
      // `moderation` is a top-level map rather than a field on each message
      // precisely so this rule can refuse it: a rule can name a key, but cannot
      // reach inside an array to protect one field of one element — which is
      // why a participant could previously set their own reported message back
      // to `approved` (#938).
      //
      // Two holes stay open here, both with the same shape and both needing
      // work beyond a rule. `participants` is client-written because
      // syncParticipants mirrors the project's permissions from whichever
      // client notices the change; moving that to a trigger is what would close
      // it. And a participant can still rewrite another participant's message
      // *text*, because an append-only guard over `messages` would make
      // soft-deleting your own message inexpressible and risks the rules
      // expression limits on a 128KB array; messages as a subcollection is the
      // real fix. Both are recorded in chatRules.test.ts rather than left
      // silent.
      allow update: if request.auth != null && resource.data != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['messages', 'unread', 'participants'])
        && request.resource.data.messages.size() >= resource.data.messages.size();
      allow delete: if request.auth != null && ownsChatsProject();
    }
    match /classes/{class} {
      function isTeacher() { 
        return "teacher" in request.auth.token && request.auth.token.teacher; 
      }

      // Only teachers can create classes
      allow create: if request.auth != null && isTeacher();
      // Students and teachers can read classes
      allow get: if request.auth != null && resource.data != null && (
        ("learners" in resource.data && request.auth.uid in resource.data.learners) || 
        ("teachers" in resource.data && request.auth.uid in resource.data.teachers)
      );
      allow list: if request.auth != null;
      // Only teachers of a class can update and delete classes
      allow update, delete: if request.auth != null && isTeacher() && (resource.data != null && request.auth.uid in resource.data.teachers);
    }
    match /characters/{character} {
      // Anyone logged in can create characters
      allow create: if request.auth != null;
      // Allowed if it doesn't exist or this is the owner asking, Owners or ownerless characters can be read
      allow read: 
        if resource == null ||
          ("public" in resource.data && resource.data.public) || 
          (request.auth != null && 
            (
              ("owner" in resource.data && request.auth.uid == resource.data.owner) ||
              ("collaborators" in resource.data && request.auth.uid in resource.data.collaborators)
            )
          );
      // Only owners can update or delete.
      allow update: if request.auth.uid == resource.data.owner || ("collaborators" in resource.data && request.auth.uid in resource.data.collaborators);
      allow delete: if request.auth.uid == resource.data.owner;
    }
    match /feedback/{id} {
      // Anyone can see feedback
      allow read: if true;
      // Anyone logged in can create feedback
      allow create: if request.auth != null;
      // Only the creator can read, update, or delete their feedback; anyone can vote on the feedback though
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.creator || ("mod" in request.auth.token && request.auth.token.mod) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["votes"]));
    }
    match /howtos/{id} {
      function isGalleryPublic(galleryID) {
        let gallery = get(/databases/$(database)/documents/galleries/$(galleryID)).data;
        return gallery != null && "public" in gallery && gallery.public;
      }

      function isRequestorOwnerCollaborator(uid) {
        return resource.data != null && (("creator" in resource.data && uid == resource.data.creator) || ("collaborators" in resource.data && uid in resource.data.collaborators));
      }

      function isRequestorCuratorCollaborator(uid, galleryID) {
        let gallery = get(/databases/$(database)/documents/galleries/$(galleryID)).data;
        return gallery != null && (("curators" in gallery && uid in gallery.curators) || ("creators" in gallery && uid in gallery.creators));
      }

      function isRequestorCurator(uid, galleryID) {
        let gallery = get(/databases/$(database)/documents/galleries/$(galleryID)).data;
        return gallery != null && "curators" in gallery && uid in gallery.curators;
      }

      function isRequestorViewer(uid) {
        return 
          "scopeOverwrite" in resource.data &&
          !resource.data.scopeOverwrite &&
          "viewersFlat" in resource.data && 
          uid in resource.data.viewersFlat;
      }

      allow create: if request.auth != null && "galleryId" in request.resource.data && isRequestorCuratorCollaborator(request.auth.uid, request.resource.data.galleryId);
      // Published how-tos are readable if:
      // 1) the gallery the how-to is in is public
      // 2) the requestor is the owner or a collaborator
      // 3) the requestor is a curator or collaborator of the gallery the how-to is in
      // 4) the requestor is a viewer of the gallery the how-to is in
      // Unpublished how-tos (drafts) are only readable by the creator and collaborators
      allow read: 
        if resource.data != null && (
          (request.auth != null && "mod" in request.auth.token && request.auth.token.mod) ||
          ('isPublic' in resource.data && resource.data.isPublic) ||
          isRequestorOwnerCollaborator(request.auth.uid) ||
          ('galleryId' in resource.data && isGalleryPublic(resource.data.galleryId)) ||
          ("published" in resource.data && resource.data.published && (
            ('galleryId' in resource.data && isRequestorCuratorCollaborator(request.auth.uid, resource.data.galleryId)) ||
            isRequestorViewer(request.auth.uid)
          ))
        );

      allow update: 
      // How-tos can be updated if:
      // 0) a moderator
      // 1) owner or collaborator
      // 2) curator of the gallery the how-to is in
      // we also allow updating the social interactions of a how-to as long as the user can view it (viewer, owner, collaborator, gallery curator or collaborator)
      // and updating xcoord, ycoord by how-to owner/collaborator and gallery curator/collaborator
        if request.auth != null && 
          (
            ("mod" in request.auth.token && request.auth.token.mod) ||
            isRequestorOwnerCollaborator(request.auth.uid) ||
            ("galleryId" in request.resource.data && isRequestorCurator(request.auth.uid, request.resource.data.galleryId)) ||
            ('galleryId' in request.resource.data && 
              (
                (
                  isRequestorCuratorCollaborator(request.auth.uid, request.resource.data.galleryId) || 
                  isRequestorOwnerCollaborator(request.auth.uid)
                ) && 
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(["xcoord", "ycoord"])
              ) ||
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(["social"]) && 
                (
                  isRequestorViewer(request.auth.uid) || 
                  isRequestorCuratorCollaborator(request.auth.uid, request.resource.data.galleryId) || 
                  isRequestorOwnerCollaborator(request.auth.uid)
                )
              )  
            )
          );
      allow delete: if request.auth != null && (resource.data.creator == request.auth.uid || isRequestorCurator(request.auth.uid, resource.data.galleryId));
    }
  }
}