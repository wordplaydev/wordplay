{
    "projects": {
        "default": "wordplay-dev",
        "dev": "wordplay-dev",
        "prod": "wordplay-prod"
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "runtime": "nodejs22",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "**/*.test.ts",
                "lib/**/*.test.js",
                "lib/**/*.test.js.map"
            ],
            "predeploy": [
                "npm ci --prefix \"$RESOURCE_DIR\"",
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ]
        }
    ],
    "hosting": {
        "predeploy": ["npm run build:web"],
        "public": "build",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "headers": [
            {
                "source": "/_app/immutable/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            },
            {
                "source": "/locales/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            },
            {
                "source": "/updates.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            },
            {
                "source": "/_app/version.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "/function/getWebpage",
                "run": {
                    "serviceId": "getwebpage",
                    "region": "us-central1",
                    "pinTag": true
                }
            },
            {
                "regex": "^(?:/[A-Za-z0-9_+-]+)?/(?:project|gallery)/[^/]+/?$",
                "function": {
                    "functionId": "getPagePreview",
                    "region": "us-central1",
                    "pinTag": true
                }
            },
            {
                "source": "/sitemap.xml",
                "function": {
                    "functionId": "getSitemap",
                    "region": "us-central1",
                    "pinTag": true
                }
            },
            {
                "source": "**",
                "destination": "/200.html"
            }
        ],
        "cleanUrls": true
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5002
        },
        "ui": {
            "enabled": true
        },
        "singleProjectMode": true
    }
}
