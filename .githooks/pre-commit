#!/bin/sh
# Auto-format staged files with prettier before committing, so formatting drift
# never reaches CI's `prettier --check` gate. lint-staged formats only the
# staged files and re-stages them. Installed via core.hooksPath by
# scripts/setup-git-config.ts (run from postinstall).
npx lint-staged || exit 1

# The corpus sweeps (src/util/sweepTests.ts) are out of `npm run test:run`,
# because their cost scales with static/examples and static/locales rather than
# with the code — 172 of the unit suite's 318 CPU-seconds. That is only safe if
# staging the corpus runs them. The generated locale artifacts (names.json, each
# locale's how-to bundle) and the localized examples all go stale silently: only
# `npm run locales` notices, and the CI job that runs it does no build, so before
# this the first sign of a missed regeneration was a red deploy.
#
# Runs after lint-staged so it reads the formatted, re-staged content. The match
# is deliberately broad and includes the sweeps' own source modules, since a
# change to retargetExampleNames.ts or examples.ts changes every answer they give:
# a needless run costs seconds, a missed one costs a blocked deploy.
# WORDPLAY_SWEEP_CHANGED restricts the two localized-example sweeps to the locales
# this working tree actually touched — the same predicate `npm run locales` uses —
# so a one-locale commit pays a few seconds rather than a minute. CI never sets it
# and always runs every locale. Repair with `npm run locales-fix`; bypass with
# --no-verify or WORDPLAY_SKIP_SWEEP=1.
if [ -z "$WORDPLAY_SKIP_SWEEP" ] && git diff --cached --name-only |
	grep -qE '^(static/examples/|static/locales/|src/locale/en-US\.json$|src/util/verify-locales/|src/examples/)'; then
	echo "Corpus staged; running the sweep for what changed..."
	WORDPLAY_SWEEP_CHANGED=1 npm run test:sweep || exit 1
fi

# An in-place edit to an en-US string leaves every translation describing older
# English, and nothing else notices — `$!` has to be typed by hand and almost
# never is (#1144). This compares the staged en-US against HEAD (two blob reads,
# no history walk) and names what changed. A warning, not a gate: the fix is a
# translation run, so blocking the commit would be the wrong shape.
if git diff --cached --name-only |
	grep -qE '^(src/locale/en-US\.json|static/locales/en-US/en-US-tutorial(-[a-z]+)?\.json)$'; then
	npx tsx src/util/verify-locales/driftCLI.ts --staged || true
fi
